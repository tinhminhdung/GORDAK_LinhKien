@model List<Antigravity.ECommerce.Models.FAQ>
@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    ViewData["Title"] = ViewBag.CurrentCategory != null ? ViewBag.CurrentCategory.Name : "Câu hỏi thường gặp";
    var categories = ViewBag.Categories as List<Antigravity.ECommerce.Models.Category>;
    int currentPage = ViewBag.CurrentPage;
    int totalPages = (int)Math.Ceiling((double)ViewBag.TotalCount / ViewBag.PageSize);
    ViewData["SchemaFAQs"] = Model;
}

@section Styles {
    <style>
        .faq-hero {
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            border-radius: 20px;
            padding: 60px 40px;
            text-align: center;
            margin-bottom: 50px;
        }
        .accordion-button:not(.collapsed) {
            color: #0d6efd;
            background-color: #f1f7ff;
            box-shadow: inset 0 -1px 0 rgba(0,0,0,.125);
            font-weight: 600;
        }
        .accordion-button {
            font-size: 1.1rem;
            font-weight: 500;
            padding: 20px;
        }
        .accordion-body {
            font-size: 1rem;
            line-height: 1.6;
            color: #555;
            padding: 20px;
        }
        .cat-nav {
            overflow-x: auto;
            white-space: nowrap;
            padding-bottom: 5px;
            margin-bottom: 30px;
        }
        .cat-nav-item {
            padding: 10px 20px;
            border-radius: 30px;
            text-decoration: none;
            color: #555;
            background: #f8f9fa;
            font-weight: 500;
            transition: all 0.2s;
        }
        .cat-nav-item:hover, .cat-nav-item.active {
            background: #0d6efd;
            color: #fff;
        }
    </style>
}

<div class="container mt-3 mb-2">
    <nav class="sp-breadcrumb">
        <a href="/">Trang chủ</a> 
        <i class="fa-solid fa-chevron-right"></i> 
        @if(ViewBag.CurrentCategory == null) {
            <span>Hỏi đáp</span>
        } else {
            <a href="/hoi-dap.html">Hỏi đáp</a> <i class="fa-solid fa-chevron-right"></i> <span>@ViewBag.CurrentCategory.Name</span>
        }
    </nav>
</div>

<div class="container">
    <div class="faq-hero shadow-sm mt-3">
        <h1 class="fw-bold mb-3 display-5">Bạn có câu hỏi? Chúng tôi có câu trả lời</h1>
        <p class="text-muted fs-5 mb-0 max-w-2xl mx-auto">Tìm kiếm thông tin bạn cần từ cơ sở dữ liệu các câu hỏi thường gặp nhất của chúng tôi.</p>
    </div>

    @if (categories != null && categories.Count > 0)
    {
        <div class="row">
            <div class="col-12">
                <div class="cat-nav d-flex gap-2 justify-content-center">
                    <a href="/hoi-dap.html" class="cat-nav-item @(ViewBag.CurrentCategory == null ? "active" : "")">Tất cả</a>
                    @foreach (var cat in categories)
                    {
                        <a href="/hoi-dap/@(cat.Slug).html" class="cat-nav-item @(ViewBag.CurrentCategory != null && ViewBag.CurrentCategory.CategoryId == cat.CategoryId ? "active" : "")">@cat.Name</a>
                    }
                </div>
            </div>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-lg-9">
            @if (Model != null && Model.Count > 0)
            {
                <div class="accordion shadow-sm" id="accordionFAQ" style="border-radius: 10px; overflow:hidden;">
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var item = Model[i];
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="heading_@item.FAQId">
                                <button class="accordion-button @(i != 0 ? "collapsed" : "")" type="button" data-bs-toggle="collapse" data-bs-target="#collapse_@item.FAQId" aria-expanded="@(i == 0 ? "true" : "false")" aria-controls="collapse_@item.FAQId">
                                    @item.Question
                                </button>
                            </h2>
                            <div id="collapse_@item.FAQId" class="accordion-collapse collapse @(i == 0 ? "show" : "")" aria-labelledby="heading_@item.FAQId" data-bs-parent="#accordionFAQ">
                                <div class="accordion-body">
                                    @Html.Raw(item.Answer)
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="vd-pagination mt-4 mb-5">
                    @if (currentPage > 1)
                    {
                        <a class="vd-page-btn" href="?page=@(currentPage - 1)"><i class="fa-solid fa-chevron-left" style="font-size:11px;"></i></a>
                    }
                    else
                    {
                        <a class="vd-page-btn disabled" href="javascript:void(0);"><i class="fa-solid fa-chevron-left" style="font-size:11px;"></i></a>
                    }
                    @for (int i = 1; i <= Math.Max(1, totalPages); i++)
                    {
                        <a class="vd-page-btn @(i == currentPage ? "active" : "")" href="?page=@i">@i</a>
                    }
                    @if (currentPage < totalPages)
                    {
                        <a class="vd-page-btn" href="?page=@(currentPage + 1)"><i class="fa-solid fa-chevron-right" style="font-size:11px;"></i></a>
                    }
                    else
                    {
                        <a class="vd-page-btn disabled" href="javascript:void(0);"><i class="fa-solid fa-chevron-right" style="font-size:11px;"></i></a>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <lord-icon src="https://cdn.lordicon.com/msoeawqm.json" trigger="loop" style="width:100px;height:100px"></lord-icon>
                    <h4 class="text-muted mt-3">Chưa có câu hỏi nào trong chuyên mục này.</h4>
                </div>
                <!-- Load lordicon script if needed -->
                <script src="https://cdn.lordicon.com/bhenfmcm.js"></script>
            }
        </div>
    </div>
</div>


<br />
