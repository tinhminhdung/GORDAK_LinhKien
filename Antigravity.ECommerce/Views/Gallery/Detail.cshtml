@model Antigravity.ECommerce.Models.Gallery
@using Antigravity.ECommerce.Services
@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    ViewData["Title"] = Model.AlbumName;
    var related = ViewBag.Related as List<Antigravity.ECommerce.Models.Gallery>;
    if (!string.IsNullOrEmpty(Model.CoverImage)) { ViewData["Image"] = Model.CoverImage; }
    
    var settings = SSetting.GetViewModel();

    // Lấy dữ liệu cho Sidebar trực tiếp trong View
    var categories = SCategory.GetAll().Where(x => x.Status == 1 && x.CategoryType == 6).OrderBy(x => x.SortOrder).ToList();
    var allGalleries = SGallery.GetAll().Where(x => x.Status == 1).ToList();
    var totalGalleryCount = allGalleries.Count;
    var lookup = SCategory.GetAll().ToLookup(x => x.ParentId);
    foreach (var cat in categories)
    {
        var catIds = SCategory.GetDescendantIds(cat.CategoryId, lookup);
        cat.ItemCount = allGalleries.Count(x => catIds.Contains(x.CategoryId));
    }
}

@section Styles {
    <!-- GLightbox CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css" />
    <style>
        .album-header {
            background:#f8f9fa;
            border-radius:15px;
            padding:30px;
            margin-bottom:30px;
        }
        .masonry-grid {
            display: column;
            column-count: 3;
            column-gap: 20px;
        }
        @@media (max-width: 991px) { .masonry-grid { column-count: 2; } }
        @@media (max-width: 575px) { .masonry-grid { column-count: 1; } }

        .masonry-item {
            margin-bottom: 20px;
            break-inside: avoid;
            position: relative;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
            transition: transform 0.3s ease;
            display: block;
        }
        .masonry-item img {
            width: 100%;
            height: auto;
            display: block;
            transition: transform 0.5s ease;
        }
        .masonry-item:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.15); }
        .masonry-item:hover img { transform: scale(1.05); }
        
        .masonry-caption {
            position: absolute;
            bottom: -50px; left: 0; right: 0;
            background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
            color: #fff; padding: 20px 15px 15px;
            transition: bottom 0.3s ease;
            font-size: 14px;
        }
        .masonry-item:hover .masonry-caption { bottom: 0; }
        .social-circle {
            display: inline-flex; align-items: center; justify-content: center;
            width: 36px; height: 36px; border-radius: 50%; color: #fff;
            font-size: 14px; transition: opacity .2s;
        }
        .social-circle:hover { opacity: .8; color: #fff; }
    </style>
}

<div class="container mt-3 mb-2">
    <nav class="sp-breadcrumb">
        <a href="/">Trang chủ</a> 
        <i class="fa-solid fa-chevron-right"></i> 
        <a href="/thu-vien-anh.html">Thư viện Ảnh</a>
        <i class="fa-solid fa-chevron-right"></i> 
        <span>@Model.AlbumName</span>
    </nav>
</div>

<main class="container mb-5">
    <div class="row g-4">
        <!-- NỘI DUNG CHÍNH -->
        <div class="col-lg-9">
            
            <div class="album-header">
                <h1 class="fw-bold fs-2" style="color: #212d45; line-height: 1.3;">@Model.AlbumName</h1>
                <p class="text-muted mt-2 mb-0"><i class="mdi mdi-calendar-blank"></i> @Model.CreatedAt.ToString("dd/MM/yyyy") &nbsp;|&nbsp; <i class="mdi mdi-folder-image"></i> @Model.CategoryName</p>
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <p class="mt-3 mb-0" style="font-size:16px;">@Model.Description</p>
                }
            </div>

            <div class="masonry-grid mt-4">
                @if (Model.ImageList != null && Model.ImageList.Count > 0)
                {
                    foreach (var img in Model.ImageList)
                    {
                        <a href="@img.ImagePath" class="glightbox masonry-item" data-gallery="album_@Model.GalleryId" data-title="@img.Caption" data-description="@img.Caption">
                            <img src="@img.ImagePath" alt="@img.Caption" loading="lazy">
                            @if (!string.IsNullOrEmpty(img.Caption))
                            {
                                <div class="masonry-caption">@img.Caption</div>
                            }
                        </a>
                    }
                }
                else
                {
                    <p class="text-center text-muted w-100 py-5">Album này chưa có ảnh nào.</p>
                }
            </div>

            <!-- Social Share -->
            <div class="d-flex align-items-center gap-3 mt-5 p-3 bg-light rounded-3">
                <span class="fw-bold">Chia sẻ album: </span>
                <div class="d-flex gap-2">
                    <a href="https://www.facebook.com/sharer/sharer.php?u=@(Context.Request.Scheme + "://" + Context.Request.Host + Context.Request.Path)" target="_blank" class="social-circle" style="background:#3b5998;"><i class="fa-brands fa-facebook-f"></i></a>
                    <a href="https://twitter.com/intent/tweet?url=@(Context.Request.Scheme + "://" + Context.Request.Host + Context.Request.Path)" target="_blank" class="social-circle" style="background:#1da1f2;"><i class="fa-brands fa-twitter"></i></a>
                    <a href="https://www.linkedin.com/shareArticle?mini=true&url=@(Context.Request.Scheme + "://" + Context.Request.Host + Context.Request.Path)" target="_blank" class="social-circle" style="background:#0a66c2;"><i class="fa-brands fa-linkedin-in"></i></a>
                </div>
            </div>

        </div>

        <!-- SIDEBAR -->
        <div class="col-lg-3">
            <!-- Danh mục -->
            <div class="tt-sidebar-box mb-3">
                <h4 class="tt-sidebar-title">DANH MỤC ẢNH</h4>
                <ul class="tt-sidebar-list">
                    <li><a href="/thu-vien-anh.html">Tất cả <span>@totalGalleryCount</span></a></li>
                    @foreach(var cat in categories.Take(10)) {
                        <li><a href="/thu-vien-anh/@(cat.Slug).html">@cat.Name <span>@cat.ItemCount</span></a></li>
                    }
                </ul>
                @if(categories.Count > 10) {
                    <a href="javascript:void(0)" onclick="$('.tt-sidebar-list li.d-none').removeClass('d-none'); $(this).hide();" class="tt-sidebar-link">Xem tất cả danh mục <i class="fa-solid fa-arrow-right"></i></a>
                    <ul class="tt-sidebar-list">
                         @foreach(var cat in categories.Skip(10)) {
                            <li class="d-none"><a href="/thu-vien-anh/@(cat.Slug).html">@cat.Name <span>@cat.ItemCount</span></a></li>
                        }
                    </ul>
                }
            </div>

            <!-- Album liên quan -->
            @if(related != null && related.Any()) {
            <div class="tt-sidebar-box mb-3">
                <h4 class="tt-sidebar-title">ALBUM LIÊN QUAN</h4>
                @foreach(var r in related.Take(5)) {
                    <div class="tt-hot-item">
                        <a href="/album/@(r.Slug).html">
                            <img src="@(string.IsNullOrEmpty(r.CoverImage) ? "/assets/images/no-image.png" : r.CoverImage)" alt="@r.AlbumName">
                        </a>
                        <div>
                            <a href="/album/@(r.Slug).html" class="tt-hot-title line-clamp-2">@r.AlbumName</a>
                            <div class="tt-hot-meta">
                                <i class="fa-regular fa-calendar"></i> @r.CreatedAt.ToString("dd/MM/yyyy")
                            </div>
                        </div>
                    </div>
                }
            </div>
            }

            <!-- CTA Box -->
            <partial name="_SidebarCTA" />
        </div>
    </div>
</main>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/glightbox/dist/js/glightbox.min.js"></script>
    <script>
        const lightbox = GLightbox({
            touchNavigation: true,
            loop: true,
            autoplayVideos: true,
            zoomable: true
        });
    </script>
}
