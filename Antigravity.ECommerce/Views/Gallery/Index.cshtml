@model List<Antigravity.ECommerce.Models.Gallery>
@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    ViewData["Title"] = ViewBag.CurrentCategory != null ? ViewBag.CurrentCategory.Name : "Thư viện Ảnh";
    var categories = ViewBag.Categories as List<Antigravity.ECommerce.Models.Category>;
    int currentPage = ViewBag.CurrentPage;
    int totalPages = (int)Math.Ceiling((double)ViewBag.TotalCount / ViewBag.PageSize);
}

@section Styles {
    <style>
        .gallery-card {
            border: none;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
            transition: all 0.3s ease;
        }
        .gallery-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        }
        .gallery-img-wrap {
            position: relative;
            height: 220px;
            overflow: hidden;
        }
        .gallery-img-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }
        .gallery-card:hover .gallery-img-wrap img {
            transform: scale(1.08);
        }
        .gallery-overlay {
            position: absolute;
            bottom: 0; left: 0; right: 0;
            background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
            padding: 20px 15px;
            color: #fff;
        }
        .album-count {
            position: absolute;
            top: 10px; right: 10px;
            background: rgba(0,0,0,0.6);
            color: #fff;
            padding: 4px 10px;
            border-radius: 20px;
            backdrop-filter: blur(4px);
            font-size: 13px;
        }
        .cat-nav {
            overflow-x: auto;
            white-space: nowrap;
            -webkit-overflow-scrolling: touch;
            padding-bottom: 5px;
        }
        .cat-nav::-webkit-scrollbar { height: 4px; }
        .cat-nav::-webkit-scrollbar-thumb { background: #ccc; border-radius: 4px; }
    </style>
}

<div class="row mb-5">
    <div class="col-12 text-center">
        <h1 class="fw-bold mb-3">@(ViewBag.CurrentCategory != null ? ViewBag.CurrentCategory.Name : "Khám phá Thư viện Ảnh")</h1>
        @if (ViewBag.CurrentCategory != null)
        {
            <p class="text-muted max-w-2xl mx-auto">@ViewBag.CurrentCategory.Description</p>
        }
        else
        {
            <p class="text-muted max-w-2xl mx-auto">Khám phá những khoảnh khắc và dự án tuyệt vời qua các lăng kính đa chiều của chúng tôi.</p>
        }
    </div>
</div>

@if (categories != null && categories.Count > 0)
{
    <div class="row mb-4">
        <div class="col-12">
            <div class="cat-nav d-flex gap-2 justify-content-center">
                <a href="/thu-vien-anh.html" class="btn rounded-pill px-4 @(ViewBag.CurrentCategory == null ? "btn-primary" : "btn-light")">Tất cả</a>
                @foreach (var cat in categories)
                {
                    <a href="/thu-vien-anh/@cat.Slug" class="btn rounded-pill px-4 @(ViewBag.CurrentCategory != null && ViewBag.CurrentCategory.CategoryId == cat.CategoryId ? "btn-primary" : "btn-light")">@cat.Name</a>
                }
            </div>
        </div>
    </div>
}

<div class="row g-4 pt-3">
    @if (Model != null && Model.Count > 0)
    {
        foreach (var gallery in Model)
        {
            <div class="col-md-6 col-lg-4">
                <a href="/album/@(gallery.Slug).html" class="text-decoration-none">
                    <div class="card gallery-card h-100">
                        <div class="gallery-img-wrap">
                            <img src="@(string.IsNullOrEmpty(gallery.CoverImage) ? "/assets/images/placeholder.png" : gallery.CoverImage)" class="lazy" alt="@gallery.AlbumName">
                            <span class="album-count"><i class="mdi mdi-image-multiple-outline me-1"></i>Album</span>
                            <div class="gallery-overlay">
                                <h5 class="mb-1 text-white">@gallery.AlbumName</h5>
                                <span class="small text-white-50"><i class="mdi mdi-calendar ms-1"></i> @gallery.CreatedAt.ToString("dd/MM/yyyy")</span>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5">
            <h4 class="text-muted">Không tìm thấy album nào.</h4>
        </div>
    }
</div>

@if (totalPages > 1)
{
    <div class="vd-pagination mt-4 mb-5">
        @if (currentPage > 1)
        {
            <a class="vd-page-btn" href="?page=@(currentPage - 1)"><i class="fa-solid fa-chevron-left" style="font-size:11px;"></i></a>
        }
        @for (int i = 1; i <= totalPages; i++)
        {
            <a class="vd-page-btn @(i == currentPage ? "active" : "")" href="?page=@i">@i</a>
        }
        @if (currentPage < totalPages)
        {
            <a class="vd-page-btn" href="?page=@(currentPage + 1)"><i class="fa-solid fa-chevron-right" style="font-size:11px;"></i></a>
        }
    </div>
}
