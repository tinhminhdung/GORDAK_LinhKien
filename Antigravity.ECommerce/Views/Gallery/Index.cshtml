@model List<Antigravity.ECommerce.Models.Gallery>
@using Antigravity.ECommerce.Services
@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    ViewData["Title"] = ViewBag.CurrentCategory != null ? ViewBag.CurrentCategory.Name : "Thư viện Ảnh";
    var categories = ViewBag.Categories as List<Antigravity.ECommerce.Models.Category> ?? new List<Antigravity.ECommerce.Models.Category>();
    var currentCat = ViewBag.CurrentCategory as Antigravity.ECommerce.Models.Category;
    int currentPage = ViewBag.CurrentPage;
    int totalPages = (int)Math.Ceiling((double)ViewBag.TotalCount / ViewBag.PageSize);
    
    var settings = SSetting.GetViewModel();

    // Lấy danh sách hot galleries trực tiếp trong View
    var hotGalleries = SGallery.GetAll().Where(x => x.Status == 1).OrderByDescending(x => x.CreatedAt).Take(5).ToList();
    var totalGalleryCount = SGallery.GetAll().Count(x => x.Status == 1);
}

@section Styles {
    <style>
        .gallery-card {
            border: none;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
            transition: all 0.3s ease;
        }
        .gallery-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        }
        .gallery-img-wrap {
            position: relative;
            height: 220px;
            overflow: hidden;
        }
        .gallery-img-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }
        .gallery-card:hover .gallery-img-wrap img {
            transform: scale(1.08);
        }
        .gallery-overlay {
            position: absolute;
            bottom: 0; left: 0; right: 0;
            background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
            padding: 20px 15px;
            color: #fff;
        }
        .album-count {
            position: absolute;
            top: 10px; right: 10px;
            background: rgba(0,0,0,0.6);
            color: #fff;
            padding: 4px 10px;
            border-radius: 20px;
            backdrop-filter: blur(4px);
            font-size: 13px;
        }
    </style>
}

<div class="container mt-3 mb-4">
    <nav class="sp-breadcrumb">
        <a href="/">Trang chủ</a> 
        <i class="fa-solid fa-chevron-right"></i> 
        @if(currentCat == null) {
            <span>Thư viện ảnh</span>
        } else {
            <a href="/thu-vien-anh.html">Thư viện ảnh</a> <i class="fa-solid fa-chevron-right"></i> <span>@currentCat.Name</span>
        }
    </nav>
</div>

<main class="container mb-5">
    <h1 class="lh-page-title mb-3 text-uppercase">@(currentCat?.Name ?? "THƯ VIỆN ẢNH")</h1>

    <!-- Filter tabs -->
    @if(categories.Any()) {
    <div class="tt-filter-tabs mb-4">
        <a href="/thu-vien-anh.html" class="tt-filter-btn @(currentCat == null ? "active" : "")">Tất cả</a>
        @foreach(var cat in categories) {
            <a href="/thu-vien-anh/@(cat.Slug).html" class="tt-filter-btn @(currentCat?.CategoryId == cat.CategoryId ? "active" : "")">@cat.Name</a>
        }
    </div>
    }

    <div class="row g-4">
        <!-- NỘI DUNG CHÍNH -->
        <div class="col-lg-9">
            
            <div class="row g-4">
                @if (Model != null && Model.Count > 0)
                {
                    foreach (var gallery in Model)
                    {
                        <div class="col-md-6 col-lg-4">
                            <a href="/album/@(gallery.Slug).html" class="text-decoration-none">
                                <div class="card gallery-card h-100">
                                    <div class="gallery-img-wrap">
                                        <img src="@(string.IsNullOrEmpty(gallery.CoverImage) ? "/assets/images/placeholder.png" : gallery.CoverImage)" alt="@gallery.AlbumName">
                                        <span class="album-count"><i class="mdi mdi-image-multiple-outline me-1"></i>Album</span>
                                        <div class="gallery-overlay">
                                            <h5 class="mb-1 text-white">@gallery.AlbumName</h5>
                                            <span class="small text-white-50"><i class="mdi mdi-calendar ms-1"></i> @gallery.CreatedAt.ToString("dd/MM/yyyy")</span>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center py-5">
                        <i class="fa-regular fa-images fa-3x text-muted mb-3"></i>
                        <h4 class="text-muted">Không tìm thấy album nào.</h4>
                    </div>
                }
            </div>

            <div class="vd-pagination mt-4 mb-5">
                @if (currentPage > 1)
                {
                    <a class="vd-page-btn" href="?page=@(currentPage - 1)"><i class="fa-solid fa-chevron-left" style="font-size:11px;"></i></a>
                }
                else
                {
                    <a class="vd-page-btn disabled" href="javascript:void(0);"><i class="fa-solid fa-chevron-left" style="font-size:11px;"></i></a>
                }
                @for (int i = 1; i <= Math.Max(1, totalPages); i++)
                {
                    <a class="vd-page-btn @(i == currentPage ? "active" : "")" href="?page=@i">@i</a>
                }
                @if (currentPage < totalPages)
                {
                    <a class="vd-page-btn" href="?page=@(currentPage + 1)"><i class="fa-solid fa-chevron-right" style="font-size:11px;"></i></a>
                }
                else
                {
                    <a class="vd-page-btn disabled" href="javascript:void(0);"><i class="fa-solid fa-chevron-right" style="font-size:11px;"></i></a>
                }
            </div>

        </div>

        <!-- SIDEBAR -->
        <div class="col-lg-3">
            <!-- Danh mục -->
            <div class="tt-sidebar-box mb-3">
                <h4 class="tt-sidebar-title">DANH MỤC ẢNH</h4>
                <ul class="tt-sidebar-list">
                    <li><a href="/thu-vien-anh.html">Tất cả <span>@totalGalleryCount</span></a></li>
                    @foreach(var cat in categories.Take(10)) {
                        <li><a href="/thu-vien-anh/@(cat.Slug).html">@cat.Name <span>@cat.ItemCount</span></a></li>
                    }
                </ul>
                @if(categories.Count > 10) {
                    <a href="javascript:void(0)" onclick="$('.tt-sidebar-list li.d-none').removeClass('d-none'); $(this).hide();" class="tt-sidebar-link">Xem tất cả danh mục <i class="fa-solid fa-arrow-right"></i></a>
                    <ul class="tt-sidebar-list">
                         @foreach(var cat in categories.Skip(10)) {
                            <li class="d-none"><a href="/thu-vien-anh/@(cat.Slug).html">@cat.Name <span>@cat.ItemCount</span></a></li>
                        }
                    </ul>
                }
            </div>

            <!-- Album mới nhất -->
            @if(hotGalleries.Any()) {
            <div class="tt-sidebar-box mb-3">
                <h4 class="tt-sidebar-title">ALBUM MỚI NHẤT</h4>
                @foreach(var hg in hotGalleries) {
                    <div class="tt-hot-item">
                        <a href="/album/@(hg.Slug).html">
                            <img src="@(string.IsNullOrEmpty(hg.CoverImage) ? "/assets/images/placeholder.png" : hg.CoverImage)" alt="@hg.AlbumName">
                        </a>
                        <div>
                            <a href="/album/@(hg.Slug).html" class="tt-hot-title line-clamp-2">@hg.AlbumName</a>
                            <div class="tt-hot-meta">
                                <i class="fa-regular fa-calendar"></i> @hg.CreatedAt.ToString("dd/MM/yyyy")
                            </div>
                        </div>
                    </div>
                }
            </div>
            }

            <!-- CTA Box -->
            <partial name="_SidebarCTA" />
        </div>
    </div>
</main>
