@model IEnumerable<Antigravity.ECommerce.Models.Product>
@{
    ViewData["Title"] = "Quản lý Sản phẩm";
    Layout = "_AdminLayout";

    int pageIndex = ViewBag.PageIndex ?? 1;
    int pageSize = ViewBag.PageSize ?? 20;
    int totalCount = ViewBag.TotalCount ?? 0;
    int totalPages = (int)Math.Ceiling((double)totalCount / pageSize);

    string sortColumn = ViewBag.SortColumn;
    string sortOrder = ViewBag.SortOrder;
}

<style>
    .badge-category {
        max-width: 220px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: block;
        padding: 5px 8px;
        background: rgba(41, 156, 219, 0.1);
        color: #299cdb;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 500;
        cursor: help;
    }
    .sort-icon {
        font-size: 14px;
        margin-left: 5px;
        vertical-align: middle;
        color: #adb5bd;
    }
    .sort-icon.active {
        color: #405189;
    }
    /* Hide default bootstrap/theme sort icons */
    th.sort::after, th.sort::before {
        display: none !important;
    }
</style>

<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0">Sản phẩm</h4>
            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="/Admin">Admin</a></li>
                    <li class="breadcrumb-item active">Sản phẩm</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header border-0">
                <div class="d-flex align-items-center">
                    <h5 class="card-title mb-0 flex-grow-1">Danh sách Sản phẩm (@totalCount)</h5>
                    <div class="flex-shrink-0 d-flex gap-2">
                        <div class="dropdown" id="bulkOptions" style="display:none;">
                            <button class="btn btn-soft-success" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="ri-settings-3-line align-bottom me-1"></i> Thao tác nhanh (<span id="selectedCount">0</span>)
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="javascript:void(0);" onclick="bulkUpdateStatus(1, null)">Hiện sản phẩm</a></li>
                                <li><a class="dropdown-item" href="javascript:void(0);" onclick="bulkUpdateStatus(0, null)">Ẩn sản phẩm</a></li>
                                <li class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="javascript:void(0);" onclick="bulkUpdateStatus(null, true)">Bật Bán chạy</a></li>
                                <li><a class="dropdown-item" href="javascript:void(0);" onclick="bulkUpdateStatus(null, false)">Tắt Bán chạy</a></li>
                                <li class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" href="javascript:void(0);" onclick="bulkDelete()"><i class="ri-delete-bin-line me-1"></i> Xóa vĩnh viễn</a></li>
                            </ul>
                        </div>
                        <a href="javascript:void(0);" onclick="exportToCSV()" class="btn btn-soft-success"><i class="ri-add-line align-bottom me-1"></i> Xuất CSV</a>
                        <a href="/AdminProduct/Create" class="btn btn-soft-success"><i class="ri-add-line align-bottom me-1"></i> Thêm mới</a>
                    </div>
                </div>
            </div>
            <div class="card-body border border-dashed border-end-0 border-start-0">
                <form id="filterForm" method="get">
 <input type="hidden" name="sort" value="@sortColumn" />
 <input type="hidden" name="order" value="@sortOrder" />
 <input type="hidden" name="page" value="@pageIndex" />
 <div class="row g-3 align-items-center">
 <div class="col-xxl-3 col-lg-4 col-sm-6">
 <div class="search-box">
 <input type="text" name="kw" class="form-control" value="@ViewBag.Keyword" placeholder="Tìm kiếm tên, SKU...">
 <i class="ri-search-line search-icon"></i>
 </div>
 </div>
 <div class="col-xxl-2 col-lg-4 col-sm-6">
 @{
 var selectedCats = ViewBag.CategoryIds != null ? ((string)ViewBag.CategoryIds).Split(',') : new string[0];
 }
 <select class="form-control selectpicker" data-live-search="true" name="categories" multiple data-selected-text-format="count> 2" title="--- Danh mục ---" data-actions-box="true">
 @if (ViewBag.Categories != null)
 {
 foreach (var item in ViewBag.Categories as List<Antigravity.ECommerce.Models.Category>)
 {
 <option value="@item.CategoryId" selected="@(selectedCats.Contains(item.CategoryId.ToString()) ?"selected" : null)">@item.Name</option>
 }
 }
 </select>
 </div>
 <div class="col-xxl-2 col-lg-4 col-sm-6">
 <select class="form-control selectpicker" data-live-search="true" name="status">
 <option value="">--- Trạng thái ---</option>
 <option value="1" selected="@(ViewBag.Status == 1 ?"selected" : null)">Đang bán</option>
 <option value="0" selected="@(ViewBag.Status == 0 ?"selected" : null)">Đang ẩn</option>
 </select>
 </div>
 <div class="col-xxl-2 col-lg-6 col-sm-6">
 <div class="input-group">
 <input type="number" name="priceMin" class="form-control" value="@ViewBag.PriceMin" placeholder="Giá từ">
 <span class="input-group-text">-</span>
 <input type="number" name="priceMax" class="form-control" value="@ViewBag.PriceMax" placeholder="Giá đến">
 </div>
 </div>
 <div class="col-xxl-3 col-lg-6 col-sm-12">
 <div class="input-group">
 <span class="input-group-text">Ngày tạo</span>
 <input type="date" name="dateMin" class="form-control" value="@ViewBag.DateMin">
 <input type="date" name="dateMax" class="form-control" value="@ViewBag.DateMax">
 </div>
 </div>
 <div class="col-12 mt-3">
 <div class="d-flex justify-content-end gap-2">
 <button type="submit" class="btn btn-soft-success"><i class="ri-equalizer-fill me-1 align-bottom"></i> Lọc dữ liệu</button>
 <a href="/AdminProduct" class="btn btn-light"><i class="ri-refresh-line me-1 align-bottom"></i> Làm mới</a>
 </div>
 </div>
 </div>
 </form>
            </div>
            <div class="card-body">
                <div class="table-responsive table-card">
                    <table class="table table-nowrap align-middle">
                        <thead class="table-light text-muted">
                            <tr>
                                <th style="width: 40px;">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="checkAll">
                                    </div>
                                </th>
                                <th onclick="changeSort('Name')" class="sort cursor-pointer">Sản phẩm <i class="ri-arrow-up-down-line sort-icon @(sortColumn == "Name" ? "active" : "")"></i></th>
                                <th>Danh mục</th>
                                <th onclick="changeSort('Price')" class="sort cursor-pointer text-center">Giá <i class="ri-arrow-up-down-line sort-icon @(sortColumn == "Price" ? "active" : "")"></i></th>
                                <th onclick="changeSort('Stock')" class="sort cursor-pointer text-center">Kho <i class="ri-arrow-up-down-line sort-icon @(sortColumn == "Stock" ? "active" : "")"></i></th>
                                <th onclick="changeSort('Views')" class="sort cursor-pointer text-center">Xem <i class="ri-arrow-up-down-line sort-icon @(sortColumn == "Views" ? "active" : "")"></i></th>
                                <th onclick="changeSort('CreatedAt')" class="sort cursor-pointer text-center">Ngày tạo <i class="ri-arrow-up-down-line sort-icon @(sortColumn == "CreatedAt" ? "active" : "")"></i></th>
                                <th class="text-center">Bán chạy (HOT)</th>
                                <th class="text-center">Trạng thái</th>
                                <th class="text-center">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null)
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="form-check">
                                                <input class="form-check-input checkItem" type="checkbox" value="@item.ProductId">
                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="flex-shrink-0 me-3">
                                                    <img src="@(string.IsNullOrEmpty(item.MainImage) ? "/assets/images/no-image.png" : item.MainImage)" class="avatar-sm rounded p-1 bg-light border" alt="">
                                                </div>
                                                <div class="flex-grow-1">
                                                    <h6 class="fs-14 mb-1"><a href="/AdminProduct/Edit/@item.ProductId" class="text-body fw-bold">@item.Name</a></h6>
                                                    <div class="d-flex gap-2 align-items-center mt-1">
                                                        <span class="text-muted fs-12">SKU: @item.SKU</span>
                                                        @if (!string.IsNullOrEmpty(item.Slug)) {
                                                            <a href="/san-pham/detail/@(item.Slug)-@(item.ProductId).html" target="_blank" class="text-muted fs-12 text-decoration-none d-inline-block text-truncate" style="max-width: 200px; vertical-align: bottom;" title="/san-pham/detail/@(item.Slug)-@(item.ProductId).html"><i class="ri-link me-1"></i>/san-pham/detail/@(item.Slug)-@(item.ProductId).html</a>
                                                        }
                                                        @if (!string.IsNullOrEmpty(item.YoutubeVideo))
                                                        {
                                                            <span class="badge badge-soft-danger fs-10"><i class="ri-youtube-fill align-bottom"></i> Clip</span>
                                                        }
                                                        @if (item.IsNew)
                                                        {
                                                            <span class="badge badge-soft-info fs-10">Mới</span>
                                                        }
                                                        @if (item.IsBestSeller)
                                                        {
                                                            <span class="badge badge-soft-warning fs-10">Bán chạy</span>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                        <td style="width: 240px;">
                                            <div class="badge-category" title="@item.CategoryNames">
                                                <i class="ri-price-tag-3-line me-1"></i> @item.CategoryNames
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            <div class="d-flex flex-column align-items-center">
                                                <span class="text-success fw-bold" title="Giá bán (VAT 8%)">@item.Price.ToString("N0")</span>
                                                @if (item.OldPrice > 0)
                                                {
                                                    <span class="text-muted fs-11" title="Giá (Chưa VAT)">@item.OldPrice.ToString("N0")</span>
                                                }
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge @(item.Stock <= 5 ? "bg-danger" : "bg-light text-dark")">@item.Stock</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="text-muted"><i class="ri-eye-line align-middle"></i> @item.Views</span>
                                        </td>
                                        <td class="text-center fs-12 text-muted">@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                                        <td class="text-center">
                                            <div class="form-check form-switch fs-18 d-inline-block">
                                                <input class="form-check-input cursor-pointer" type="checkbox" @(item.IsHot ? "checked" : "") 
                                                       onchange="updateQuick(@item.ProductId, null, this.checked)">
                                            </div>
                                        </td>
                                        <td class="text-center">
                                             <div class="form-check form-switch form-switch-success d-inline-block">
                                                <input class="form-check-input cursor-pointer" type="checkbox" @(item.Status == 1 ? "checked" : "") 
                                                       onchange="updateQuick(@item.ProductId, this.checked ? 1 : 0, null)">
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            <div class="d-flex justify-content-center gap-1">
                                                <a href="/san-pham/detail/@(item.Slug)-@(item.ProductId).html" target="_blank" class="btn btn-sm btn-soft-secondary" title="Xem trên web">
                                                    <i class="ri-eye-line"></i>
                                                </a>
                                                <a href="javascript:void(0);" onclick="duplicateItem(@item.ProductId)" class="btn btn-sm btn-soft-success" title="Nhân bản">
                                                    <i class="ri-file-copy-line"></i>
                                                </a>
                                                <a href="/AdminProduct/Edit/@item.ProductId" class="btn btn-sm btn-soft-info" title="Chỉnh sửa">
                                                    <i class="ri-pencil-line"></i>
                                                </a>
                                                <button onclick="deleteItem(@item.ProductId)" class="btn btn-sm btn-soft-danger" title="Xóa">
                                                    <i class="ri-delete-bin-line"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                @await Html.PartialAsync("_Pagination", new { PageIndex = pageIndex, TotalPages = totalPages, TotalCount = totalCount, DisplayCount = Model?.Count() ?? 0, JsFunction = "changePage" })
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#checkAll').change(function() {
                $('.checkItem').prop('checked', $(this).prop('checked'));
                toggleBulkDeleteBtn();
            });
            $(document).on('change', '.checkItem', function() {
                toggleBulkDeleteBtn();
            });
        });

        function toggleBulkDeleteBtn() {
            const count = $('.checkItem:checked').length;
            if (count > 0) {
                $('#selectedCount').text(count);
                $('#bulkOptions').fadeIn();
            } else {
                $('#bulkOptions').fadeOut();
            }
        }

        async function bulkUpdateStatus(status, hot) {
            let ids = [];
            $('.checkItem:checked').each(function() {
                ids.push(parseInt($(this).val()));
            });

            if (confirm(`Bạn có chắc chắn muốn cập nhật ${ids.length} sản phẩm đã chọn?`)) {
                try {
                    const response = await fetch('/AdminProduct/BulkUpdateStatus', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ ids: ids, status: status, isHot: hot })
                    });
                    const result = await response.json();
                    if (result.success) {
                        location.reload();
                    } else {
                        alert(result.message || 'Lỗi khi cập nhật!');
                    }
                } catch (e) {
                    alert('Lỗi hệ thống!');
                }
            }
        }

        async function bulkDelete() {
            let ids = [];
            $('.checkItem:checked').each(function() {
                ids.push(parseInt($(this).val()));
            });

            if (confirm(`Bạn có chắc chắn muốn xóa ${ids.length} sản phẩm đã chọn?`)) {
                try {
                    const response = await fetch('/AdminProduct/BulkDelete', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(ids)
                    });
                    const result = await response.json();
                    if (result.success) {
                        location.reload();
                    } else {
                        alert(result.message || 'Lỗi khi xóa!');
                    }
                } catch (e) {
                    alert('Lỗi hệ thống!');
                }
            }
        }

        function updateQuick(id, status, hot) {
            $.ajax({
                url: '/AdminProduct/UpdateQuick',
                type: 'POST',
                data: { id: id, status: status, hot: hot },
                success: function(res) {
                    if (res.success) {
                        Toastify({
                            text: "Cập nhật thành công!",
                            duration: 2000,
                            gravity: "top",
                            position: "right",
                            backgroundColor: "#0ab39c",
                        }).showToast();
                        
                        if(status !== null) {
                             setTimeout(() => location.reload(), 500); 
                        }
                    } else {
                        alert(res.message);
                    }
                }
            });
        }

        function changePage(p) {
            const form = document.getElementById('filterForm');
            form.page.value = p;
            form.submit();
        }
        function changeSort(col) {
            const form = document.getElementById('filterForm');
            if (form.sort.value === col) {
                form.order.value = form.order.value === 'ASC' ? 'DESC' : 'ASC';
            } else {
                form.sort.value = col;
                form.order.value = 'ASC';
            }
            form.submit();
        }
        function deleteItem(id) {
            if (confirm('Bạn có chắc chắn muốn xóa sản phẩm này?')) {
                $.ajax({
                    url: '/AdminProduct/Delete/' + id,
                    type: 'POST',
                    success: function (res) {
                        if (res.success) {
                             Toastify({ text: "Đã xóa thành công!", backgroundColor: "#0ab39c" }).showToast();
                             setTimeout(() => location.reload(), 500);
                        } else {
                            if (res.type === "RESTRICED") {
                                if (confirm(res.message + "\n\nBẠN CÓ MUỐN XÓA VĨNH VIỄN KHÔNG? \n(Cảnh báo: Đơn hàng cũ sẽ không thể xem lại chi tiết tên/ảnh sản phẩm đầy đủ)")) {
                                    forceDelete(id);
                                }
                            } else {
                                alert(res.message);
                            }
                        }
                    }
                });
            }
        }

        function forceDelete(id) {
            $.ajax({
                url: '/AdminProduct/ForceDelete/' + id,
                type: 'POST',
                success: function (res) {
                    if (res.success) {
                        Toastify({ text: "Đã xóa vĩnh viễn!", backgroundColor: "#0ab39c" }).showToast();
                        setTimeout(() => location.reload(), 500);
                    } else {
                        alert(res.message);
                    }
                }
            });
        }

        function duplicateItem(id) {
            if (confirm('Bạn có muốn nhân bản sản phẩm này không?')) {
                $.ajax({
                    url: '/AdminProduct/Duplicate/' + id,
                    type: 'POST',
                    success: function (res) {
                        if (res.success) {
                            Toastify({
                                text: "Đã nhân bản! Đang chuyển hướng...",
                                duration: 2000,
                                backgroundColor: "#0ab39c",
                            }).showToast();
                            setTimeout(() => {
                                window.location.href = '/AdminProduct/Edit/' + res.newId;
                            }, 1000);
                        } else {
                            alert(res.message);
                        }
                    }
                });
            }
        }

        function exportToCSV() {
            const form = document.getElementById('filterForm');
            const params = new URLSearchParams(new FormData(form)).toString();
            window.location.href = '/AdminProduct/ExportCSV?' + params;
        }
    </script>
}
