@model Antigravity.ECommerce.Models.Category
@{
    Layout = "_MainLayout";
}

@if (!string.IsNullOrEmpty(Model.Banner))
{
    <section class="py-5 text-white position-relative" style="background: url('@Model.Banner') center/cover; min-height: 250px;">
        <div class="position-absolute top-0 start-0 w-100 h-100 bg-dark opacity-50"></div>
        <div class="container position-relative py-4">
            <h1 class="display-4 fw-bold">@Model.Name</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="/" class="text-white-50 text-decoration-none">Trang chủ</a></li>
                    <li class="breadcrumb-item active text-white" aria-current="page">@Model.Name</li>
                </ol>
            </nav>
        </div>
    </section>
}
else
{
    <section class="bg-primary py-4 text-white">
        <div class="container">
            <h1 class="fw-bold mb-1">@Model.Name</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="/" class="text-white-50 text-decoration-none">Trang chủ</a></li>
                    <li class="breadcrumb-item active text-white" aria-current="page">@Model.Name</li>
                </ol>
            </nav>
        </div>
    </section>
}

<section class="py-5 bg-white">
    <div class="container py-3">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <article class="cms-content fs-5" style="line-height: 1.8; color: #333;">
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div class="lead fw-bold mb-4 p-3 bg-light border-start border-4 border-primary">
                            @Model.Description
                        </div>
                    }

                    <div class="mt-4">
                        @Html.Raw(Model.Content)
                    </div>
                </article>
            </div>
        </div>
    </div>
</section>

@section Styles {
    <style>
        .cms-content img { max-width: 100%; height: auto; border-radius: 8px; margin: 15px 0; }
        .cms-content h2, .cms-content h3 { margin-top: 30px; font-weight: bold; }
    </style>
}
