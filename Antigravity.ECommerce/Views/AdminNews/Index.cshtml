@model List<Antigravity.ECommerce.Models.News>
@{
    ViewBag.Title = "Quản lý Tin tức & Bài viết";
    Layout = "_AdminLayout";
    int pageIndex = ViewBag.PageIndex ?? 1;
    int pageSize = ViewBag.PageSize ?? 20;
    int totalCount = ViewBag.TotalCount ?? 0;
    int totalPages = (int)Math.Ceiling((double)totalCount / pageSize);
}

<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0">Quản lý Tin tức (@totalCount)</h4>
            <div class="page-title-right d-flex gap-2">
                <div class="dropdown" id="bulkOptions" style="display:none;">
                    <button class="btn btn-soft-info dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="ri-settings-3-line align-bottom me-1"></i> Thao tác nhanh (<span id="selectedCount">0</span>)
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="javascript:void(0);" onclick="bulkUpdateStatus(1)">Hiện bài viết</a></li>
                        <li><a class="dropdown-item" href="javascript:void(0);" onclick="bulkUpdateStatus(0)">Ẩn bài viết</a></li>
                        <li class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" href="javascript:void(0);" onclick="bulkDelete()"><i class="ri-delete-bin-line me-1"></i> Xóa vĩnh viễn</a></li>
                    </ul>
                </div>
                <a href="/AdminNews/Create" class="btn btn-primary">
                    <i class="ri-add-line align-middle me-1"></i> Viết bài mới
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-header border-0 bg-transparent py-3">
                <form method="get" action="/AdminNews/Index" id="newsFilterForm">
 <input type="hidden" name="page" id="pageIndex" value="@pageIndex" />
 <input type="hidden" name="sort" value="@ViewBag.SortColumn" />
 <input type="hidden" name="order" value="@ViewBag.SortOrder" />
 <div class="row g-3">
 <div class="col-xxl-4 col-sm-6">
 <div class="search-box">
 <input type="text" name="kw" value="@ViewBag.Keyword" class="form-control border-light" placeholder="Tìm tiêu đề bài viết...">
 <i class="ri-search-line search-icon"></i>
 </div>
 </div>
 <div class="col-xxl-3 col-sm-4">
 <select class="form-control selectpicker" data-live-search="true" name="catId" data-live-search="true">
 <option value="">-- Tất cả danh mục --</option>
 @foreach (var cat in ViewBag.Categories)
 {
 <option value="@cat.CategoryId" selected="@(ViewBag.CategoryId == cat.CategoryId)">@cat.Name</option>
 }
 </select>
 </div>
 <div class="col-xxl-2 col-sm-4">
 <select class="form-control selectpicker" data-live-search="true" name="status">
 <option value="">-- Trạng thái --</option>
 <option value="1" selected="@(ViewBag.Status == 1)">Đã đăng</option>
 <option value="0" selected="@(ViewBag.Status == 0)">Bản nháp</option>
 </select>
 </div>
 <div class="col-xxl-3 col-sm-4 d-flex gap-2">
 <button type="submit" class="btn btn-primary flex-grow-1">
 <i class="ri-equalizer-fill me-1 align-bottom"></i> Lọc
 </button>
 <a href="/AdminNews" class="btn btn-light px-3">
 <i class="ri-refresh-line align-bottom"></i>
 </a>
 </div>
 </div>
 </form>
            </div>
            
            <div class="card-body pt-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-muted">
                            <tr>
                                <th style="width: 40px;">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="selectAll">
                                    </div>
                                </th>
                                <th style="width: 80px;">Ảnh</th>
                                <th onclick="changeSort('Title')" class="sort cursor-pointer">Nội dung bài viết <i class="ri-arrow-up-down-line sort-icon @(ViewBag.SortColumn == "Title" ? "active" : "")"></i></th>
                                <th>Danh mục</th>
                                <th onclick="changeSort('Views')" class="sort cursor-pointer text-center">Tương tác <i class="ri-arrow-up-down-line sort-icon @(ViewBag.SortColumn == "Views" ? "active" : "")"></i></th>
                                <th class="text-center">Nổi bật (HOT)</th>
                                <th onclick="changeSort('Status')" class="sort cursor-pointer text-center">Trạng thái <i class="ri-arrow-up-down-line sort-icon @(ViewBag.SortColumn == "Status" ? "active" : "")"></i></th>
                                <th class="text-center" style="width: 140px;">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Count > 0)
                            {
                                foreach (var item in Model)
                                {
                                    <tr id="row-@item.NewsId">
                                        <td>
                                            <div class="form-check">
                                                <input class="form-check-input select-item" type="checkbox" value="@item.NewsId" onchange="toggleBulkDeleteBtn()">
                                            </div>
                                        </td>
                                        <td>
                                            <div class="flex-shrink-0">
                                                <img src="@(string.IsNullOrEmpty(item.Image) ? "/assets/images/no-image.png" : item.Image)" alt="" class="rounded shadow-sm" style="width: 70px; height: 45px; object-fit: cover;">
                                            </div>
                                        </td>
                                        <td>
                                            <div>
                                                <h6 class="fs-14 mb-1"><a href="/AdminNews/Edit/@item.NewsId" class="text-dark fw-bold">@item.Title</a></h6>
                                                <div class="d-flex gap-3 small text-muted">
                                                    <span><i class="ri-calendar-line me-1 text-primary"></i>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                                    <span><i class="ri-user-3-line me-1 text-success"></i>@item.CreatedBy</span>
                                                    @if (!string.IsNullOrEmpty(item.Slug)) {
                                                        <a href="/tin-tuc/detail/@(item.Slug).html" target="_blank" class="text-muted text-decoration-none d-inline-block text-truncate" style="max-width: 200px; vertical-align: bottom;" title="Xem trên web"><i class="ri-link me-1"></i>/tin-tuc/detail/@(item.Slug).html</a>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td><span class="badge badge-soft-info fs-11">@item.CategoryName</span></td>
                                        <td class="text-center">
                                            <div class="d-flex justify-content-center gap-3 text-muted small">
                                                <span title="Lượt xem"><i class="ri-eye-line me-1 text-primary"></i>@item.Views</span>
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            <div class="form-check form-switch form-switch-md form-switch-danger" dir="ltr" style="display: inline-block;">
                                                <input type="checkbox" class="form-check-input" onchange="updateQuick(@item.NewsId, 'IsHot', this.checked)" @(item.IsHot ? "checked" : "") title="Hiển thị ở khối TIN NỔI BẬT trang chủ/tin tức">
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            @if (item.Status == 1)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">Đã đăng</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Bản nháp</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <div class="d-flex justify-content-center gap-1">
                                                <a href="/News/Detail/@item.Slug" target="_blank" class="btn btn-sm btn-soft-secondary" title="Xem trên web">
                                                    <i class="ri-eye-line"></i>
                                                </a>
                                                <a href="/AdminNews/Edit/@item.NewsId" class="btn btn-sm btn-soft-info" title="Sửa bài viết">
                                                    <i class="ri-pencil-line"></i>
                                                </a>
                                                <button onclick="deleteNews(@item.NewsId)" class="btn btn-sm btn-soft-danger" title="Xóa">
                                                    <i class="ri-delete-bin-line"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5">
                                        <div class="avatar-lg mx-auto mb-3">
                                            <div class="avatar-title bg-soft-info text-info fs-36 rounded-circle">
                                                <i class="ri-article-line"></i>
                                            </div>
                                        </div>
                                        <h5 class="text-muted">Chưa tìm thấy bài viết nào</h5>
                                        <p class="text-muted small">Thử thay đổi bộ lọc hoặc tạo bài viết đầu tiên của bạn.</p>
                                        <a href="/AdminNews/Create" class="btn btn-primary btn-sm mt-2">Tạo bài viết mới</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @await Html.PartialAsync("_Pagination", new { PageIndex = pageIndex, TotalPages = totalPages, TotalCount = totalCount, DisplayCount = Model?.Count ?? 0 })
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            // Select all logic
            $('#selectAll').on('change', function () {
                $('.select-item').prop('checked', $(this).prop('checked'));
                toggleBulkDeleteBtn();
            });
        });

        function changePage(page) {
            $('#pageIndex').val(page);
            $('#newsFilterForm').submit();
        }

        function changeSort(col) {
            const form = document.getElementById('newsFilterForm');
            if (form.sort.value === col) {
                form.order.value = form.order.value === 'ASC' ? 'DESC' : 'ASC';
            } else {
                form.sort.value = col;
                form.order.value = 'ASC';
            }
            form.submit();
        }

        function deleteNews(id) {
            Swal.fire({
                title: 'Xác nhận xóa?',
                text: "Bài viết này sẽ bị xóa vĩnh viễn khỏi hệ thống!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Đồng ý xóa',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/AdminNews/Delete/' + id, function (res) {
                        if (res.success) {
                            Swal.fire('Thành công', 'Đã xóa bài viết!', 'success').then(() => {
                                location.reload();
                            });
                        } else {
                            Swal.fire('Lỗi', res.message, 'error');
                        }
                    });
                }
            })
        }

        function toggleBulkDeleteBtn() {
            const count = $('.select-item:checked').length;
            if (count > 0) {
                $('#selectedCount').text(count);
                $('#bulkOptions').fadeIn();
            } else {
                $('#bulkOptions').fadeOut();
            }
        }

        function bulkDelete() {
            const ids = [];
            $('.select-item:checked').each(function () {
                ids.push(parseInt($(this).val()));
            });

            if (ids.length === 0) return;

            Swal.fire({
                title: 'Xóa nhiều bài viết?',
                text: `Bạn có chắc chắn muốn xóa ${ids.length} bài viết đã chọn không?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Xác nhận xóa',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/AdminNews/BulkDelete',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(ids),
                        success: function (res) {
                            if (res.success) {
                                Swal.fire('Thành công', `Đã xóa bài viết!`, 'success').then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Lỗi', res.message, 'error');
                            }
                        }
                    });
                }
            });
        }

        function bulkUpdateStatus(status) {
            const ids = [];
            $('.select-item:checked').each(function () {
                ids.push(parseInt($(this).val()));
            });

            if (ids.length === 0) return;

            $.ajax({
                url: '/AdminNews/BulkUpdateStatus',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ ids: ids, status: status }),
                success: function (res) {
                    if (res.success) {
                        location.reload();
                    } else {
                        Swal.fire('Lỗi', 'Cập nhật trạng thái thất bại', 'error');
                    }
                }
            });
        }

        function updateQuick(id, field, value) {
            $.post('/AdminNews/UpdateQuick', { id: id, field: field, value: value }, function(res) {
                if(!res.success) {
                    Swal.fire('Lỗi', res.message, 'error');
                } else {
                    Toastify({
                        text: "Đã cập nhật thay đổi!",
                        duration: 3000,
                        gravity: "bottom",
                        position: "right",
                        backgroundColor: "linear-gradient(to right, #00b09b, #96c93d)",
                    }).showToast();
                }
            });
        }
    </script>
}

<style>
    .card { transition: all 0.3s ease; }
    .table thead th { font-weight: 700; text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px; }
    .badge { font-weight: 600; padding: 0.5em 0.8em; }
    .search-box .search-icon { left: 13px; color: #878a99; }
    .search-box .form-control { padding-left: 40px; }
    #newsFilterForm .btn-light { background: #f3f3f9; border: none; }
    #newsFilterForm .btn-light:hover { background: #e9e9f2; }
</style>
