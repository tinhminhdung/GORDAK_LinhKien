@model Antigravity.ECommerce.Models.GlobalSettingsViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Cấu hình hệ thống";
}

<div class="container-fluid p-0">
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <div>
                <h3 class="mb-0 text-dark fw-bold">Cấu hình hệ thống</h3>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="/AdminDashboard">Dashboard</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Configuration</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>


    <form asp-action="Save" method="post" enctype="multipart/form-data" id="formSettings">
        <div class="row">
            <div class="col-xl-2 col-lg-3">
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-0">
                        <div class="nav flex-column nav-pills" id="v-pills-tab" role="tablist" aria-orientation="vertical">
                            <button class="nav-link text-start py-3 px-4 border-bottom rounded-0" id="nav-general-tab" data-bs-toggle="pill" data-bs-target="#nav-general" type="button" role="tab"><i class="fas fa-cog me-2"></i> Thông tin chung</button>
                            <button class="nav-link text-start py-3 px-4 border-bottom rounded-0" id="nav-contact-tab" data-bs-toggle="pill" data-bs-target="#nav-contact" type="button" role="tab"><i class="fas fa-address-book me-2"></i> Liên hệ & Bản đồ</button>
                            <button class="nav-link text-start py-3 px-4 border-bottom rounded-0" id="nav-invoice-tab" data-bs-toggle="pill" data-bs-target="#nav-invoice" type="button" role="tab"><i class="fas fa-file-invoice me-2"></i> Thông tin hóa đơn</button>
                            <button class="nav-link text-start py-3 px-4 border-bottom rounded-0" id="nav-social-tab" data-bs-toggle="pill" data-bs-target="#nav-social" type="button" role="tab"><i class="fas fa-share-alt me-2"></i> Mạng xã hội</button>
                            <button class="nav-link text-start py-3 px-4 border-bottom rounded-0" id="nav-error-tab" data-bs-toggle="pill" data-bs-target="#nav-error" type="button" role="tab"><i class="fas fa-exclamation-triangle me-2"></i> Trang lỗi & Bảo trì</button>
                            <button class="nav-link text-start py-3 px-4 border-bottom rounded-0" id="nav-system-tab" data-bs-toggle="pill" data-bs-target="#nav-system" type="button" role="tab"><i class="fas fa-server me-2"></i> Tối ưu & Cache</button>
                            <button class="nav-link text-start py-3 px-4 border-bottom rounded-0" id="nav-smtp-tab" data-bs-toggle="pill" data-bs-target="#nav-smtp" type="button" role="tab"><i class="fas fa-envelope me-2"></i> Cấu hình Email (SMTP)</button>
                            <button class="nav-link text-start py-3 px-4 border-bottom rounded-0" id="nav-seo-tab" data-bs-toggle="pill" data-bs-target="#nav-seo" type="button" role="tab"><i class="fas fa-search me-2"></i> SEO & Analytics</button>
                            <button class="nav-link text-start py-3 px-4 border-bottom rounded-0" id="nav-rank-tab" data-bs-toggle="pill" data-bs-target="#nav-rank" type="button" role="tab"><i class="fas fa-crown me-2"></i> Hạng thành viên</button>
                            <button class="nav-link text-start py-3 px-4 border-bottom rounded-0" id="nav-image-tab" data-bs-toggle="pill" data-bs-target="#nav-image" type="button" role="tab"><i class="fas fa-image me-2"></i> Cài đặt Hình ảnh</button>
                            <button class="nav-link text-start py-3 px-4 border-bottom rounded-0" id="nav-news-tab" data-bs-toggle="pill" data-bs-target="#nav-news" type="button" role="tab"><i class="fas fa-newspaper me-2"></i> Cấu hình Tin tức</button>
                            <button class="nav-link text-start py-3 px-4 rounded-0" id="nav-product-tab" data-bs-toggle="pill" data-bs-target="#nav-product" type="button" role="tab"><i class="fas fa-box me-2"></i> Cấu hình Sản phẩm</button>
                        </div>
                    </div>
                </div>
                
                
            </div>

            <div class="col-xl-10 col-lg-9">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-4">
                        <div class="tab-content" id="v-pills-tabContent">
                            <!-- General Settings -->
                            <div class="tab-pane fade show active" id="nav-general" role="tabpanel">
                                <h5 class="fw-bold mb-4">Thông tin chung</h5>
                                <div class="row g-4">
                                    <div class="col-md-12">
                                        <label class="form-label fw-semibold">Tiêu đề Website</label>
                                        <input type="text" asp-for="SiteTitle" class="form-control form-control-lg rounded-3" placeholder="Nhập tiêu đề website...">
                                    </div>
                                    <div class="col-md-12">
                                        <label class="form-label fw-semibold">Mô tả Website (SEO Description)</label>
                                        <textarea asp-for="SiteDescription" class="form-control rounded-3" rows="3" placeholder="Nhập mô tả ngắn cho website..."></textarea>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Logo Website</label>
                                        <div class="input-group shadow-sm">
                                            <span class="input-group-text bg-light border-end-0"><i class="fas fa-image text-primary"></i></span>
                                            <input type="text" asp-for="Logo" id="txtLogo" class="form-control border-start-0" placeholder="/img/logo.png">
                                            <button type="button" class="btn btn-primary px-3" onclick="openFileManager('txtLogo')">
                                                <i class="fas fa-folder-open me-1"></i> Chọn ảnh
                                            </button>
                                        </div>
                                        <div class="mt-3 preview-image-container p-2 border rounded-3 bg-light d-flex align-items-center justify-content-center" style="height: 120px; border-style: dashed !important;">
                                            <img id="imgLogo" src="@(string.IsNullOrEmpty(Model.Logo) ? "/img/no-image.png" : Model.Logo)" class="img-fluid rounded-2" style="max-height: 100px; object-fit: contain;">
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Favicon (Icon tab trình duyệt)</label>
                                        <div class="input-group shadow-sm">
                                            <span class="input-group-text bg-light border-end-0"><i class="fas fa-icons text-warning"></i></span>
                                            <input type="text" asp-for="Favicon" id="txtFavicon" class="form-control border-start-0" placeholder="/favicon.ico">
                                            <button type="button" class="btn btn-primary px-3" onclick="openFileManager('txtFavicon')">
                                                <i class="fas fa-folder-open me-1"></i> Chọn ảnh
                                            </button>
                                        </div>
                                        <div class="mt-3 preview-image-container p-2 border rounded-3 bg-light d-flex align-items-center justify-content-center" style="height: 120px; border-style: dashed !important;">
                                            <img id="imgFavicon" src="@(string.IsNullOrEmpty(Model.Favicon) ? "/favicon.ico" : Model.Favicon)" class="img-fluid rounded-2" style="max-height: 48px; width: 48px; object-fit: contain;">
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <label class="form-label fw-semibold">Bản quyền (Copyright)</label>
                                        <input type="text" asp-for="Copyright" class="form-control rounded-3" placeholder="© 2026 Antigravity. All rights reserved.">
                                    </div>
                                </div>
                            </div>

                            <!-- Contact Settings -->
                            <div class="tab-pane fade" id="nav-contact" role="tabpanel">
                                <h5 class="fw-bold mb-4">Thông tin liên hệ & Bản đồ</h5>
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Hotline hỗ trợ</label>
                                        <input type="text" asp-for="Hotline" class="form-control rounded-3" placeholder="1900 1234">
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Email liên hệ</label>
                                        <input type="email" asp-for="Email" class="form-control rounded-3" placeholder="info@domain.com">
                                    </div>
                                    <div class="col-md-12">
                                        <label class="form-label fw-semibold">Địa chỉ trụ sở</label>
                                        <input type="text" asp-for="Address" class="form-control rounded-3" placeholder="Số 123 Nguyễn Huệ, Quận 1...">
                                    </div>
                                    <div class="col-md-12">
                                        <label class="form-label fw-semibold">Nhúng bản đồ Google (Iframe URL/Code)</label>
                                        <textarea asp-for="MapCode" class="form-control rounded-3" rows="3" placeholder="Dán mã nhúng iframe bản đồ tại đây..."></textarea>
                                        <div class="small text-muted mt-1">Lấy từ Google Maps > Chia sẻ > Nhúng bản đồ</div>
                                    </div>
                                    <div class="col-md-12">
                                        <label class="form-label fw-semibold">Thông tin chân trang (Footer Info)</label>
                                        <textarea asp-for="FooterInfo" id="editorFooter" class="form-control rounded-3" rows="4"></textarea>
                                    </div>
                                </div>
                            </div>

                            <!-- Invoice Settings -->
                            <div class="tab-pane fade" id="nav-invoice" role="tabpanel">
                                <h5 class="fw-bold mb-4">Thông tin hiển thị trên hóa đơn</h5>
                                <div class="row g-4">
                                    <div class="col-md-12">
                                        <label class="form-label fw-semibold">Tiêu đề hóa đơn (Header)</label>
                                        <textarea asp-for="InvoiceHeader" id="editorInvoiceHeader" class="form-control rounded-3" rows="3"></textarea>
                                    </div>
                                    <div class="col-md-12">
                                        <label class="form-label fw-semibold">Ghi chú chân hóa đơn (Footer)</label>
                                        <textarea asp-for="InvoiceFooter" id="editorInvoiceFooter" class="form-control rounded-3" rows="3"></textarea>
                                    </div>

                                    <div class="col-md-6 mt-4">
                                        <div class="card border-0 shadow-sm rounded-3" style="background: linear-gradient(135deg, #f0fff4 0%, #eefbf5 100%); border-left: 4px solid #0ab39c !important;">
                                            <div class="card-body p-3">
                                                <label class="form-label fw-bold mb-1"><i class="fas fa-truck me-2 text-success"></i>Phí vận chuyển mặc định</label>
                                                <div class="input-group">
                                                    <input type="number" asp-for="DefaultShippingFee" class="form-control rounded-start" min="0" step="1000" placeholder="0">
                                                    <span class="input-group-text">₫</span>
                                                </div>
                                                <small class="text-muted mt-1 d-block"><i class="fas fa-info-circle me-1"></i>Nhập <strong>0</strong> nếu muốn <strong>Miễn phí vận chuyển</strong>. Giá trị này sẽ áp dụng cho tất cả đơn hàng.</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Social Settings -->
                            <div class="tab-pane fade" id="nav-social" role="tabpanel">
                                <h5 class="fw-bold mb-4">Mạng xã hội</h5>
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold"><i class="fab fa-facebook me-2 text-primary"></i> Facebook URL</label>
                                        <input type="text" asp-for="Facebook" class="form-control rounded-3" placeholder="https://facebook.com/...">
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold"><i class="fab fa-youtube me-2 text-danger"></i> YouTube URL</label>
                                        <input type="text" asp-for="YouTube" class="form-control rounded-3" placeholder="https://youtube.com/...">
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold"><i class="fas fa-comment me-2 text-info"></i> Zalo (Số điện thoại/Link)</label>
                                        <input type="text" asp-for="Zalo" class="form-control rounded-3" placeholder="090123...">
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold"><i class="fab fa-instagram me-2 text-danger"></i> Instagram</label>
                                        <input type="text" asp-for="Instagram" class="form-control rounded-3" placeholder="https://instagram.com/...">
                                    </div>
                                </div>
                            </div>

                            <!-- Error Pages Settings -->
                            <div class="tab-pane fade" id="nav-error" role="tabpanel">
                                <h5 class="fw-bold mb-4">Cấu hình Trang lỗi & Bảo trì</h5>
                                <div class="card border border-warning-subtle mb-4">
                                    <div class="card-body bg-warning bg-opacity-10">
                                        <div class="form-check form-switch mb-3">
                                            <input class="form-check-input" type="checkbox" asp-for="MaintenanceMode" id="switchMaintenance">
                                            <label class="form-check-label fw-bold" for="switchMaintenance">KÍCH HOẠT CHẾ ĐỘ BẢO TRÌ</label>
                                        </div>
                                        <div>
                                            <label class="form-label small fw-bold">Nội dung thông báo bảo trì</label>
                                            <textarea asp-for="MaintenanceMessage" id="editorMaintenance" class="form-control" rows="5"></textarea>
                                        </div>
                                    </div>
                                </div>

                                <div class="row g-4">
                                    <div class="col-md-12">
                                        <label class="form-label fw-semibold">Nội dung trang 404 (Không tìm thấy)</label>
                                        <textarea asp-for="Error404Message" id="editor404" class="form-control" rows="3"></textarea>
                                    </div>
                                    <div class="col-md-12">
                                        <label class="form-label fw-semibold">Nội dung trang 500 (Lỗi hệ thống)</label>
                                        <textarea asp-for="Error500Message" id="editor500" class="form-control" rows="3"></textarea>
                                    </div>
                                    <div class="col-md-12">
                                        <label class="form-label fw-semibold">Nội dung trang 403 (Không có quyền)</label>
                                        <textarea asp-for="Error403Message" id="editor403" class="form-control" rows="3"></textarea>
                                    </div>
                                </div>
                            </div>

                            <!-- System/Cache Settings -->
                            <div class="tab-pane fade" id="nav-system" role="tabpanel">
                                <h5 class="fw-bold mb-4">Tối ưu & Cache</h5>
                                <div class="card border border-primary-subtle mb-4">
                                    <div class="card-body bg-primary bg-opacity-10">
                                        <div class="form-check form-switch mb-3">
                                            <input class="form-check-input" type="checkbox" asp-for="EnableCache" id="switchCache">
                                            <label class="form-check-label fw-bold text-primary" for="switchCache">BẬT CACHE DỮ LIỆU</label>
                                        </div>
                                        <div class="row align-items-center">
                                            <div class="col-md-6">
                                                <label class="form-label small fw-bold">Thời gian xóa cache (Phút)</label>
                                                <input type="number" asp-for="CacheTimeout" class="form-control border-primary">
                                                <div class="small text-muted mt-1"><i class="fas fa-info-circle me-1"></i> Nhập <strong class="text-danger">0</strong> để luôn lấy dữ liệu mới từ Database.</div>
                                            </div>
                                            <div class="col-md-6">
                                                <button type="button" class="btn btn-danger w-100 fw-bold" onclick="clearCache()">
                                                    <i class="fas fa-trash-alt me-2"></i> XÓA CACHE THỦ CÔNG NGAY
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="alert alert-info border-0 shadow-sm rounded-4 mb-4">
                                    <h6><i class="fas fa-info-circle me-2"></i> Chính sách lưu trữ Cache</h6>
                                    <ul class="small mb-0 ps-3">
                                        <li><strong>Chỉ áp dụng cho giao diện người dùng:</strong> Dữ liệu Admin CMS luôn được tải trực tiếp từ Database.</li>
                                        <li><strong>Tự động giải phóng:</strong> Khi Admin thêm mới / chỉnh sửa xóa các bài viết, module liên quan sẽ tự xóa Cache của nó ngay lập tức.</li>
                                        <li><strong>Các Module đang áp dụng Cache tối ưu:</strong> Sản phẩm, Danh mục, Tin tức nổi bật, Banner quảng cáo (Slider), Video, FAQ.</li>
                                    </ul>
                                </div>
                                <h5 class="fw-bold mb-4 mt-4">Công cụ SEO Sitemap</h5>
                                <div class="card border border-success-subtle mb-4">
                                    <div class="card-body bg-success bg-opacity-10 d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="fw-bold text-success mb-1">Cập nhật Sitemap.xml tự động</h6>
                                            <p class="small text-muted mb-0">Hệ thống sẽ quét lại toàn bộ bài viết, tin tức, DM để sinh và ping Sitemap cho Google Webmaster.</p>
                                        </div>
                                        <button type="button" class="btn btn-success fw-bold px-4" onclick="generateSitemap()">
                                            <i class="fas fa-sitemap me-2"></i> TẠO AUTO SITEMAP
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- SMTP Settings -->
                            <div class="tab-pane fade" id="nav-smtp" role="tabpanel">
                                <h5 class="fw-bold mb-4">Cấu hình Email gửi tự động (SMTP)</h5>
                                <div class="alert alert-info border-0 shadow-sm rounded-4 mb-4">
                                    <h6 class="fw-bold text-info"><i class="fas fa-info-circle me-2"></i> SMTP dùng để làm gì?</h6>
                                    <p class="small mb-2">Tính năng này giúp website gửi email trực tiếp cho khách hàng trong các trường hợp: <strong>Quên mật khẩu</strong>, <strong>Xác nhận đơn hàng</strong>, <strong>Thông báo khuyến mãi</strong>.</p>
                                    
                                    <h6 class="fw-bold text-danger mt-3"><i class="fas fa-exclamation-triangle me-2"></i> Hướng dẫn sửa lỗi gửi mail (5.7.0 Authentication Required)</h6>
                                    <div class="small">
                                        <p class="mb-1">Lỗi này xảy ra khi máy chủ từ chối mật khẩu của bạn. <strong>Nếu bạn đang dùng Gmail để gửi:</strong> Google không còn cho phép dùng mật khẩu đăng nhập bình thường để gửi SMTP nữa.</p>
                                        <ol class="mb-0 ps-3">
                                            <li>Bạn phải vào <a href="https://myaccount.google.com/security" target="_blank" class="fw-bold text-decoration-none">Tài khoản Google <i class="fas fa-external-link-alt ms-1" style="font-size: 0.75rem;"></i></a> -> Bảo mật -> Bật <strong>Xác minh 2 bước</strong>.</li>
                                            <li>Sau đó truy cập <a href="https://myaccount.google.com/apppasswords" target="_blank" class="fw-bold text-decoration-none text-danger">Trang Mật khẩu ứng dụng <i class="fas fa-external-link-alt ms-1" style="font-size: 0.75rem;"></i></a> để tạo một chuỗi 16 ký tự.</li>
                                            <li>Mang chuỗi 16 ký tự đó dán vào ô <strong>Mật khẩu SMTP</strong> bên dưới. Lúc này web sẽ gửi được email bình thường!</li>
                                        </ol>
                                    </div>
                                </div>
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Máy chủ SMTP (Server)</label>
                                        <input type="text" asp-for="SmtpServer" class="form-control rounded-3" placeholder="smtp.gmail.com">
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Cổng (Port)</label>
                                        <input type="number" asp-for="SmtpPort" class="form-control rounded-3" placeholder="587">
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Email gửi</label>
                                        <input type="email" asp-for="SmtpEmail" class="form-control rounded-3" placeholder="email@gmail.com">
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Mật khẩu (App Password)</label>
                                        <div class="input-group">
                                            <input type="password" asp-for="SmtpPassword" id="SmtpPassword" class="form-control rounded-3 rounded-end-0" placeholder="Mật khẩu ứng dụng">
                                            <button class="btn btn-outline-secondary px-3" type="button" onclick="togglePassword('SmtpPassword')">
                                                <i class="fas fa-eye" id="eye-SmtpPassword"></i> Hiện
                                            </button>
                                        </div>
                                        <div class="small text-muted mt-1">Đối với Gmail, bạn cần tạo <strong>Mật khẩu ứng dụng (App Password)</strong>.</div>
                                    </div>
                                </div>

                                <hr class="my-4">
                                <h5 class="fw-bold mb-3"><i class="fas fa-envelope-open-text me-2 text-primary"></i> Mẫu Email Template</h5>
                                <div class="alert alert-light border shadow-none rounded-4 mb-3">
                                    <h6 class="fw-bold mb-2"><i class="fas fa-code me-1"></i> Biến thay thế có thể dùng:</h6>
                                    <div class="d-flex flex-wrap gap-2">
                                        <code>{CustomerName}</code> <code>{OrderCode}</code> <code>{TotalAmount}</code> 
                                        <code>{OrderDate}</code> <code>{StatusName}</code> <code>{NewPassword}</code> <code>{SiteName}</code>
                                    </div>
                                </div>
                                <div class="row g-4">
                                    <div class="col-md-12">
                                        <label class="form-label fw-semibold">📦 Mẫu email xác nhận đơn hàng</label>
                                        <textarea asp-for="EmailTemplateOrderConfirm" id="editorEmailOrderConfirm" class="form-control rounded-3" rows="6" placeholder="Để trống nếu muốn dùng mẫu mặc định. Hỗ trợ HTML."></textarea>
                                    </div>
                                    <div class="col-md-12">
                                        <label class="form-label fw-semibold">🚚 Mẫu email cập nhật trạng thái đơn hàng</label>
                                        <textarea asp-for="EmailTemplateOrderStatus" id="editorEmailOrderStatus" class="form-control rounded-3" rows="6" placeholder="Để trống nếu muốn dùng mẫu mặc định. Hỗ trợ HTML."></textarea>
                                    </div>
                                    <div class="col-md-12">
                                        <label class="form-label fw-semibold">🔐 Mẫu email khôi phục mật khẩu</label>
                                        <textarea asp-for="EmailTemplatePasswordReset" id="editorEmailPasswordReset" class="form-control rounded-3" rows="6" placeholder="Để trống nếu muốn dùng mẫu mặc định. Hỗ trợ HTML."></textarea>
                                    </div>
                                </div>
                            </div>

                            <!-- SEO & Analytics Settings -->
                            <div class="tab-pane fade" id="nav-seo" role="tabpanel">
