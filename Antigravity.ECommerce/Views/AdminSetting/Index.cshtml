<!-- Modal File Manager (Reuse from previous implementation) -->
<div class="modal fade" id="fileManagerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Quản lý tệp tin</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0" style="height: 75vh;">
                <iframe id="fileManagerIframe" src="/FileManager" width="100%" height="100%" frameborder="0"></iframe>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentInputId = '';
        const fileManagerModal = new bootstrap.Modal(document.getElementById('fileManagerModal'));

        function openFileManager(inputId) {
            currentInputId = inputId;
            const iframe = document.getElementById('fileManagerIframe');
            iframe.src = '/FileManager?fieldId=' + inputId;
            fileManagerModal.show();
        }

        // Catch message from File Manager iframe
        window.addEventListener('message', function(event) {
            if (event.data && event.data.type === 'fileSelected') {
                const url = event.data.url;
                if (currentInputId) {
                    document.getElementById(currentInputId).value = url;
                    
                    // Update preview if exists
                    const previewId = currentInputId === 'txtLogo' ? 'imgLogo' : (currentInputId === 'txtFavicon' ? 'imgFavicon' : '');
                    if (previewId) {
                        document.getElementById(previewId).src = url;
                    }
                }
                fileManagerModal.hide();
            }
        });

        $(function() {
            // Ghi nhớ Tab khi nhấn
            const activeTab = localStorage.getItem('admin_setting_active_tab');
            if (activeTab) {
                const tabEl = document.querySelector(`#v-pills-tab button[data-bs-target="${activeTab}"]`);
                if (tabEl) {
                    const tab = new bootstrap.Tab(tabEl);
                    tab.show();
                }
            }

            // Lưu tab vào localStorage khi thay đổi
            const tabElements = document.querySelectorAll('#v-pills-tab button[data-bs-toggle="pill"]');
            tabElements.forEach(el => {
                el.addEventListener('shown.bs.tab', event => {
                    localStorage.setItem('admin_setting_active_tab', event.target.getAttribute('data-bs-target'));
                });
            });

            // Tự động Submit khi gạt nút Bảo trì hoặc Cache (Tùy chọn nhanh)
            $('#switchMaintenance, #switchCache').on('change', function() {
                const label = $(this).closest('div').find('label').text();
                Swal.fire({
                    title: 'Xác nhận thay đổi?',
                    text: `Bạn có muốn áp dụng ngay ${label} không?`,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Áp dụng ngay'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $('form').submit();
                    } else {
                        $(this).prop('checked', !$(this).prop('checked'));
                    }
                });
            });
        });

        function clearCache() {
            Swal.fire({
                title: 'Xác nhận xóa cache?',
                text: "Toàn bộ dữ liệu tạm thời sẽ được làm mới từ Database!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Đồng ý xóa',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/AdminSetting/ClearCache', function(res) {
                        if(res.success) {
                            Swal.fire('Thành công', 'Đã làm mới cache hệ thống!', 'success');
                        } else {
                            Swal.fire('Lỗi', res.message, 'error');
                        }
                    });
                }
            });
        }

        function generateSitemap() {
            Swal.fire({
                title: 'Tạo Sitemap?',
                text: 'Hệ thống sẽ quét toàn bộ dữ liệu và có thể mất khoảng 5-10 giây.',
                icon: 'info',
                showCancelButton: true,
                confirmButtonText: 'Bắt đầu quét',
                cancelButtonText: 'Đóng'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: 'Đang tạo Sitemap...',
                        html: 'Vui lòng không đóng trình duyệt lúc này.',
                        allowOutsideClick: false,
                        didOpen: () => { Swal.showLoading() }
                    });
                    
                    $.post('/AdminSetting/GenerateSitemap', function(res) {
                        if(res.success) {
                            Swal.fire('Thành công', 'Đã lưu sitemap.xml tại thư mục root!', 'success');
                        } else {
                            Swal.fire('Lỗi', res.message, 'error');
                        }
                    });
                }
            });
        }

        function togglePassword(inputId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById('eye-' + inputId);
            const btn = icon.parentElement;
            if (input.type === "password") {
                input.type = "text";
                icon.classList.replace('fa-eye', 'fa-eye-slash');
                btn.innerHTML = `<i class="fas fa-eye-slash" id="eye-${inputId}"></i> Ẩn`;
            } else {
                input.type = "password";
                icon.classList.replace('fa-eye-slash', 'fa-eye');
                btn.innerHTML = `<i class="fas fa-eye" id="eye-${inputId}"></i> Hiện`;
            }
        }

        // Initialize CKEditor for Settings
        $(function() {
            // SweetAlert2 for TempData messages
            @if (TempData["SuccessMessage"] != null) {
                <text>
                Swal.fire({
                    icon: 'success',
                    title: 'Thành công!',
                    text: '@Html.Raw(TempData["SuccessMessage"])',
                    timer: 3000,
                    timerProgressBar: true,
                    showConfirmButton: false
                });
                </text>
            }
            @if (TempData["ErrorMessage"] != null) {
                <text>
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi!',
                    text: '@Html.Raw(TempData["ErrorMessage"])',
                    confirmButtonText: 'Đóng'
                });
                </text>
            }

            // Currency formatting with commas
            $('.currency-input').on('input', function() {
                let value = this.value.replace(/[^0-9]/g, '');
                if (value === '') value = '0';
                
                const targetId = $(this).data('target');
                document.getElementById(targetId).value = value;
                
                this.value = parseInt(value).toLocaleString('en-US');
            });

            // Prevent scroll on number change
            $('.currency-input').on('wheel', function(e) {
                e.preventDefault();
            });

            const editorConfig = {
                filebrowserBrowseUrl: '/FileManager/Index?mode=select',
                filebrowserImageBrowseUrl: '/FileManager/Index?mode=select&type=Images',
                filebrowserUploadUrl: '/FileManager/Upload?type=Files',
                filebrowserImageUploadUrl: '/FileManager/Upload?type=Images',
                height: 250,
                removeButtons: 'Print,NewPage,Preview,ExportPdf,Save'
            };

            if (document.getElementById('editorMaintenance')) CKEDITOR.replace('editorMaintenance', editorConfig);
            if (document.getElementById('editorFooter')) CKEDITOR.replace('editorFooter', editorConfig);
            if (document.getElementById('editorInvoiceHeader')) CKEDITOR.replace('editorInvoiceHeader', editorConfig);
            if (document.getElementById('editorInvoiceFooter')) CKEDITOR.replace('editorInvoiceFooter', editorConfig);
            if (document.getElementById('editor404')) CKEDITOR.replace('editor404', editorConfig);
            if (document.getElementById('editor403')) CKEDITOR.replace('editor403', editorConfig);
            if (document.getElementById('editor500')) CKEDITOR.replace('editor500', editorConfig);
            if (document.getElementById('editorEmailOrderConfirm')) CKEDITOR.replace('editorEmailOrderConfirm', editorConfig);
            if (document.getElementById('editorEmailOrderStatus')) CKEDITOR.replace('editorEmailOrderStatus', editorConfig);
            if (document.getElementById('editorEmailPasswordReset')) CKEDITOR.replace('editorEmailPasswordReset', editorConfig);

            $('#formSettings').on('submit', function(e) {
                e.preventDefault();
                // Update CKEditor instances before submitting
                for (instance in CKEDITOR.instances) {
                    CKEDITOR.instances[instance].updateElement();
                }
                
                const activeTabName = $('#v-pills-tab .nav-link.active').text().trim();
                const formData = new FormData(this);
                const btn = $(this).find('button[type="submit"]');
                const originalText = btn.html();
                
                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i> ĐANG LƯU...');

                $.ajax({
                    url: $(this).attr('action'),
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function(res) {
                        if (res.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Thành công!',
                                text: 'Đã lưu ' + activeTabName,
                                timer: 3000,
                                timerProgressBar: true,
                                showConfirmButton: false
                            });
                        } else {
                            Swal.fire('Lỗi', res.message || 'Có lỗi xảy ra', 'error');
                        }
                    },
                    error: function() {
                        Swal.fire('Lỗi', 'Lỗi kết nối máy chủ', 'error');
                    },
                    complete: function() {
                        btn.prop('disabled', false).html(originalText);
                    }
                });
            });
        });
    </script>
}

<style>
