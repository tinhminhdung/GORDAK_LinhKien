<script>
    function bulkRegenerateImages() {
        Swal.fire({
            title: 'Tạo lại toàn bộ Thumbnail?',
            html: '<p class="mb-1">Hệ thống sẽ xóa tất cả ảnh thu nhỏ cũ và tạo lại theo cài đặt mới.</p><p class="text-success fw-bold mb-0">⚠️ Ảnh gốc KHÔNG bị ảnh hưởng.</p>',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: '<i class="fas fa-redo me-1"></i> Bắt đầu tạo lại',
            cancelButtonText: 'Hủy',
            confirmButtonColor: '#f1b44c'
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire({
                    title: 'Đang tạo lại Thumbnail...',
                    html: 'Vui lòng không đóng trình duyệt lúc này.',
                    allowOutsideClick: false,
                    didOpen: () => { Swal.showLoading() }
                });
                $.post('/FileManager/BulkOptimize', function(data) {
                    if (data.success) {
                        const savedMB = (data.savedBytes / 1024 / 1024).toFixed(1);
                        Swal.fire({
                            icon: 'success',
                            title: 'Hoàn tất!',
                            html: `<div class="text-start"><p>📊 Tổng: <strong>${data.total}</strong> ảnh</p><p>✅ Đã tối ưu: <strong>${data.optimized}</strong> ảnh</p><p>💾 Tiết kiệm: <strong>${savedMB} MB</strong></p><p class="text-success fw-bold">⚠️ Ảnh gốc KHÔNG bị thay đổi.</p></div>`
                        });
                    } else {
                        Swal.fire('Lỗi', 'Không thể tạo lại thumbnail.', 'error');
                    }
                });
            }
        });
    }

    function selectWatermark() {
        // Mở popup FileManager để chọn ảnh logo
        var width = window.innerWidth * 0.8;
        var height = window.innerHeight * 0.8;
        var left = (window.innerWidth - width) / 2;
        var top = (window.innerHeight - height) / 2;
        
        window.open('/FileManager?fieldId=watermarkUrl', 'FileManagerWM', `width=${width},height=${height},top=${top},left=${left},scrollbars=yes,resizable=yes`);
    }

    function selectPreviewBg() {
        var width = window.innerWidth * 0.8;
        var height = window.innerHeight * 0.8;
        var left = (window.innerWidth - width) / 2;
        var top = (window.innerHeight - height) / 2;
        window.open('/FileManager?fieldId=previewBg', 'FileManagerPreview', `width=${width},height=${height},top=${top},left=${left},scrollbars=yes,resizable=yes`);
    }

    // Callback từ FileManager
    window.setFileUrl = function (urls, fieldId) {
        if (urls && urls.length > 0) {
            if (fieldId === 'watermarkUrl') {
                document.getElementById('watermarkUrl').value = urls[0];
                updateWatermarkPreview();
            } else if (fieldId === 'previewBg') {
                document.getElementById('wmPreviewBox').style.backgroundImage = `url('${urls[0]}')`;
            }
        }
    };

    function updateWatermarkPreview() {
        const logoUrl = document.getElementById('watermarkUrl').value;
        const pos = document.getElementById('Image_WatermarkPosition').value;
        const size = document.getElementById('Image_WatermarkSize').value;
        const opacity = document.getElementById('Image_WatermarkOpacity').value;
        
        const previewLogo = document.getElementById('wmPreviewLogo');
        if (!logoUrl) {
            previewLogo.style.display = 'none';
            return;
        }
        
        previewLogo.src = logoUrl;
        
        if (pos === 'Tile') {
            previewLogo.style.display = 'none';
            document.getElementById('wmPreviewBox').style.position = 'relative';
            // Không hỗ trợ preview tile phức tạp trong html tĩnh dễ dàng, chỉ báo hiệu ứng mờ
            return;
        }

        previewLogo.style.display = 'block';
        previewLogo.style.width = size + '%';
        previewLogo.style.opacity = opacity / 100;
        
        // Reset positions
        previewLogo.style.top = 'auto';
        previewLogo.style.bottom = 'auto';
        previewLogo.style.left = 'auto';
        previewLogo.style.right = 'auto';
        previewLogo.style.transform = 'none';
        
        const padding = '2%';
        
        switch (pos) {
            case 'TopLeft':
                previewLogo.style.top = padding;
                previewLogo.style.left = padding;
                break;
            case 'TopRight':
                previewLogo.style.top = padding;
                previewLogo.style.right = padding;
                break;
            case 'BottomLeft':
                previewLogo.style.bottom = padding;
                previewLogo.style.left = padding;
                break;
            case 'Center':
                previewLogo.style.top = '50%';
                previewLogo.style.left = '50%';
                previewLogo.style.transform = 'translate(-50%, -50%)';
                break;
            case 'BottomRight':
            default:
                previewLogo.style.bottom = padding;
                previewLogo.style.right = padding;
                break;
        }
    }

    // Init preview on load
    document.addEventListener('DOMContentLoaded', function() {
        updateWatermarkPreview();
        const watermarkInput = document.getElementById('watermarkUrl');
        if(watermarkInput) watermarkInput.addEventListener('input', updateWatermarkPreview);

        // Init Gemini Live Check
        let geminiInput = document.getElementById('GeminiApiKey');
        if(geminiInput) {
            checkGeminiConnection(geminiInput.value);
            let timeout = null;
            geminiInput.addEventListener('input', function() {
                clearTimeout(timeout);
                document.getElementById('ai-status-indicator').innerHTML = '<span class="badge bg-secondary px-3"><i class="fas fa-spinner fa-spin"></i> Đang kiểm tra...</span>';
                timeout = setTimeout(() => { checkGeminiConnection(this.value); }, 1000);
            });
        }
    });

    async function checkGeminiConnection(key) {
        const indicator = document.getElementById('ai-status-indicator');
        if (!key || key.trim() === '') {
            indicator.innerHTML = '<span class="badge bg-secondary px-3">Chưa có mã</span>';
            return;
        }
        try {
            const response = await fetch('/AdminSetting/CheckGeminiApi', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(key)
            });
            const res = await response.json();
            if (res.success) {
                indicator.innerHTML = '<span class="badge bg-success px-3 py-2" style="font-size:12px"><i class="fas fa-check-circle"></i> Kết nối thành công</span>';
            } else {
                indicator.innerHTML = '<span class="badge bg-danger px-3 py-2" style="font-size:12px" title="'+res.message+'"><i class="fas fa-times-circle"></i> Lỗi API Key</span>';
            }
        } catch (err) {
            indicator.innerHTML = '<span class="badge bg-danger px-3"><i class="fas fa-wifi"></i> Lỗi mạng</span>';
        }
    }
</script>
