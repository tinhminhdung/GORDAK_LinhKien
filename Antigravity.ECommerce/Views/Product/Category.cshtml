@model List<Antigravity.ECommerce.Models.Product>
@{
    Layout = "_MainLayout";
    var category = ViewBag.Category as Antigravity.ECommerce.Models.Category;
    ViewData["Title"] = category != null ? category.Name : (ViewBag.Keyword != null ? "Tìm kiếm: " + ViewBag.Keyword : "Tất cả sản phẩm");

    // Lấy danh sách danh mục gốc để hiển thị
    var allProductCats = Antigravity.ECommerce.Services.SCategory.GetAll().Where(x => x.CategoryType == 1 || x.CategoryType == null).ToList();
    var parentCategories = Antigravity.ECommerce.Services.SCache.GetOrSet("Home_Categories", () => allProductCats.Where(x => x.ParentId == 0).OrderBy(x => x.SortOrder).ToList(), 60);
    
    // Đếm số lượng sản phẩm thực tế theo CategoryId từ DB
    var productCounts = Antigravity.ECommerce.Services.SCache.GetOrSet("Product_CountByCategory", () => Antigravity.ECommerce.Services.SProduct.CountByCategory(), 10);
    var catLookup = allProductCats.ToLookup(x => x.ParentId);
    
    // Hàm tính tổng sản phẩm của 1 category + tất cả con cháu
    int SumDescendants(int catId) {
        int count = productCounts != null && productCounts.ContainsKey(catId) ? productCounts[catId] : 0;
        foreach (var child in catLookup[catId]) {
            count += SumDescendants(child.CategoryId);
        }
        return count;
    }
    
    // Tính aggregate counts cho từng category cha
    var aggregateCounts = new Dictionary<int, int>();
    int totalAllProducts = 0;
    if (parentCategories != null) {
        foreach (var pc in parentCategories) {
            int sum = SumDescendants(pc.CategoryId);
            aggregateCounts[pc.CategoryId] = sum;
            totalAllProducts += sum;
        }
    }

    var bestSellers = Antigravity.ECommerce.Services.SCache.GetOrSet("Product_BestSellers", () => Antigravity.ECommerce.Services.SProduct.Search(null, null, 1, true, null, null, "SortOrder", "ASC", 1, 12), 60);
    var commitments = Antigravity.ECommerce.Services.SAdvertising.GetByPosition("Product_Commitment");

    // SEO Schema Setup
    ViewData["SchemaBreadcrumbs"] = new List<Antigravity.ECommerce.Models.BreadcrumbItem> {
        new Antigravity.ECommerce.Models.BreadcrumbItem { Name = "Trang chủ", Url = "/" },
        new Antigravity.ECommerce.Models.BreadcrumbItem { Name = "Sản phẩm", Url = "/san-pham.html" }
    };
    if (category != null) {
        ((List<Antigravity.ECommerce.Models.BreadcrumbItem>)ViewData["SchemaBreadcrumbs"]).Add(
            new Antigravity.ECommerce.Models.BreadcrumbItem { Name = category.Name, Url = Context.Request.Path }
        );
    }
}

<!-- ======== BREADCRUMB ======== -->
<div class="container mt-3 mb-4">
  <nav class="sp-breadcrumb"><a href="/">Trang chủ</a> <i class="fa-solid fa-chevron-right"></i> <span>@(category != null ? category.Name : (ViewBag.Keyword != null ? "Tìm kiếm: " + ViewBag.Keyword : "Sản phẩm"))</span></nav>
</div>

<!-- ======== CATEGORY FILTER ======== -->
<div class="container mb-3">
  <div class="sp-cat-list">
    <a href="/san-pham.html" class="sp-cat-item @(category == null ? "active" : "")">
      <i class="fa-solid fa-border-all"></i>
      <div><strong>Tất cả sản phẩm</strong><small>@totalAllProducts sản phẩm</small></div>
    </a>
    @if(parentCategories != null)
    {
      foreach(var cat in parentCategories)
      {
        <a href="/san-pham/@(cat.Slug).html" class="sp-cat-item @((category != null && category.CategoryId == cat.CategoryId) ? "active" : "")">
          @if(!string.IsNullOrEmpty(cat.Image)){
            <img src="@cat.Image" alt="@cat.Name" style="width: 32px; height: 32px; object-fit: contain;" />
          } else {
            <i class="@(cat.Icon ?? "fa-solid fa-box")"></i>
          }
          <div><strong>@cat.Name</strong><small>@(aggregateCounts != null && aggregateCounts.ContainsKey(cat.CategoryId) ? aggregateCounts[cat.CategoryId] : cat.ItemCount) sản phẩm</small></div>
        </a>
      }
    }
  </div>
  
  <!-- Mobile & Desktop Filter Trigger -->
  <div class="d-flex justify-content-between align-items-center mt-3 border-top pt-3 d-lg-none">
    <div class="fw-bold text-dark"><i class="fa-solid fa-list me-1"></i> Hiển thị @(Model != null ? Model.Count : 0) sản phẩm</div>
    <button class="btn btn-outline-dark btn-sm rounded-1 px-3 d-flex align-items-center gap-2" data-bs-toggle="offcanvas" data-bs-target="#filterOffcanvas">
      <i class="fa-solid fa-sliders"></i> Lọc & Sắp xếp
    </button>
  </div>
</div>

<!-- ======== PRODUCT GRID ======== -->
<div class="container">
  <div class="row g-3">
    @if (Model != null && Model.Any())
    {
        foreach (var p in Model)
        {
            <div class="col-6 col-md-4 col-lg-3 col-xl-2-4">
                <div class="product-card position-relative h-100 d-flex flex-column">
                  @if(p.IsHot){<span class="badge-hot">HOT</span>}
                  <span class="badge-heart" onclick="toggleWishlist(@p.ProductId)" style="cursor:pointer"><i class="fa-regular fa-heart"></i></span>
                  <a href="/san-pham/detail/@(p.Slug).html" class="d-block text-center mb-2" style="height: 180px;">
                      <img src="@(string.IsNullOrEmpty(p.MainImage) ? "/assets/images/placeholder.png" : p.MainImage)" class="product-img h-100 w-100 object-fit-contain" alt="@p.Name">
                  </a>
                  <h3 class="product-name"><a href="/san-pham/detail/@(p.Slug).html" class="text-decoration-none text-dark">@p.Name</a></h3>
                  <p class="product-desc line-clamp-2" style="font-size:12px; color:#666;">@(string.IsNullOrEmpty(p.ShortDescription) ? p.Name : p.ShortDescription)</p>
                  <div class="mt-auto">
                      <div class="product-price">@p.Price.ToString("N0")đ</div>
                      <div class="product-actions d-flex gap-2 mt-2">
                        <a href="/san-pham/detail/@(p.Slug).html" class="btn-outline-gd flex-fill text-center px-0 py-1" style="font-size:13px;">Chi tiết</a>
                        <a href="javascript:void(0)" onclick="addToCart(@p.ProductId,1)" class="btn-gd flex-fill d-flex align-items-center justify-content-center gap-1 py-1" style="font-size:13px;">
                          <i class="fa-solid fa-cart-shopping"></i> Mua
                        </a>
                      </div>
                  </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5">
            <i class="fa-solid fa-box-open fa-3x text-muted mb-3"></i>
            <p class="fs-5 text-muted">Không tìm thấy sản phẩm nào phù hợp.</p>
            <a href="/san-pham.html" class="btn btn-primary mt-2">Xem tất cả sản phẩm</a>
        </div>
    }
  </div>

  <!-- Pagination -->
  @if (ViewBag.PageCount > 1)
  {
      int pIndex = ViewBag.PageIndex ?? 1;
      int pCount = ViewBag.PageCount;
      string qParams = $"&q={ViewBag.Keyword}&priceMin={Context.Request.Query["priceMin"]}&priceMax={Context.Request.Query["priceMax"]}&sort={Context.Request.Query["sort"]}";

      <div class="vd-pagination mt-4 mb-5">
          @if (pIndex > 1)
          {
              <a class="vd-page-btn" href="?page=@(pIndex - 1)@qParams"><i class="fa-solid fa-chevron-left" style="font-size:11px;"></i></a>
          }

          @for (int i = 1; i <= pCount; i++)
          {
              <a class="vd-page-btn @(i == pIndex ? "active" : "")" href="?page=@(i)@qParams">@i</a>
          }

          @if (pIndex < pCount)
          {
              <a class="vd-page-btn" href="?page=@(pIndex + 1)@qParams"><i class="fa-solid fa-chevron-right" style="font-size:11px;"></i></a>
          }
      </div>
  }
</div>

<!-- ======== SẢN PHẨM BÁN CHẠY ======== -->
@if(bestSellers != null && bestSellers.Count > 0)
{
<div class="container sp-bestseller-sec mt-5">
  <h2 class="gt-section-title text-uppercase mb-3"><i class="fa-solid fa-fire text-danger"></i> SẢN PHẨM BÁN CHẠY</h2>
  <div class="position-relative group-slider">
    <button class="btn btn-light position-absolute top-50 start-0 translate-middle-y shadow-sm z-3 d-none d-md-block sp-slider-prev" onclick="spSlide(-1)" style="border-radius:50%; width:40px; height:40px; margin-left:-20px;"><i class="fa-solid fa-chevron-left"></i></button>
    
    <div class="row g-3 flex-nowrap overflow-auto hide-scrollbar pb-3 sp-slider-wrap" id="spSlider" style="scrollbar-width: none;">
      @foreach(var p in bestSellers)
      {
      <div class="col-6 col-md-4 col-lg-3 col-xl-2-4 sp-slider-item">
        <div class="product-card position-relative h-100 d-flex flex-column bg-white">
            @if(p.IsHot){<span class="badge-hot">HOT</span>}
            <span class="badge-heart" onclick="toggleWishlist(@p.ProductId)" style="cursor:pointer"><i class="fa-regular fa-heart"></i></span>
            <a href="/san-pham/detail/@(p.Slug).html" class="d-block text-center mb-2" style="height: 180px;">
                <img src="@(string.IsNullOrEmpty(p.MainImage) ? "/assets/images/placeholder.png" : p.MainImage)" class="product-img h-100 w-100 object-fit-contain" alt="@p.Name">
            </a>
            <h3 class="product-name"><a href="/san-pham/detail/@(p.Slug).html" class="text-decoration-none text-dark">@p.Name</a></h3>
            <p class="product-desc line-clamp-2" style="font-size:12px; color:#666;">@(string.IsNullOrEmpty(p.ShortDescription) ? p.Name : p.ShortDescription)</p>
            <div class="mt-auto">
                <div class="product-price">@p.Price.ToString("N0")đ</div>
                <div class="product-actions d-flex gap-2 mt-2">
                  <a href="/san-pham/detail/@(p.Slug).html" class="btn-outline-gd flex-fill text-center px-0 py-1" style="font-size:13px;">Chi tiết</a>
                  <a href="javascript:void(0)" onclick="addToCart(@p.ProductId,1)" class="btn-gd flex-fill d-flex align-items-center justify-content-center gap-1 py-1" style="font-size:13px;">
                    <i class="fa-solid fa-cart-shopping"></i> Mua
                  </a>
                </div>
            </div>
        </div>
      </div>
      }
    </div>
    
    <button class="btn btn-light position-absolute top-50 end-0 translate-middle-y shadow-sm z-3 d-none d-md-block sp-slider-next" onclick="spSlide(1)" style="border-radius:50%; width:40px; height:40px; margin-right:-20px;"><i class="fa-solid fa-chevron-right"></i></button>
  </div>
</div>
}

<!-- ======== CAM KẾT BAR ======== -->
<div class="container my-4">
  <div class="sp-commit-bar">
    @if(commitments != null)
    {
        foreach(var c in commitments)
        {
            <div class="sp-commit-item"><i class="@c.VideoUrl"></i><div><strong>@c.Title</strong><small>@c.Description</small></div></div>
        }
    }
  </div>
</div>


<!-- ======== FILTER OFFCANVAS ======== -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="filterOffcanvas" style="width: 350px;">
  <div class="offcanvas-header border-bottom bg-light">
    <h5 class="offcanvas-title fw-bold text-uppercase"><i class="fa-solid fa-sliders text-primary"></i> Lọc & Sắp xếp</h5>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>
  <div class="offcanvas-body">
    <form method="get">
        @if (ViewBag.Keyword != null) {
            <input type="hidden" name="q" value="@ViewBag.Keyword" />
        }

        <div class="mb-4">
            <label class="form-label fw-bold mb-3 text-dark"><i class="fa-solid fa-sort me-1 text-primary"></i> Sắp xếp theo</label>
            <div class="sort-pills d-flex flex-column">
                @{
                    var currentSort = Context.Request.Query["sort"].ToString();
                    if (string.IsNullOrEmpty(currentSort)) currentSort = "newest";
                }
                <div class="form-check mb-2">
                    <input class="form-check-input" type="radio" name="sort" id="sort_newest" value="newest" @(currentSort == "newest" ? "checked" : "")>
                    <label class="form-check-label" for="sort_newest">Mới nhất</label>
                </div>
                <div class="form-check mb-2">
                    <input class="form-check-input" type="radio" name="sort" id="sort_asc" value="price_asc" @(currentSort == "price_asc" ? "checked" : "")>
                    <label class="form-check-label" for="sort_asc">Giá: Thấp đến Cao</label>
                </div>
                <div class="form-check mb-2">
                    <input class="form-check-input" type="radio" name="sort" id="sort_desc" value="price_desc" @(currentSort == "price_desc" ? "checked" : "")>
                    <label class="form-check-label" for="sort_desc">Giá: Cao đến Thấp</label>
                </div>
            </div>
        </div>
        
        <hr>

        <div class="mb-4 mt-3">
            <label class="form-label fw-bold mb-3 text-dark"><i class="fa-solid fa-money-bill-wave me-1 text-primary"></i> Khoảng giá</label>
            <div id="price-slider" class="mb-3 mt-2 mx-2"></div>
            <div class="d-flex justify-content-between align-items-center mt-3">
                <span id="price-min-display" class="price-value-display fw-bold text-danger">0 ₫</span>
                <span class="text-muted">-</span>
                <span id="price-max-display" class="price-value-display fw-bold text-danger">50,000,000 ₫</span>
            </div>
            <input type="hidden" name="priceMin" id="priceMin" value="@Context.Request.Query["priceMin"]">
            <input type="hidden" name="priceMax" id="priceMax" value="@Context.Request.Query["priceMax"]">
        </div>

        <div class="d-flex gap-2 pt-3 border-top mt-auto fixed-bottom p-3 bg-white border-top">
            <a href="?" class="btn btn-light flex-grow-1 border">Thiết lập lại</a>
            <button type="submit" class="btn btn-primary flex-grow-1">Áp dụng</button>
        </div>
    </form>
  </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/nouislider/15.7.1/nouislider.min.css" />
    <style>
        .sp-cat-list::-webkit-scrollbar { display: none; }
        .sp-cat-item.active { border-color: var(--bs-primary) !important; background: rgba(var(--bs-primary-rgb), 0.05) !important; box-shadow: inset 0 0 0 1px var(--bs-primary); }
        .hide-scrollbar::-webkit-scrollbar { display: none; }
        
        /* noUiSlider Customization */
        .noUi-target { background: #e9ecef; border: none; height: 6px; }
        .noUi-connect { background: var(--bs-primary); }
        .noUi-handle { border-radius: 50%; background: #fff; border: 2px solid var(--bs-primary); width: 20px !important; height: 20px !important; right: -10px !important; top: -7px !important; }
        .noUi-handle::before, .noUi-handle::after { display: none; }

        /* Commit Bar Separators */
        @@media (min-width: 992px) {
            .sp-commit-bar { gap: 0; padding-left: 0; padding-right: 0; }
            .sp-commit-item { position: relative; padding: 0 2px; justify-content: center; }
            .sp-commit-item:not(:last-child)::after { 
                content: ''; 
                position: absolute; 
                right: 0; 
                top: -20px; 
                height: calc(100% + 40px); 
                width: 1px; 
                background-color: #e5e5e5; 
            }
        }
    </style>
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/nouislider/15.7.1/nouislider.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var slider = document.getElementById('price-slider');
            var minInput = document.getElementById('priceMin');
            var maxInput = document.getElementById('priceMax');
            var minDisplay = document.getElementById('price-min-display');
            var maxDisplay = document.getElementById('price-max-display');

            var maxSliderPrice = 50000000;
            var startMin = minInput.value ? parseInt(minInput.value) : 0;
            var startMax = maxInput.value ? parseInt(maxInput.value) : maxSliderPrice;

            noUiSlider.create(slider, {
                start: [startMin, startMax],
                connect: true,
                step: 100000,
                range: { 'min': 0, 'max': maxSliderPrice },
                format: {
                    to: function (value) { return Math.round(value); },
                    from: function (value) { return Number(value); }
                }
            });

            slider.noUiSlider.on('update', function (values, handle) {
                var value = values[handle];
                var formattedValue = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(value);
                
                if (handle === 0) {
                    minInput.value = value;
                    minDisplay.innerHTML = formattedValue;
                } else {
                    maxInput.value = value;
                    maxDisplay.innerHTML = value >= maxSliderPrice ? formattedValue.replace('₫', '') + '+' : formattedValue;
                }
            });
        });

        // Slider sản phẩm bán chạy
        function spSlide(dir) {
          const wrap = document.getElementById('spSlider');
          if(!wrap) return;
          const itemW = wrap.querySelector('.sp-slider-item').offsetWidth;
          
          // === CẤU HÌNH SỐ LƯỢNG SẢN PHẨM TRƯỢT ===
          // Bạn có thể sửa các số bên dưới để thay đổi số lượng item trượt đi mỗi khi bấm nút.
          // Nếu để = 0, JS sẽ tự động tính toán trượt theo kích thước màn hình hiện tại.
          const configItemsToScroll = {
              desktop: 5,   // Số item trượt trên PC (chiều rộng >= 1200px)
              laptop: 4,    // Số item trượt trên Laptop (chiều rộng >= 992px)
              tablet: 3,    // Số item trượt trên Tablet ngang (chiều rộng >= 768px)
              mobile: 2     // Số item trượt trên Mobile (chiều rộng < 768px)
          };
          // ========================================

          let visibleItems = 1;
          const w = window.innerWidth;

          if (w >= 1200) {
              visibleItems = configItemsToScroll.desktop || Math.max(1, Math.floor(wrap.clientWidth / itemW));
          } else if (w >= 992) {
              visibleItems = configItemsToScroll.laptop || Math.max(1, Math.floor(wrap.clientWidth / itemW));
          } else if (w >= 768) {
              visibleItems = configItemsToScroll.tablet || Math.max(1, Math.floor(wrap.clientWidth / itemW));
          } else {
              visibleItems = configItemsToScroll.mobile || Math.max(1, Math.floor(wrap.clientWidth / itemW));
          }
          
          // Cuộn đúng bằng số lượng item đang hiển thị
          wrap.scrollBy({ left: dir * itemW * visibleItems, behavior: 'smooth' });
        }
    </script>
}
