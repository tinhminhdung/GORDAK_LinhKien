@model Antigravity.ECommerce.Models.Product
@using Antigravity.ECommerce.Services
@{
    Layout = "_MainLayout";
    ViewData["Title"] = !string.IsNullOrEmpty(Model.SeoTitle) ? Model.SeoTitle : Model.Name;
    ViewData["Description"] = !string.IsNullOrEmpty(Model.SeoDescription) ? Model.SeoDescription : Model.ShortDescription;
    
    var related = ViewBag.RelatedProducts as List<Antigravity.ECommerce.Models.Product>;
    var gallery = !string.IsNullOrEmpty(Model.ImageGallery) ? Model.ImageGallery.Split(',').ToList() : new List<string>();
    var tags = !string.IsNullOrEmpty(Model.Tags) ? Model.Tags.Split(',').ToList() : new List<string>();

    // SEO Schema Setup
    ViewData["SchemaProduct"] = Model;
    ViewData["SchemaBreadcrumbs"] = new List<Antigravity.ECommerce.Models.BreadcrumbItem> {
        new Antigravity.ECommerce.Models.BreadcrumbItem { Name = "Trang chủ", Url = "/" },
        new Antigravity.ECommerce.Models.BreadcrumbItem { Name = "Sản phẩm", Url = "/san-pham.html" },
        new Antigravity.ECommerce.Models.BreadcrumbItem { Name = Model.Name, Url = Context.Request.Path }
    };

    if (!string.IsNullOrEmpty(Model.YoutubeVideo))
    {
        ViewData["SchemaVideo"] = new Antigravity.ECommerce.Models.Video {
            Title = "Video Review: " + Model.Name,
            YoutubeId = Model.YoutubeVideo,
            ThumbnailUrl = $"https://img.youtube.com/vi/{Model.YoutubeVideo}/maxresdefault.jpg",
            CreatedAt = Model.CreatedAt
        };
    }
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <style>
        .product-gallery-thumb .swiper-slide { opacity: 0.4; cursor: pointer; border-radius: 8px; overflow: hidden; }
        .product-gallery-thumb .swiper-slide-thumb-active { opacity: 1; border: 2px solid var(--bs-primary); }
        .gallery-main-img { border-radius: 20px; aspect-ratio: 1/1; object-fit: cover; }
        .gallery-thumb-img { aspect-ratio: 1/1; object-fit: cover; }
        .share-btn { width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #f8f9fa; color: #6c757d; transition: 0.3s; }
        .share-btn:hover { background: #0d6efd; color: white; }
        .product-content { font-size: 1.1rem; line-height: 1.8; color: #444; }
        .product-content img { max-width: 100%; border-radius: 15px; margin: 25px 0; box-shadow: 0 10px 30px rgba(0,0,0,0.05); }
    </style>
}



<div class="bg-light py-2">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/Product/Search" class="text-decoration-none">Sản phẩm</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
            </ol>
        </nav>
    </div>
</div>

<section class="py-5 bg-white">
    <div class="container">
        <div class="row g-5">
            <!-- Left: Gallery -->
            <div class="col-lg-6">
                <div class="sticky-top" style="top: 100px;">
                    <div class="swiper product-gallery-main mb-3">
                        <div class="swiper-wrapper">
                            <div class="swiper-slide">
                                <img src="@(string.IsNullOrEmpty(Model.MainImage) ? "/assets/images/placeholder.png" : Model.MainImage)" class="w-100 gallery-main-img">
                            </div>
                            @foreach(var img in gallery) {
                                <div class="swiper-slide">
                                    <img src="@img" class="w-100 gallery-main-img">
                                </div>
                            }
                        </div>
                        <div class="swiper-button-next"></div>
                        <div class="swiper-button-prev"></div>
                    </div>
                    
                    <div thumbsSlider="" class="swiper product-gallery-thumb">
                        <div class="swiper-wrapper">
                            <div class="swiper-slide">
                                <img src="@Model.MainImage" class="w-100 gallery-thumb-img">
                            </div>
                            @foreach(var img in gallery) {
                                <div class="swiper-slide">
                                    <img src="@img" class="w-100 gallery-thumb-img">
                                </div>
                            }
                        </div>
                    </div>

                    @if(!string.IsNullOrEmpty(Model.YoutubeVideo)) {
                        <div class="mt-5 p-4 bg-light rounded-4">
                            <h6 class="fw-bold mb-3 d-flex align-items-center">
                                <span class="bg-danger text-white rounded-circle p-1 me-2" style="width: 24px; height: 24px; display: flex; align-items: center; justify-content: center;">
                                    <i class="mdi mdi-play fs-12"></i>
                                </span> 
                                Video Review Thực Tế
                            </h6>
                            <div class="ratio ratio-16x9 rounded-4 overflow-hidden shadow-sm">
                                <iframe src="https://www.youtube.com/embed/@Model.YoutubeVideo?rel=0" allowfullscreen></iframe>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Right: Info -->
            <div class="col-lg-6">
                <div class="ps-lg-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="mb-3">
                            <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 mb-2">SKU: @Model.SKU</span>
                            <h1 class="display-6 fw-bold text-dark">@Model.Name</h1>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="share-btn text-danger border border-danger-subtle bg-white" onclick="toggleWishlist(@Model.ProductId)" title="Yêu thích"><i class="ri-heart-3-fill fs-5"></i></button>
                            <a href="https://www.facebook.com/sharer/sharer.php?u=@(Context.Request.Scheme)://@(Context.Request.Host)@(Context.Request.Path)" target="_blank" class="share-btn" title="Chia sẻ Facebook"><i class="mdi mdi-facebook"></i></a>
                            <a href="javascript:void(0)" onclick="copyToClipboard(window.location.href)" class="share-btn" title="Copy Link"><i class="mdi mdi-link-variant"></i></a>
                        </div>
                    </div>
                    
                    <div class="d-flex align-items-center mb-4">
                        @{ var topReviewStats = ViewBag.ReviewStats as Antigravity.ECommerce.Models.ReviewStatsModel; }
                        <div class="text-warning me-2">
                            @for(int i=1; i<=5; i++){
                                if(topReviewStats != null && i <= Math.Round(topReviewStats.AverageRating)) { <i class="mdi mdi-star"></i> }
                                else { <i class="mdi mdi-star-outline"></i> }
                            }
                        </div>
                        <span class="text-muted small">(@(topReviewStats != null ? topReviewStats.AverageRating.ToString("0.1") : "5.0")/5 - @Model.Views lượt xem)</span>
                        <span class="mx-3 text-divider">|</span>
                        <span class="text-success small fw-semibold"><i class="mdi mdi-check-decagram-outline me-1"></i> Tình trạng: @(Model.Stock > 0 ? "Còn hàng ("+Model.Stock+")" : "Hết hàng")</span>
                    </div>

                    <div class="p-4 border border-light-subtle rounded-4 mb-4 bg-light bg-opacity-50">
                        <div class="row align-items-center">
                            <div class="col-sm-7">
                                <div class="price-box">
                                    <h2 class="text-primary fw-bold mb-0">@Model.Price.ToString("N0") ₫</h2>
                                    @if(Model.OldPrice > Model.Price) {
                                        <div class="d-flex align-items-center mt-1">
                                            <span class="text-muted text-decoration-line-through me-2">@Model.OldPrice.ToString("N0") ₫</span>
                                            <span class="badge bg-danger">Tiết kiệm @((int)((Model.OldPrice - Model.Price) / Model.OldPrice * 100))%</span>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="col-sm-5 text-sm-end mt-3 mt-sm-0">
                                <div class="text-muted small mb-1">Đơn vị tính: <strong>@Model.Unit</strong></div>
                                <div class="text-muted small">Trọng lượng: <strong>@Model.Weight g</strong></div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <p class="text-secondary" style="font-size: 1.05rem;">@Model.ShortDescription</p>
                    </div>

                    @if (tags != null && tags.Any())
                    {
                        <div class="mb-4 d-flex align-items-center flex-wrap gap-2">
                            <span class="small fw-bold text-muted me-2 text-uppercase" style="letter-spacing: 0.5px; font-size: 11px;">Từ khóa:</span>
                            @foreach (var tag in tags)
                            {
                                <a href="/Product/Search?q=@tag.Trim()" class="badge bg-light text-primary border border-primary-subtle fw-normal text-decoration-none" style="font-size: 13px; padding: 6px 12px;">#@tag.Trim()</a>
                            }
                        </div>
                    }

                    <div class="row g-3 mb-5">
                        <div class="col-sm-4">
                            <div class="input-group border rounded-pill overflow-hidden">
                                <button class="btn btn-link text-dark text-decoration-none px-3 border-0" type="button" onclick="changeQty(-1)"><i class="mdi mdi-minus"></i></button>
                                <input type="number" class="form-control border-0 text-center fw-bold" id="buyQty" value="1" min="1" max="@Model.Stock">
                                <button class="btn btn-link text-dark text-decoration-none px-3 border-0" type="button" onclick="changeQty(1)"><i class="mdi mdi-plus"></i></button>
                            </div>
                        </div>
                        <div class="col-sm-8">
                            <button class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow-lg" onclick="addToCartAction(@Model.ProductId)">
                                <i class="mdi mdi-cart-outline me-2"></i> THÊM VÀO GIỎ HÀNG
                            </button>
                        </div>
                    </div>

                    <div class="card border-0 bg-primary bg-opacity-10 rounded-4 p-3 mb-4">
                        <div class="row g-3">
                            <div class="col-4 text-center">
                                <div class="bg-white p-2 rounded-3 mb-2 shadow-sm"><i class="mdi mdi-truck-delivery-outline fs-4 text-primary"></i></div>
                                <div class="small fw-semibold">Giao nhanh</div>
                            </div>
                            <div class="col-4 text-center">
                                <div class="bg-white p-2 rounded-3 mb-2 shadow-sm"><i class="mdi mdi-shield-check-outline fs-4 text-primary"></i></div>
                                <div class="small fw-semibold">Bảo hành 12th</div>
                            </div>
                            <div class="col-4 text-center">
                                <div class="bg-white p-2 rounded-3 mb-2 shadow-sm"><i class="mdi mdi-repeat fs-4 text-primary"></i></div>
                                <div class="small fw-semibold">Đổi trả 7 ngày</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-5 pt-4">
            <div class="col-lg-8">
                <!-- Content Tabs -->
                <ul class="nav nav-pills custom-pills mb-4" id="productTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active rounded-pill px-4 py-2 me-2" data-bs-toggle="pill" data-bs-target="#desc-pane" type="button">Mô tả sản phẩm</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link rounded-pill px-4 py-2" data-bs-toggle="pill" data-bs-target="#review-pane" type="button">Đánh giá & Bình luận</button>
                    </li>
                </ul>
                <div class="tab-content" id="productTabContent">
                    <div class="tab-pane fade show active" id="desc-pane">
                        <div class="product-content">
                            @Html.Raw(Model.DetailDescription)
                        </div>
                    </div>
                    <div class="tab-pane fade" id="review-pane">
                        <partial name="_ProductReviews" model="Model" />
                    </div>
                </div>
            </div>
            
            <div class="col-lg-4">
                <!-- Related Products Sidebar -->
                @if(related != null && related.Any()) {
                    <div class="p-4 bg-light rounded-4">
                        <h5 class="fw-bold mb-4 border-bottom pb-2">Sản phẩm liên quan</h5>
                        <div class="d-flex flex-column gap-3">
                            @foreach(var item in related.Take(5)) {
                                <a href="/san-pham/detail/@(item.Slug ?? "product").html" class="d-flex align-items-center text-decoration-none bg-white p-2 rounded-3 shadow-sm border border-light-subtle">
                                    <img src="@item.MainImage" width="70" height="70" class="rounded-3 object-fit-cover me-3">
                                    <div>
                                        <h6 class="text-dark mb-1 fs-14 fw-semibold" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">@item.Name</h6>
                                        <div class="text-primary fw-bold">@item.Price.ToString("N0") ₫</div>
                                    </div>
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var swiperThumb = new Swiper(".product-gallery-thumb", {
                spaceBetween: 10,
                slidesPerView: 4,
                freeMode: true,
                watchSlidesProgress: true,
            });
            var swiperMain = new Swiper(".product-gallery-main", {
                spaceBetween: 10,
                navigation: {
                    nextEl: ".swiper-button-next",
                    prevEl: ".swiper-button-prev",
                },
                thumbs: {
                    swiper: swiperThumb,
                },
            });
        });

        function changeQty(amount) {
            let input = document.getElementById('buyQty');
            let val = parseInt(input.value) + amount;
            let max = parseInt(input.getAttribute('max'));
            if(val >= 1 && val <= max) input.value = val;
        }

        function addToCartAction(productId) {
            let qty = document.getElementById('buyQty').value;
            if(typeof addToCart === 'function') {
                addToCart(productId, qty);
            } else {
                console.error("addToCart function is not defined globally.");
            }
        }
        
        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(function() {
                alert('Đã copy đường dẫn!');
            });
        }
    </script>
}
