                        </div>
                    </div>

                    <div class="text-muted mb-3" style="font-size: 12.5px; line-height: 1.5;">
                        <i class="fa-solid fa-phone-volume text-primary me-1"></i> Nhân viên Nhật Minh sẽ gọi điện xác nhận trước khi giữ đơn cho quý khách.
                    </div>

                    <div class="d-flex justify-content-end align-items-center gap-2 pt-2 border-top">
                        <button type="button" class="hub-btn-cancel" data-bs-dismiss="modal">Đóng</button>
                        <button type="button" id="btnHubNotifySubmit" onclick="submitHubNotify();" class="hub-btn-submit">
                            <i class="fa-solid fa-paper-plane"></i> <span>Gửi thông tin</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
function openModalBaoChoToi(sku, name, expected, unit) {
    if (name) $('#hub-notify-name').text(name);
    if (sku) {
        $('#hub-notify-sku').text(sku);
        $('#hub_notify_sku_input').val(sku);
    }
    if (expected) {
        $('#hub-notify-expected').text(expected);
        $('#hub-notify-expected-wrap').show();
    } else {
        $('#hub-notify-expected-wrap').hide();
    }
    if (unit) $('#hub-notify-unit').text(unit);
    $('#hub-notify-alert').hide().html('');
    $('#btnHubNotifySubmit').prop('disabled', false).html('<i class="fa-solid fa-paper-plane"></i> <span>Gửi thông tin</span>');
    var modalEl = document.getElementById('modalBaoChoToi');
    if (window.bootstrap && bootstrap.Modal) {
        var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
        modal.show();
    } else {
        $('#modalBaoChoToi').modal('show');
    }
}

function submitHubNotify() {
    var $btn = $('#btnHubNotifySubmit');
    var name = ($('#hub_notify_name_input').val() || '').trim();
    var phone = ($('#hub_notify_phone_input').val() || '').trim();
    var address = ($('#hub_notify_address_input').val() || '').trim();

    if (name.length < 2) {
        $('#hub-notify-alert').removeClass('alert-success').addClass('alert alert-danger')
            .html('<i class="fa-solid fa-circle-exclamation"></i> Vui lòng nhập họ và tên (tối thiểu 2 ký tự).').show();
        $('#hub_notify_name_input').focus();
        return false;
    }
    if (!/^(0|\+84)\d{9,10}$/.test(phone.replace(/[\s.-]/g, ''))) {
        $('#hub-notify-alert').removeClass('alert-success').addClass('alert alert-danger')
            .html('<i class="fa-solid fa-circle-exclamation"></i> Số điện thoại không hợp lệ (yêu cầu 10 chữ số).').show();
        $('#hub_notify_phone_input').focus();
        return false;
    }
    if (address.length < 5) {
        $('#hub-notify-alert').removeClass('alert-success').addClass('alert alert-danger')
            .html('<i class="fa-solid fa-circle-exclamation"></i> Vui lòng nhập địa chỉ nhận hàng (tối thiểu 5 ký tự).').show();
        $('#hub_notify_address_input').focus();
        return false;
    }

    $btn.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin"></i> <span>Đang gửi...</span>');

    var formData = $('#frmHubNotify').serialize();
    $.ajax({
        type: 'POST',
        url: '/api/hub-notify',
        data: formData,
        dataType: 'json',
        success: function(res) {
            if (res && res.success) {
                $('#hub-notify-alert').removeClass('alert-danger').addClass('alert alert-success')
                    .html('<i class="fa-solid fa-circle-check"></i> ' + res.message).show();
                $('#hub_notify_name_input').val('');
                $('#hub_notify_phone_input').val('');
                $('#hub_notify_address_input').val('');
                $('#hub_notify_note_input').val('');
                $btn.prop('disabled', false).html('<i class="fa-solid fa-check"></i> <span>Đã gửi thành công</span>');
                setTimeout(function() {
                    var modalEl = document.getElementById('modalBaoChoToi');
                    if (window.bootstrap && bootstrap.Modal) {
                        var modal = bootstrap.Modal.getInstance(modalEl);
                        if (modal) modal.hide();
                    } else {
                        $('#modalBaoChoToi').modal('hide');
                    }
                }, 2500);
            } else {
                $('#hub-notify-alert').removeClass('alert-success').addClass('alert alert-danger')
                    .html('<i class="fa-solid fa-circle-exclamation"></i> ' + (res ? res.message : 'Có lỗi xảy ra, vui lòng thử lại.')).show();
                $btn.prop('disabled', false).html('<i class="fa-solid fa-paper-plane"></i> <span>Gửi thông tin</span>');
            }
        },
        error: function() {
            $('#hub-notify-alert').removeClass('alert-success').addClass('alert alert-danger')
                .html('<i class="fa-solid fa-triangle-exclamation"></i> Không thể kết nối máy chủ. Vui lòng thử lại sau!').show();
            $btn.prop('disabled', false).html('<i class="fa-solid fa-paper-plane"></i> <span>Gửi thông tin</span>');
        }
    });
    return false;
}
</script>
}
