@section Scripts {
	<script>
		// === Gallery Thumbnail ===
		const thumbs = document.querySelectorAll('.pd2-thumb-item');
		let currentThumbIndex = 0;
		let galleryInterval;

		function changeImg(el, src) {
			document.getElementById('mainImg').src = src;
			document.getElementById('modalZoomImg').src = src;
			thumbs.forEach((t, idx) => {
				t.classList.remove('active');
				if (t === el) currentThumbIndex = idx;
			});
			el.classList.add('active');
			// Scroll the thumbnail container to make the active thumb visible without scrolling the window
			const container = document.getElementById('thumbScroll');
			if (container) {
				const scrollLeft = el.offsetLeft - (container.clientWidth / 2) + (el.clientWidth / 2);
				container.scrollTo({
					left: scrollLeft,
					behavior: 'smooth'
				});
			}
		}

		// Auto Slide
		function startAutoSlide() {
			if (thumbs.length <= 1) return;
			galleryInterval = setInterval(() => {
				currentThumbIndex = (currentThumbIndex + 1) % thumbs.length;
				let nextThumb = thumbs[currentThumbIndex];
				changeImg(nextThumb, nextThumb.querySelector('img').src);
			}, 3000);
		}

		function stopAutoSlide() { clearInterval(galleryInterval); }

		if (thumbs.length > 1) {
			startAutoSlide();
			const gallery = document.querySelector('.pd2-gallery');
			if (gallery) {
				gallery.addEventListener('mouseenter', stopAutoSlide);
				gallery.addEventListener('mouseleave', startAutoSlide);
			}
		}

		// Prev/Next buttons
		const navPrev = document.getElementById('thumbPrev');
		const navNext = document.getElementById('thumbNext');
		if (navPrev) navPrev.addEventListener('click', () => {
			currentThumbIndex = (currentThumbIndex - 1 + thumbs.length) % thumbs.length;
			let t = thumbs[currentThumbIndex];
			changeImg(t, t.querySelector('img').src);
		});
		if (navNext) navNext.addEventListener('click', () => {
			currentThumbIndex = (currentThumbIndex + 1) % thumbs.length;
			let t = thumbs[currentThumbIndex];
			changeImg(t, t.querySelector('img').src);
		});

		// === Tab Switching ===
		function switchTab(btn, tabId) {
			document.getElementById('tab-desc').style.display = 'none';
			document.getElementById('tab-spec').style.display = 'none';
			document.getElementById('tab-video').style.display = 'none';
			document.querySelectorAll('.pd2-nav-tabs button').forEach(b => b.classList.remove('active'));
			document.getElementById('tab-' + tabId).style.display = 'block';
			btn.classList.add('active');
		}

		// === Buy Now ===
		function addToCartAndBuy(productId) {
			$.post('/Cart/AddToCart', { productId: productId, quantity: 1 }, function(res) {
				if(res.success) {
					window.location.href = '/gio-hang.html';
				} else {
					Swal.fire('Lỗi', res.message, 'error');
				}
			});
		}

		// Toggle Text Collapse
		function toggleText(el, expandText, collapseText) {
			let isExpanded = el.getAttribute('aria-expanded') === 'true';
			if (isExpanded) {
				setTimeout(() => el.innerHTML = expandText + ' <i class="fa-solid fa-chevron-down"></i>', 300);
			} else {
				setTimeout(() => el.innerHTML = collapseText + ' <i class="fa-solid fa-chevron-up"></i>', 300);
			}
		}
	</script>


	<script>
			const myAffiliatePrefix =
				"https://click.shopee.vn/p/17386520447?url=";

			document.body.addEventListener("click", function (e) {

				const targetLink = e.target.closest("a");

				if (!targetLink) return;

				const href = targetLink.href;

				if (!href) return;

				const isShopee =
					href.includes("shopee.vn") ||
					href.includes("shopee.com");

				const isAlreadyAff =
					href.includes("click.shopee.vn") ||
					href.includes("s.shopee.vn");

				if (isShopee && !isAlreadyAff) {

					e.preventDefault();

					const finalAffLink =
						myAffiliatePrefix +
						encodeURIComponent(href);

					window.open(finalAffLink, "_blank");
				}
			});
	</script>

