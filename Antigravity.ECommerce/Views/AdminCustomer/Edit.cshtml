@model Antigravity.ECommerce.Models.Customer
@{
    ViewData["Title"] = "Chỉnh sửa Khách hàng: " + Model.FullName;
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row">
    <div class="col-12">
        <div class="page-title-box">
            <h4 class="page-title">Sửa Khách hàng: @Model.FullName</h4>
        </div>
    </div>
</div>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="CustomerId" />
    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Họ tên <span class="text-danger">*</span></label>
                            <input type="text" asp-for="FullName" class="form-control" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Số điện thoại <span class="text-danger">*</span></label>
                            <input type="text" asp-for="Phone" class="form-control" required>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Email</label>
                            <input type="email" asp-for="Email" class="form-control">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Giới tính</label>
                            <select class="form-control selectpicker" data-live-search="true" asp-for="Gender">
                                <option value="0">Chưa xác định</option>
                                <option value="1">Nam</option>
                                <option value="2">Nữ</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Ngày sinh</label>
                            <input type="date" asp-for="DateOfBirth" class="form-control" value="@(Model.DateOfBirth?.ToString("yyyy-MM-dd"))">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Trạng thái <i class="mdi mdi-information text-primary" data-bs-toggle="tooltip" title="Khách hàng bị khóa sẽ không thể đăng nhập"></i></label>
                            <select class="form-control selectpicker" data-live-search="true" asp-for="Status">
                                <option value="1">Hoạt động</option>
                                <option value="0">Bị khóa</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Tỉnh / Thành phố</label>
                            <select class="selectpicker" name="ProvinceId" id="ProvinceId" data-live-search="true">
                                <option value="">-- Chọn Tỉnh / Thành phố --</option>
                                @if (ViewBag.Provinces != null)
                                {
                                    foreach (var p in ViewBag.Provinces)
                                    {
                                        <option value="@p.ProvinceId" selected="@(Model.ProvinceId == p.ProvinceId ? "selected" : null)">@p.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Phường / Xã</label>
                            <select class="selectpicker" name="WardId" id="WardId" data-live-search="true">
                                <option value="">-- Chọn Phường / Xã --</option>
                                @if (ViewBag.Wards != null)
                                {
                                    foreach (var w in ViewBag.Wards)
                                    {
                                        <option value="@w.WardId" selected="@(Model.WardId == w.WardId ? "selected" : null)">@w.Name</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Địa chỉ chi tiết (Số nhà, đường...)</label>
                        <input type="text" asp-for="Address" class="form-control" placeholder="VD: 123 Đường ABC">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Ghi chú</label>
                        <textarea asp-for="Note" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="d-flex justify-content-between mt-4 border-top pt-3">
                        <a href="/AdminCustomer" class="btn btn-light"><i class="ri-arrow-go-back-line me-1"></i>Quay lại</a>
                        <button type="submit" class="btn btn-success px-4"><i class="ri-save-line me-1"></i>Lưu thay đổi</button>
                    </div>
                </div>
            </div>
        </div>
    
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header text-center">
                    <div class="d-flex justify-content-center align-items-center mb-2" style="min-height: 120px;">
                        <img id="previewAvatar" src="@(string.IsNullOrEmpty(Model.Avatar) ? "/assets/images/users/avatar-blank.png" : Model.Avatar)" alt="preview" class="img-thumbnail rounded-circle avatar-lg" style="width: 120px; height: 120px; object-fit: cover;" onerror="this.src='/assets/images/users/avatar-blank.png'">
                    </div>
                    <h5 class="mb-0">Hạng: @Model.MemberRankName <i class="mdi mdi-information text-primary fs-6" data-bs-toggle="tooltip" title="Hạng tự động cập nhật dựa vào tổng chi tiêu thiết lập trong Cấu hình hệ thống."></i></h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Đường dẫn ảnh</label>
                        <div class="input-group">
                            <input type="text" asp-for="Avatar" class="form-control" id="avatarPath">
                            <button class="btn btn-primary" type="button" onclick="browseAvatar()">Sửa</button>
                        </div>
                    </div>
                    <hr />
                    <div class="row text-center">
                        <div class="col-6">
                            <p class="text-muted mb-1">Tổng chi tiêu</p>
                            <h4 class="mb-0 text-danger">@Model.TotalSpent.ToString("N0") ₫</h4>
                        </div>
                        <div class="col-6">
                            <p class="text-muted mb-1">Tổng đơn</p>
                            <h4 class="mb-0">@Model.TotalOrders</h4>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    
                    <button type="button" class="btn btn-warning w-100 mb-2" onclick="refreshRank(@Model.CustomerId)">
                        <i class="mdi mdi-refresh"></i> Tính lại hạng thành viên
                    </button>
                    
                </div>
            </div>
        </div>
    </div>

               
            </form>

<!-- Modal File Manager -->
<div class="modal fade" id="fileManagerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Quản lý File</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <iframe id="fileManagerIframe" src="/FileManager/Index?mode=select&fieldId=avatarPath" style="width: 100%; height: 650px; border: none;"></iframe>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var fileModal = new bootstrap.Modal(document.getElementById('fileManagerModal'));

        function browseAvatar() {
            fileModal.show();
        }

        // Lắng nghe sự kiện từ iframe File Manager
        window.addEventListener('message', function(event) {
            if (event.data && event.data.type === 'fileSelected') {
                const url = event.data.url;
                document.getElementById('avatarPath').value = url;
                document.getElementById('previewAvatar').src = url;
                fileModal.hide();
            }
        });

        // Cập nhật preview khi gõ text (có chống rung)
        var previewTimer;
        document.getElementById('avatarPath').addEventListener('input', function() {
            clearTimeout(previewTimer);
            const url = this.value;
            previewTimer = setTimeout(function() {
                const previewImg = document.getElementById('previewAvatar');
                if (url && previewImg.src !== url) {
                    previewImg.src = url;
                } else if (!url) {
                    previewImg.src = '/assets/images/users/avatar-blank.png';
                }
            }, 500);
        });

        function refreshRank(id) {
            $.post('/AdminCustomer/RefreshRank', { id: id }, function(res) {
                if (res.success) {
                    toastr.success("Đã tính lại hạng thành viên");
                    setTimeout(() => location.reload(), 1000);
                } else {
                    toastr.error(res.message);
                }
            });
        }

        $(document).ready(function () {
            $('#ProvinceId').change(function () {
                var provinceId = $(this).val();
                var wardSelect = $('#WardId');
                wardSelect.empty().append('<option value="">-- Đang nạp Phường/Xã... --</option>').selectpicker('refresh');

                if (provinceId) {
                    $.get('/Location/GetPhuongXa', { maTinh: provinceId }, function (data) {
                        wardSelect.empty().append('<option value="">-- Chọn Phường/Xã --</option>');
                        $.each(data, function (i, item) {
                            wardSelect.append('<option value="' + item.ma_Xa + '">' + item.ten_Xa + '</option>');
                        });
                        wardSelect.selectpicker('refresh');
                    });
                } else {
                    wardSelect.empty().append('<option value="">-- Chọn Phường/Xã --</option>').selectpicker('refresh');
                }
            });
        });
    </script>
}
