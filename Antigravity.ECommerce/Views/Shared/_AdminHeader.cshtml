@{
    var _orderStats = Antigravity.ECommerce.Services.SOrder.GetStatusCounts() ?? new Antigravity.ECommerce.Models.OrderCountModel();
    var _dashSummary = Antigravity.ECommerce.Services.SDashboard.GetSummary() ?? new Antigravity.ECommerce.Models.DashboardSummary();
    var _recentOrdersForCart = Antigravity.ECommerce.Services.SDashboard.GetRecentOrders(5) ?? new System.Collections.Generic.List<Antigravity.ECommerce.Models.Order>();
    var _contactStats = Antigravity.ECommerce.Framework.FContact.GetStats() ?? new Antigravity.ECommerce.Framework.ContactStats();
    
    int _newOrderCount = _orderStats.New;
    int _unreadContactCount = _contactStats.UnreadCount;
    int _bellNotiCount = _unreadContactCount; 
}
<header id="page-topbar">
    <div class="layout-width">
        <div class="navbar-header">
            <div class="d-flex">
                <!-- LOGO -->
                <div class="navbar-brand-box horizontal-logo">
                    <a href="/Admin" class="logo logo-dark text-decoration-none">
                        <span class="logo-sm">
                            <h3 class="text-dark mt-4 fw-bold">EA</h3>
                        </span>
                        <span class="logo-lg">
                            <h3 class="text-dark mt-4 fw-bold" style="letter-spacing: 1px;">Elite Admin</h3>
                        </span>
                    </a>

                    <a href="/Admin" class="logo logo-light text-decoration-none">
                        <span class="logo-sm">
                            <h3 class="text-white mt-4 fw-bold">EA</h3>
                        </span>
                        <span class="logo-lg">
                            <h3 class="text-white mt-4 fw-bold" style="letter-spacing: 1px;">Elite Admin</h3>
                        </span>
                    </a>
                </div>

                <button type="button" class="btn btn-sm px-3 fs-16 header-item vertical-menu-btn topnav-hamburger"
                    id="topnav-hamburger-icon">
                    <span class="hamburger-icon">
                        <span></span>
                        <span></span>
                        <span></span>
                    </span>
                </button>

            </div>

            <div class="d-flex align-items-center">



                <div class="dropdown topbar-head-dropdown ms-1 header-item">
                    <button type="button" class="btn btn-icon btn-topbar btn-ghost-secondary rounded-circle"
                        id="page-header-cart-dropdown" data-bs-toggle="dropdown" data-bs-auto-close="outside"
                        aria-haspopup="true" aria-expanded="false">
                        <i class='bx bx-shopping-bag fs-22'></i>
                        @if(_newOrderCount > 0) {
                        <span class="position-absolute topbar-badge cartitem-badge fs-10 translate-middle badge rounded-pill bg-info">@_newOrderCount</span>
                        }
                    </button>
                    <div class="dropdown-menu dropdown-menu-xl dropdown-menu-end p-0 dropdown-menu-cart"
                        aria-labelledby="page-header-cart-dropdown">
                        <div class="p-3 border-top-0 border-start-0 border-end-0 border-dashed border">
                            <div class="row align-items-center">
                                <div class="col">
                                    <h6 class="m-0 fs-16 fw-semibold"> Đơn hàng mới</h6>
                                </div>
                                <div class="col-auto">
                                    <span class="badge badge-soft-warning fs-13"><span class="cartitem-badge">@_newOrderCount</span> chờ xử lý</span>
                                </div>
                            </div>
                        </div>
                        <div data-simplebar style="max-height: 300px;">
                            <div class="p-2">
                                @if(_recentOrdersForCart.Count == 0) {
                                <div class="text-center empty-cart" id="empty-cart">
                                    <div class="avatar-md mx-auto my-3">
                                        <div class="avatar-title bg-soft-info text-info fs-36 rounded-circle">
                                            <i class='bx bx-cart'></i>
                                        </div>
                                    </div>
                                    <h5 class="mb-3">Chưa có đơn hàng nào!</h5>
                                </div>
                                } else {
                                    foreach(var ord in _recentOrdersForCart) {
                                        <div class="d-block dropdown-item dropdown-item-cart text-wrap px-3 py-2">
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-sm me-3">
                                                    <span class="avatar-title bg-soft-success text-success rounded-circle fs-16 p-2">
                                                        <i class="bx bx-shopping-bag"></i>
                                                    </span>
                                                </div>
                                                <div class="flex-1">
                                                    <h6 class="mt-0 mb-1 fs-14">
                                                        <a href="/AdminOrder/Detail?id=@ord.OrderId" class="text-reset">@ord.OrderCode</a>
                                                    </h6>
                                                    <p class="mb-0 fs-12 text-muted">
                                                        Khách: <span>@ord.CustomerName</span>
                                                    </p>
                                                </div>
                                                <div class="px-2">
                                                    <h5 class="m-0 fw-normal"><span class="cart-item-price">@ord.TotalAmount.ToString("N0") đ</span></h5>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                        <div class="p-3 border-bottom-0 border-start-0 border-end-0 border-dashed border"
                            id="checkout-elem">
                            <a href="/AdminOrder" class="btn btn-success text-center w-100">
                                Xem tất cả đơn hàng
                            </a>
                        </div>
                    </div>
                </div>

                <div class="ms-1 header-item d-none d-sm-flex">
                    <a href="/" target="_blank" class="btn btn-icon btn-topbar btn-ghost-primary rounded-circle" data-bs-toggle="tooltip" title="Xem Website">
                        <i class='bx bx-globe fs-22'></i>
                    </a>
                </div>

                <div class="ms-1 header-item d-none d-sm-flex">
                    <button type="button" class="btn btn-icon btn-topbar btn-ghost-secondary rounded-circle"
                        data-toggle="fullscreen">
                        <i class='bx bx-fullscreen fs-22'></i>
                    </button>
                </div>

                <div class="ms-1 header-item d-none d-sm-flex">
                    <button type="button"
                        class="btn btn-icon btn-topbar btn-ghost-secondary rounded-circle light-dark-mode">
                        <i class='bx bx-moon fs-22'></i>
                    </button>
                </div>

                <div class="dropdown topbar-head-dropdown ms-1 header-item">
                    <button type="button" class="btn btn-icon btn-topbar btn-ghost-secondary rounded-circle"
                        id="page-header-notifications-dropdown" data-bs-toggle="dropdown" aria-haspopup="true"
                        aria-expanded="false">
                        <i class='bx bx-bell fs-22'></i>
                        @if(_bellNotiCount > 0) {
                        <span class="position-absolute topbar-badge fs-10 translate-middle badge rounded-pill bg-danger">@_bellNotiCount<span class="visually-hidden">unread messages</span></span>
                        }
                    </button>
                    <div class="dropdown-menu dropdown-menu-lg dropdown-menu-end p-0"
                        aria-labelledby="page-header-notifications-dropdown">

                        <div class="dropdown-head bg-primary bg-pattern rounded-top">
                            <div class="p-3">
                                <div class="row align-items-center">
                                    <div class="col">
                                        <h6 class="m-0 fs-16 fw-semibold text-white"> Tin nhắn liên hệ</h6>
                                    </div>
                                    <div class="col-auto dropdown-tabs">
                                        <span class="badge badge-soft-light fs-13"> @_unreadContactCount Mới</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="tab-content" id="notificationItemsTabContent">
                            <div class="tab-pane fade show active py-2 ps-2" id="all-noti-tab" role="tabpanel">
                                <div data-simplebar style="max-height: 300px;" class="pe-2">
                                    @if(_unreadContactCount > 0) {
                                    <div class="text-reset notification-item d-block dropdown-item position-relative">
                                        <div class="d-flex">
                                            <div class="avatar-xs me-3">
                                                <span class="avatar-title bg-soft-info text-info rounded-circle fs-16">
                                                    <i class="ri-message-3-line"></i>
                                                </span>
                                            </div>
                                            <div class="flex-1">
                                                <a href="/AdminContact" class="stretched-link">
                                                    <h6 class="mt-0 mb-2 lh-base">Có <b>@_unreadContactCount</b> tin nhắn liên hệ mới cần xử lý!</h6>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                    }

                                    @if(_dashSummary.LowStockCount > 0) {
                                    <div class="text-reset notification-item d-block dropdown-item position-relative">
                                        <div class="d-flex">
                                            <div class="avatar-xs me-3">
                                                <span class="avatar-title bg-soft-danger text-danger rounded-circle fs-16">
                                                    <i class='bx bx-error'></i>
                                                </span>
                                            </div>
                                            <div class="flex-1">
                                                <a href="/AdminProduct" class="stretched-link">
                                                    <h6 class="mt-0 mb-2 fs-13 lh-base">Kho hàng: Có <b class="text-danger">@_dashSummary.LowStockCount</b> sản phẩm sắp hết hàng!</h6>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                    }

                                    @if(_unreadContactCount == 0 && _dashSummary.LowStockCount == 0) {
                                    <div class="text-center pb-5 mt-2">
                                        <h6 class="fs-18 fw-semibold lh-base">Không có tin nhắn mới</h6>
                                    </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="dropdown ms-sm-3 header-item topbar-user">
                    <button type="button" class="btn" id="page-header-user-dropdown" data-bs-toggle="dropdown"
                        aria-haspopup="true" aria-expanded="false">
                        <span class="d-flex align-items-center">
                            @{
                                var fullName = User.Claims.FirstOrDefault(c => c.Type == "FullName")?.Value ?? User.Identity?.Name;
                                var roleName = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "Admin";
                                var avatar = User.Claims.FirstOrDefault(c => c.Type == "Avatar")?.Value;
                                if (string.IsNullOrEmpty(avatar)) avatar = "/assets/images/users/avatar-1.jpg";
                            }
                            <img class="rounded-circle header-profile-user" src="@avatar"
                                alt="Header Avatar">
                            <span class="text-start ms-xl-2">
                                <span class="d-none d-xl-inline-block ms-1 fw-bold user-name-text">@fullName</span>
                                <span class="d-none d-xl-block ms-1 fs-12 text-muted user-name-sub-text">@roleName</span>
                            </span>
                        </span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end shadow-lg border-0">
                        <!-- item-->
                        <h6 class="dropdown-header text-muted">Chào, @(User.Identity?.Name)!</h6>
                        <a class="dropdown-item" href="/AdminUser/Edit/@User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier)?.Value">
                            <i class="mdi mdi-account-circle text-muted fs-16 align-middle me-1"></i> 
                            <span class="align-middle">Profile</span>
                        </a>
                        <a class="dropdown-item" href="/AdminContact">
                            <i class="mdi mdi-message-text-outline text-muted fs-16 align-middle me-1"></i> 
                            <span class="align-middle">Messages</span>
                        </a>
                        <a class="dropdown-item" href="/AdminSetting">
                            <i class="mdi mdi-cog-outline text-muted fs-16 align-middle me-1"></i> 
                            <span class="align-middle">Cài đặt hệ thống</span>
                        </a>
                        <div class="dropdown-divider"></div>
                        <a class="dropdown-item text-danger" href="/Admin/Logout">
                            <i class="mdi mdi-logout text-danger fs-16 align-middle me-1"></i> 
                            <span class="align-middle fw-bold">Đăng xuất</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>