@using Antigravity.ECommerce.Services
@{
    var settings = SSetting.GetViewModel();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <partial name="_SeoHeader" />
    <partial name="_SeoSchema" />

    <!-- Preconnect to CDNs -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700;900&display=swap" rel="stylesheet">
    
    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Deferred Icons CSS (kept for some inner views if needed) -->
    <link rel="preload" href="https://cdnjs.cloudflare.com/ajax/libs/MaterialDesign-Webfont/7.2.96/css/materialdesignicons.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/MaterialDesign-Webfont/7.2.96/css/materialdesignicons.min.css" />
    </noscript>

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />

    <style>

        /* 5-column grid for large screens */
        @@media (min-width: 1200px) {
            .col-xl-2-4 { flex: 0 0 auto; width: 20%; }
        }
    </style>
    
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    
    <partial name="_Header" />

    <main role="main">
        @RenderBody()
    </main>

    <partial name="_Footer" />
 
    <!-- Core JS -->
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Standard App Functions -->
    <script>
        $(document).ready(function() {
            // Load initial wishlist state if logged in
            $.get('/Member/GetWishlistIds', function(res) {
                let ids = res;
                if (typeof res === 'string') {
                    try { ids = JSON.parse(res); } catch(e) { return; }
                }
                if (Array.isArray(ids) && ids.length > 0) {
                    ids.forEach(function(id) {
                        $('[onclick="toggleWishlist(' + id + ')"] i')
                            .removeClass('fa-regular')
                            .addClass('fa-solid text-danger');
                    });
                }
            });
        });

        function addToCart(productId, qty = 1) {
            $.post('/Cart/AddToCart', { productId: productId, quantity: qty }, function(res) {
                if(res.success) {
                    $('#cartCount').text(res.count);
                    $('.cart-badge').text(res.count); // For new header
                    Swal.fire({
                        title: 'Đã thêm vào giỏ!',
                        text: 'Sản phẩm đã được thêm vào giỏ hàng thành công.',
                        icon: 'success',
                        timer: 1500,
                        showConfirmButton: false
                    });
                } else {
                    Swal.fire('Lỗi', res.message, 'error');
                }
            });
        }

        function toggleWishlist(productId) {
            $.post('/Member/ToggleWishlist', { productId: productId }, function(res) {
                if(res.success) {
                    let isAdded = res.action === 'added';
                    let msg = isAdded ? 'Đã thêm vào danh sách yêu thích!' : 'Đã xóa khỏi danh sách yêu thích!';
                    let icon = isAdded ? 'success' : 'info';
                    
                    // Update all hearts for this product in the UI
                    $('[onclick="toggleWishlist(' + productId + ')"] i')
                        .removeClass(isAdded ? 'fa-regular' : 'fa-solid text-danger')
                        .addClass(isAdded ? 'fa-solid text-danger' : 'fa-regular');

                    Swal.fire({
                        title: 'Thành công!',
                        text: msg,
                        icon: icon,
                        timer: 1500,
                        showConfirmButton: false
                    });
                } else {
                    Swal.fire({
                        title: 'Thông báo',
                        text: res.message,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonText: 'Đăng nhập',
                        cancelButtonText: 'Đóng'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.href = '/dang-nhap.html';
                        }
                    });
                }
            });
        }
    </script>

    <!-- SEO & Performance Infrastructure (Separate and reusable) -->
    <partial name="_SeoFooter" />
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
