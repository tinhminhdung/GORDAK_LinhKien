@using Antigravity.ECommerce.Services
@{
    var settings = SSetting.GetViewModel();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <partial name="_SeoHeader" />
    <partial name="_SeoSchema" />

    <!-- Preconnect to CDNs -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700;900&display=swap" rel="stylesheet">
    
    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Deferred Icons CSS (kept for some inner views if needed) -->
    <link rel="preload" href="https://cdnjs.cloudflare.com/ajax/libs/MaterialDesign-Webfont/7.2.96/css/materialdesignicons.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/MaterialDesign-Webfont/7.2.96/css/materialdesignicons.min.css" />
    </noscript>

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />

    <style>
        /* Multi-level Menu CSS */
        .dropdown-menu .dropdown-menu { top: 0; left: 100%; margin-top: -1px; }
        .dropdown-item { transition: all 0.2s; padding: 10px 20px; border-radius: 4px; }
        .dropdown-item:hover { background-color: var(--bs-primary); color: #fff; padding-left: 25px; }
        .nav-item.dropdown:hover > .dropdown-menu { display: block; opacity: 1; visibility: visible; transform: translateY(0); }
        .dropdown-menu { 
            display: block; opacity: 0; visibility: hidden; 
            transform: translateY(10px); transition: all 0.3s ease;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1); border: 0 !important;
        }
        .dropdown-menu.show { opacity: 1; visibility: visible; transform: translateY(0); }
        .dropdown-submenu { position: relative; }
        .dropdown-submenu:hover > .dropdown-menu { display: block; opacity: 1; visibility: visible; }
    </style>
    
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    
    <partial name="_Header" />

    <main role="main">
        @RenderBody()
    </main>

    <partial name="_Footer" />
 
    <!-- Core JS -->
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Standard App Functions -->
    <script>
        function addToCart(productId, qty = 1) {
            $.post('/Cart/AddToCart', { productId: productId, quantity: qty }, function(res) {
                if(res.success) {
                    $('#cartCount').text(res.count);
                    $('.cart-badge').text(res.count); // For new header
                    Swal.fire({
                        title: 'Đã thêm vào giỏ!',
                        text: 'Sản phẩm đã được thêm vào giỏ hàng thành công.',
                        icon: 'success',
                        timer: 1500,
                        showConfirmButton: false
                    });
                } else {
                    Swal.fire('Lỗi', res.message, 'error');
                }
            });
        }

        function toggleWishlist(productId) {
            $.post('/Member/ToggleWishlist', { productId: productId }, function(res) {
                if(res.success) {
                    let msg = res.action === 'added' ? 'Đã thêm vào danh sách yêu thích!' : 'Đã xóa khỏi danh sách yêu thích!';
                    let icon = res.action === 'added' ? 'success' : 'info';
                    Swal.fire({
                        title: 'Thành công!',
                        text: msg,
                        icon: icon,
                        timer: 1500,
                        showConfirmButton: false
                    });
                } else {
                    Swal.fire({
                        title: 'Thông báo',
                        text: res.message,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonText: 'Đăng nhập',
                        cancelButtonText: 'Đóng'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.href = '/dang-nhap.html';
                        }
                    });
                }
            });
        }
    </script>

    <!-- SEO & Performance Infrastructure (Separate and reusable) -->
    <partial name="_SeoFooter" />
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
