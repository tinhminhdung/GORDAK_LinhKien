@model Antigravity.ECommerce.Models.Product
@{
    var reviewStats = ViewBag.ReviewStats as Antigravity.ECommerce.Models.ReviewStatsModel ?? new Antigravity.ECommerce.Models.ReviewStatsModel();
    var reviews = ViewBag.Reviews as List<Antigravity.ECommerce.Models.ProductReview> ?? new List<Antigravity.ECommerce.Models.ProductReview>();
}
<!-- Review Stats Summary -->
<div class="row g-4 mb-4">
    <div class="col-md-4 text-center">
        <div class="p-4 bg-light rounded-4">
            <div class="display-4 fw-bold text-warning">@reviewStats.AverageRating.ToString("0.1")</div>
            <div class="text-warning fs-4 mb-1">
                @for(int s=1;s<=5;s++){<i class="ri-star-fill @(s <= Math.Round(reviewStats.AverageRating) ? "" : "opacity-25")"></i>}
            </div>
            <div class="text-muted" style="font-size:0.85rem;">@reviewStats.TotalReviews đánh giá</div>
        </div>
    </div>
    <div class="col-md-8">
        @{ var starCounts = new[]{reviewStats.Star5,reviewStats.Star4,reviewStats.Star3,reviewStats.Star2,reviewStats.Star1}; }
        @for(int i=0;i<5;i++){
            var starNum = 5-i;
            var count = starCounts[i];
            var pct = reviewStats.TotalReviews > 0 ? (count*100/reviewStats.TotalReviews) : 0;
            <div class="d-flex align-items-center mb-1">
                <span class="text-nowrap me-2" style="font-size:0.8rem;min-width:35px;">@starNum <i class="ri-star-fill text-warning"></i></span>
                <div class="progress flex-grow-1" style="height:8px;border-radius:4px;">
                    <div class="progress-bar bg-warning" style="width:@pct%"></div>
                </div>
                <span class="ms-2 text-muted" style="font-size:0.8rem;min-width:25px;">@count</span>
            </div>
        }
    </div>
</div>

<!-- Filter buttons -->
<div class="d-flex flex-wrap gap-2 mb-4">
    <button class="btn btn-sm btn-primary rounded-pill px-3 review-filter active" data-star="">Tất cả</button>
    @for(int s=5;s>=1;s--){
        <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 review-filter" data-star="@s">@s ★</button>
    }
</div>

<!-- Reviews list -->
<div id="reviewsList">
    @if(reviews.Any()){
        @foreach(var rv in reviews){
            var avatarUrl = !string.IsNullOrEmpty(rv.CustomerAvatar) ? rv.CustomerAvatar : $"https://ui-avatars.com/api/?name={System.Net.WebUtility.UrlEncode(rv.CustomerName ?? "User")}&background=random&size=40";
            <div class="d-flex mb-4 pb-3 border-bottom">
                <img src="@avatarUrl" class="rounded-circle me-3 flex-shrink-0" style="width:44px;height:44px;object-fit:cover;">
                <div class="flex-grow-1">
                    <div class="d-flex align-items-center mb-1">
                        <strong style="font-size:0.9rem;">@rv.CustomerName</strong>
                        @if(rv.IsVerifiedPurchase){
                            <span class="badge bg-success-subtle text-success ms-2" style="font-size:0.7rem;"><i class="ri-check-line"></i> Đã mua hàng</span>
                        }
                        <span class="text-muted ms-auto" style="font-size:0.75rem;">@rv.CreatedAt.ToString("dd/MM/yyyy")</span>
                    </div>
                    <div class="text-warning mb-1" style="font-size:0.85rem;">
                        @for(int s=1;s<=5;s++){<i class="ri-star-fill @(s <= rv.Rating ? "" : "opacity-25")"></i>}
                    </div>
                    @if(!string.IsNullOrEmpty(rv.Title)){
                        <div class="fw-semibold mb-1" style="font-size:0.9rem;">@rv.Title</div>
                    }
                    <p class="text-muted mb-1" style="font-size:0.85rem;">@rv.Content</p>
                    @if(!string.IsNullOrEmpty(rv.AdminReply)){
                        <div class="bg-light rounded-3 p-3 mt-2" style="border-left:3px solid #405189;">
                            <div class="fw-semibold mb-1" style="font-size:0.8rem;color:#405189;"><i class="ri-customer-service-2-line me-1"></i> Phản hồi từ shop</div>
                            <p class="mb-0 text-muted" style="font-size:0.83rem;">@rv.AdminReply</p>
                        </div>
                    }
                </div>
            </div>
        }
    } else {
        <div class="text-center py-4 text-muted">
            <i class="ri-chat-smile-3-line display-4 opacity-25"></i>
            <p class="mt-2">Chưa có đánh giá nào</p>
        </div>
    }
</div>

<hr class="my-4">

<!-- Submit review form -->
<div id="reviewFormArea">
    <h6 class="fw-bold mb-3"><i class="ri-edit-2-line me-1"></i> Viết đánh giá của bạn</h6>
    <div class="mb-3">
        <label class="form-label" style="font-size:0.85rem;">Chọn số sao <span class="text-danger">*</span></label>
        <div id="starPicker" class="d-flex gap-1 fs-4" style="cursor:pointer;">
            @for(int s=1;s<=5;s++){
                <i class="ri-star-line text-warning star-pick" data-value="@s"></i>
            }
        </div>
        <input type="hidden" id="reviewRating" value="0">
    </div>
    <div class="mb-3">
        <label class="form-label" style="font-size:0.85rem;">Tiêu đề (không bắt buộc)</label>
        <input type="text" id="reviewTitle" class="form-control" placeholder="Ví dụ: Sản phẩm rất tốt" style="font-size:0.9rem;">
    </div>
    <div class="mb-3">
        <label class="form-label" style="font-size:0.85rem;">Nội dung đánh giá <span class="text-danger">*</span></label>
        <textarea id="reviewContent" class="form-control" rows="3" placeholder="Chia sẻ trải nghiệm của bạn..." style="font-size:0.9rem;"></textarea>
    </div>
    <button class="btn btn-primary rounded-pill px-4" style="font-size:0.9rem;" onclick="submitReview(@Model.ProductId)">
        <i class="ri-send-plane-line me-1"></i> Gửi đánh giá
    </button>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        // Star picker interaction
        document.querySelectorAll('.star-pick').forEach(function(star) {
            star.addEventListener('click', function() {
                var val = parseInt(this.dataset.value);
                document.getElementById('reviewRating').value = val;
                document.querySelectorAll('.star-pick').forEach(function(s, idx) {
                    s.className = (idx < val) ? 'ri-star-fill text-warning star-pick' : 'ri-star-line text-warning star-pick';
                });
            });
            star.addEventListener('mouseenter', function() {
                var val = parseInt(this.dataset.value);
                document.querySelectorAll('.star-pick').forEach(function(s, idx) {
                    s.className = (idx < val) ? 'ri-star-fill text-warning star-pick' : 'ri-star-line text-warning star-pick';
                });
            });
        });
        document.getElementById('starPicker')?.addEventListener('mouseleave', function() {
            var val = parseInt(document.getElementById('reviewRating').value);
            document.querySelectorAll('.star-pick').forEach(function(s, idx) {
                s.className = (idx < val) ? 'ri-star-fill text-warning star-pick' : 'ri-star-line text-warning star-pick';
            });
        });

        // Filter reviews by star
        $('.review-filter').on('click', function() {
            $('.review-filter').removeClass('active btn-primary').addClass('btn-outline-secondary');
            $(this).removeClass('btn-outline-secondary').addClass('active btn-primary');
            var star = $(this).data('star');
            var productId = @Model.ProductId;
            $.get('/Product/GetReviews', { productId: productId, rating: star || null }, function(res) {
                var html = '';
                if (res.reviews && res.reviews.length > 0) {
                    res.reviews.forEach(function(rv) {
                        var avatar = rv.customerAvatar || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(rv.customerName || 'User') + '&background=random&size=40');
                        var stars = '';
                        for(var i=1;i<=5;i++) stars += '<i class="ri-star-fill ' + (i<=rv.rating?'':'opacity-25') + '"></i>';
                        var verified = rv.isVerifiedPurchase ? '<span class="badge bg-success-subtle text-success ms-2" style="font-size:0.7rem;"><i class="ri-check-line"></i> Đã mua hàng</span>' : '';
                        var adminReply = rv.adminReply ? '<div class="bg-light rounded-3 p-3 mt-2" style="border-left:3px solid #405189;"><div class="fw-semibold mb-1" style="font-size:0.8rem;color:#405189;"><i class="ri-customer-service-2-line me-1"></i> Phản hồi từ shop</div><p class="mb-0 text-muted" style="font-size:0.83rem;">' + rv.adminReply + '</p></div>' : '';
                        var titleHtml = rv.title ? '<div class="fw-semibold mb-1" style="font-size:0.9rem;">' + rv.title + '</div>' : '';
                        html += '<div class="d-flex mb-4 pb-3 border-bottom"><img src="' + avatar + '" class="rounded-circle me-3 flex-shrink-0" style="width:44px;height:44px;object-fit:cover;"><div class="flex-grow-1"><div class="d-flex align-items-center mb-1"><strong style="font-size:0.9rem;">' + (rv.customerName||'') + '</strong>' + verified + '<span class="text-muted ms-auto" style="font-size:0.75rem;">' + new Date(rv.createdAt).toLocaleDateString('vi-VN') + '</span></div><div class="text-warning mb-1" style="font-size:0.85rem;">' + stars + '</div>' + titleHtml + '<p class="text-muted mb-1" style="font-size:0.85rem;">' + (rv.content||'') + '</p>' + adminReply + '</div></div>';
                    });
                } else {
                    html = '<div class="text-center py-4 text-muted"><i class="ri-chat-smile-3-line display-4 opacity-25"></i><p class="mt-2">Không có đánh giá nào</p></div>';
                }
                $('#reviewsList').html(html);
            });
        });
    });

    function submitReview(productId) {
        var rating = parseInt($('#reviewRating').val());
        var title = $('#reviewTitle').val();
        var content = $('#reviewContent').val();

        if (rating < 1) {
            Swal.fire('Chú ý', 'Vui lòng chọn số sao', 'warning');
            return;
        }
        if (!content || content.trim().length < 5) {
            Swal.fire('Chú ý', 'Vui lòng nhập nội dung đánh giá (ít nhất 5 ký tự)', 'warning');
            return;
        }

        $.post('/Product/SubmitReview', { productId: productId, rating: rating, title: title, content: content }, function(res) {
            if (res.success) {
                Swal.fire({ icon: 'success', title: 'Thành công!', text: res.message, timer: 2000, showConfirmButton: false }).then(function() {
                    location.reload();
                });
            } else {
                Swal.fire('Thông báo', res.message, 'warning');
            }
        });
    }
</script>
