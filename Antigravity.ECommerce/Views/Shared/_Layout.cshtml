@{
    var settingsView = Antigravity.ECommerce.Services.SSetting.GetViewModel();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <partial name="_SeoHeader" />
    <partial name="_SeoSchema" />
    
    <!-- Link CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/MaterialDesign-Webfont/7.2.96/css/materialdesignicons.min.css" />
    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
    
    <style>

        .nav-link { font-weight: 500; font-size: 15px; color: #333 !important; }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    
    @await Html.PartialAsync("_Header")

    <div class="container py-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    @await Html.PartialAsync("_Footer")

    <!-- Core JS -->
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script>
        function addToCart(productId, qty = 1) {
            $.post('/Cart/AddToCart', { productId: productId, quantity: qty }, function(res) {
                if(res.success) {
                    $('#cartCount').text(res.count);
                    Swal.fire({ title: 'Thành công', icon: 'success', timer: 1500, showConfirmButton: false });
                }
            });
        }
    </script>

    <partial name="_SeoFooter" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
