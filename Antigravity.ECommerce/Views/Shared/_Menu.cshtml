@using Antigravity.ECommerce.Models
@model List<Category>

<ul class="navbar-nav me-auto mb-0 mx-auto justify-content-center flex-column flex-lg-row gap-2 gap-lg-5">
    @if (Model != null)
    {
        @foreach (var item in Model)
        {
            @await Html.PartialAsync("_MenuItem", item)
        }
    }
</ul>
