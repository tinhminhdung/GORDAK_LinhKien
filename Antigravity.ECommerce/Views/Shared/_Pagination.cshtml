@using Microsoft.AspNetCore.Routing
@model object
@{
    var dict = new RouteValueDictionary(Model);
    int pageIndex = dict.ContainsKey("PageIndex") ? Convert.ToInt32(dict["PageIndex"]) : 1;
    int totalPages = dict.ContainsKey("TotalPages") ? Convert.ToInt32(dict["TotalPages"]) : 1;
    string jsFunction = dict.ContainsKey("JsFunction") ? dict["JsFunction"].ToString() : "changePage";
}

@if (totalPages > 1)
{
    <div class="d-flex justify-content-center mt-3">
        <nav aria-label="Page navigation example">
            <ul class="pagination pagination-separated justify-content-center mb-0">
                @if (pageIndex > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="javascript:void(0);" onclick="@(jsFunction + "(" + (pageIndex - 1) + ")")">Trước</a>
                    </li>
                }

                @{
                    int range = 2; // Number of pages around current page
                    
                    // Always show 1
                    <li class="page-item @(pageIndex == 1 ? "active" : "")">
                        <a class="page-link" href="javascript:void(0);" onclick="@(jsFunction + "(1)")">1</a>
                    </li>

                    if (pageIndex - range > 2)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }

                    for (int i = Math.Max(2, pageIndex - range); i <= Math.Min(totalPages - 1, pageIndex + range); i++)
                    {
                        <li class="page-item @(i == pageIndex ? "active" : "")">
                            <a class="page-link" href="javascript:void(0);" onclick="@(jsFunction + "(" + i + ")")">@i</a>
                        </li>
                    }

                    if (pageIndex + range < totalPages - 1)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }

                    // Always show last if > 1
                    if (totalPages > 1)
                    {
                        <li class="page-item @(pageIndex == totalPages ? "active" : "")">
                            <a class="page-link" href="javascript:void(0);" onclick="@(jsFunction + "(" + totalPages + ")")">@totalPages</a>
                        </li>
                    }
                }

                @if (pageIndex < totalPages)
                {
                    <li class="page-item">
                        <a class="page-link" href="javascript:void(0);" onclick="@(jsFunction + "(" + (pageIndex + 1) + ")")">Tiếp</a>
                    </li>
                }
            </ul>
        </nav>
    </div>
}
