@model string
@{
    var message = Model ?? "Không tìm thấy dữ liệu phù hợp.";
}
<div class="col-12 text-center py-5">
    <i class="fa-solid fa-box-open fa-3x text-muted mb-3"></i>
    <p class="fs-5 text-muted">@message</p>
    <a href="/" class="btn btn-outline-primary mt-2">Quay lại Trang chủ</a>
</div>
