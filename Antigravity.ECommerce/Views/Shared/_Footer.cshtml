@using Antigravity.ECommerce.Services
@using Antigravity.ECommerce.Models
@{
    var settings = SSetting.GetViewModel();
    var footerGroups = SCategory.GetMenuTree("Footer");

    // Helper: tạo URL đúng cho mọi loại menu item
    Func<Category, string> GetMenuUrl = (item) => {
        if (!string.IsNullOrEmpty(item.Url)) return item.Url;
        if (!string.IsNullOrEmpty(item.Slug)) {
            return item.CategoryType switch {
                1 => "/san-pham/" + item.Slug + ".html",
                2 => "/tin-tuc/" + item.Slug + ".html",
                4 => "/bai-viet/" + item.Slug + ".html",
                _ => "/" + item.Slug
            };
        }
        return "#";
    };
}

<!-- ======== COMMITMENT BAR ======== -->
<div class="commitment-bar">
    <div class="container flex-footer-between">
        <div class="commitment-text">
            <i class="fas fa-shield-alt"></i>
            <div>
                <strong>CAM KẾT MANG ĐẾN SẢN PHẨM CHÍNH HÃNG, CHẤT LƯỢNG</strong>
                <p>Đồng hành cùng bạn trong mọi công việc</p>
            </div>
        </div>
        <div class="commitment-actions">
            <a href="/lien-he.html" class="btn-cb-quote">NHẬN BÁO GIÁ NGAY</a>
            <a href="tel:@settings.Hotline" class="btn-cb-call"><i class="fas fa-phone-alt"></i> GỌI TƯ VẤN: @settings.Hotline</a>
        </div>
    </div>
</div>

<!-- ======== MAIN FOOTER ======== -->
<footer class="main-footer">
    <div class="container footer-grid">

        <!-- Cột 1: Logo & Social (cố định từ cấu hình) -->
        <div class="footer-col">
            <div class="footer-col-desc">
                @Html.Raw(!string.IsNullOrEmpty(settings.FooterInfo) ? settings.FooterInfo : settings.SiteDescription)
            </div>
            <div class="footer-social">
                @if (!string.IsNullOrEmpty(settings.Facebook)) {
                    <a href="@settings.Facebook" target="_blank" class="fsoc-fb"><i class="fab fa-facebook-f"></i></a>
                }
                @if (!string.IsNullOrEmpty(settings.YouTube)) {
                    <a href="@settings.YouTube" target="_blank" class="fsoc-yt"><i class="fab fa-youtube"></i></a>
                }
                @if (!string.IsNullOrEmpty(settings.Zalo)) {
                    <a href="https://zalo.me/@settings.Zalo" target="_blank" class="fsoc-zl"><i class="fas fa-comment-dots"></i></a>
                }
            </div>
        </div>

        <!-- Cột 2..N: Dynamic từ AdminMenu (position: Footer) -->
        <!-- Mỗi item cha = 1 cột | Mỗi item con = 1 link trong cột đó -->
        @foreach (var group in footerGroups) {
            <div class="footer-col">
                <h4>@group.Name</h4>
                @if (group.Children != null && group.Children.Any()) {
                    <ul>
                        @foreach (var item in group.Children) {
                            <li><a href="@GetMenuUrl(item)" target="@(item.Target ?? "_self")">@item.Name</a></li>
                        }
                    </ul>
                }
            </div>
        }

        <!-- Cột cuối: Thông tin liên hệ (cố định từ cấu hình) -->
        <div class="footer-col">
            @if (!string.IsNullOrEmpty(settings.FooterContactInfo)) {
                @Html.Raw(settings.FooterContactInfo)
            } else {
                <h4>@settings.SiteTitle</h4>
                <div class="footer-contact-info-custom mt-3">
                    <ul class="footer-contact-info">
                        @if (!string.IsNullOrEmpty(settings.Address)) {
                            <li><i class="fas fa-map-marker-alt"></i> @settings.Address</li>
                        }
                        @if (!string.IsNullOrEmpty(settings.Hotline)) {
                            <li><i class="fas fa-phone-alt"></i> <a href="tel:@settings.Hotline">@settings.Hotline</a></li>
                        }
                        @if (!string.IsNullOrEmpty(settings.Email)) {
                            <li><i class="fas fa-envelope"></i> <a href="mailto:@settings.Email">@settings.Email</a></li>
                        }
                        <li><i class="fas fa-globe"></i> @Context.Request.Host.Value</li>
                    </ul>
                </div>
            }
        </div>

    </div>

    <div class="footer-bottom-bar">
        <div class="container">
            @settings.Copyright
        </div>
    </div>
</footer>

<!-- ======== MOBILE BOTTOM NAV ======== -->
<nav class="mobile-bottom-nav d-lg-none">
    <a href="/" class="mnav-item @(Context.Request.Path == "/" ? "active" : "")"><i class="fa-solid fa-house"></i><span>Trang chủ</span></a>
    <a href="/san-pham.html" class="mnav-item"><i class="fa-solid fa-box"></i><span>Sản phẩm</span></a>
    <a href="/gio-hang.html" class="mnav-item position-relative">
        <i class="fa-solid fa-cart-shopping"></i><span class="mnav-badge cart-badge">0</span><span>Giỏ hàng</span>
    </a>
    <a href="/lien-he.html" class="mnav-item"><i class="fa-solid fa-address-book"></i><span>Liên hệ</span></a>
</nav>

<!-- ======== FLOATING CHAT ======== -->
@if (!string.IsNullOrEmpty(settings.Zalo)) {
    <a href="https://zalo.me/@settings.Zalo" target="_blank" class="chat-float d-none d-lg-flex text-decoration-none">
        <img src="/assets/images/zalo_logo.png" alt="Zalo" width="24" height="24" style="border-radius: 5px;">
        <span class="text-dark">Chat Zalo</span>
    </a>
}
