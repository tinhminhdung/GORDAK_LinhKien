	<!-- Initialize System-wide Tooltips & Selectpicker -->
	<script>
		$(function () {
			// Enable tooltips globally
			var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
			var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
			  return new bootstrap.Tooltip(tooltipTriggerEl)
			});

			// Initialize bootstrap-select for all selects to ensure consistency
			// Destroy any auto-initialized instances first to prevent duplicate UI elements
			$('select:not(.no-selectpicker)').each(function() {
				var $el = $(this);
				if ($el.parent().hasClass('bootstrap-select')) {
					$el.selectpicker('destroy');
				}
				// Check for size classes
				var isSmall = $el.hasClass('form-select-sm') || $el.hasClass('form-control-sm');
				var isLarge = $el.hasClass('form-select-lg') || $el.hasClass('form-control-lg');
				
				// Remove form-select classes from the original element to avoid bootstrap-select copying them
				$el.removeClass('form-select form-select-sm form-select-lg form-control-sm form-control-lg');
				
				var btnStyle = 'btn-outline-secondary bg-white text-dark custom-selectpicker';
				if (isSmall) btnStyle += ' btn-sm';
				if (isLarge) btnStyle += ' btn-lg';

				// Apply custom class to style it identically to native form-select
				$el.selectpicker({
					container: 'body',
					style: btnStyle,
					size: 10,
					width: '100%'
				});
			});
		});
	</script>

