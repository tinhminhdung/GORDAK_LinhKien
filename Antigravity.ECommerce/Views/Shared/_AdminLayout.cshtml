	<style>
		:root {
			--vz-card-box-shadow: 0 1px 2px rgba(56, 65, 74, 0.15);
		}

		body {
			background-color: #f3f3f9;
			font-family: 'Inter', sans-serif !important;
		}
		
		h1, h2, h3, h4, h5, h6, .navbar-brand-box {
			font-family: 'Inter', sans-serif !important;
		}

		.card {
			border: none;
			box-shadow: var(--vz-card-box-shadow);
			border-radius: 10px;
			transition: transform 0.2s ease, box-shadow 0.2s ease;
		}

		.table thead th {
			background-color: #f8f9fa;
			text-transform: uppercase;
			font-size: 11px;
			font-weight: 700;
			letter-spacing: 0.5px;
			color: #878a99;
		}

		/* ACTIVE MENU HIGHLIGHT */
		.navbar-menu .nav-link.active {
			background: rgba(var(--vz-primary-rgb), 0.1) !important;
			color: var(--vz-primary) !important;
			border-right: 3px solid var(--vz-primary);
			font-weight: 600;
		}
		
		#scrollbar .nav-sm .nav-link.active {
			background: transparent !important;
			border-right: none;
			position: relative;
		}
		
		#scrollbar .nav-sm .nav-link.active::before {
			content: '';
			position: absolute;
			left: -12px;
			top: 50%;
			transform: translateY(-50%);
			width: 6px;
			height: 6px;
			background-color: var(--vz-primary);
			border-radius: 50%;
		}

		.btn {
			border-radius: 6px;
			font-weight: 500;
		}

		.badge {
			padding: 0.5em 0.8em;
			font-weight: 600;
			border-radius: 4px;
		}

		.page-title {
			font-weight: 700;
			color: #495057;
		}

		.avatar-title {
			font-weight: 600;
		}

		/* Fix bootstrap-select appearance to perfectly match native form-select */
		.bootstrap-select > .dropdown-toggle::after {
			display: none !important; /* Hide the default solid triangle caret */
		}
		.bootstrap-select > .dropdown-toggle.custom-selectpicker {
			background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%23343a40' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M2 5l6 6 6-6'/%3e%3c/svg%3e") !important;
			background-repeat: no-repeat !important;
			background-position: right 0.85rem center !important;
			background-size: 16px 12px !important;
			padding-right: 2.25rem !important;
			border: 1px solid #ced4da !important;
			border-radius: 0.25rem !important;
			box-shadow: none !important;
		}
		.bootstrap-select > .dropdown-toggle.custom-selectpicker:focus,
		.bootstrap-select > .dropdown-toggle.custom-selectpicker:active {
			border-color: #405189 !important;
			box-shadow: 0 0 0 0.2rem rgba(64, 81, 137, 0.1) !important;
			background-color: #fff !important;
		}
		.bootstrap-select .dropdown-toggle .filter-option {
			display: flex;
			align-items: center;
			padding-left: 0;
		}
		.bootstrap-select .dropdown-menu {
			border-radius: 0.4rem;
			box-shadow: 0 5px 15px rgba(0,0,0,0.1);
			border: 1px solid #e9ebec;
			padding: 0.5rem;
		}
		.bootstrap-select .dropdown-menu li a {
			border-radius: 0.3rem;
			margin: 2px 0;
			padding: 0.5rem 0.8rem;
		}
		.bootstrap-select .dropdown-menu li a:hover {
			background-color: #f3f6f9;
		}

		/* Sprint 6: Sidebar Dark - Highlight active menu item */
		/* Bỏ style aria-expanded vì click vào đâu nó cũng sáng gây loạn */
		[data-sidebar="dark"] .navbar-menu .navbar-nav .nav-link.active {
			background-color: rgba(255, 255, 255, 0.1) !important;
			color: #fff !important;
			border-left: 3px solid #0ab39c !important;
			font-weight: 600 !important;
		}

		[data-sidebar="dark"] .navbar-menu .navbar-nav .nav-link.active i {
			color: #0ab39c !important;
		}
		
		/* Khắc phục lỗi gãy layout border-left ở menu cấp 2 */
		[data-sidebar="dark"] .navbar-menu .navbar-nav .menu-dropdown .nav-link.active {
		    border-left: none !important;
		    background-color: transparent !important;
		    color: #45cb85 !important; /* Màu xanh lá nổi hơn */
		}
		[data-sidebar="dark"] .navbar-menu .navbar-nav .menu-dropdown .nav-link.active::before {
		    color: #45cb85 !important;
		}
		.cursor-pointer { cursor: pointer; }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

	<!-- Begin page -->
	<div id="layout-wrapper">

		@await Html.PartialAsync("_AdminHeader")

		@await Html.PartialAsync("_AdminMenu")

		<!-- Vertical Overlay-->
		<div class="vertical-overlay"></div>

		<!-- ============================================================== -->
		<!-- Start right Content here -->
		<!-- ============================================================== -->
		<div class="main-content">

			<div class="page-content">
				<div class="container-fluid">
					@RenderBody()
				</div>
			</div>
			<!-- End Page-content -->
			@await Html.PartialAsync("_AdminFooter")

		</div>
		<!-- end main content-->

	</div>
	<!-- END layout-wrapper -->
