	<script src="/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        $(document).ready(function () {
            $("#btn-save-theme").click(function () {
                var btn = $(this);
                btn.prop('disabled', true).html('<i class="bx bx-loader bx-spin font-size-16 align-middle me-2"></i> Đang lưu...');
                
                var payload = {
                    layout: $("input[name='data-layout']:checked").val(),
                    scheme: $("input[name='data-layout-mode']:checked").val(),
                    sidebar: $("input[name='data-sidebar']:checked").val(),
                    sidebarSize: $("input[name='data-sidebar-size']:checked").val(),
                    topbar: $("input[name='data-topbar']:checked").val()
                };

                $.post("/Admin/SaveTheme", payload, function (res) {
                    btn.prop('disabled', false).html('<i class="ri-save-line align-middle me-1"></i> Lưu cấu hình');
                    if (res.success) {
                        if (typeof Swal !== 'undefined') {
                            Swal.fire({ title: "Thành công", text: res.message, icon: "success", timer: 2000, showConfirmButton: false });
                        } else {
                            alert(res.message);
                        }
                    } else {
                        if (typeof Swal !== 'undefined') {
                            Swal.fire("Lỗi!", res.message, "error");
                        } else {
                            alert(res.message);
                        }
                    }
                }).fail(function () {
                    btn.prop('disabled', false).html('<i class="ri-save-line align-middle me-1"></i> Lưu cấu hình');
                    alert("Lỗi kết nối máy chủ!");
                });
            });

            // Poll for background email errors
            setInterval(function() {
                $.get('/Admin/GetEmailErrors', function(errors) {
                    if (errors && errors.length > 0) {
                        errors.forEach(function(err) {
                            if (typeof Toastify !== 'undefined') {
                                Toastify({
                                    text: err,
                                    duration: 10000,
                                    gravity: "top",
                                    position: "right",
                                    backgroundColor: "#f06548",
                                    close: true
                                }).showToast();
                            } else {
                                console.error(err);
                            }
                        });
                    }
                }).fail(function() { /* Ignore polling errors */ });
            }, 10000);
        });
    </script>
