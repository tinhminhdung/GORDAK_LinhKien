@model Antigravity.ECommerce.Models.Category
@{
    ViewData["Title"] = "Chỉnh sửa Danh mục";
    Layout = "_AdminLayout";
}

<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0">Chỉnh sửa Danh mục</h4>
            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="/AdminCategory" class="btn btn-soft-dark btn-sm"><i class="ri-arrow-left-line align-bottom me-1"></i> Quay lại danh sách</a></li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <form action="/AdminCategory/Edit" method="post" id="categoryForm">
                    <input type="hidden" asp-for="CategoryId" />
                    <div class="mb-3">
                        <label class="form-label">Tên danh mục <span class="text-danger">*</span> <i class="mdi mdi-information text-primary" data-bs-toggle="tooltip" title="Tên nhóm sản phẩm hiển thị trên Menu. VD: Áo thun nam"></i></label>
                        <input type="text" class="form-control" asp-for="Name" id="Name" placeholder="Nhập tên danh mục">
                        <span asp-validation-for="Name" class="text-danger mt-1 d-block"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Tùy chỉnh Slug (URL) <i class="mdi mdi-information text-primary" data-bs-toggle="tooltip" title="Đường dẫn url tĩnh, hệ thống sẽ tự sinh nếu để trống"></i></label>
                            <input type="text" class="form-control" asp-for="Slug" id="Slug">
                            <span asp-validation-for="Slug" class="text-danger mt-1 d-block"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Danh mục cha <i class="mdi mdi-information text-primary" data-bs-toggle="tooltip" title="Nếu chọn, đây sẽ là danh mục con (Sub-category). Để Gốc nếu là danh mục lớn."></i></label>
                            <select class="form-control selectpicker" data-live-search="true" asp-for="ParentId">
                                <option value="0">--- Là danh mục gốc ---</option>
                                @if(ViewBag.Categories != null)
                                {
                                    foreach(var item in ViewBag.Categories as List<Antigravity.ECommerce.Models.Category>)
                                    {
                                        if (item.CategoryId != Model.CategoryId) {
                                            <option value="@item.CategoryId">@item.Name</option>
                                        }
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <input type="hidden" asp-for="CategoryType" />
                    <input type="hidden" asp-for="LinkType" />
                    <input type="hidden" asp-for="Url" />
                    <input type="hidden" asp-for="Target" />

                    <div class="mb-3">
                        <label class="form-label">Mô tả ngắn</label>
                        <textarea class="form-control" id="Description" asp-for="Description" rows="3" placeholder="Nhập mô tả ngắn gọn về danh mục..."></textarea>
                    </div>

                    <div class="mb-3" id="divContent">
                        <label class="form-label">Nội dung chi tiết</label>
                        <textarea id="ckeditor-classic" asp-for="Content"></textarea>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Thứ tự hiển thị <i class="mdi mdi-information text-primary" data-bs-toggle="tooltip" title="Số càng nhỏ càng lên trên cùng"></i></label>
                            <input type="number" class="form-control" asp-for="SortOrder">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Trạng thái</label>
                            <select class="form-control selectpicker" data-live-search="true" asp-for="Status">
                                <option value="1">Hiển thị</option>
                                <option value="0">Ẩn</option>
                            </select>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        
                        
                    </div>
                
                <div class="d-flex justify-content-between mt-4 border-top pt-3">
                    <a href="/AdminCategory" class="btn btn-light"><i class="ri-arrow-go-back-line me-1"></i>Quay lại</a>
                    <button type="submit" class="btn btn-success px-4"><i class="ri-save-line me-1"></i>Lưu thay đổi</button>
                </div>
            </form>
            </div>
        </div>

        <div class="card mt-3" id="divSeoCard">
            <div class="card-header"><h5 class="card-title mb-0">Tối ưu SEO cho trang nội dung</h5></div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Tiêu đề SEO</label>
                    <input type="text" class="form-control" id="SeoTitle" form="categoryForm" asp-for="SeoTitle">
                </div>
                <div class="mb-3">
                    <label class="form-label">Mô tả SEO</label>
                    <textarea class="form-control" id="SeoDescription" form="categoryForm" asp-for="SeoDescription" rows="3"></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label">Từ khóa SEO</label>
                    <input type="text" class="form-control" form="categoryForm" asp-for="SeoKeywords">
                </div>
                <div class="bg-light p-3 rounded mt-3">
                    <h6 class="fs-13 text-muted mb-2 text-uppercase">Google Search Preview</h6>
                    <div style="font-family: Arial, sans-serif;">
                        <div class="text-primary fs-18 mb-1" id="seo_preview_title">@Model.SeoTitle</div>
                        <div class="text-success fs-13 mb-1">https://example.com/p/<span id="seo_preview_slug">@Model.Slug</span>.html</div>
                        <div class="text-muted fs-13" id="seo_preview_desc" style="line-height:1.4;">@Model.SeoDescription</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header"><h5 class="card-title mb-0">Hình ảnh danh mục</h5></div>
            <div class="card-body">
                <div class="input-group mb-3">
                    <input type="text" class="form-control" asp-for="Image" id="Image" form="categoryForm">
                    <button class="btn btn-primary" type="button" onclick="openFileManager('Image')">Chọn ảnh</button>
                </div>
                <img id="imgPreview" src="@Model.Image" style="max-width: 100%; @(string.IsNullOrEmpty(Model.Image) ? "display: none;" : "") border-radius: 4px;" />
                <div class="mt-3">
                    <label class="form-label">Mô tả ảnh (SEO Alt)</label>
                    <input type="text" class="form-control" asp-for="ImageAlt" form="categoryForm">
                </div>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header"><h5 class="card-title mb-0">Banner danh mục</h5></div>
            <div class="card-body">
                <div class="input-group mb-3">
                    <input type="text" class="form-control" asp-for="Banner" id="Banner" form="categoryForm">
                    <button class="btn btn-info" type="button" onclick="openFileManager('Banner')">Chọn Banner</button>
                </div>
                <img id="bannerPreview" src="@Model.Banner" style="max-width: 100%; @(string.IsNullOrEmpty(Model.Banner) ? "display: none;" : "") border-radius: 4px; max-height: 150px; object-fit: cover;" />
            </div>
        </div>

                <input type="hidden" asp-for="MenuPosition" />

        <div class="card mt-3">
            <div class="card-header"><h5 class="card-title mb-0">Biểu tượng (Icon)</h5></div>
            <div class="card-body">
                <div class="input-group mb-2">
                    <span class="input-group-text"><i class="ri-remixicon-line"></i></span>
                    <input type="text" class="form-control" asp-for="Icon" form="categoryForm">
                    <button class="btn btn-primary" type="button" onclick="openFileManager('Icon')">Chọn ảnh</button>
                </div>
                <p class="text-muted fs-12">Mã icon hoặc ảnh.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function initEditor(id, height = 300) {
            if (!document.getElementById(id)) return;
            CKEDITOR.replace(id, {
                language: 'vi',
                height: height,
                filebrowserBrowseUrl: '/FileManager',
                filebrowserImageBrowseUrl: '/FileManager'
            });
        }

        document.addEventListener("DOMContentLoaded", function() {
            initEditor('ckeditor-classic', 400);
        });

        function openFileManager(fieldId) {
            window.open('/FileManager?fieldId=' + fieldId, 'FileManager', 'width=1100,height=750');
        }

        function setFileUrl(url, fieldId) {
            const fileUrl = Array.isArray(url) ? url[0] : url;
            if (CKEDITOR.instances[fieldId]) {
                const content = `<img src="${fileUrl}" />`;
                CKEDITOR.instances[fieldId].insertHtml(content);
            } else {
                const input = document.getElementById(fieldId);
                if (input) {
                    input.value = fileUrl;
                    if (fieldId === 'Image') {
                        const preview = document.getElementById('imgPreview');
                        if (preview) { preview.src = fileUrl; preview.style.display = 'block'; }
                    } else if (fieldId === 'Banner') {
                        const preview = document.getElementById('bannerPreview');
                        if (preview) { preview.src = fileUrl; preview.style.display = 'block'; }
                    }
                }
            }
            window.isDirty = true;
        }

        window.isDirty = false;
        document.getElementById('categoryForm').addEventListener('change', () => window.isDirty = true);
        window.addEventListener('beforeunload', function (e) {
            if (window.isDirty) {
                e.preventDefault();
                e.returnValue = '';
            }
        });
        document.getElementById('categoryForm').addEventListener('submit', () => window.isDirty = false);

        document.getElementById('Name').addEventListener('input', function() {
            var slug = this.value.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[đĐ]/g, 'd').replace(/([^a-z0-9\s])/g, '').replace(/\s+/g, '-').replace(/-+/g, '-').replace(/^-+|-+$/g, '');
            document.getElementById('Slug').value = slug;
            updateSeoPreview();
        });

        function updateSeoPreview() {
            const title = document.getElementById('SeoTitle').value || document.getElementById('Name').value || 'Tiêu đề danh mục';
            let desc = document.getElementById('SeoDescription').value;
            if(!desc) {
                desc = document.getElementById('Description').value || 'Mô tả ngắn gọn về danh mục sẽ hiển thị tại đây để thu hút khách hàng click vào trang web của bạn.';
            }
            const slug = document.getElementById('Slug').value || 'slug-danh-muc';
            
            document.getElementById('seo_preview_title').innerText = title;
            document.getElementById('seo_preview_desc').innerText = desc;
            document.getElementById('seo_preview_slug').innerText = slug;
        }

        document.getElementById('SeoTitle').addEventListener('input', updateSeoPreview);
        document.getElementById('SeoDescription').addEventListener('input', updateSeoPreview);
        document.getElementById('Description').addEventListener('input', updateSeoPreview);
        document.getElementById('Slug').addEventListener('input', updateSeoPreview);
        
        // Logic ẩn hiện các trường CMS
        function toggleCmsFields() {
            const catType = $('#CategoryType').val();
            if (catType == "4") {
                $('#divContent').show();
            } else {
                $('#divContent').hide();
            }
        }

        document.getElementById('CategoryType').addEventListener('change', toggleCmsFields);
        document.getElementById('LinkType').addEventListener('change', toggleCmsFields);
        
        // Cập nhật MenuPosition string
        document.querySelectorAll('input[name="MenuPos"]').forEach(chk => {
            chk.addEventListener('change', () => {
                let pos = Array.from(document.querySelectorAll('input[name="MenuPos"]:checked')).map(c => c.value).join(',');
                document.getElementById('MenuPosition').value = pos;
            });
        });

        document.addEventListener("DOMContentLoaded", function() { 
            updateSeoPreview();
            toggleCmsFields();
        });
    </script>
}
