@{
    Layout = null; // Trang lỗi thường dùng layout tối giản riêng
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title | Antigravity CMS</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
    <style>
        :root {
            --primary-color: #4e73df;
            --secondary-color: #858796;
            --bg-gradient: linear-gradient(135deg, #f8f9fc 0%, #e2e8f0 100%);
        }
        body {
            font-family: 'Outfit', sans-serif;
            background: var(--bg-gradient);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #2d3748;
            margin: 0;
            overflow: hidden;
        }
        .error-container {
            text-align: center;
            padding: 3rem;
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(10px);
            border-radius: 30px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.1);
            max-width: 600px;
            width: 90%;
            border: 1px solid rgba(255,255,255,0.5);
        }
        .error-code {
            font-size: 120px;
            font-weight: 700;
            margin: 0;
            line-height: 1;
            background: linear-gradient(to right, #4e73df, #224abe);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            filter: drop-shadow(0 5px 10px rgba(78,115,223,0.3));
        }
        .error-title {
            font-size: 28px;
            font-weight: 600;
            margin-top: 20px;
            color: #1a202c;
        }
        .error-message {
            font-size: 18px;
            color: var(--secondary-color);
            margin: 20px 0 40px;
            line-height: 1.6;
        }
        .btn-home {
            background: var(--primary-color);
            color: white;
            padding: 12px 35px;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
            box-shadow: 0 10px 20px rgba(78,115,223,0.2);
            border: none;
        }
        .btn-home:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(78,115,223,0.4);
            color: white;
        }
        .illustration {
            width: 200px;
            margin-bottom: 30px;
            animation: floating 3s ease-in-out infinite;
        }
        @@keyframes floating {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-15px); }
            100% { transform: translateY(0px); }
        }
        .bg-shapes div {
            position: absolute;
            background: rgba(78,115,223,0.05);
            border-radius: 50%;
            z-index: -1;
        }
        .shape-1 { width: 400px; height: 400px; top: -100px; left: -100px; }
        .shape-2 { width: 300px; height: 300px; bottom: -50px; right: -50px; }
    </style>
</head>
<body>
    <div class="bg-shapes">
        <div class="shape-1 animate__animated animate__pulse animate__infinite"></div>
        <div class="shape-2 animate__animated animate__pulse animate__infinite animate__slow"></div>
    </div>

    <div class="error-container animate__animated animate__zoomIn">
        <div class="illustration">
             <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 8V12M12 16H12.01M22 12C22 17.5228 17.5228 22 12 22C6.47715 22 2 17.5228 2 12C2 6.47715 6.47715 2 12 2C17.5228 2 22 6.47715 22 12Z" stroke="#4e73df" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>
        
        @if(ViewBag.StatusCode > 0) {
            <h1 class="error-code">@ViewBag.StatusCode</h1>
        } else {
            <h1 class="error-code">OFF</h1>
        }
        
        <h2 class="error-title">@ViewBag.Title</h2>
        <p class="error-message">@Html.Raw(ViewBag.Message)</p>
        
        <a href="/" class="btn-home">Quay lại Trang chủ</a>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
