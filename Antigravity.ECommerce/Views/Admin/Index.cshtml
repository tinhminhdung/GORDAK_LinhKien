@using Antigravity.ECommerce.Models
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Bảng điều khiển";
    var summary = ViewBag.Summary as DashboardSummary ?? new DashboardSummary();
    var revenueData = ViewBag.RevenueData as List<RevenueByDay> ?? new List<RevenueByDay>();
    var topProducts = ViewBag.TopProducts as List<TopProduct> ?? new List<TopProduct>();
    var topCategories = ViewBag.TopCategories as List<TopCategory> ?? new List<TopCategory>();
    var recentOrders = ViewBag.RecentOrders as List<Order> ?? new List<Order>();
    var lowStock = ViewBag.LowStock as List<Product> ?? new List<Product>();
    var views7d = ViewBag.Views7d as List<ViewsByDay> ?? new List<ViewsByDay>();
    var trafficSource = ViewBag.TrafficSource as List<TrafficSource> ?? new List<TrafficSource>();
    var recentContacts = ViewBag.RecentContacts as List<ContactMessage> ?? new List<ContactMessage>();
    var recentNews = ViewBag.RecentNews as List<News> ?? new List<News>();
}

<div class="row">
    <div class="col-12">
        <div class="page-title-box d-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0">Bảng điều khiển</h4>
        </div>
    </div>
</div>

<!-- KPI Cards -->
<div class="row">
    <!-- Processing Orders -->
    <div class="col-xl-3 col-md-6">
        <div class="card card-animate border-bottom border-3 border-info">
            <div class="card-body">
                <div class="d-flex align-items-end justify-content-between">
                    <div>
                        <p class="text-uppercase fw-semibold text-muted text-truncate mb-2">📦 Đơn chưa xử lý</p>
                        <h4 class="fs-22 fw-bold ff-secondary mb-0">@summary.ProcessingOrderCount</h4>
                    </div>
                    <div class="avatar-sm flex-shrink-0">
                        <span class="avatar-title bg-soft-info rounded fs-2">
                            <i class="bx bx-package text-info"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Customers -->
    <div class="col-xl-3 col-md-6">
        <div class="card card-animate border-bottom border-3 border-warning">
            <div class="card-body">
                <div class="d-flex align-items-end justify-content-between">
                    <div>
                        <p class="text-uppercase fw-semibold text-muted text-truncate mb-2">👥 Khách mới (7 ngày)</p>
                        <h4 class="fs-22 fw-bold ff-secondary mb-0">@summary.NewCustomerCount7d</h4>
                    </div>
                    <div class="avatar-sm flex-shrink-0">
                        <span class="avatar-title bg-soft-warning rounded fs-2">
                            <i class="bx bx-user-circle text-warning"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Orders -->
    <div class="col-xl-3 col-md-6">
        <div class="card card-animate border-bottom border-3 border-success">
            <div class="card-body">
                <div class="d-flex align-items-end justify-content-between">
                    <div>
                        <p class="text-uppercase fw-semibold text-muted text-truncate mb-2">🛒 Đơn hàng mới</p>
                        <h4 class="fs-22 fw-bold ff-secondary mb-0">@summary.NewOrderCount</h4>
                    </div>
                    <div class="avatar-sm flex-shrink-0">
                        <span class="avatar-title bg-soft-success rounded fs-2">
                            <i class="bx bx-shopping-bag text-success"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Revenue -->
    <div class="col-xl-3 col-md-6">
        <div class="card card-animate border-bottom border-3 border-danger">
            <div class="card-body">
                <div class="d-flex align-items-end justify-content-between">
                    <div>
                        <p class="text-uppercase fw-semibold text-muted text-truncate mb-2">💰 Doanh thu</p>
                        <h4 class="fs-22 fw-bold ff-secondary mb-0">@summary.TodayRevenue.ToString("N0") ₫</h4>
                    </div>
                    <div class="avatar-sm flex-shrink-0">
                        <span class="avatar-title bg-soft-danger rounded fs-2">
                            <i class="bx bx-dollar-circle text-danger"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Chart: Thống kê Doanh Thu (ApexCharts) -->
    <div class="col-xl-8">
        <div class="card card-height-100">
            <div class="card-header border-0 align-items-center d-flex">
                <h4 class="card-title mb-0 flex-grow-1">Phân tích Doanh thu & Đơn hàng (365 ngày)</h4>
                <div>
                    <button type="button" id="btn-filter-1m" class="btn btn-soft-primary btn-sm filter-btn">1M</button>
                    <button type="button" id="btn-filter-6m" class="btn btn-soft-secondary btn-sm filter-btn">6M</button>
                    <button type="button" id="btn-filter-1y" class="btn btn-soft-secondary btn-sm filter-btn">1Y</button>
                    <button type="button" id="btn-filter-all" class="btn btn-soft-secondary btn-sm filter-btn">ALL</button>
                </div>
            </div><!-- end card header -->

            <div class="card-body p-0 pb-2">
                <div class="w-100">
                    <div id="revenue_orders_chart" data-colors='["--vz-success", "--vz-info"]' class="apex-charts" dir="ltr"></div>
                </div>
            </div><!-- end card body -->
        </div><!-- end card -->
    </div><!-- end col -->

    <!-- Chart: Phân bổ Danh mục (Pie Chart) -->
    <div class="col-xl-4">
        <div class="card card-height-100">
            <div class="card-header align-items-center d-flex">
                <h4 class="card-title mb-0 flex-grow-1">Phân bổ Sản phẩm</h4>
            </div>
            <div class="card-body">
                <div id="category_distribution_chart" data-colors='["--vz-primary", "--vz-success", "--vz-warning", "--vz-danger", "--vz-info"]' class="apex-charts" dir="ltr"></div>
                
                <div class="mt-4">
                    @foreach(var cat in topCategories.Take(5)) {
                        <div class="d-flex align-items-center mb-2">
                            <div class="flex-grow-1">
                                <h5 class="fs-13 mb-0">@cat.Name</h5>
                            </div>
                            <div class="flex-shrink-0">
                                <span class="text-muted fs-12">@cat.ProductCount SP</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Top Products -->
    <div class="col-xl-6">
        <div class="card">
            <div class="card-header align-items-center d-flex">
                <h4 class="card-title mb-0 flex-grow-1">Top 10 Sản phẩm bán chạy</h4>
                <a href="/AdminProduct" class="btn btn-soft-primary btn-sm">Xem kho</a>
            </div>
            <div class="card-body">
                <div class="table-responsive table-card">
                    <table class="table table-borderless table-centered align-middle table-nowrap mb-0">
                        <thead class="text-muted table-light">
                            <tr>
                                <th>Sản phẩm</th>
                                <th class="text-center">Đã bán</th>
                                <th class="text-end">Doanh thu</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach(var p in topProducts) {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="@p.MainImage" height="30" class="me-2 rounded" />
                                            <span>@p.Name</span>
                                        </div>
                                    </td>
                                    <td class="text-center fw-bold">@p.TotalSold</td>
                                    <td class="text-end text-danger fw-bold">@p.TotalRevenue.ToString("N0") ₫</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Recent Orders -->
    <div class="col-xl-6">
        <div class="card">
            <div class="card-header align-items-center d-flex">
                <h4 class="card-title mb-0 flex-grow-1">Đơn hàng mới nhất</h4>
                <a href="/AdminOrder" class="btn btn-soft-info btn-sm">Xem tất cả</a>
            </div>
            <div class="card-body">
                <div class="table-responsive table-card">
                    <table class="table table-borderless table-centered align-middle table-nowrap mb-0">
                        <thead class="text-muted table-light">
                            <tr>
                                <th>Mã đơn</th>
                                <th>Khách hàng</th>
                                <th>Tổng tiền</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach(var o in recentOrders) {
                                <tr>
                                    <td><a href="/AdminOrder/Detail/@o.OrderId" class="fw-medium">@o.OrderCode</a></td>
                                    <td>@o.CustomerName</td>
                                    <td class="text-danger fw-bold">@o.TotalAmount.ToString("N0") ₫</td>
                                    <td>
                                        @switch(o.OrderStatus){
                                            case 0: <span class="badge bg-info">Mới</span> break;
                                            case 1: <span class="badge bg-primary">Xác nhận</span> break;
                                            default: <span class="badge bg-secondary">Khác</span> break;
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Low Stock -->
    <div class="col-xl-6">
        <div class="card" id="low-stock-table">
            <div class="card-header align-items-center d-flex">
                <h4 class="card-title mb-0 flex-grow-1">Sản phẩm sắp hết hàng</h4>
                <a href="/AdminProduct" class="btn btn-soft-danger btn-sm">Quản lý kho</a>
            </div>
            <div class="card-body">
                <div class="table-responsive table-card">
                    <table class="table table-centered table-nowrap mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Sản phẩm</th>
                                <th class="text-center">Tồn kho</th>
                                <th>Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach(var p in lowStock) {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="@p.MainImage" height="30" class="me-2 rounded" />
                                            <span>@p.Name</span>
                                        </div>
                                    </td>
                                    <td class="text-center"><span class="badge bg-soft-danger text-danger">@p.Stock</span></td>
                                    <td><a href="/AdminProduct/Edit/@p.ProductId" class="btn btn-sm btn-light">Nhập hàng</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <!-- Recent Contacts -->
    <div class="col-xl-6">
        <div class="card">
            <div class="card-header align-items-center d-flex">
                <h4 class="card-title mb-0 flex-grow-1">Liên hệ mới nhất</h4>
                <a href="/AdminContact" class="btn btn-soft-warning btn-sm">Xem thư mục</a>
            </div>
            <div class="card-body">
                <div class="table-responsive table-card">
                    <table class="table table-centered table-nowrap mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Người gửi</th>
                                <th>Tiêu đề</th>
                                <th class="text-center">Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach(var c in recentContacts) {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-xs me-2">
                                                <span class="avatar-title bg-soft-primary text-primary rounded-circle fs-13">
                                                    @c.FullName.Substring(0, 1).ToUpper()
                                                </span>
                                            </div>
                                            <span>@c.FullName</span>
                                        </div>
                                    </td>
                                    <td><span class="text-truncate" style="max-width: 150px; display: inline-block;">@c.Subject</span></td>
                                    <td class="text-center">
                                        @if(c.Status == 0) { <span class="badge bg-danger">Mới</span> }
                                        else if(c.Status == 1) { <span class="badge bg-warning">Đã đọc</span> }
                                        else { <span class="badge bg-success">Hoàn tất</span> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent News -->
    <div class="col-xl-6">
        <div class="card">
            <div class="card-header align-items-center d-flex">
                <h4 class="card-title mb-0 flex-grow-1">Tin tức mới nhất</h4>
                <a href="/AdminNews" class="btn btn-soft-success btn-sm">Xem tất cả</a>
            </div>
            <div class="card-body">
                <div class="table-responsive table-card">
                    <table class="table table-centered table-nowrap mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Bài viết</th>
                                <th>Ngày đăng</th>
                                <th class="text-center">Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach(var n in recentNews) {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            @if(!string.IsNullOrEmpty(n.Image)){
                                                <img src="@n.Image" height="30" class="me-2 rounded" style="width:40px; object-fit:cover;" />
                                            }
                                            <span class="text-truncate" style="max-width: 150px; display: inline-block;">@n.Title</span>
                                        </div>
                                    </td>
                                    <td>@(n.CreatedAt.ToString("dd/MM/yyyy"))</td>
                                    <td class="text-center">
                                        @if(n.Status == 1) { <span class="badge bg-success">Đã xuất bản</span> }
                                        else { <span class="badge bg-secondary">Bản nháp</span> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- apexcharts -->
    <script src="~/assets/libs/apexcharts/apexcharts.min.js"></script>

    <script>
        // Lấy màu từ thuộc tính data-colors để code ngắn gọn
        function getChartColorsArray(chartId) {
            if (document.getElementById(chartId) !== null) {
                var colors = document.getElementById(chartId).getAttribute("data-colors");
                if (colors) {
                    colors = JSON.parse(colors);
                    return colors.map(function (value) {
                        var newValue = value.replace(" ", "");
                        if (newValue.indexOf(",") === -1) {
                            var color = getComputedStyle(document.documentElement).getPropertyValue(newValue);
                            if (color) return color;
                            else return newValue;;
                        } else {
                            var val = value.split(',');
                            if (val.length == 2) {
                                var rgbaColor = getComputedStyle(document.documentElement).getPropertyValue(val[0]);
                                rgbaColor = "rgba(" + rgbaColor + "," + val[1] + ")";
                                return rgbaColor;
                            } else {
                                return newValue;
                            }
                        }
                    });
                }
            }
        }

        // 1. Biểu đồ Doanh thu & Đơn hàng (Mixed Chart - 365 Days)
        var revenueColors = getChartColorsArray("revenue_orders_chart") || ["#0ab39c", "#299cdb"];
        
        // Tạo chuỗi [timestamp, giá trị] cho ApexCharts
        var revenueSeriesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(revenueData.Select(x => new object[] { new DateTimeOffset(x.Date).ToUnixTimeMilliseconds(), x.Revenue })));
        var ordersSeriesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(revenueData.Select(x => new object[] { new DateTimeOffset(x.Date).ToUnixTimeMilliseconds(), x.OrderCount })));

        var options = {
            series: [{
                name: 'Đơn hàng',
                type: 'area', // line có đổ rèm xuống đẹp hơn
                data: ordersSeriesData
            }, {
                name: 'Doanh thu',
                type: 'bar',
                data: revenueSeriesData
            }],
            chart: {
                id: 'revenue-chart',
                height: 370,
                type: 'line',
                toolbar: {
                    show: true,
                    autoSelected: 'pan'
                }
            },
            stroke: {
                curve: 'smooth',
                dashArray: [0, 0, 8],
                width: [2, 0, 2.2]
            },
            fill: {
                opacity: [0.1, 0.9, 1]
            },
            markers: {
                size: [0, 0, 0],
                strokeWidth: 2,
                hover: {
                    size: 4,
                }
            },
            xaxis: {
                type: 'datetime',
                axisTicks: {
                    show: false
                },
                axisBorder: {
                    show: false
                }
            },
            grid: {
                show: true,
                xaxis: { lines: { show: true } },   
                yaxis: { lines: { show: false } },
                padding: { top: 0, right: -2, bottom: 15, left: 10 },
            },
            legend: {
                show: true,
                horizontalAlign: 'center',
                offsetX: 0,
                offsetY: -5,
                markers: { width: 9, height: 9, radius: 6 },
                itemMargin: { horizontal: 10, vertical: 0 },
            },
            plotOptions: {
                bar: { columnWidth: '30%', barHeight: '70%'}
            },
            colors: revenueColors,
            tooltip: {
                shared: true,
                x: { format: 'dd MMM yyyy' },
                y: [{
                    formatter: function (y) {
                        if(typeof y !== "undefined") {
                            return y.toFixed(0) + " Đơn";
                        }
                        return y;
                    }
                }, {
                    formatter: function (y) {
                        if(typeof y !== "undefined") {
                            return y.toLocaleString("vi-VN") + " đ";
                        }
                        return y;
                    }
                }]
            }
        };

        var chart = new ApexCharts(document.querySelector("#revenue_orders_chart"), options);
        chart.render();

        // 1.1 Biểu đồ Phân bổ Danh mục (Donut/Pie Chart)
        var categoryColors = getChartColorsArray("category_distribution_chart") || ["#405189", "#0ab39c", "#f7b84b", "#f06548", "#299cdb"];
        var categoryLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(topCategories.Take(5).Select(x => x.Name)));
        var categorySeries = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(topCategories.Take(5).Select(x => x.ProductCount)));

        var categoryOptions = {
            series: categorySeries,
            labels: categoryLabels,
            chart: {
                type: 'donut',
                height: 250,
            },
            plotOptions: {
                pie: {
                    donut: {
                        size: '70%'
                    }
                }
            },
            dataLabels: {
                enabled: false
            },
            legend: {
                show: false,
            },
            colors: categoryColors
        };

        var categoryChart = new ApexCharts(document.querySelector("#category_distribution_chart"), categoryOptions);
        categoryChart.render();

        // 2. Kích hoạt chức năng của các nút Filter (ALL, 1M, 6M, 1Y)
        document.getElementById('btn-filter-1m').addEventListener('click', function(e) {
            updateActiveState(e.target);
            var now = new Date().getTime();
            var minDate = now - (30 * 24 * 60 * 60 * 1000); // Trừ 30 ngày
            chart.zoomX(minDate, now);
        });

        document.getElementById('btn-filter-6m').addEventListener('click', function(e) {
            updateActiveState(e.target);
            var now = new Date().getTime();
            var minDate = now - (180 * 24 * 60 * 60 * 1000); // Trừ ~180 ngày
            chart.zoomX(minDate, now);
        });

        document.getElementById('btn-filter-1y').addEventListener('click', function(e) {
            updateActiveState(e.target);
            var now = new Date().getTime();
            var minDate = now - (365 * 24 * 60 * 60 * 1000); // Trừ 365 ngày
            chart.zoomX(minDate, now);
        });

        document.getElementById('btn-filter-all').addEventListener('click', function(e) {
            updateActiveState(e.target);
            // Reset zoom to view all data
            chart.resetSeries();
        });

        function updateActiveState(btn) {
            document.querySelectorAll('.filter-btn').forEach(function(el) {
                el.classList.remove('btn-soft-primary');
                el.classList.add('btn-soft-secondary');
            });
            btn.classList.remove('btn-soft-secondary');
            btn.classList.add('btn-soft-primary');
        }

        // Tự động kích hoạt mặc định 1 Tháng (1M)
        document.getElementById('btn-filter-1m').click();
    </script>
}
