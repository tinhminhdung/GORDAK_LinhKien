@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "CẢNH BÁO: TRUY CẬP BỊ CHẶN";
    var module = ViewBag.Module ?? "Module này";
}

<style>
    .forbidden-anim {
        animation: shake 0.5s cubic-bezier(.36,.07,.19,.97) both;
        transform: translate3d(0, 0, 0);
    }
    @@keyframes shake {
        10%, 90% { transform: translate3d(-1px, 0, 0); }
        20%, 80% { transform: translate3d(2px, 0, 0); }
        30%, 50%, 70% { transform: translate3d(-4px, 0, 0); }
        40%, 60% { transform: translate3d(4px, 0, 0); }
    }
</style>


<div class="page-content">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6 col-xl-5">
                <div class="card mt-4">
                    <div class="card-body p-4 text-center">
                        <div class="avatar-lg mx-auto mt-2 forbidden-anim">
                            <div class="avatar-title bg-soft-danger text-danger display-3 rounded-circle">
                                <i class="ri-error-warning-fill"></i>
                            </div>
                        </div>
                        <div class="mt-4 pt-2">
                            <h3 class="text-uppercase text-danger fw-bold">Dừng lại! Truy cập bị cấm</h3>
                            <p class="text-muted mb-4 fs-16">Bạn không có đủ thẩm quyền để vào module <span class="badge bg-danger">@module</span>.</p>
                            
                            <div class="alert alert-danger border-dash rounded mb-4" role="alert">
                                <div class="d-flex align-items-center">
                                    <i class="ri-alarm-warning-line fs-24 me-2"></i>
                                    <div class="text-start">
                                        <strong>CẢNH BÁO HỆ THỐNG:</strong><br/>
                                        Hành động truy cập trái phép của bạn đã được ghi lại. Vui lòng liên hệ Admin nếu bạn cho rằng đây là một sự nhầm lẫn.
                                    </div>
                                </div>
                            </div>

                            <p class="mb-4">Tự động quay lại Dashboard sau <span id="countdown" class="fw-bold text-primary">10</span> giây...</p>


                            <div class="d-flex gap-2 justify-content-center">
                                <a href="/Admin" class="btn btn-success w-100">
                                    <i class="ri-home-4-line align-bottom me-1"></i> Về Dashboard
                                </a>
                                <button onclick="history.back()" class="btn btn-outline-danger w-100">
                                    <i class="ri-arrow-go-back-line align-bottom me-1"></i> Quay lại
                                </button>
                            </div>
                        </div>
                    </div>
                    <!-- end card body -->
                </div>
                <!-- end card -->
            </div>
        </div>
    </div>
</div>

<script>
    let seconds = 10;
    const interval = setInterval(() => {
        seconds--;
        document.getElementById('countdown').innerText = seconds;
        if (seconds <= 0) {
            clearInterval(interval);
            window.location.href = '/Admin';
        }
    }, 1000);
</script>

