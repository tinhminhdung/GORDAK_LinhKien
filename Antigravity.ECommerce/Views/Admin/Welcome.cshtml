@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Chào mừng quay trở lại";
    var fullName = User.Claims.FirstOrDefault(c => c.Type == "FullName")?.Value ?? User.Identity?.Name;
    var avatar = User.Claims.FirstOrDefault(c => c.Type == "Avatar")?.Value;
    
    // Thống kê nhanh để hiển thị thêm "hay ho"
    var _orderStats = Antigravity.ECommerce.Services.SOrder.GetStatusCounts() ?? new Antigravity.ECommerce.Models.OrderCountModel();
    var _contactStats = Antigravity.ECommerce.Framework.FContact.GetStats() ?? new Antigravity.ECommerce.Framework.ContactStats();
}

<div class="page-content welcome-wrapper">
    <div class="container-fluid">
        <div class="row min-vh-100 align-items-center justify-content-center">
            <div class="col-lg-8">
                <div class="welcome-card animate__animated animate__fadeIn">
                    <div class="avatar-container animate__animated animate__bounceIn">
                        @if (!string.IsNullOrEmpty(avatar))
                        {
                            <img src="@avatar" alt="Avatar" class="welcome-avatar shadow-lg">
                        }
                        else
                        {
                            <div class="welcome-avatar-initials shadow-lg">
                                @(!string.IsNullOrEmpty(fullName) ? fullName.Substring(0, 1).ToUpper() : "A")
                            </div>
                        }
                        <div class="pulse-ring"></div>
                    </div>

                    <div class="text-center mt-4">
                        <h1 class="welcome-title">Xin chào, <span class="text-gradient">@fullName</span>!</h1>
                        <p class="welcome-subtitle">Chào mừng bạn trở lại với hệ thống quản trị <br><b>ELITE ADMIN CMS</b></p>
                    </div>

                    <div class="row mt-5 justify-content-center stats-row">
                        <a href="/AdminOrder" class="col-md-4 text-decoration-none text-dark">
                            <div class="stat-item">
                                <div class="stat-icon bg-soft-info text-info"><i class="ri-shopping-cart-2-line"></i></div>
                                <div class="stat-info text-start">
                                    <h4 class="m-0">@_orderStats.New</h4>
                                    <p class="m-0 text-muted">Đơn hàng mới</p>
                                </div>
                            </div>
                        </a>
                        <a href="/AdminContact" class="col-md-4 text-decoration-none text-dark">
                            <div class="stat-item">
                                <div class="stat-icon bg-soft-warning text-warning"><i class="ri-chat-smile-2-line"></i></div>
                                <div class="stat-info text-start">
                                    <h4 class="m-0">@_contactStats.UnreadCount</h4>
                                    <p class="m-0 text-muted">Liên hệ mới</p>
                                </div>
                            </div>
                        </a>
                    </div>

                    <div class="d-flex justify-content-center gap-3 mt-5 action-buttons">
                        <a href="/Admin" class="btn btn-primary-gradient shadow-lg">
                             Bảng điều khiển <i class="ri-arrow-right-line ms-2"></i>
                        </a>
                        <a href="/" target="_blank" class="btn btn-glass">
                            Xem Website <i class="ri-external-link-line ms-2"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .welcome-wrapper {
        background: radial-gradient(circle at top right, rgba(10, 179, 156, 0.05), transparent),
                    radial-gradient(circle at bottom left, rgba(64, 81, 137, 0.05), transparent);
        overflow: hidden;
    }
    .welcome-card {
        padding: 60px 40px;
        background: rgba(255, 255, 255, 0.8);
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 30px;
        backdrop-filter: blur(20px);
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.1);
        text-align: center;
    }
    [data-layout-mode="dark"] .welcome-card {
        background: rgba(33, 37, 41, 0.6);
        border-color: rgba(255, 255, 255, 0.05);
    }

    .avatar-container {
        position: relative;
        width: 140px;
        height: 140px;
        margin: 0 auto;
    }
    .welcome-avatar {
        width: 130px;
        height: 130px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid #fff;
        position: relative;
        z-index: 2;
    }
    .welcome-avatar-initials {
        width: 130px;
        height: 130px;
        border-radius: 50%;
        background: linear-gradient(135deg, #405189, #0ab39c);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 50px;
        font-weight: bold;
        border: 4px solid #fff;
        position: relative;
        z-index: 2;
    }

    .pulse-ring {
        content: "";
        width: 140px;
        height: 140px;
        background: rgba(10, 179, 156, 0.3);
        border-radius: 50%;
        position: absolute;
        top: 0; left: 0;
        animation: pulse-ring 2s infinite;
        z-index: 1;
    }
    @@keyframes pulse-ring {
        0% { transform: scale(0.9); opacity: 0.8; }
        100% { transform: scale(1.4); opacity: 0; }
    }

    .welcome-title {
        font-size: clamp(1.8rem, 4vw, 2.8rem);
        font-weight: 800;
        letter-spacing: -0.02em;
        line-height: 1.3;
        margin-bottom: 10px;
    }
    .text-gradient {
        background: linear-gradient(135deg, #405189, #0ab39c);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    .welcome-subtitle {
        font-size: 1.1rem;
        color: #777;
        text-transform: uppercase;
        letter-spacing: 2px;
    }

    .stat-item {
        background: rgba(255, 255, 255, 0.5);
        border-radius: 20px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 15px;
        transition: 0.3s;
    }
    .stat-item:hover { transform: translateY(-5px); background: #fff; }
    .stat-icon {
        width: 45px; height: 45px;
        border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 20px;
    }

    .btn-primary-gradient {
        background: linear-gradient(135deg, #405189, #0ab39c);
        color: white;
        border: none;
        padding: 15px 40px;
        border-radius: 50px;
        font-weight: 600;
        transition: 0.3s;
    }
    .btn-primary-gradient:hover { transform: scale(1.05); color: white; box-shadow: 0 10px 20px rgba(10, 179, 156, 0.3); }
    
    .btn-glass {
        padding: 15px 40px;
        border-radius: 50px;
        background: rgba(255, 255, 255, 0.3);
        border: 1px solid rgba(0, 0, 0, 0.1);
        font-weight: 600;
        transition: 0.3s;
    }
    .btn-glass:hover { background: rgba(255, 255, 255, 0.5); }
</style>

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
}
