@model List<Antigravity.ECommerce.Models.Video>
@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    var categories = ViewBag.Categories as List<Antigravity.ECommerce.Models.Category> ?? new List<Antigravity.ECommerce.Models.Category>();
    var hotVideos = ViewBag.HotVideos as List<Antigravity.ECommerce.Models.Video> ?? new List<Antigravity.ECommerce.Models.Video>();
    var currentCat = ViewBag.CurrentCategory as Antigravity.ECommerce.Models.Category;
    int currentPage = ViewBag.CurrentPage;
    int totalPages = (int)Math.Ceiling((double)ViewBag.TotalCount / ViewBag.PageSize);
    
    // Breadcrumb
    ViewData["SchemaBreadcrumbs"] = new List<Antigravity.ECommerce.Models.BreadcrumbItem> {
        new Antigravity.ECommerce.Models.BreadcrumbItem { Name = "Trang chủ", Url = "/" },
        new Antigravity.ECommerce.Models.BreadcrumbItem { Name = "Video", Url = "/video.html" }
    };
    if(currentCat != null) {
        ((List<Antigravity.ECommerce.Models.BreadcrumbItem>)ViewData["SchemaBreadcrumbs"]).Add(new Antigravity.ECommerce.Models.BreadcrumbItem { Name = currentCat.Name, Url = "/video/" + currentCat.Slug + ".html" });
    }
}

<div class="container mt-3 mb-4">
    <nav class="sp-breadcrumb">
        <a href="/">Trang chủ</a> 
        <i class="fa-solid fa-chevron-right"></i> 
        @if(currentCat == null) {
            <span>Video</span>
        } else {
            <a href="/video.html">Video</a> <i class="fa-solid fa-chevron-right"></i> <span>@currentCat.Name</span>
        }
    </nav>
</div>

<main class="container mb-5">
    <h1 class="lh-page-title mb-3 text-uppercase">@(currentCat?.Name ?? "VIDEO")</h1>

    <!-- Filter tabs -->
    @if(categories.Any()) {
    <div class="tt-filter-tabs mb-4">
        <a href="/video.html" class="tt-filter-btn @(currentCat == null ? "active" : "")">Tất cả</a>
        @foreach(var cat in categories) {
            <a href="/video/@(cat.Slug).html" class="tt-filter-btn @(currentCat?.CategoryId == cat.CategoryId ? "active" : "")">@cat.Name</a>
        }
    </div>
    }

    <div class="row g-4">
        <!-- NỘI DUNG CHÍNH -->
        <div class="col-lg-9">
            @{
                var featuredVideo = ViewBag.FeaturedVideo as Antigravity.ECommerce.Models.Video;
            }
            
            @if(featuredVideo != null) {
                var featuredUrl = $"/video/detail/{featuredVideo.Slug}.html";
                <!-- Video Player chinh (luon hien) -->
                <div class="vd-player-wrap mb-4">
                    <a href="@featuredUrl" class="d-block text-decoration-none text-dark">
                        <div class="vd-player-main">
                            <img src="@(string.IsNullOrEmpty(featuredVideo.ThumbnailUrl) ? "/assets/images/placeholder.png" : featuredVideo.ThumbnailUrl)" alt="@featuredVideo.Title" class="vd-player-thumb">
                            <div class="vd-player-overlay">
                                <span class="vd-badge-live">MỚI NHẤT</span>
                                <button type="button" class="vd-play-btn"><i class="fa-solid fa-play"></i></button>
                            </div>
                        </div>
                        <h2 class="vd-video-title mt-3">@featuredVideo.Title</h2>
                    </a>
                    <div class="tt-card-meta mb-2">
                        <i class="fa-regular fa-calendar"></i> @featuredVideo.CreatedAt.ToString("dd/MM/yyyy")
                    </div>
                    <p class="tt-card-desc line-clamp-2">@featuredVideo.SeoDescription</p>
                    <div class="vd-actions">
                        <a href="https://www.facebook.com/sharer/sharer.php?u=@(Context.Request.Scheme + "://" + Context.Request.Host + featuredUrl)" target="_blank" class="vd-action-btn"><i class="fa-solid fa-share-nodes"></i> Chia sẻ</a>
                    </div>
                </div>
            }

            @if(Model != null && Model.Any()) {
                <!-- Cac video khac -->
                <h3 class="sp-section-title">VIDEO LIÊN QUAN</h3>
                <div class="row g-3 mb-4">
                    @foreach(var item in Model) {
                        var videoUrl = $"/video/detail/{item.Slug}.html";
                        <div class="col-6 col-md-4">
                            <div class="vd-related-card">
                                <div class="vd-thumb-wrap">
                                    <a href="@videoUrl">
                                        <img src="@(string.IsNullOrEmpty(item.ThumbnailUrl) ? "/assets/images/placeholder.png" : item.ThumbnailUrl)" alt="@item.Title">
                                        <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); color: white; font-size: 2rem; opacity: 0.8; text-shadow: 0 2px 4px rgba(0,0,0,0.5);"><i class="fa-solid fa-circle-play"></i></div>
                                    </a>
                                </div>
                                <h3 class="vd-rel-name line-clamp-2 mt-2">
                                    <a href="@videoUrl">@item.Title</a>
                                </h3>
                                <div class="tt-hot-meta mt-1" style="font-size: 12px; color: #666;">
                                    <i class="fa-regular fa-calendar"></i> @item.CreatedAt.ToString("dd/MM/yyyy")
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Phan trang -->
                @if (totalPages > 1) {
                <div class="vd-pagination">
                    @if (currentPage > 1) {
                        <a href="?page=@(currentPage - 1)" class="vd-page-btn"><i class="fa-solid fa-chevron-left"></i></a>
                    } else {
                        <span class="vd-page-btn disabled"><i class="fa-solid fa-chevron-left"></i></span>
                    }

                    @{
                        int maxVisible = 3;
                        int startP = Math.Max(1, currentPage - 1);
                        int endP = Math.Min(Math.Max(1, totalPages), startP + maxVisible - 1);
                        if (endP - startP < maxVisible - 1) { startP = Math.Max(1, endP - maxVisible + 1); }
                    }

                    @if (startP > 1) {
                        <a href="?page=1" class="vd-page-btn">1</a>
                        if (startP > 2) { <span class="vd-page-dots">...</span> }
                    }

                    @for (int i = startP; i <= endP; i++) {
                        <a href="?page=@i" class="vd-page-btn @(i == currentPage ? "active" : "")">@i</a>
                    }

                    @if (endP < totalPages) {
                        if (endP < totalPages - 1) { <span class="vd-page-dots">...</span> }
                        <a href="?page=@totalPages" class="vd-page-btn">@totalPages</a>
                    }

                    @if (currentPage < totalPages) {
                        <a href="?page=@(currentPage + 1)" class="vd-page-btn"><i class="fa-solid fa-chevron-right"></i></a>
                    } else {
                        <span class="vd-page-btn disabled"><i class="fa-solid fa-chevron-right"></i></span>
                    }
                </div>
                }
            } @* end if Model.Any *@
            
            @if(featuredVideo == null && (Model == null || !Model.Any())) {
                <div class="text-center py-5">
                    <i class="fa-solid fa-video-slash fa-3x text-muted mb-3"></i>
                    <p class="text-muted">Không có video nào trong mục này.</p>
                </div>
            }
        </div>

        <!-- SIDEBAR -->
        <div class="col-lg-3">
            <!-- Danh mục video -->
            <div class="tt-sidebar-box mb-3">
                <h4 class="tt-sidebar-title">DANH MỤC VIDEO</h4>
                <ul class="tt-sidebar-list">
                    <li><a href="/video.html">Tất cả <span>@ViewBag.TotalVideoCount</span></a></li>
                    @foreach(var cat in categories.Take(10)) {
                        <li><a href="/video/@(cat.Slug).html" class="@(currentCat?.CategoryId == cat.CategoryId ? "active" : "")">@cat.Name <span>@cat.ItemCount</span></a></li>
                    }
                </ul>
                @if(categories.Count > 10) {
                    <a href="javascript:void(0)" onclick="$('#video-more-cats li').removeClass('d-none'); $(this).hide();" class="tt-sidebar-link">Xem tất cả danh mục <i class="fa-solid fa-arrow-right"></i></a>
                    <ul class="tt-sidebar-list" id="video-more-cats">
                         @foreach(var cat in categories.Skip(10)) {
                            <li class="d-none"><a href="/video/@(cat.Slug).html">@cat.Name <span>@cat.ItemCount</span></a></li>
                        }
                    </ul>
                }
            </div>

            <!-- Video nổi bật -->
            @if(hotVideos.Any()) {
            <div class="tt-sidebar-box mb-3">
                <h4 class="tt-sidebar-title">VIDEO NỔI BẬT</h4>
                @foreach(var hv in hotVideos) {
                    <div class="tt-hot-item">
                        <div class="vd-thumb-wrap vd-thumb-sm" style="width: 80px; flex-shrink: 0; position: relative;">
                            <a href="/video/detail/@(hv.Slug).html">
                                <img src="@(string.IsNullOrEmpty(hv.ThumbnailUrl) ? "/assets/images/placeholder.png" : hv.ThumbnailUrl)" alt="@hv.Title" style="width:100%; aspect-ratio:16/9; object-fit:cover; border-radius: 4px;">
                                <div style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); color:#fff; font-size:16px; opacity:0.8;"><i class="fa-solid fa-circle-play"></i></div>
                            </a>
                        </div>
                        <div class="ms-2">
                            <a href="/video/detail/@(hv.Slug).html" class="tt-hot-title line-clamp-2" style="font-size: 13px;">@hv.Title</a>
                            <div class="tt-hot-meta" style="font-size: 11px;">
                                <i class="fa-regular fa-calendar"></i> @hv.CreatedAt.ToString("dd/MM/yyyy")
                            </div>
                        </div>
                    </div>
                }
            </div>
            }

            <!-- CTA Box -->
            <partial name="_SidebarCTA" />
        </div>
    </div>
</main>
