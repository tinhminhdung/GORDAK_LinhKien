@model Antigravity.ECommerce.Models.Video
@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    ViewData["Title"] = Model.Title;
    var related = ViewBag.Related as List<Antigravity.ECommerce.Models.Video>;

    // SEO Schema Setup
    ViewData["SchemaVideo"] = Model;
    ViewData["SchemaBreadcrumbs"] = new List<Antigravity.ECommerce.Models.BreadcrumbItem> {
        new Antigravity.ECommerce.Models.BreadcrumbItem { Name = "Trang chủ", Url = "/" },
        new Antigravity.ECommerce.Models.BreadcrumbItem { Name = "Video", Url = "/video.html" },
        new Antigravity.ECommerce.Models.BreadcrumbItem { Name = Model.Title, Url = Context.Request.Path }
    };
}

@section Styles {
    <style>
        .video-container {
            position: relative;
            padding-bottom: 56.25%; /* 16:9 aspect ratio */
            height: 0;
            overflow: hidden;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            background: #000;
        }
        .video-container iframe {
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 100%;
            border: 0;
        }
        .video-header {
            margin-top: 30px;
            padding-bottom: 20px;
            border-bottom: 1px solid #eee;
        }
        
        /* Related Videos Side */
        .related-card {
            display: flex; gap: 15px; margin-bottom: 15px;
            transition: all 0.2s ease;
            text-decoration: none !important;
            padding: 10px; border-radius: 10px;
        }
        .related-card:hover { background: #f8f9fa; }
        .related-thumb {
            width: 160px; min-width: 160px; height: 90px;
            border-radius: 8px; position: relative; overflow: hidden;
        }
        .related-thumb img { width: 100%; height: 100%; object-fit: cover; }
        .related-thumb .time-badge {
            position: absolute; bottom: 5px; right: 5px;
            background: rgba(0,0,0,0.8); color: white;
            font-size: 11px; padding: 2px 5px; border-radius: 4px;
        }
        .related-info h6 {
            color: #000; font-size: 14px; font-weight: 600;
            display: -webkit-box; -webkit-line-clamp: 2;
            -webkit-box-orient: vertical; overflow: hidden;
            line-height: 1.4; margin-bottom: 5px;
        }
        .related-info span { color: #606060; font-size: 12px; }
    </style>
}

<nav aria-label="breadcrumb">
  <ol class="breadcrumb mt-3 mb-4">
    <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
    <li class="breadcrumb-item"><a href="/video.html">Video</a></li>
    <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
  </ol>
</nav>

<div class="row">
    <!-- Main Video -->
    <div class="col-lg-8 mb-5">
        <div class="video-container">
            <iframe src="https://www.youtube.com/embed/@Model.YoutubeId?autoplay=0&rel=0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        </div>
        
        <div class="video-header">
            <h1 class="fw-bold fs-3 mt-2">@Model.Title</h1>
            <div class="d-flex justify-content-between align-items-center mt-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-danger text-white rounded-circle d-flex justify-content-center align-items-center fw-bold" style="width: 45px; height: 45px; font-size: 20px;">
                        @(!string.IsNullOrEmpty(Model.CategoryName) ? Model.CategoryName.Substring(0,1) : "V")
                    </div>
                    <div>
                        <div class="fw-bold">@Model.CategoryName</div>
                        <div class="text-muted small">@Model.CreatedAt.ToString("dd MMMM, yyyy")</div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Sidebar Related Videos -->
    <div class="col-lg-4">
        <h5 class="fw-bold mb-4 border-bottom pb-2">Video cùng chuyên mục</h5>
        @if (related != null && related.Count > 0)
        {
            foreach (var r in related)
            {
                <a href="/video/detail/@(r.Slug).html" class="related-card">
                    <div class="related-thumb">
                        <img src="@r.ThumbnailUrl" alt="@r.Title">
                        <div class="time-badge"><i class="mdi mdi-play"></i></div>
                    </div>
                    <div class="related-info">
                        <h6>@r.Title</h6>
                        <span>@r.CategoryName</span><br/>
                        <span>@r.CreatedAt.ToString("dd/MM/yyyy")</span>
                    </div>
                </a>
            }
        }
    </div>
</div>
