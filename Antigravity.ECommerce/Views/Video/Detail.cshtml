@model Antigravity.ECommerce.Models.Video
@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    ViewData["Title"] = Model.Title;
    var related = ViewBag.Related as List<Antigravity.ECommerce.Models.Video> ?? new List<Antigravity.ECommerce.Models.Video>();
    var categories = ViewBag.Categories as List<Antigravity.ECommerce.Models.Category> ?? new List<Antigravity.ECommerce.Models.Category>();
    var hotVideos = ViewBag.HotVideos as List<Antigravity.ECommerce.Models.Video> ?? new List<Antigravity.ECommerce.Models.Video>();

    // SEO Schema Setup
    ViewData["SchemaVideo"] = Model;
    ViewData["SchemaBreadcrumbs"] = new List<Antigravity.ECommerce.Models.BreadcrumbItem> {
        new Antigravity.ECommerce.Models.BreadcrumbItem { Name = "Trang chủ", Url = "/" },
        new Antigravity.ECommerce.Models.BreadcrumbItem { Name = "Video", Url = "/video.html" },
        new Antigravity.ECommerce.Models.BreadcrumbItem { Name = Model.Title, Url = Context.Request.Path }
    };
}

@section Styles {
    <style>
        .video-container {
            position: relative;
            padding-bottom: 56.25%; /* 16:9 aspect ratio */
            height: 0;
            overflow: hidden;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            background: #000;
        }
        .video-container iframe {
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 100%;
            border: 0;
        }
    </style>
}

<div class="container mt-3 mb-2">
    <nav class="sp-breadcrumb">
        <a href="/">Trang chủ</a> 
        <i class="fa-solid fa-chevron-right"></i> 
        <a href="/video.html">Video</a> 
        <i class="fa-solid fa-chevron-right"></i> 
        <span>Chi tiết</span>
    </nav>
</div>

<main class="container mb-5">
    <div class="row g-4 mt-1">
        <!-- NỘI DUNG CHÍNH -->
        <div class="col-lg-9">
            <div class="vd-player-wrap mb-4">
                <div class="video-container mb-3">
                    <iframe src="https://www.youtube.com/embed/@Model.YoutubeId?autoplay=1&rel=0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                </div>
                
                <h1 class="vd-video-title fs-3">@Model.Title</h1>
                <div class="tt-card-meta mb-2">
                    <i class="fa-regular fa-calendar"></i> @Model.CreatedAt.ToString("dd/MM/yyyy")
                </div>
                <div class="tt-card-desc mb-3" style="font-size: 15px; color: #444;">
                    @Html.Raw(Model.SeoDescription)
                </div>
                <div class="vd-actions">
                    <a href="https://www.facebook.com/sharer/sharer.php?u=@(Context.Request.Scheme + "://" + Context.Request.Host + Context.Request.Path)" target="_blank" class="vd-action-btn"><i class="fa-solid fa-share-nodes"></i> Chia sẻ</a>
                </div>
            </div>

            <!-- Video liên quan -->
            @if (related.Any())
            {
                <h3 class="sp-section-title mt-5">VIDEO LIÊN QUAN</h3>
                <div class="row g-3 mb-4">
                    @foreach (var r in related)
                    {
                        var rUrl = $"/video/detail/{r.Slug}.html";
                        <div class="col-6 col-md-4">
                            <div class="vd-related-card">
                                <div class="vd-thumb-wrap">
                                    <a href="@rUrl">
                                        <img src="@(string.IsNullOrEmpty(r.ThumbnailUrl) ? "/assets/images/placeholder.png" : r.ThumbnailUrl)" alt="@r.Title" style="width:100%; object-fit:cover; aspect-ratio: 16/9;">
                                        <div class="vd-play-icon-sm" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); color: white; font-size: 2rem; opacity: 0.8; text-shadow: 0 2px 4px rgba(0,0,0,0.5);"><i class="fa-solid fa-circle-play"></i></div>
                                    </a>
                                </div>
                                <h3 class="vd-rel-name line-clamp-2 mt-2" style="font-size: 14px; height: 40px; overflow: hidden;">
                                    <a href="@rUrl" class="text-decoration-none text-dark">@r.Title</a>
                                </h3>
                                <div class="tt-hot-meta mt-1" style="font-size: 12px; color: #666;">
                                    <i class="fa-regular fa-calendar"></i> @r.CreatedAt.ToString("dd/MM/yyyy")
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- SIDEBAR -->
        <div class="col-lg-3">
            <!-- Danh mục video -->
            <div class="tt-sidebar-box mb-3">
                <h4 class="tt-sidebar-title">DANH MỤC VIDEO</h4>
                <ul class="tt-sidebar-list">
                    <li><a href="/video.html">Tất cả <span>@ViewBag.TotalVideoCount</span></a></li>
                    @foreach(var cat in categories.Take(10)) {
                        <li><a href="/video/@(cat.Slug).html">@cat.Name <span>@cat.ItemCount</span></a></li>
                    }
                </ul>
                @if(categories.Count > 10) {
                    <a href="javascript:void(0)" onclick="$('#video-more-cats-d li').removeClass('d-none'); $(this).hide();" class="tt-sidebar-link">Xem tất cả danh mục <i class="fa-solid fa-arrow-right"></i></a>
                    <ul class="tt-sidebar-list" id="video-more-cats-d">
                         @foreach(var cat in categories.Skip(10)) {
                            <li class="d-none"><a href="/video/@(cat.Slug).html">@cat.Name <span>@cat.ItemCount</span></a></li>
                        }
                    </ul>
                }
            </div>

            <!-- Video nổi bật -->
            @if(hotVideos.Any()) {
            <div class="tt-sidebar-box mb-3">
                <h4 class="tt-sidebar-title">VIDEO NỔI BẬT</h4>
                @foreach(var hv in hotVideos) {
                    <div class="tt-hot-item">
                        <div class="vd-thumb-wrap vd-thumb-sm" style="width: 80px; flex-shrink: 0; position: relative;">
                            <a href="/video/detail/@(hv.Slug).html">
                                <img src="@(string.IsNullOrEmpty(hv.ThumbnailUrl) ? "/assets/images/placeholder.png" : hv.ThumbnailUrl)" alt="@hv.Title" style="width:100%; aspect-ratio:16/9; object-fit:cover; border-radius: 4px;">
                                <div style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); color:#fff; font-size:16px; opacity:0.8;"><i class="fa-solid fa-circle-play"></i></div>
                            </a>
                        </div>
                        <div class="ms-2">
                            <a href="/video/detail/@(hv.Slug).html" class="tt-hot-title line-clamp-2" style="font-size: 13px;">@hv.Title</a>
                            <div class="tt-hot-meta" style="font-size: 11px;">
                                <i class="fa-regular fa-calendar"></i> @hv.CreatedAt.ToString("dd/MM/yyyy")
                            </div>
                        </div>
                    </div>
                }
            </div>
            }

            <!-- CTA Box -->
            <partial name="_SidebarCTA" />
        </div>
    </div>
</main>
