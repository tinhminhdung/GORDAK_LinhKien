<script src="/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
<script>
    // ════ STATE ════
    let selectedUrls = [];
    let currentView = 'grid';
    let currentFilter = 'all';
    let currentSort = 'name-asc';
    let ctxTarget = null;
    let ctxSidebarPath = '';
    let ctxSidebarType = '';

    const FIELD_ID = '@fieldId';
    const FUNC_NUM = '@funcNum';
    const BASE_URL = '/FileManager?fieldId=' + FIELD_ID + '&CKEditorFuncNum=' + FUNC_NUM;

    // ════ NAVIGATE ════
    function navigate(url) { location.href = url; }

    // ════ VIEW ════
    function setView(v) {
        currentView = v;
        const c = document.getElementById('file-container');
        c.className = 'view-' + v;
        document.querySelectorAll('.view-btn').forEach(b => b.classList.remove('active'));
        document.getElementById('vbtn-' + v)?.classList.add('active');
    }

    // ════ SORT ════
    function toggleSortMenu() {
        document.getElementById('sort-menu').classList.toggle('show');
    }
    function setSort(key, el) {
        currentSort = key;
        document.querySelectorAll('.sort-menu-item').forEach(i => i.classList.remove('active'));
        el.classList.add('active');
        // Use data-label to avoid icon characters appearing in the label
        document.getElementById('sort-text').textContent = el.dataset.label || el.querySelector('span')?.textContent || key;
        document.getElementById('sort-menu').classList.remove('show');
        sortItems();
    }
    function sortItems() {
        const c = document.getElementById('file-container');
        const items = [...c.querySelectorAll('.fm-item')];
        items.sort((a, b) => {
            const aFolder = a.classList.contains('folder-card');
            const bFolder = b.classList.contains('folder-card');
            if (aFolder && !bFolder) return -1;
            if (!aFolder && bFolder) return 1;
            const aName = (a.dataset.name || '');
            const bName = (b.dataset.name || '');
            const aSize = parseInt(a.dataset.size || '0');
            const bSize = parseInt(b.dataset.size || '0');
            const aDate = new Date(a.dataset.datemod || 0);
            const bDate = new Date(b.dataset.datemod || 0);
            switch (currentSort) {
                case 'name-asc': return aName.localeCompare(bName);
                case 'name-desc': return bName.localeCompare(aName);
                case 'date-desc': return bDate - aDate;
                case 'date-asc': return aDate - bDate;
                case 'size-desc': return bSize - aSize;
                case 'size-asc': return aSize - bSize;
                case 'type': return (a.dataset.type || '').localeCompare(b.dataset.type || '');
                default: return 0;
            }
        });
        items.forEach(el => c.appendChild(el));
    }

    // ════ FILTER ════
    function setFilter(type, el) {
        currentFilter = type;
        document.querySelectorAll('.filter-item').forEach(i => i.classList.remove('active'));
        el.classList.add('active');
        applyFilters();
    }
    function applyFilters() {
        const q = document.getElementById('searchInput').value.toLowerCase().trim();
        let vis = 0;
        document.querySelectorAll('.fm-item').forEach(el => {
            const name = el.dataset.name || '';
            const type = el.dataset.type || '';
            const matchQ = !q || name.includes(q);
            const matchType = currentFilter === 'all' || type === currentFilter || type === 'folder';
            el.style.display = matchQ && matchType ? '' : 'none';
            if (matchQ && matchType && type !== 'folder') vis++;
        });
        document.getElementById('fm-count-label').textContent = vis + ' tệp hiển thị';
    }

    // ════ SELECTION ════
    function toggleSelect(el) {
        if (el.classList.contains('folder-card')) return;
        const cb = el.querySelector('.item-checkbox');
        if (!cb) return;
        cb.checked = !cb.checked;
        syncSelection(cb);
    }
    function syncSelection(cb) {
        const url = cb.value;
        const item = cb.closest('.file-card');
        if (cb.checked) { if (!selectedUrls.includes(url)) selectedUrls.push(url); item?.classList.add('selected'); }
        else { selectedUrls = selectedUrls.filter(u => u !== url); item?.classList.remove('selected'); }
        updateBar();
    }
    function updateBar() {
        const bar = document.getElementById('multi-select-bar');
        document.getElementById('selected-count').innerText = selectedUrls.length;
        bar.style.display = selectedUrls.length > 0 ? 'block' : 'none';
    }
    function clearSelection() {
        document.querySelectorAll('.item-checkbox').forEach(cb => { cb.checked = false; cb.closest('.file-card')?.classList.remove('selected'); });
        selectedUrls = []; updateBar();
    }
    function useSelected() {
        if (!selectedUrls.length) return;
        if (window.opener) {
            if (FUNC_NUM && window.opener.CKEDITOR) window.opener.CKEDITOR.tools.callFunction(FUNC_NUM, selectedUrls[0]);
            else if (window.opener.setFileUrl) window.opener.setFileUrl(selectedUrls, FIELD_ID);
            window.close();
        } else {
            // Support iframe / postMessage
            window.parent.postMessage({ type: 'fileSelected', url: selectedUrls[0], fieldId: FIELD_ID }, '*');
        }
    }
    function quickUse(url) {
        if (window.opener) {
            if (FUNC_NUM && window.opener.CKEDITOR) window.opener.CKEDITOR.tools.callFunction(FUNC_NUM, url);
            else if (window.opener.setFileUrl) window.opener.setFileUrl([url], FIELD_ID);
            window.close();
        } else {
            // Support iframe / postMessage
            window.parent.postMessage({ type: 'fileSelected', url: url, fieldId: FIELD_ID }, '*');
        }
    }

    // ════ CONTEXT MENU – File ════
    function showFileCtx(e, el, type, path, name) {
        e.preventDefault(); e.stopPropagation();
        ctxTarget = { el, type, path, name };
        const m = document.getElementById('ctx-menu');
        const isImage = type === 'file' && path.match(/\.(jpg|jpeg|png|webp|gif|bmp)$/i);
        document.getElementById('ctx-use').style.display = type === 'file' ? 'flex' : 'none';
        document.getElementById('ctx-preview').style.display = isImage ? 'flex' : 'none';
        document.getElementById('ctx-open-tab').style.display = type === 'file' ? 'flex' : 'none';
        document.getElementById('ctx-copy').style.display = type === 'file' ? 'flex' : 'none';
        // Image-specific items
        document.getElementById('ctx-edit-img').style.display = isImage ? 'flex' : 'none';
        document.getElementById('ctx-regen').style.display = isImage ? 'flex' : 'none';
        document.getElementById('ctx-info').style.display = isImage ? 'flex' : 'none';
        m.style.display = 'block';
        positionMenu(m, e);
    }
    function positionMenu(m, e) {
        m.style.left = e.clientX + 'px'; m.style.top = e.clientY + 'px';
        setTimeout(() => {
            const r = m.getBoundingClientRect();
            if (r.right > window.innerWidth) m.style.left = (e.clientX - r.width) + 'px';
            if (r.bottom > window.innerHeight) m.style.top = (e.clientY - r.height) + 'px';
        }, 0);
    }
    function ctxUse() {
        if (ctxTarget) quickUse(ctxTarget.path);
    }
    function ctxCopy() {
        if (ctxTarget) { navigator.clipboard.writeText(window.location.origin + ctxTarget.path).then(() => alert('Đã sao chép đường dẫn!')); }
    }
    function ctxPreview() {
        if (!ctxTarget) return;
        document.getElementById('preview-img').src = ctxTarget.path;
        document.getElementById('preview-name').textContent = ctxTarget.name;
        new bootstrap.Modal(document.getElementById('previewModal')).show();
    }
    function ctxOpenTab() { if (ctxTarget) window.open(ctxTarget.path, '_blank'); }
    function ctxDelete() {
        if (!ctxTarget) return;
        document.getElementById('deleteInputs').innerHTML = '<input type="hidden" name="itemPaths" value="' + ctxTarget.path + '" />';
        document.getElementById('del-name').textContent = ctxTarget.name;
        hideCtxMenus();
        new bootstrap.Modal(document.getElementById('deleteModal')).show();
    }
    function ctxUseFromPreview() {
        const src = document.getElementById('preview-img').src;
        const rel = src.replace(window.location.origin, '');
        quickUse(rel);
    }

    // ════ CONTEXT MENU – Sidebar ════
    function showSidebarCtx(e, path, type) {
        e.preventDefault(); e.stopPropagation();
        ctxSidebarPath = path; ctxSidebarType = type;
        const m = document.getElementById('sidebar-ctx');
        const delBtn = document.getElementById('sidebar-ctx-delete');
        delBtn.style.display = type === 'root' ? 'none' : 'flex';
        m.style.display = 'block';
        positionMenu(m, e);
    }
    function sidebarNavigate() { navigate(BASE_URL + '&path=' + ctxSidebarPath); hideCtxMenus(); }
    function sidebarCreateSub() {
        document.getElementById('cf-path').value = ctxSidebarPath;
        document.getElementById('cf-label').innerHTML = 'Thư mục con trong: <b>' + (ctxSidebarPath || '/Uploads') + '</b>';
        document.getElementById('cf-name').value = '';
        hideCtxMenus();
        new bootstrap.Modal(document.getElementById('createFolderModal')).show();
    }
    function sidebarDelete() {
        if (!ctxSidebarPath) return;
        const name = ctxSidebarPath.split('/').pop();
        document.getElementById('deleteInputs').innerHTML = '<input type="hidden" name="itemPaths" value="' + ctxSidebarPath + '" />';
        document.getElementById('del-name').textContent = name;
        hideCtxMenus();
        new bootstrap.Modal(document.getElementById('deleteModal')).show();
    }

    function bulkDelete() {
        if (!selectedUrls.length) return;
        let html = '';
        selectedUrls.forEach(url => html += '<input type="hidden" name="itemPaths" value="' + url + '" />');
        document.getElementById('deleteInputs').innerHTML = html;
        document.getElementById('del-name').textContent = selectedUrls.length + ' mục đã chọn';
        new bootstrap.Modal(document.getElementById('deleteModal')).show();
    }

    // ════ HELPERS ════
    function hideCtxMenus() {
        document.getElementById('ctx-menu').style.display = 'none';
        document.getElementById('sidebar-ctx').style.display = 'none';
        document.getElementById('sort-menu').classList.remove('show');
    }
    document.addEventListener('click', hideCtxMenus);

    // ════ FULLSCREEN ════
    function toggleFullscreen() {
        document.body.classList.toggle('fullscreen-mode');
        const icon = document.getElementById('fullscreen-icon');
        icon.className = document.body.classList.contains('fullscreen-mode') ? 'ri-fullscreen-exit-line' : 'ri-fullscreen-line';
    }

    // ════ IMAGE INFO ════
    function ctxImageInfo() {
        if (!ctxTarget) return;
        hideCtxMenus();
        const el = ctxTarget.el;
        document.getElementById('info-name').textContent = ctxTarget.name;
        const w = el?.dataset.imgw || '?', h = el?.dataset.imgh || '?';
        document.getElementById('info-dimensions').textContent = w + ' × ' + h + ' px';
        const size = parseInt(el?.dataset.size || 0);
        document.getElementById('info-size').textContent = size > 1024*1024 ? (size/1024/1024).toFixed(2)+' MB' : Math.round(size/1024)+' KB';
        const typeLabels = { banner:'🟦 Banner', landscape:'🟧 Ngang', square:'🟩 Vuông', portrait:'🟪 Dọc' };
        document.getElementById('info-type').textContent = typeLabels[el?.dataset.imgtype] || 'Không xác định';
        const hasThumb = el?.dataset.hasthumb === 'true';
        document.getElementById('info-thumb').innerHTML = hasThumb ? '✅ Có thumbnail WebP' : '⚠️ Chưa tối ưu';
        const saved = hasThumb ? '—' : '0%';
        document.getElementById('info-saved').textContent = hasThumb ? 'Đã tối ưu' : 'Chưa tối ưu - Bấm "Tạo lại Thumbnail"';
        new bootstrap.Modal(document.getElementById('imageInfoModal')).show();
    }

    // ════ REGENERATE THUMBNAIL ════
    function ctxRegenerateThumb() {
        if (!ctxTarget) return;
        hideCtxMenus();
        fetch('/FileManager/RegenerateThumbnail', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'filePath=' + encodeURIComponent(ctxTarget.path)
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                alert('✅ Đã tạo thumbnail thành công! (' + Math.round(data.thumbSize/1024) + ' KB)');
                location.reload();
            } else {
                alert('❌ ' + (data.message || 'Lỗi'));
            }
        });
    }

    // ════ IMAGE EDITOR (Cropper.js) ════
    let cropper = null;
    function ctxEditImage() {
        if (!ctxTarget) return;
        hideCtxMenus();
        document.getElementById('edit-img-name').textContent = ctxTarget.name;
        const img = document.getElementById('cropperImage');
        img.src = ctxTarget.path + '?t=' + Date.now(); // cache bust

        // Destroy previous cropper
        if (cropper) { cropper.destroy(); cropper = null; }

        const modal = new bootstrap.Modal(document.getElementById('editImageModal'));
        modal.show();

        // Init cropper after modal is fully shown
        document.getElementById('editImageModal').addEventListener('shown.bs.modal', function handler() {
            if (cropper) cropper.destroy();
            cropper = new Cropper(img, {
                viewMode: 1,
                autoCropArea: 0.8,
                responsive: true,
                background: true
            });
            this.removeEventListener('shown.bs.modal', handler);
        });
    }

    function setCropRatio(ratio) {
        if (cropper) cropper.setAspectRatio(ratio);
    }

    function cropperRotate(deg) {
        if (cropper) cropper.rotate(deg);
    }

    function saveCroppedImage() {
        if (!cropper || !ctxTarget) return;
        const data = cropper.getData(true);
        fetch('/FileManager/CropImage', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `filePath=${encodeURIComponent(ctxTarget.path)}&x=${data.x}&y=${data.y}&width=${data.width}&height=${data.height}`
        })
        .then(r => r.json())
        .then(res => {
            if (res.success) {
                alert('✅ Đã lưu & tối ưu! Thumbnail mới: ' + Math.round(res.thumbSize/1024) + ' KB\n\n⚠️ Ảnh gốc KHÔNG bị thay đổi.');
                bootstrap.Modal.getInstance(document.getElementById('editImageModal'))?.hide();
                location.reload();
            } else {
                alert('❌ ' + (res.message || 'Lỗi'));
            }
        });
    }

    // Cleanup cropper on modal close
    document.getElementById('editImageModal')?.addEventListener('hidden.bs.modal', function() {
        if (cropper) { cropper.destroy(); cropper = null; }
    });

    // ════ BULK OPTIMIZE ════
    function bulkOptimizeAll() {
        if (!confirm('🚀 Tạo thumbnail cho TẤT CẢ ảnh chưa tối ưu?\n\nQuá trình này có thể mất vài phút.\nẢnh gốc KHÔNG bị thay đổi.')) return;
        fetch('/FileManager/BulkOptimize', { method: 'POST' })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                const savedMB = (data.savedBytes / 1024 / 1024).toFixed(1);
                alert(`✅ Hoàn tất!\n\n📊 Tổng: ${data.total} ảnh\n✅ Đã tối ưu: ${data.optimized} ảnh\n💾 Tiết kiệm: ${savedMB} MB\n\n⚠️ Ảnh gốc KHÔNG bị thay đổi.`);
                location.reload();
            }
        });
    }

    // ════ DRAG & DROP ════
    const dragOverlay = document.getElementById('drag-overlay');
    let dragCounter = 0;
    document.addEventListener('dragenter', e => { e.preventDefault(); dragCounter++; dragOverlay.classList.add('active'); });
    document.addEventListener('dragleave', e => { e.preventDefault(); dragCounter--; if (dragCounter <= 0) { dragCounter = 0; dragOverlay.classList.remove('active'); } });
    document.addEventListener('dragover', e => e.preventDefault());
    document.addEventListener('drop', e => {
        e.preventDefault();
        dragCounter = 0;
        dragOverlay.classList.remove('active');
        if (e.dataTransfer.files.length > 0) {
            const form = new FormData();
            form.append('currentPath', '@currentPath');
            form.append('fieldId', '@fieldId');
            form.append('CKEditorFuncNum', '@funcNum');
            for (const file of e.dataTransfer.files) { form.append('files', file); }
            fetch('/FileManager/Upload', { method: 'POST', body: form })
            .then(() => location.reload());
        }
    });

    // ════ KEYBOARD SHORTCUTS ════
    document.addEventListener('keydown', e => {
        if (e.key === 'Escape') { hideCtxMenus(); return; }
        // F2 → Edit image
        if (e.key === 'F2' && selectedUrls.length === 1) {
            e.preventDefault();
            const sel = document.querySelector('.file-card.selected');
            if (sel && sel.dataset.url?.match(/\.(jpg|jpeg|png|webp|gif|bmp)$/i)) {
                ctxTarget = { el: sel, type: 'file', path: sel.dataset.url, name: sel.querySelector('.fname')?.textContent || '' };
                ctxEditImage();
            }
        }
        // F11 → Fullscreen
        if (e.key === 'F11') { e.preventDefault(); toggleFullscreen(); }
        // Delete → Delete selected
        if (e.key === 'Delete' && selectedUrls.length > 0) { e.preventDefault(); bulkDelete(); }
        // Ctrl+A → Select all
        if (e.key === 'a' && (e.ctrlKey || e.metaKey)) {
            e.preventDefault();
            document.querySelectorAll('.file-card .item-checkbox').forEach(cb => {
                cb.checked = true; syncSelection(cb);
            });
        }
    });

</script>
</body>
</html>
