@model Antigravity.ECommerce.Models.Order
@{
    ViewBag.Title = "Thanh toán đơn hàng";
}

<section class="checkout-section py-5 bg-light">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white border-bottom-0 pt-4 px-4">
                        <h4 class="fw-bold mb-0"><i class="ri-map-pin-line me-2 text-primary"></i> Thông tin giao hàng</h4>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Họ và tên <span class="text-danger">*</span></label>
                                <input type="text" class="form-control form-control-lg" placeholder="Nguyễn Văn A" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Số điện thoại <span class="text-danger">*</span></label>
                                <input type="tel" class="form-control form-control-lg" placeholder="0901234567" required>
                            </div>
                            <div class="col-md-12">
                                <label class="form-label">Địa chỉ email (Để nhận hóa đơn)</label>
                                <input type="email" class="form-control form-control-lg" placeholder="example@gmail.com">
                            </div>

                            <!-- Bộ chọn địa giới 2026 -->
                            <div class="col-md-4">
                                <label class="form-label">Tỉnh / Thành phố <span class="text-danger">*</span></label>
                                <select id="ProvinceId" class="form-select form-select-lg selectpicker" data-live-search="true" title="Chọn Tỉnh thành">
                                    @foreach (var p in ViewBag.Provinces) {
                                        <option value="@p.ProvinceId">@p.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Phường / Xã <span class="text-danger">*</span></label>
                                <select id="WardId" class="form-select form-select-lg selectpicker" data-live-search="true" title="Chọn Phường xã" disabled>
                                    <option value="">Vui lòng chọn Tỉnh</option>
                                </select>
                            </div>

                            <div class="col-md-12">
                                <label class="form-label">Địa chỉ chi tiết (Số nhà, tên đường...)</label>
                                <textarea class="form-control" rows="2" placeholder="VD: Số 12, Ngõ 34, Đường ABC..."></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header bg-white border-bottom-0 pt-4 px-4">
                        <h4 class="fw-bold mb-0"><i class="ri-bank-card-line me-2 text-primary"></i> Phương thức thanh toán</h4>
                    </div>
                    <div class="card-body p-4">
                        <div class="payment-options">
                            <div class="form-check payment-item p-3 border rounded-3 mb-3">
                                <input class="form-check-input" type="radio" name="payment" id="cod" checked>
                                <label class="form-check-label d-flex align-items-center" for="cod">
                                    <i class="ri-truck-line fs-24 me-3 text-success"></i>
                                    <div>
                                        <span class="fw-bold d-block">Thanh toán khi nhận hàng (COD)</span>
                                        <small class="text-muted">Kiểm tra hàng trước khi thanh toán</small>
                                    </div>
                                </label>
                            </div>
                            <div class="form-check payment-item p-3 border rounded-3">
                                <input class="form-check-input" type="radio" name="payment" id="bank">
                                <label class="form-check-label d-flex align-items-center" for="bank">
                                    <i class="ri-bank-line fs-24 me-3 text-primary"></i>
                                    <div>
                                        <span class="fw-bold d-block">Chuyển khoản ngân hàng</span>
                                        <small class="text-muted">Hỗ trợ Napas 24/7 siêu tốc</small>
                                    </div>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 sticky-top" style="top: 20px;">
                    <div class="card-header bg-white border-bottom-0 pt-4 px-4">
                        <h4 class="fw-bold mb-0">Tóm tắt đơn hàng</h4>
                    </div>
                    <div class="card-body p-4">
                        <div class="cart-items mb-4">
                            <!-- Demo item -->
                            <div class="d-flex align-items-center mb-3">
                                <img src="/uploads/SanPham/img-1.jpg" class="rounded-3 me-3" style="width: 60px; height: 60px; object-fit: cover;">
                                <div class="flex-grow-1">
                                    <h6 class="mb-0 text-truncate" style="max-width: 180px;">iPhone 15 Pro Max</h6>
                                    <small class="text-muted">SL: 1 x 34,990,000đ</small>
                                </div>
                            </div>
                        </div>

                        <hr>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Tạm tính</span>
                            <span class="fw-bold">34,990,000đ</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Phí vận chuyển</span>
                            <span class="text-success fw-bold">Miễn phí</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-4">
                            <h5 class="fw-bold">Tổng cộng</h5>
                            <h5 class="fw-bold text-danger">34,990,000đ</h5>
                        </div>

                        <button class="btn btn-primary btn-lg w-100 rounded-pill py-3 fw-bold">
                            XÁC NHẬN ĐẶT HÀNG
                        </button>
                        <p class="text-center small text-muted mt-3 mb-0">
                            Bằng cách đặt hàng, bạn đồng ý với Điều khoản dịch vụ của chúng tôi.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-select@1.14.0-beta3/dist/css/bootstrap-select.min.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-select@1.14.0-beta3/dist/js/bootstrap-select.min.js"></script>

    <script>
        $(function() {
            // Load Wards when Province changes
            $('#ProvinceId').on('change', function() {
                var pId = $(this).val();
                $('#WardId').empty().append('<option value="">Đang tải...</option>').prop('disabled', true).selectpicker('refresh');

                if (pId) {
                    $.get('/Location/GetPhuongXa?maTinh=' + pId, function(data) {
                        var html = '<option value="">Chọn Phường xã</option>';
                        data.forEach(function(item) {
                            html += '<option value="' + item.ma_Xa + '">' + item.ten_Xa + '</option>';
                        });
                        $('#WardId').html(html).prop('disabled', false).selectpicker('refresh');
                    });
                }
            });
        });
    </script>
}

<style>
    .payment-item {
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .payment-item:hover {
        background-color: #f8f9fa;
        border-color: #1a3c8a !important;
    }
    .payment-item input:checked + label {
        color: #1a3c8a;
    }
    .selectpicker + .btn {
        background: white !important;
        border: 1px solid #dee2e6 !important;
        padding: 0.6rem 1rem !important;
    }
</style>
