@model Antigravity.ECommerce.Models.Category
@{
    ViewData["Title"] = "Thêm mới Danh mục Tài liệu";
    Layout = "_AdminLayout";
}

<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0">Thêm Danh mục Tài liệu</h4>
            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="/AdminDocumentCategory" class="btn btn-soft-dark btn-sm"><i class="ri-arrow-left-line align-bottom me-1"></i> Quay lại danh sách</a></li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <form action="/AdminDocumentCategory/Create" method="post" id="categoryForm">
                    <div class="mb-3">
                        <label class="form-label">Tên danh mục <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" asp-for="Name" id="Name" placeholder="Nhập tên danh mục">
                        <span asp-validation-for="Name" class="text-danger mt-1 d-block"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Tùy chỉnh Slug (URL)</label>
                            <input type="text" class="form-control" asp-for="Slug" id="Slug" placeholder="tu-dong-theo-ten">
                            <span asp-validation-for="Slug" class="text-danger mt-1 d-block"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Danh mục cha</label>
                            <select class="form-control selectpicker" data-live-search="true" asp-for="ParentId">
                                <option value="0">--- Là danh mục gốc ---</option>
                                @if(ViewBag.Categories != null)
                                {
                                    foreach(var item in ViewBag.Categories as List<Antigravity.ECommerce.Models.Category>)
                                    {
                                        <option value="@item.CategoryId">@item.Name</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <input type="hidden" asp-for="CategoryType" value="6" />
                    <input type="hidden" asp-for="LinkType" value="1" />
                    <input type="hidden" asp-for="Url" />
                    <input type="hidden" asp-for="Target" value="_self" />
                    <input type="hidden" asp-for="MenuPosition" />

                    <div class="mb-3">
                        <label class="form-label">Mô tả ngắn</label>
                        <textarea class="form-control" id="Description" asp-for="Description" rows="3" placeholder="Nhập mô tả ngắn gọn..."></textarea>
                    </div>

                    <div class="mb-3" id="divContent" style="display:none;">
                        <label class="form-label">Nội dung chi tiết</label>
                        <textarea id="ckeditor-classic" asp-for="Content"></textarea>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Thứ tự hiển thị</label>
                            <input type="number" class="form-control" asp-for="SortOrder" value="0">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Trạng thái</label>
                            <select class="form-control" asp-for="Status">
                                <option value="1">Hiển thị</option>
                                <option value="0">Ẩn</option>
                            </select>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        
                        
                    </div>
                
                <div class="d-flex justify-content-between mt-4 border-top pt-3">
                    <a href="/AdminDocumentCategory" class="btn btn-light"><i class="ri-arrow-go-back-line me-1"></i>Quay lại</a>
                    <button type="submit" class="btn btn-success px-4"><i class="ri-save-line me-1"></i>Lưu thêm mới</button>
                </div>
            </form>
            </div>
        </div>

        <div class="card mt-3" id="divSeoCard">
            <div class="card-header"><h5 class="card-title mb-0">Tối ưu SEO</h5></div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Tiêu đề SEO</label>
                    <input type="text" class="form-control" id="SeoTitle" form="categoryForm" asp-for="SeoTitle" placeholder="Tiêu đề hiển thị trên Google">
                </div>
                <div class="mb-3">
                    <label class="form-label">Mô tả SEO</label>
                    <textarea class="form-control" id="SeoDescription" form="categoryForm" asp-for="SeoDescription" rows="3" placeholder="Đoạn mô tả ngắn"></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label">Từ khóa SEO</label>
                    <input type="text" class="form-control" form="categoryForm" asp-for="SeoKeywords" placeholder="Cách nhau bằng dấu phẩy">
                </div>
                <div class="bg-light p-3 rounded mt-3">
                    <h6 class="fs-13 text-muted mb-2 text-uppercase">Google Search Preview</h6>
                    <div style="font-family: Arial, sans-serif;">
                        <div class="text-primary fs-18 mb-1" id="seo_preview_title">Tiêu đề SEO sẽ hiển thị ở đây...</div>
                        <div class="text-success fs-13 mb-1">https://example.com/tai-lieu/<span id="seo_preview_slug">slug-cua-trang</span>.html</div>
                        <div class="text-muted fs-13" id="seo_preview_desc" style="line-height:1.4;">Mô tả SEO sẽ hiển thị ở đây. Độ dài tối ưu khoảng 150-160 ký tự.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header"><h5 class="card-title mb-0">Hình ảnh danh mục</h5></div>
            <div class="card-body">
                <div class="input-group mb-3">
                    <input type="text" class="form-control" asp-for="Image" id="Image" form="categoryForm" placeholder="Chưa chọn ảnh..." readonly>
                    <button class="btn btn-primary" type="button" onclick="openFileManager('Image')">Chọn ảnh</button>
                </div>
                <img id="imgPreview" src="" style="max-width: 100%; display: none; border-radius: 4px;" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/ckeditor/ckeditor.js"></script>
    <script>
        function openFileManager(fieldId) {
            window.open('/FileManager?fieldId=' + fieldId, 'FileManager', 'width=1100,height=750');
        }

        function setFileUrl(url, fieldId) {
            const fileUrl = Array.isArray(url) ? url[0] : url;
            const input = document.getElementById(fieldId);
            if (input) {
                input.value = fileUrl;
                if (fieldId === 'Image') {
                    const preview = document.getElementById('imgPreview');
                    if (preview) { preview.src = fileUrl; preview.style.display = 'block'; }
                }
            }
        }

        document.getElementById('Name').addEventListener('input', function() {
            var slug = this.value.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[đĐ]/g, 'd').replace(/([^a-z0-9\s])/g, '').replace(/\s+/g, '-').replace(/-+/g, '-').replace(/^-+|-+$/g, '');
            document.getElementById('Slug').value = slug;
            updateSeoPreview();
        });

        function updateSeoPreview() {
            const title = document.getElementById('SeoTitle').value || document.getElementById('Name').value || 'Tiêu đề SEO sẽ hiển thị ở đây...';
            let desc = document.getElementById('SeoDescription').value || document.getElementById('Description').value || 'Mô tả SEO sẽ hiển thị ở đây. Độ dài tối ưu khoảng 150-160 ký tự.';
            const slug = document.getElementById('Slug').value || 'slug-cua-trang';
            
            document.getElementById('seo_preview_title').innerText = title;
            document.getElementById('seo_preview_desc').innerText = desc.substring(0, 160);
            document.getElementById('seo_preview_slug').innerText = slug;
        }

        document.getElementById('SeoTitle').addEventListener('input', updateSeoPreview);
        document.getElementById('SeoDescription').addEventListener('input', updateSeoPreview);
        document.getElementById('Description').addEventListener('input', updateSeoPreview);
        document.getElementById('Slug').addEventListener('input', updateSeoPreview);
    </script>
}

