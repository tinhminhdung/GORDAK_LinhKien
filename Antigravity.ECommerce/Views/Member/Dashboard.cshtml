@{
    Layout = "_MemberLayout";
    ViewData["Title"] = "Tổng quan tài khoản";
    var customer = ViewBag.Customer as Antigravity.ECommerce.Models.Customer;
    var recentOrders = ViewBag.RecentOrders as List<Antigravity.ECommerce.Models.Order>;
}

@section MemberStyles {
    <style>
        .stat-card {
            background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
            border-radius: 16px;
            padding: 1.5rem;
            border: 1px solid #edf2f7;
            display: flex;
            align-items: center;
            box-shadow: 0 4px 6px rgba(0,0,0,0.02);
            transition: transform 0.3s;
        }
        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.05);
        }
        .stat-icon {
            width: 60px;
            height: 60px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.75rem;
            margin-right: 1.25rem;
        }
        .icon-blue { background: #ebf4ff; color: #3182ce; }
        .icon-green { background: #f0fff4; color: #38a169; }
        .icon-yellow { background: #fffff0; color: #d69e2e; }
        .stat-content h3 {
            font-size: 1.5rem;
            font-weight: 700;
            color: #2d3748;
            margin: 0;
        }
        .stat-content p {
            font-size: 0.875rem;
            color: #718096;
            margin: 0;
            font-weight: 500;
        }
        .section-title {
            font-size: 1.25rem;
            font-weight: 700;
            color: #1a202c;
            margin-bottom: 1.5rem;
            padding-bottom: 0.5rem;
            border-bottom: 2px solid #edf2f7;
        }
        @@media (max-width: 767px) {
            .stat-card {
                padding: 0.75rem;
                border-radius: 12px;
            }
            .stat-icon {
                width: 42px;
                height: 42px;
                font-size: 1.25rem;
                margin-right: 0.75rem;
                border-radius: 10px;
            }
            .stat-content h3 {
                font-size: 1.1rem;
            }
            .stat-content p {
                font-size: 0.75rem;
            }
            .section-title {
                font-size: 1rem;
                margin-bottom: 1rem;
            }
            .member-content .table {
                font-size: 0.8rem;
            }
            .member-content h4 {
                font-size: 1rem;
            }
        }
    </style>
}

<div class="row mb-4">
    <div class="col-md-4 mb-3">
        <div class="stat-card">
            <div class="stat-icon icon-blue">
                <i class="fa-solid fa-bag-shopping"></i>
            </div>
            <div class="stat-content">
                <h3>@ViewBag.RealTotalOrders</h3>
                <p>Tổng đơn hàng</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="stat-card">
            <div class="stat-icon icon-green">
                <i class="fa-solid fa-wallet"></i>
            </div>
            <div class="stat-content">
                <h3>@(((decimal)ViewBag.RealTotalSpent).ToString("N0"))đ</h3>
                <p>Tổng chi tiêu</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <a href="/thanh-vien/danh-gia.html" class="text-decoration-none">
            <div class="stat-card">
                <div class="stat-icon icon-yellow">
                    <i class="fa-solid fa-star"></i>
                </div>
                <div class="stat-content">
                    <h3>★</h3>
                    <p>Đánh giá của tôi</p>
                </div>
            </div>
        </a>
    </div>
</div>

<h4 class="section-title">Đơn hàng gần đây</h4>
@if (recentOrders != null && recentOrders.Any())
{
    <!-- Desktop table -->
    <div class="table-responsive d-none d-md-block">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Mã đơn</th>
                    <th>Ngày đặt</th>
                    <th>Tổng tiền</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in recentOrders)
                {
                    <tr>
                        <td><strong>@order.OrderCode</strong></td>
                        <td>@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td><strong class="text-danger">@order.TotalAmount.ToString("N0")đ</strong></td>
                        <td>
                            @switch (order.OrderStatus)
                            {
                                case 0: <span class="badge bg-warning">Chờ xác nhận</span>; break;
                                case 1: <span class="badge bg-info">Đang xử lý</span>; break;
                                case 2: <span class="badge bg-primary">Đang giao</span>; break;
                                case 3: <span class="badge bg-success">Hoàn thành</span>; break;
                                case 4: <span class="badge bg-danger">Đã hủy</span>; break;
                                default: <span class="badge bg-secondary">Không xác định</span>; break;
                            }
                        </td>
                        <td>
                            <a href="@Url.Action("OrderDetail", "Member", new { id = order.OrderId })" class="btn btn-sm btn-outline-primary">Chi tiết</a>
                            @if(order.OrderStatus == 3)
                            {
                                <form asp-controller="Member" asp-action="Reorder" method="post" class="d-inline">
                                    <input type="hidden" name="orderId" value="@order.OrderId" />
                                    <button type="submit" class="btn btn-sm btn-outline-success">Mua lại</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Mobile card list -->
    <div class="d-md-none">
        @foreach (var order in recentOrders)
        {
            <div style="background:#fff;border:1px solid #edf2f7;border-radius:10px;padding:10px;margin-bottom:8px;">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <strong style="font-size:0.82rem;">@order.OrderCode</strong>
                    <small class="text-muted" style="font-size:0.72rem;">@order.CreatedAt.ToString("dd/MM/yyyy")</small>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-danger" style="font-size:0.95rem;">@order.TotalAmount.ToString("N0")đ</span>
                    <span>
                        @switch (order.OrderStatus)
                        {
                            case 0: <span class="badge bg-warning" style="font-size:0.7rem;">Chờ xác nhận</span>; break;
                            case 1: <span class="badge bg-info" style="font-size:0.7rem;">Đang xử lý</span>; break;
                            case 2: <span class="badge bg-primary" style="font-size:0.7rem;">Đang giao</span>; break;
                            case 3: <span class="badge bg-success" style="font-size:0.7rem;">Hoàn thành</span>; break;
                            case 4: <span class="badge bg-danger" style="font-size:0.7rem;">Đã hủy</span>; break;
                            default: <span class="badge bg-secondary" style="font-size:0.7rem;">N/A</span>; break;
                        }
                        <a href="@Url.Action("OrderDetail", "Member", new { id = order.OrderId })" class="btn btn-sm btn-outline-primary ms-1" style="font-size:0.72rem;padding:2px 8px;">Chi tiết</a>
                    </span>
                </div>
            </div>
        }
    </div>

    <div class="text-center mt-3">
        <a href="@Url.Action("Orders", "Member")" class="btn btn-link text-decoration-none">Xem tất cả đơn hàng <i class="fa-solid fa-arrow-right"></i></a>
    </div>
}
else
{
    <div class="text-center py-4">
        <i class="fa-solid fa-cart-arrow-down text-muted mb-3 d-block" style="font-size: 80px; opacity: 0.5"></i>
        <p class="text-muted">Bạn chưa có đơn hàng nào.</p>
        <a href="/" class="btn btn-primary">Mua sắm ngay</a>
    </div>
}

