@{
    Layout = "_MainLayout";
    var customer = ViewBag.Customer as Antigravity.ECommerce.Models.Customer;
}

@section Styles {
    <style>
        .member-layout {
            padding: 1.5rem 15px;
            background: #f8f9fa;
            min-height: calc(100vh - 200px);
        }
        .member-sidebar {
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
            padding: 2rem 1.5rem;
            position: sticky;
            top: 2rem;
        }
        .member-avatar-box {
            text-align: center;
            margin-bottom: 2rem;
            padding-bottom: 2rem;
            border-bottom: 1px solid #edf2f7;
        }
        .member-avatar {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid #fff;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            margin-bottom: 1rem;
        }
        .member-name {
            font-size: 1.25rem;
            font-weight: 700;
            color: #1a202c;
            margin-bottom: 0.25rem;
        }
        .member-rank {
            display: inline-block;
            padding: 0.25rem 1rem;
            background: linear-gradient(135deg, #f6e05e 0%, #ecc94b 100%);
            color: #744210;
            border-radius: 20px;
            font-size: 0.875rem;
            font-weight: 600;
        }
        .member-nav {
            list-style: none;
            padding: 0;
            margin: 0;
        }
        .member-nav li {
            margin-bottom: 0.5rem;
        }
        .member-nav a {
            display: flex;
            align-items: center;
            padding: 0.75rem 1rem;
            color: #4a5568;
            text-decoration: none;
            border-radius: 10px;
            font-weight: 500;
            transition: all 0.2s;
        }
        .member-nav a:hover, .member-nav a.active {
            background: #e6f0fa;
            color: #1a3c8a;
        }
        .member-nav a i {
            margin-right: 10px;
            font-size: 1.25rem;
        }
        .member-content {
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
            padding: 2rem;
        }
        @@media (max-width: 767px) {
            .member-layout {
                padding: 0.5rem 0;
            }
            .member-sidebar {
                padding: 0.75rem;
                margin: 0;
                border-radius: 10px;
                width: 100%;
                box-shadow: 0 2px 8px rgba(0,0,0,0.04);
            }
            .member-content {
                padding: 0.75rem;
                margin: 0;
                border-radius: 10px;
                width: 100%;
            }
            .member-avatar-box {
                display: flex;
                align-items: center;
                text-align: left;
                margin-bottom: 0.75rem;
                padding-bottom: 0.75rem;
                gap: 12px;
            }
            .member-avatar {
                width: 50px;
                height: 50px;
                margin-bottom: 0;
                border-width: 2px;
            }
            .member-name {
                font-size: 1rem;
                margin-bottom: 0.15rem;
            }
            .member-rank {
                font-size: 0.75rem;
                padding: 0.15rem 0.6rem;
            }
            .member-nav {
                display: flex;
                overflow-x: auto;
                gap: 4px;
                padding-bottom: 4px;
                -webkit-overflow-scrolling: touch;
                scrollbar-width: none;
            }
            .member-nav::-webkit-scrollbar {
                display: none;
            }
            .member-nav li {
                margin-bottom: 0;
                flex-shrink: 0;
            }
            .member-nav a {
                padding: 0.4rem 0.75rem;
                font-size: 0.8rem;
                border-radius: 20px;
                white-space: nowrap;
                background: #f5f7fa;
            }
            .member-nav a:hover, .member-nav a.active {
                background: #1a3c8a;
                color: #fff;
            }
            .member-nav a i {
                font-size: 0.85rem;
                margin-right: 5px;
            }
        }
        
        /* Ghi đè màu chủ đạo cho các trang thành viên */
        .btn-primary {
            background-color: #1a3c8a;
            border-color: #1a3c8a;
        }
        .btn-primary:hover {
            background-color: #122b63;
            border-color: #122b63;
        }
        .btn-outline-primary {
            color: #1a3c8a;
            border-color: #1a3c8a;
        }
        .btn-outline-primary:hover {
            background-color: #1a3c8a;
            border-color: #1a3c8a;
            color: #fff;
        }
        .text-primary {
            color: #1a3c8a !important;
        }
        .btn-link {
            color: #1a3c8a;
        }
        .btn-link:hover {
            color: #122b63;
        }
    </style>
    @RenderSection("MemberStyles", required: false)
}

<div class="member-layout">
    <div class="container px-3 px-md-0">
        <nav class="sp-breadcrumb mb-4" style="background: transparent; padding: 0;">
            <a href="/">Trang chủ</a> <i class="fa-solid fa-chevron-right mx-2 text-muted" style="font-size:10px;"></i>
            <a href="@Url.Action("Dashboard", "Member")">Thành viên</a> <i class="fa-solid fa-chevron-right mx-2 text-muted" style="font-size:10px;"></i>
            <span>@ViewData["Title"]</span>
        </nav>
        <div class="row">
            <div class="col-lg-3 mb-4 mb-lg-0">
                <div class="member-sidebar">
                    <div class="member-avatar-box">
                        @{
                            var avatarUrl = !string.IsNullOrEmpty(customer?.Avatar) ? customer.Avatar : $"https://ui-avatars.com/api/?name={System.Net.WebUtility.UrlEncode(customer?.FullName ?? "User")}&background=random&size=100";
                        }
                        <img src="@avatarUrl" alt="Avatar" class="member-avatar">
                        <div class="member-name">@(customer?.FullName ?? "Thành viên")</div>
                        <div class="member-rank">@(customer?.MemberRankName ?? "Hạng thường")</div>
                    </div>
                    <ul class="member-nav">
                        <li>
                            <a href="@Url.Action("Dashboard", "Member")" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")">
                                <i class="fa-solid fa-gauge"></i> Tổng quan
                            </a>
                        </li>
                        <li>
                            <a href="@Url.Action("Orders", "Member")" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Orders" ? "active" : "")">
                                <i class="fa-solid fa-file-invoice-dollar"></i> Đơn hàng của tôi
                            </a>
                        </li>
                        <li>
                            <a href="@Url.Action("Profile", "Member")" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Profile" ? "active" : "")">
                                <i class="fa-solid fa-user-gear"></i> Thông tin cá nhân
                            </a>
                        </li>
                        <li>
                            <a href="@Url.Action("Wishlist", "Member")" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Wishlist" ? "active" : "")">
                                <i class="fa-solid fa-heart"></i> Sản phẩm yêu thích
                            </a>
                        </li>
                        <li>
                            <a href="/thanh-vien/danh-gia.html" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "MyReviews" ? "active" : "")">
                                <i class="fa-solid fa-star"></i> Đánh giá của tôi
                            </a>
                        </li>
                        <li>
                            <a href="@Url.Action("ChangePassword", "Member")" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "ChangePassword" ? "active" : "")">
                                <i class="fa-solid fa-key"></i> Đổi mật khẩu
                            </a>
                        </li>
                        <li>
                            <a href="@Url.Action("Logout", "Account")" class="text-danger">
                                <i class="fa-solid fa-right-from-bracket"></i> Đăng xuất
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="col-lg-9">
                <div class="member-content">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("MemberScripts", required: false)
}
