@model List<Antigravity.ECommerce.Models.Wishlist>
@{
    Layout = "_MemberLayout";
    ViewData["Title"] = "Sản phẩm yêu thích";
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <h4 class="fw-bold text-dark mb-0">Sản phẩm yêu thích</h4>
    <span class="badge bg-primary rounded-pill" id="wishlistCount">@(Model?.Count ?? 0) sản phẩm</span>
</div>

@if (Model != null && Model.Any())
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4" id="wishlistGrid">
        @foreach (var item in Model)
        {
            <div class="col" id="wishlist-item-@item.ProductId">
                <div class="card h-100 border-0 shadow-sm rounded-4 position-relative">
                    <button class="btn btn-light position-absolute top-0 end-0 m-2 rounded-circle shadow-sm"
                            onclick="removeWishlistItem(@item.ProductId)"
                            title="Xoá khỏi yêu thích"
                            style="z-index: 10; width: 34px; height: 34px; padding: 0; display: flex; align-items: center; justify-content: center;">
                        <i class="fa-solid fa-xmark text-danger" style="font-size: 16px;"></i>
                    </button>
                    <a href="/san-pham/detail/@(item.Slug).html">
                        <img src="@(string.IsNullOrEmpty(item.ProductImage) ? "/assets/images/placeholder.png" : item.ProductImage)"
                             class="card-img-top rounded-top-4" alt="@item.ProductName"
                             style="height: 200px; object-fit: contain; padding: 15px; background: #f8f9fa;">
                    </a>
                    <div class="card-body d-flex flex-column">
                        <h6 class="card-title mb-2" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            <a href="/san-pham/detail/@(item.Slug).html" class="text-dark text-decoration-none fw-bold">@item.ProductName</a>
                        </h6>
                        <p class="card-text text-danger fw-bold mb-3" style="font-size: 18px;">@item.Price.ToString("N0")đ</p>
                        <div class="d-flex gap-2 mt-auto">
                            <a href="/san-pham/detail/@(item.Slug).html" class="btn btn-outline-primary flex-fill py-2">
                                <i class="fa-solid fa-eye me-1"></i> Xem
                            </a>
                            <button class="btn btn-primary flex-fill py-2" onclick="addToCart(@item.ProductId, 1)">
                                <i class="fa-solid fa-cart-shopping me-1"></i> Mua
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="fa-regular fa-heart text-muted mb-3 d-block" style="font-size: 4rem; opacity: 0.5;"></i>
        <h5 class="text-muted">Danh sách yêu thích trống</h5>
        <p class="text-muted mb-4">Bạn chưa lưu sản phẩm nào vào danh sách yêu thích.</p>
        <a href="/san-pham.html" class="btn btn-primary px-4 py-2">
            <i class="fa-solid fa-shopping-bag me-1"></i> Khám phá sản phẩm
        </a>
    </div>
}

@section MemberScripts {
    <script>
        function removeWishlistItem(productId) {
            Swal.fire({
                title: 'Xác nhận xoá?',
                text: 'Bạn có muốn xoá sản phẩm này khỏi danh sách yêu thích?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Xoá',
                cancelButtonText: 'Huỷ'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Member/ToggleWishlist', { productId: productId }, function (res) {
                        if (res.success && res.action === 'removed') {
                            $('#wishlist-item-' + productId).fadeOut(300, function() {
                                $(this).remove();
                                // Update count
                                var remaining = $('#wishlistGrid .col').length;
                                $('#wishlistCount').text(remaining + ' sản phẩm');
                                if (remaining === 0) {
                                    location.reload();
                                }
                            });
                            Swal.fire({
                                title: 'Đã xoá!',
                                text: 'Sản phẩm đã được xoá khỏi danh sách yêu thích.',
                                icon: 'success',
                                timer: 1500,
                                showConfirmButton: false
                            });
                        } else if (!res.success) {
                            Swal.fire('Lỗi', res.message || 'Có lỗi xảy ra!', 'error');
                        }
                    });
                }
            });
        }
    </script>
}
