@model Antigravity.ECommerce.Models.GlobalSettingsViewModel
@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    ViewData["Title"] = "Liên hệ";
}

<div class="contact-page py-5 bg-light">
    <div class="container py-4">
        <!-- Section Header -->
        <div class="row justify-content-center mb-5">
            <div class="col-lg-8 text-center">
                <h1 class="display-5 fw-bold text-dark mb-3">Liên Hệ Với Chúng Tôi</h1>
                <p class="lead text-muted">Chúng tôi luôn sẵn sàng lắng nghe và hỗ trợ bạn. Vui lòng gửi yêu cầu hoặc liên hệ trực tiếp qua thông tin bên dưới.</p>
                <div class="mx-auto bg-primary" style="height: 4px; width: 80px; border-radius: 2px;"></div>
            </div>
        </div>

        <div class="row g-4 mb-5">
            <!-- Contact Info Cards -->
            <div class="col-md-4">
                <div class="contact-card p-4 bg-white shadow-sm rounded-4 border-0 h-100 transition-hover">
                    <div class="icon-box bg-soft-primary rounded-circle mb-4">
                        <i class="ri-map-pin-line text-primary fs-2"></i>
                    </div>
                    <h5 class="fw-bold mb-3">Văn Phòng</h5>
                    <p class="text-muted mb-0">@Model.Address</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="contact-card p-4 bg-white shadow-sm rounded-4 border-0 h-100 transition-hover">
                    <div class="icon-box bg-soft-success rounded-circle mb-4">
                        <i class="ri-phone-line text-success fs-2"></i>
                    </div>
                    <h5 class="fw-bold mb-3">Điện thoại / Hotline</h5>
                    <p class="text-muted mb-1"><strong>Hotline:</strong> @Model.Hotline</p>
                    @if (!string.IsNullOrEmpty(Model.ContactPhone2))
                    {
                        <p class="text-muted mb-0"><strong>Kỹ thuật:</strong> @Model.ContactPhone2</p>
                    }
                </div>
            </div>
            <div class="col-md-4">
                <div class="contact-card p-4 bg-white shadow-sm rounded-4 border-0 h-100 transition-hover">
                    <div class="icon-box bg-soft-info rounded-circle mb-4">
                        <i class="ri-mail-line text-info fs-2"></i>
                    </div>
                    <h5 class="fw-bold mb-3">Email Hỗ Trợ</h5>
                    <p class="text-muted mb-1">@Model.Email</p>
                    @if (!string.IsNullOrEmpty(Model.ContactEmail2))
                    {
                        <p class="text-muted mb-0">@Model.ContactEmail2</p>
                    }
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- Contact Form -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden h-100">
                    <div class="card-body p-5">
                        <h3 class="fw-bold mb-4">Gửi tin nhắn</h3>
                        <form id="contactForm" onsubmit="return handleContactSubmit(event)">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Họ và tên <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control form-control-lg border-light bg-light" id="fullName" required placeholder="Nhập họ tên...">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Email <span class="text-danger">*</span></label>
                                    <input type="email" class="form-control form-control-lg border-light bg-light" id="email" required placeholder="example@gmail.com">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Số điện thoại</label>
                                    <input type="tel" class="form-control form-control-lg border-light bg-light" id="phone" placeholder="0xxx ...">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Tiêu đề</label>
                                    <input type="text" class="form-control form-control-lg border-light bg-light" id="subject" placeholder="Tiêu đề liên hệ...">
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Nội dung tin nhắn <span class="text-danger">*</span></label>
                                    <textarea class="form-control border-light bg-light" id="message" rows="5" required placeholder="Bạn cần hỗ trợ điều gì?"></textarea>
                                </div>
                                <div class="col-12 mt-4">
                                    <button type="submit" id="submitBtn" class="btn btn-primary btn-lg w-100 rounded-pill py-3 fw-bold shadow-sm">
                                        <i class="ri-send-plane-fill me-2"></i> Gửi Yêu Cầu
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Google Map -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden h-100 min-height-400">
                    @if (!string.IsNullOrEmpty(Model.MapCode))
                    {
                        <div class="ratio ratio-16x9 h-100 contact-map">
                            @Html.Raw(Model.MapCode)
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center h-100 bg-secondary text-white text-center p-5">
                            <div>
                                <i class="ri-map-2-line fs-1 mb-3"></i>
                                <p>Bản đồ chưa được cấu hình.</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.WorkingHours))
        {
            <div class="row mt-5">
                <div class="col-12">
                    <div class="alert alert-info border-0 rounded-4 p-4 shadow-sm d-flex align-items-center">
                        <i class="ri-time-line fs-2 me-4 text-primary"></i>
                        <div>
                            <h6 class="fw-bold mb-1">Giờ làm việc:</h6>
                            <p class="mb-0 text-muted">@Model.WorkingHours</p>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .transition-hover { transition: transform 0.3s ease, shadow 0.3s ease; }
    .transition-hover:hover { transform: translateY(-5px); box-shadow: 0 1rem 3rem rgba(0,0,0,.1) !important; }
    .icon-box { width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; }
    .bg-soft-primary { background-color: rgba(64, 81, 137, 0.1); }
    .bg-soft-success { background-color: rgba(10, 179, 156, 0.1); }
    .bg-soft-info { background-color: rgba(41, 156, 219, 0.1); }
    .contact-map iframe { width: 100%; height: 100%; border: 0 !important; }
    .min-height-400 { min-height: 400px; }
</style>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    function handleContactSubmit(e) {
        e.preventDefault();
        
        const btn = document.getElementById('submitBtn');
        const originalText = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Đang gửi...';

        const data = {
            fullName: document.getElementById('fullName').value,
            email: document.getElementById('email').value,
            phone: document.getElementById('phone').value,
            subject: document.getElementById('subject').value,
            message: document.getElementById('message').value
        };

        $.post('/Contact/SendMessage', data, function(res) {
            btn.disabled = false;
            btn.innerHTML = originalText;
            
            if (res.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'Gửi thành công!',
                    text: res.message,
                    confirmButtonColor: '#3085d6'
                });
                document.getElementById('contactForm').reset();
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Thất bại!',
                    text: res.message,
                    confirmButtonColor: '#d33'
                });
            }
        }).fail(function() {
            btn.disabled = false;
            btn.innerHTML = originalText;
            Swal.fire({
                icon: 'error',
                title: 'Lỗi!',
                text: 'Không thể kết nối đến máy chủ. Vui lòng thử lại sau.',
                confirmButtonColor: '#d33'
            });
        });

        return false;
    }
</script>
