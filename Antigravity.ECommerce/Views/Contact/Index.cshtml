@model Antigravity.ECommerce.Models.GlobalSettingsViewModel
@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    ViewData["Title"] = "Liên hệ";
}

<div class="container mt-3 mb-2">
    <nav class="sp-breadcrumb"><a href="/">Trang chủ</a> <i class="fa-solid fa-chevron-right"></i> <span>Liên hệ</span></nav>
</div>

<!-- ======== MAIN CONTENT ======== -->
<main class="container mb-5">
    <div class="row g-4">
        <!-- CỘT TRÁI: Thông tin -->
        <div class="col-lg-5">
            <h1 class="lh-page-title">LIÊN HỆ VỚI GORDAK</h1>
            <p class="lh-intro">Chúng tôi luôn sẵn sàng lắng nghe và hỗ trợ bạn.<br>Hãy liên hệ với Gordak để được tư vấn và giải đáp mọi thắc mắc.</p>

            <div class="lh-contact-box">
                <div class="lh-contact-item">
                    <div class="lh-contact-icon"><i class="fa-solid fa-phone-volume"></i></div>
                    <div>
                        <strong>Hotline tư vấn</strong>
                        <div class="lh-contact-val">@Model.Hotline <span class="text-muted">(8:00 - 17:30, T2 - T7)</span></div>
                    </div>
                </div>
                <div class="lh-contact-item">
                    <div class="lh-contact-icon"><i class="fa-solid fa-envelope"></i></div>
                    <div>
                        <strong>Email</strong>
                        <div class="lh-contact-val">@Model.Email</div>
                        <small class="text-muted">Phản hồi trong vòng 24 giờ</small>
                    </div>
                </div>
                <div class="lh-contact-item">
                    <div class="lh-contact-icon"><i class="fa-solid fa-location-dot"></i></div>
                    <div>
                        <strong>Địa chỉ</strong>
                        <div class="lh-contact-val">@Html.Raw(Model.Address?.Replace("\n", "<br>"))</div>
                    </div>
                </div>
                <div class="lh-contact-item">
                    <div class="lh-contact-icon"><i class="fa-solid fa-clock"></i></div>
                    <div>
                        <strong>Thời gian làm việc</strong>
                        <div class="lh-contact-val">@(string.IsNullOrEmpty(Model.WorkingHours) ? Html.Raw("Thứ 2 - Thứ 7: 08:00 - 17:30<br>Chủ nhật: Nghỉ") : Html.Raw(Model.WorkingHours.Replace("\n", "<br>")))</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: Form -->
        <div class="col-lg-7">
            <div class="lh-form-box">
                <h2 class="lh-form-title">GỬI YÊU CẦU LIÊN HỆ</h2>
                <p class="text-muted mb-3" style="font-size:13px">Vui lòng điền thông tin, chúng tôi sẽ liên hệ lại với bạn sớm nhất.</p>
                <form id="contactForm" onsubmit="return handleContactSubmit(event)">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="lh-label">Họ và tên <span class="text-danger">*</span></label>
                            <input type="text" class="form-control lh-input" id="fullName" required placeholder="Nhập họ và tên" />
                        </div>
                        <div class="col-md-6">
                            <label class="lh-label">Số điện thoại <span class="text-danger">*</span></label>
                            <input type="tel" class="form-control lh-input" id="phone" required placeholder="Nhập số điện thoại" />
                        </div>
                        <div class="col-12">
                            <label class="lh-label">Email <span class="text-danger">*</span></label>
                            <input type="email" class="form-control lh-input" id="email" required placeholder="Nhập email" />
                        </div>
                        <div class="col-12">
                            <label class="lh-label">Chủ đề <span class="text-danger">*</span></label>
                            <select class="form-select lh-input" id="subject">
                                <option value="" selected>Chọn chủ đề</option>
                                <option value="Tư vấn sản phẩm">Tư vấn sản phẩm</option>
                                <option value="Bảo hành">Bảo hành</option>
                                <option value="Hợp tác kinh doanh">Hợp tác kinh doanh</option>
                                <option value="Khác">Khác</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="lh-label">Nội dung tin nhắn <span class="text-danger">*</span></label>
                            <textarea class="form-control lh-input" id="message" rows="4" required placeholder="Nhập nội dung tin nhắn của bạn..."></textarea>
                        </div>
                        <div class="col-12">
                            <button type="submit" id="submitBtn" class="lh-btn-submit">GỬI YÊU CẦU</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ======== KẾT NỐI VỚI GORDAK ======== -->
    <div class="lh-connect-sec">
        <div class="row align-items-center" style="background: #f4f8ff; border: 1px solid #e5e5e5; border-radius: 8px; padding: 20px; margin: 0;">
            <div class="col-lg-4">
                <h3 class="lh-connect-title">KẾT NỐI VỚI GORDAK</h3>
                <p class="text-muted" style="font-size:13px">Chúng tôi luôn đồng hành cùng bạn<br>trong mọi công việc.</p>
            </div>
            <div class="col-lg-8">
                <div class="row g-3 text-center">
                    @{
                        var contactConnect = ViewBag.ContactConnect as List<Antigravity.ECommerce.Models.Advertising>;
                        if (contactConnect != null && contactConnect.Any())
                        {
                            foreach (var item in contactConnect)
                            {
                                <div class="col-6 col-md-3"><div class="lh-val-card"><i class="@(item.VideoUrl ?? "fa-solid fa-handshake")"></i><strong>@item.Title</strong><small>@Html.Raw(item.Description)</small></div></div>
                            }
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ======== FAQ ======== -->
    <h2 class="lh-faq-title text-center">CÂU HỎI THƯỜNG GẶP</h2>
    <div class="row g-3 mb-4">
        @{
            var faqs = ViewBag.FAQs as List<Antigravity.ECommerce.Models.FAQ>;
            if (faqs != null && faqs.Any())
            {
                int faqIndex = 0;
                foreach (var faq in faqs)
                {
                    faqIndex++;
                    <div class="col-md-6">
                        <div class="lh-faq-item" data-bs-toggle="collapse" data-bs-target="#faq-@faqIndex">
                            @faq.Question <i class="fa-solid fa-chevron-down ms-auto"></i>
                        </div>
                        <div class="collapse" id="faq-@faqIndex">
                            <div class="lh-faq-answer">@Html.Raw(faq.Answer)</div>
                        </div>
                    </div>
                }
            }
        }
    </div>
</main>

<style>
    .contact-map iframe { width: 100%; height: 100%; border: 0 !important; }
</style>

@section Scripts {
    <script>
        function handleContactSubmit(e) {
            e.preventDefault();
            
            const btn = document.getElementById('submitBtn');
            const originalText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Đang gửi...';

            const data = {
                fullName: document.getElementById('fullName').value,
                email: document.getElementById('email').value,
                phone: document.getElementById('phone').value,
                subject: document.getElementById('subject').value,
                message: document.getElementById('message').value
            };

            $.post('/Contact/SendMessage', data, function(res) {
                btn.disabled = false;
                btn.innerHTML = originalText;
                
                if (res.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Gửi thành công!',
                        text: res.message,
                        confirmButtonColor: '#1a3c8a'
                    });
                    document.getElementById('contactForm').reset();
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Thất bại!',
                        text: res.message,
                        confirmButtonColor: '#d33'
                    });
                }
            }).fail(function() {
                btn.disabled = false;
                btn.innerHTML = originalText;
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi!',
                    text: 'Không thể kết nối đến máy chủ. Vui lòng thử lại sau.',
                    confirmButtonColor: '#d33'
                });
            });

            return false;
        }
    </script>
}
