@model Antigravity.ECommerce.Models.Advertising
@{
    ViewBag.Title = "Thêm Banner mới";
    Layout = "_AdminLayout";
}

<form asp-action="Create" method="post">
    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label" id="label_Title">Tiêu đề Banner <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" asp-for="Title" placeholder="Nhập tiêu đề banner..." required>
                    </div>

                    <div class="row">
                        <div class="col-md-6" id="group_Image">
                            <div class="mb-3">
                                <label class="form-label" id="label_Image">Ảnh Banner <small class="text-muted">(ưu tiên hơn icon nếu có cả 2)</small></label>
                                <div class="input-group">
                                    <input type="text" class="form-control" asp-for="Image" id="Image" readonly>
                                    <button class="btn btn-primary" type="button" onclick="browseImage('Image')">Chọn ảnh</button>
                                </div>
                                <div id="image_preview" class="mt-2 text-center border rounded p-2 d-none">
                                    <img src="" style="max-height: 150px; max-width: 100%;">
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6" id="group_VideoUrl">
                            <div class="mb-3">
                                <label class="form-label" id="label_VideoUrl">Icon FontAwesome <small class="text-muted">VD: fa-solid fa-shield</small></label>
                                <input type="text" class="form-control" asp-for="VideoUrl" id="VideoUrl" placeholder="VD: fa-solid fa-shield-halved">
                                <div id="icon_preview" class="mt-2 text-center border rounded p-2 d-none">
                                    <i class="" style="font-size:32px; color:#1a3c8a;"></i>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3" id="group_Description">
                        <label class="form-label" id="label_Description">Mô tả <span class="text-danger">*</span></label>
                        <textarea class="form-control" asp-for="Description" id="Description" rows="5" placeholder="Nhập nội dung mô tả..."></textarea>
                    </div>

                    <div class="mb-3" id="group_Link">
                        <label class="form-label" id="label_Link">Đường dẫn liên kết (Link)</label>
                        <input type="text" class="form-control" asp-for="Link" placeholder="https://...">
                    </div>
                </div>
            </div>

            <div class="card" id="group_Schedule">
                <div class="card-header">
                    <h5 class="card-title mb-0">Lịch hiển thị tự động</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Ngày bắt đầu</label>
                                <input type="date" class="form-control" asp-for="StartDate">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Ngày kết thúc</label>
                                <input type="date" class="form-control" asp-for="EndDate">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Thiết lập hiển thị</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <select class="form-select" asp-for="Position" id="Position" onchange="updateLabels()" required>
                            <option value="Home_Slide">Trang chủ - Slide lớn</option>
                            <option disabled>▬▬ Trang Sản phẩm ▬▬</option>
                            <option value="Product_Commitment">Cam kết chất lượng</option>
                            <option value="Product_DealerCert">Chứng nhận đại lý</option>
                            <option disabled>▬▬ Trang chủ - Module ▬▬</option>
                            <option value="Home_WhyChoose">Vì sao chọn chúng tôi</option>
                            <option value="Home_BrandIntro">Giới thiệu Thương hiệu</option>
                            <option value="Home_BrandStat">Thống kê Thương hiệu</option>
                            <option disabled>▬▬ Trang Giới thiệu ▬▬</option>
                            <option value="About_Hero">Giới thiệu - Banner đầu trang</option>
                            <option value="About_HeroStat">Giới thiệu - Thống kê hero</option>
                            <option value="About_Intro">Giới thiệu - Về Gordak</option>
                            <option value="About_CoreValues">Giới thiệu - Giá trị cốt lõi</option>
                            <option value="About_Timeline">Giới thiệu - Hành trình phát triển</option>
                            <option value="About_JourneyImages">Giới thiệu - Ảnh hành trình</option>
                            <option value="About_Cert">Giới thiệu - Chứng nhận</option>
                            <option value="About_Cert_Desc">Giới thiệu - Nội dung phần chứng nhận</option>
                            <option disabled>▬▬ Trang Liên hệ ▬▬</option>
                            <option value="Contact_Connect">Liên hệ - Kết nối với Gordak</option>
                            <option value="Contact_CTA">Liên hệ - Banner Cần tư vấn thêm</option>
                            <option disabled>▬▬ Sidebar Chung ▬▬</option>
                            <option value="Sidebar_CTA">Cột bên - Banner tư vấn (TT, SP, FAQ...)</option>
                        </select>
                    </div>

                    <div class="mb-3" id="group_Target">
                        <label class="form-label">Cách mở trang</label>
                        <select class="form-select" asp-for="Target">
                            <option value="_self">Mở tại trang hiện tại (_self)</option>
                            <option value="_blank">Mở tab mới (_blank)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Thứ tự ưu tiên</label>
                        <input type="number" class="form-control" asp-for="SortOrder">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Trạng thái</label>
                        <select class="form-select" asp-for="Status">
                            <option value="1">Kích hoạt (Hiện)</option>
                            <option value="0">Tạm ẩn</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between mt-4 border-top pt-3">
                        <a href="/AdminAdvertising" class="btn btn-light"><i class="ri-arrow-go-back-line me-1"></i>Quay lại</a>
                        <button type="submit" class="btn btn-success px-4"><i class="ri-save-line me-1"></i>Lưu thêm mới</button>
                    </div>
                    
                </div>
            </div>
        </div>
    </div>

</form>

<!-- Modal CKFinder -->
<div class="modal fade" id="fileManagerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Quản lý File</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <iframe id="fileManagerIframe" src="/FileManager/Index?mode=select" style="width: 100%; height: 600px; border: none;"></iframe>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- CKEditor 4 CDN -->
    <script src="https://cdn.ckeditor.com/4.22.1/standard/ckeditor.js"></script>
    <script>
        // Chọn ảnh qua File Manager
        let currentImageField = '';
        function browseImage(fieldId) {
            currentImageField = fieldId;
            var myModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('fileManagerModal'));
            myModal.show();
        }

        window.addEventListener('message', function (e) {
            var url = null;
            if (e.data && e.data.mceAction === 'selectFile') {
                url = e.data.url;
            } else if (e.data && e.data.type === 'fileSelected') {
                url = e.data.url;
            }
            if (url) {
                document.getElementById(currentImageField).value = url;
                var preview = document.getElementById('image_preview');
                if (preview) {
                    preview.classList.remove('d-none');
                    preview.querySelector('img').src = url;
                }
                bootstrap.Modal.getInstance(document.getElementById('fileManagerModal'))?.hide();
            }
        });

        // Preview icon khi nhập
        document.getElementById('VideoUrl')?.addEventListener('input', function() {
            var val = this.value.trim();
            var preview = document.getElementById('icon_preview');
            if (val && val.includes('fa-')) {
                preview.classList.remove('d-none');
                preview.querySelector('i').className = val;
            } else {
                preview.classList.add('d-none');
            }
        });

        // Cấu hình hiển thị form - GIỐNG file Edit.cshtml
        var fieldConfig = {
            'Home_WhyChoose': {
                title: 'Tiêu đề USP <span class="text-danger">*</span>',
                image: { show: true, label: 'Ảnh thay thế icon <small class="text-muted">(ưu tiên hơn icon nếu có cả 2)</small>', col: 'col-md-6' },
                videoUrl: { show: true, label: 'Icon FontAwesome <small class="text-muted">VD: fa-solid fa-shield</small>', col: 'col-md-6' },
                description: { show: true, label: 'Mô tả chính <span class="text-danger">*</span>', useCK: true },
                link: { show: false },
                target: false, schedule: false
            },
            'Home_BrandStat': {
                title: 'Con số thống kê <span class="text-danger">*</span> <small class="text-muted">VD: 20+, 100%, 50+</small>',
                image: { show: true, label: 'Ảnh thay thế icon <small class="text-muted">(ưu tiên hơn icon)</small>', col: 'col-md-6' },
                videoUrl: { show: true, label: 'Icon FontAwesome <small class="text-muted">VD: fa-solid fa-globe</small>', col: 'col-md-6' },
                description: { show: true, label: 'Nhãn mô tả <small class="text-muted">VD: NĂM KINH NGHIỆM</small>', useCK: true },
                link: { show: true, label: 'Nhãn mô tả (dự phòng)' },
                target: false, schedule: false
            },
            'Home_BrandIntro': {
                title: 'Tiêu đề phần giới thiệu <span class="text-danger">*</span>',
                image: { show: true, label: 'Ảnh nhà máy / Thương hiệu', col: 'col-md-12' },
                videoUrl: { show: true, label: 'Đoạn mô tả thứ 2 <small class="text-muted">(hiển thị bên dưới đoạn 1)</small>', col: 'col-md-12', textarea: true, rows: 3 },
                description: { show: true, label: 'Đoạn mô tả chính <span class="text-danger">*</span>', rows: 4, useCK: true },
                link: { show: true, label: 'Đường dẫn "Tìm hiểu thêm"', placeholder: '/gioi-thieu.html' },
                target: false, schedule: false
            },
            'About_Hero': {
                title: 'Tiêu đề Banner <span class="text-danger">*</span>',
                image: { show: true, label: 'Ảnh nền hero (chìm dần vào nền) <span class="text-danger">*</span>', col: 'col-md-12' },
                videoUrl: { show: true, label: 'Tiêu đề phụ (Subtitle)', col: 'col-md-6' },
                description: { show: true, label: 'Đoạn mô tả ngắn', rows: 4, useCK: true },
                link: { show: true, label: 'Nhãn nhỏ trên cùng (VD: VỀ THƯƠNG HIỆU)' },
                target: false, schedule: false
            },
            'About_HeroStat': {
                title: 'Con số / Tiêu đề thống kê <span class="text-danger">*</span> <small class="text-muted">VD: Hơn 30 năm, 100+</small>',
                image: { show: true, label: 'Ảnh thay thế icon <small class="text-muted">(ưu tiên hơn icon nếu có cả 2)</small>', col: 'col-md-6' },
                videoUrl: { show: true, label: 'Icon FontAwesome <small class="text-muted">VD: fa-solid fa-clock-rotate-left</small>', col: 'col-md-6' },
                description: { show: true, label: 'Nhãn mô tả <small class="text-muted">VD: Kinh nghiệm trong ngành</small>', useCK: true },
                link: { show: false },
                target: false, schedule: false
            },
            'About_Intro': {
                title: 'Tiêu đề mục Giới thiệu <span class="text-danger">*</span>',
                image: { show: true, label: 'Ảnh giới thiệu', col: 'col-md-6' },
                videoUrl: { show: true, label: 'Icon FontAwesome <small class="text-muted">VD: fa-solid fa-check</small>', col: 'col-md-6' },
                description: { show: true, label: 'Nội dung mô tả + danh sách checklist <span class="text-danger">*</span> <small class="text-muted">Sử dụng editor để tạo danh sách</small>', rows: 6, useCK: true },
                link: { show: false },
                target: false, schedule: false
            },
            'About_CoreValues': {
                title: 'Tên giá trị cốt lõi <span class="text-danger">*</span>',
                image: { show: true, label: 'Ảnh minh hoạ <small class="text-muted">(ưu tiên hơn icon nếu có cả 2)</small>', col: 'col-md-6' },
                videoUrl: { show: true, label: 'Icon FontAwesome <small class="text-muted">VD: fa-solid fa-gem</small>', col: 'col-md-6' },
                description: { show: true, label: 'Mô tả ngắn', rows: 3, useCK: true },
                link: { show: false },
                target: false, schedule: false
            },
            'About_Timeline': {
                title: 'Tiêu đề mốc sự kiện <span class="text-danger">*</span>',
                image: { show: true, label: 'Ảnh minh hoạ <small class="text-muted">(ưu tiên hơn icon nếu có cả 2)</small>', col: 'col-md-6' },
                videoUrl: { show: true, label: 'Icon FontAwesome <small class="text-muted">VD: fa-solid fa-rocket</small>', col: 'col-md-6' },
                description: { show: true, label: 'Mô tả sự kiện <span class="text-danger">*</span>', useCK: true },
                link: { show: false },
                target: false, schedule: false
            },
            'About_JourneyImages': {
                title: 'Tiêu đề ảnh <span class="text-danger">*</span>',
                image: { show: true, label: 'Ảnh hành trình <span class="text-danger">*</span>', col: 'col-md-12' },
                videoUrl: { show: false, label: '', col: 'col-md-6' },
                description: { show: true, label: 'Mô tả ảnh (tuỳ chọn)', useCK: true },
                link: { show: false },
                target: false, schedule: false
            },
            'About_Cert': {
                title: 'Tiêu đề chứng nhận <span class="text-danger">*</span>',
                image: { show: true, label: 'Ảnh chứng nhận <span class="text-danger">*</span>', col: 'col-md-6' },
                videoUrl: { show: true, label: 'Icon FontAwesome <small class="text-muted">(tuỳ chọn)</small>', col: 'col-md-6' },
                description: { show: true, label: 'Mô tả chứng nhận', useCK: true },
                link: { show: false },
                target: false, schedule: false
            },
            'About_Cert_Desc': {
                title: 'Tiêu đề nhãn (không hiển thị) <span class="text-danger">*</span>',
                image: { show: false },
                videoUrl: { show: true, label: 'Chữ trên nút bấm (VD: Xem toàn bộ chứng nhận >)', col: 'col-md-12' },
                description: { show: true, label: 'Nội dung mô tả <span class="text-danger">*</span>', useCK: true },
                link: { show: true, label: 'Link của nút bấm', placeholder: '/gioi-thieu.html' },
                target: true, schedule: false
            },
            'Product_Commitment': {
                title: 'Tiêu đề cam kết <span class="text-danger">*</span>',
                image: { show: true, label: 'Ảnh minh hoạ <small class="text-muted">(ưu tiên hơn icon nếu có cả 2)</small>', col: 'col-md-6' },
                videoUrl: { show: true, label: 'Icon FontAwesome <small class="text-muted">VD: fa-solid fa-shield-halved</small>', col: 'col-md-6' },
                description: { show: true, label: 'Mô tả ngắn <span class="text-danger">*</span>', rows: 3, useCK: true },
                link: { show: false },
                target: false, schedule: false
            },
            'Contact_Connect': {
                title: 'Tiêu đề khối <span class="text-danger">*</span>',
                image: { show: true, label: 'Ảnh minh hoạ <small class="text-muted">(ưu tiên hơn icon nếu có cả 2)</small>', col: 'col-md-6' },
                videoUrl: { show: true, label: 'Icon FontAwesome <small class="text-muted">VD: fa-solid fa-user-tie</small>', col: 'col-md-6' },
                description: { show: true, label: 'Mô tả ngắn <span class="text-danger">*</span>', rows: 3, useCK: true },
                link: { show: false },
                target: false, schedule: false
            },
            'Contact_CTA': {
                title: 'Nội dung theo thứ tự (SortOrder=1: Tiêu đề+Subtitle | SortOrder=2: Ảnh trái+Feature | SortOrder=3: Ảnh phải+Feature) <span class="text-danger">*</span>',
                image: { show: true, label: 'Ảnh banner (SortOrder 2=Ảnh trái tư vấn viên | SortOrder 3=Ảnh phải sản phẩm)', col: 'col-md-12' },
                videoUrl: { show: true, label: 'Badge / Text phụ <small class="text-muted">(SortOrder 1: Badge nút Zalo, VD: Zalo)</small>', col: 'col-md-12' },
                description: { show: true, label: 'Nội dung: (SortOrder 1=Subtitle | SortOrder 2=Feature 2 | SortOrder 3=Feature 3)', rows: 3, useCK: false },
                link: { show: true, label: 'Liên kết: (SortOrder 1=Feature 1 | SortOrder 2=URL Zalo | SortOrder 3=tel:sốđiệnthoại)', placeholder: '' },
                target: false, schedule: false
            },
            'Product_DealerCert': {
                title: 'Tiêu đề chứng nhận <span class="text-danger">*</span>',
                image: { show: true, label: 'Ảnh chứng nhận <span class="text-danger">*</span>', col: 'col-md-6' },
                videoUrl: { show: true, label: 'Icon FontAwesome <small class="text-muted">(tuỳ chọn)</small>', col: 'col-md-6' },
                description: { show: true, label: 'Mô tả ngắn', rows: 3, useCK: true },
                link: { show: true, label: 'Đường dẫn liên kết', placeholder: '/gioi-thieu.html' },
                target: false, schedule: false
            },
            '_default': {
                title: 'Tiêu đề Banner <span class="text-danger">*</span>',
                image: { show: true, label: 'Ảnh Banner', col: 'col-md-6' },
                videoUrl: { show: true, label: 'YouTube Video ID (Nếu có)', col: 'col-md-6' },
                description: { show: true, label: 'Mô tả', useCK: true },
                link: { show: true, label: 'Đường dẫn liên kết (Link)', placeholder: 'https://...' },
                target: true, schedule: true
            }
        };

        var ckInstance = null;

        function updateLabels() {
            var pos = document.getElementById('Position').value;
            var cfg = fieldConfig[pos] || fieldConfig['_default'];

            document.getElementById('label_Title').innerHTML = cfg.title;

            var gImg = document.getElementById('group_Image');
            gImg.style.display = cfg.image.show ? '' : 'none';
            gImg.className = cfg.image.col || 'col-md-6';
            document.getElementById('label_Image').innerHTML = cfg.image.label || 'Ảnh Banner';

            var gVid = document.getElementById('group_VideoUrl');
            gVid.style.display = cfg.videoUrl.show ? '' : 'none';
            gVid.className = cfg.videoUrl.col || 'col-md-6';
            document.getElementById('label_VideoUrl').innerHTML = cfg.videoUrl.label || 'Icon FontAwesome';

            var vidInput = document.getElementById('VideoUrl');
            if (cfg.videoUrl.textarea && vidInput.tagName === 'INPUT') {
                var ta = document.createElement('textarea');
                ta.className = vidInput.className;
                ta.name = vidInput.name;
                ta.id = vidInput.id;
                ta.rows = cfg.videoUrl.rows || 2;
                ta.value = vidInput.value;
                vidInput.parentNode.replaceChild(ta, vidInput);
            } else if (!cfg.videoUrl.textarea && vidInput.tagName === 'TEXTAREA') {
                var inp = document.createElement('input');
                inp.type = 'text';
                inp.className = vidInput.className;
                inp.name = vidInput.name;
                inp.id = vidInput.id;
                inp.value = vidInput.value;
                vidInput.parentNode.replaceChild(inp, vidInput);
            }

            var gDesc = document.getElementById('group_Description');
            gDesc.style.display = cfg.description.show ? '' : 'none';
            if (cfg.description.show) {
                document.getElementById('label_Description').innerHTML = cfg.description.label;
            }

            if (cfg.description.useCK) {
                if (!ckInstance) {
                    ckInstance = CKEDITOR.replace('Description', {
                        height: 250,
                        removeButtons: 'About',
                        filebrowserImageUploadUrl: '/FileManager/UploadImage',
                        filebrowserBrowseUrl: '/FileManager/Index?mode=select'
                    });
                }
            } else {
                if (ckInstance) {
                    ckInstance.destroy();
                    ckInstance = null;
                }
            }

            var gLink = document.getElementById('group_Link');
            gLink.style.display = cfg.link.show ? '' : 'none';
            if (cfg.link.show) {
                document.getElementById('label_Link').innerHTML = cfg.link.label || 'Đường dẫn liên kết (Link)';
                var linkInput = gLink.querySelector('input');
                if (linkInput && cfg.link.placeholder) linkInput.placeholder = cfg.link.placeholder;
            }

            document.getElementById('group_Target').style.display = cfg.target ? '' : 'none';
            document.getElementById('group_Schedule').style.display = cfg.schedule ? '' : 'none';
        }

        // Auto-select position from query parameter
        document.addEventListener('DOMContentLoaded', function() {
            var params = new URLSearchParams(window.location.search);
            var pos = params.get('position');
            if (pos) {
                var sel = document.getElementById('Position');
                if (sel) sel.value = pos;
            }
            updateLabels();
        });
    </script>
}
