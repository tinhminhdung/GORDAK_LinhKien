@model List<Antigravity.ECommerce.Models.Advertising>
@{
    ViewBag.Title = "Quản lý Quảng cáo & Banner";
    Layout = "_AdminLayout";
    string kw = ViewBag.Keyword ?? "";
    string position = ViewBag.Position ?? "";
    int? status = ViewBag.Status;
    int pageIndex = ViewBag.PageIndex ?? 1;
    int pageSize = ViewBag.PageSize ?? 20;
    int totalCount = ViewBag.TotalCount ?? 0;
    int totalPages = (int)Math.Ceiling((double)totalCount / pageSize);
}

<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0">Quản lý Quảng cáo & Banner (@totalCount)</h4>
            <div class="page-title-right d-flex gap-2">
                <div class="dropdown" id="bulkOptions" style="display:none;">
                    <button class="btn btn-soft-info dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="ri-settings-3-line align-bottom me-1"></i> Thao tác nhanh (<span id="selectedCount">0</span>)
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="javascript:void(0);" onclick="bulkUpdateStatus(1)">Hiện banner</a></li>
                        <li><a class="dropdown-item" href="javascript:void(0);" onclick="bulkUpdateStatus(0)">Ẩn banner</a></li>
                        <li class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" href="javascript:void(0);" onclick="bulkDelete()"><i class="ri-delete-bin-line me-1"></i> Xóa vĩnh viễn</a></li>
                    </ul>
                </div>
                <a href="/AdminAdvertising/Create" class="btn btn-primary">
                    <i class="ri-add-line align-middle me-1"></i> Thêm Banner mới
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header border-0 bg-transparent py-3">
                <form method="get" action="/AdminAdvertising/Index" id="filterForm">
                    <input type="hidden" name="sort" value="@ViewBag.SortColumn" />
                    <input type="hidden" name="order" value="@ViewBag.SortOrder" />
                    <input type="hidden" name="page" id="pageIndex" value="@pageIndex" />
                    <div class="row g-3">
                        <div class="col-xxl-4 col-sm-6">
                            <div class="search-box">
                                <input type="text" name="kw" value="@kw" class="form-control border-light" placeholder="Tìm tiêu đề banner...">
                                <i class="ri-search-line search-icon"></i>
                            </div>
                        </div>
                        <div class="col-xxl-3 col-sm-4">
                            <select name="position" class="form-select border-light">
                                <option value="">-- Tất cả vị trí --</option>
                                <option value="Home_Slide" selected="@(position == "Home_Slide")">Trang chủ - Slide lớn</option>
                                <option value="Home_Top" selected="@(position == "Home_Top")">Trang chủ - Banner đầu trang</option>
                                <option value="Home_Middle" selected="@(position == "Home_Middle")">Trang chủ - Banner giữa</option>
                                <option value="Sidebar_Right" selected="@(position == "Sidebar_Right")">Cột phải - Sidebar</option>
                                <option value="Product_Detail" selected="@(position == "Product_Detail")">Trang chi tiết sản phẩm</option>
                                <option value="Popup" selected="@(position == "Popup")">Popup Quảng cáo</option>
                            </select>
                        </div>
                        <div class="col-xxl-2 col-sm-4">
                            <select name="status" class="form-select border-light">
                                <option value="">-- Trạng thái --</option>
                                <option value="1" selected="@(status == 1)">Đang hiện</option>
                                <option value="0" selected="@(status == 0)">Đang ẩn</option>
                            </select>
                        </div>
                        <div class="col-xxl-3 col-sm-4 d-flex gap-2">
                            <button type="submit" class="btn btn-primary flex-grow-1">
                                <i class="ri-equalizer-fill me-1 align-bottom"></i> Lọc
                            </button>
                            <a href="/AdminAdvertising" class="btn btn-light px-3">
                                <i class="ri-refresh-line align-bottom"></i>
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle table-nowrap mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 40px;">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="checkAll">
                                    </div>
                                </th>
                                <th style="width: 80px;">Ảnh</th>
                                <th onclick="changeSort('Title')" class="sort cursor-pointer">Tiêu đề / Thông tin <i class="ri-arrow-up-down-line sort-icon @(ViewBag.SortColumn == "Title" ? "active" : "")"></i></th>
                                <th>Vị trí</th>
                                <th>Liên kết</th>
                                <th>Sắp xếp</th>
                                <th>Trạng thái</th>
                                <th class="text-center" style="width: 140px;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Count > 0)
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="form-check">
                                                <input class="form-check-input select-item" type="checkbox" value="@item.AdvertisingId" onchange="toggleBulkDeleteBtn()">
                                            </div>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(item.Image))
                                            {
                                                <img src="@item.Image" alt="" class="rounded" style="width: 80px; height: 45px; object-fit: cover;">
                                            }
                                            else if (!string.IsNullOrEmpty(item.VideoUrl))
                                            {
                                                <div class="bg-soft-info text-info rounded d-flex align-items-center justify-content-center" style="width: 80px; height: 45px;">
                                                    <i class="ri-video-line fs-20"></i>
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            <h6 class="mb-1">@item.Title</h6>
                                            <p class="text-muted mb-0 small">
                                                <i class="ri-calendar-line me-1"></i>
                                                @(item.StartDate?.ToString("dd/MM/yyyy") ?? "...") - @(item.EndDate?.ToString("dd/MM/yyyy") ?? "...")
                                            </p>
                                        </td>
                                        <td>
                                            <span class="badge badge-soft-primary fs-12">@item.Position</span>
                                        </td>
                                        <td>
                                            <a href="@item.Link" target="_blank" class="text-truncate d-inline-block" style="max-width: 150px;">@item.Link</a>
                                            <br/>
                                            <small class="text-muted">Mở: @item.Target</small>
                                        </td>
                                        <td>@item.SortOrder</td>
                                        <td>
                                            <div class="form-check form-switch form-switch-success mb-0">
                                                <input class="form-check-input status-switch" type="checkbox" data-id="@item.AdvertisingId"
                                                       @(item.Status == 1 ? "checked" : "") 
                                                       onchange="updateQuickStatus(@item.AdvertisingId, this)">
                                                <label class="form-check-label status-label @(item.Status == 1 ? "text-success" : "text-muted")">
                                                    @(item.Status == 1 ? "Đang hiện" : "Đang ẩn")
                                                </label>
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            <div class="d-flex justify-content-center gap-1">
                                                <a href="/AdminAdvertising/Edit/@item.AdvertisingId" class="btn btn-sm btn-soft-info" title="Chỉnh sửa">
                                                    <i class="ri-pencil-line"></i>
                                                </a>
                                                <button class="btn btn-sm btn-soft-danger" onclick="deleteItem(@item.AdvertisingId)" title="Xóa">
                                                    <i class="ri-delete-bin-line"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-5">
                                        <div class="text-center">
                                            <lord-icon src="https://cdn.lordicon.com/msoeawqm.json" trigger="loop" colors="primary:#405189,secondary:#0ab39c" style="width:75px;height:75px"></lord-icon>
                                            <h5 class="mt-2">Chưa có banner nào</h5>
                                            <p class="text-muted">Bấm Thêm mới để bắt đầu quản trị quảng cáo.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @await Html.PartialAsync("_Pagination", new { PageIndex = pageIndex, TotalPages = totalPages, TotalCount = totalCount, DisplayCount = Model?.Count ?? 0 })
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function changeSort(col) {
            const form = document.querySelector('form');
            if(form.id === '') form.id = 'filterForm';
            
            // Check if sort input exists
            if (!form.querySelector('input[name="sort"]')) {
                const sortInp = document.createElement('input');
                sortInp.type = 'hidden'; sortInp.name = 'sort';
                form.appendChild(sortInp);
            }
            if (!form.querySelector('input[name="order"]')) {
                const orderInp = document.createElement('input');
                orderInp.type = 'hidden'; orderInp.name = 'order';
                form.appendChild(orderInp);
            }

            if (form.sort.value === col) {
                form.order.value = form.order.value === 'ASC' ? 'DESC' : 'ASC';
            } else {
                form.sort.value = col;
                form.order.value = 'ASC';
            }
            form.submit();
        }
</script>
    <script>
        $(function () {
            $('#checkAll').change(function () {
                $('.select-item').prop('checked', $(this).prop('checked'));
                toggleBulkDeleteBtn();
            });
        });

        function changePage(page) {
            $('#pageIndex').val(page);
            $('#filterForm').submit();
        }

        function deleteItem(id) {
            Swal.fire({
                title: 'Xác nhận xóa?',
                text: "Bạn không thể khôi phục sau khi xóa banner này!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#405189',
                cancelButtonColor: '#f06548',
                confirmButtonText: 'Đồng ý xóa',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/AdminAdvertising/Delete/' + id, function (res) {
                        if (res.success) {
                            Swal.fire('Thành công', 'Đã xóa banner!', 'success').then(() => {
                                location.reload();
                            });
                        } else {
                            Swal.fire('Lỗi', res.message, 'error');
                        }
                    });
                }
            })
        }

        function toggleBulkDeleteBtn() {
            const count = $('.select-item:checked').length;
            if (count > 0) {
                $('#selectedCount').text(count);
                $('#bulkOptions').fadeIn();
            } else {
                $('#bulkOptions').fadeOut();
            }
        }

        function bulkDelete() {
            const ids = [];
            $('.select-item:checked').each(function () {
                ids.push(parseInt($(this).val()));
            });

            if (ids.length === 0) return;

            Swal.fire({
                title: 'Xóa nhiều banner?',
                text: `Bạn có chắc chắn muốn xóa ${ids.length} banner đã chọn không?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#f06548',
                cancelButtonColor: '#405189',
                confirmButtonText: 'Xác nhận xóa',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/AdminAdvertising/BulkDelete',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(ids),
                        success: function (res) {
                            if (res.success) {
                                Swal.fire('Thành công', `Đã xóa banner!`, 'success').then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Lỗi', 'Xóa thất bại', 'error');
                            }
                        }
                    });
                }
            });
        }

        function updateQuickStatus(id, input) {
            const isChecked = $(input).is(':checked');
            const status = isChecked ? 1 : 0;
            const label = $(input).next('.status-label');

            $.ajax({
                url: '/AdminAdvertising/BulkUpdateStatus',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ ids: [id], status: status }),
                success: function (res) {
                    if (res.success) {
                        label.text(status == 1 ? "Đang hiện" : "Đang ẩn");
                        label.toggleClass('text-success', status == 1).toggleClass('text-muted', status == 0);
                        Toastify({ text: "Đã cập nhật trạng thái!", duration: 2000, gravity: "top", position: "right", backgroundColor: "#0ab39c" }).showToast();
                    } else {
                        $(input).prop('checked', !isChecked);
                        Swal.fire('Lỗi', 'Cập nhật trạng thái thất bại', 'error');
                    }
                },
                error: function() {
                    $(input).prop('checked', !isChecked);
                    Swal.fire('Lỗi', 'Lỗi kết nối', 'error');
                }
            });
        }

        function bulkUpdateStatus(status) {
            const ids = [];
            $('.select-item:checked').each(function () {
                ids.push(parseInt($(this).val()));
            });

            if (ids.length === 0) return;

            $.ajax({
                url: '/AdminAdvertising/BulkUpdateStatus',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ ids: ids, status: status }),
                success: function (res) {
                    if (res.success) {
                        location.reload();
                    } else {
                        Swal.fire('Lỗi', 'Cập nhật trạng thái thất bại', 'error');
                    }
                }
            });
        }
    </script>
}
