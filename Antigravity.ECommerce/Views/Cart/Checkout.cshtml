@model Antigravity.ECommerce.Models.CartViewModel
@{
    Layout = "_MainLayout";
    ViewData["Title"] = "Thanh toán đơn hàng - GORDAK Việt Nam";
}

<!-- ======== BREADCRUMB ======== -->
<div class="container mt-3 mb-3">
  <nav class="sp-breadcrumb">
      <a href="/"><i class="fa-solid fa-house" style="font-size:12px"></i> Trang chủ</a> 
      <i class="fa-solid fa-chevron-right"></i> 
      <a href="/gio-hang.html">Giỏ hàng</a> 
      <i class="fa-solid fa-chevron-right"></i> 
      <span>Đặt hàng</span>
  </nav>
</div>

<!-- ======== MAIN CONTENT ======== -->
<main class="container mb-5">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

  <form asp-action="ProcessCheckout" method="post" id="checkoutForm">
      <div class="row g-4">
        <!-- CỘT TRÁI: Form -->
        <div class="col-lg-7">
          <div class="gh-form-box">
            <h2 class="gh-section-title"><i class="fa-solid fa-user-circle" style="color:#1a3c8a"></i> THÔNG TIN NGƯỜI NHẬN HÀNG</h2>
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="lh-label">Họ và tên <span class="text-danger">*</span></label>
                  <div class="gh-input-wrap"><i class="fa-regular fa-user"></i><input type="text" asp-for="FullName" class="form-control lh-input" placeholder="Nhập họ và tên" required></div>
                </div>
                <div class="col-md-6">
                  <label class="lh-label">Số điện thoại <span class="text-danger">*</span></label>
                  <div class="gh-input-wrap"><i class="fa-solid fa-phone"></i><input type="tel" asp-for="Phone" class="form-control lh-input" placeholder="Nhập số điện thoại" required></div>
                </div>
                
                <!-- Province and Ward logic kept from previous codebase -->
                <div class="col-md-6">
                    <label class="lh-label">Tỉnh / Thành phố <span class="text-danger">*</span></label>
                    <div class="gh-input-wrap"><i class="fa-solid fa-map"></i>
                        <select id="ProvinceId" name="ProvinceId" class="form-select lh-input" required>
                            <option value="">- Chọn Tỉnh/Thành -</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="lh-label">Phường / Xã <span class="text-danger">*</span></label>
                    <div class="gh-input-wrap"><i class="fa-solid fa-map-pin"></i>
                        <select id="WardId" name="WardId" class="form-select lh-input" required>
                            <option value="">- Chọn Phường/Xã -</option>
                        </select>
                    </div>
                </div>

                <div class="col-12">
                  <label class="lh-label">Địa chỉ nhận hàng (Số nhà, tên đường) <span class="text-danger">*</span></label>
                  <div class="gh-input-wrap"><i class="fa-solid fa-location-dot"></i><input type="text" id="DetailAddress" asp-for="Address" class="form-control lh-input" placeholder="Số nhà, tên đường, khu vực..." required></div>
                </div>
                <input type="hidden" name="FullAddress" id="FullAddress" />

                <div class="col-12">
                  <label class="lh-label">Email</label>
                  <div class="gh-input-wrap"><i class="fa-solid fa-envelope"></i><input type="email" asp-for="Email" class="form-control lh-input" placeholder="Nhập email để nhận thông tin đơn hàng"></div>
                </div>
                <div class="col-12">
                  <label class="lh-label">Ghi chú đơn hàng</label>
                  <div class="gh-input-wrap"><i class="fa-regular fa-comment"></i><input type="text" asp-for="Note" class="form-control lh-input" placeholder="Ví dụ: giao giờ hành chính, gọi trước khi giao..."></div>
                </div>
              </div>

              <!-- Checkbox VAT -->
              <div class="gh-vat-check mt-3">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" id="vatCheck" name="RequiresVAT" value="true" data-bs-toggle="collapse" data-bs-target="#vatForm">
                  <label class="form-check-label" for="vatCheck">
                    <strong>Tôi cần xuất hóa đơn VAT</strong>
                    <small class="d-block text-muted">Tích vào đây nếu bạn cần xuất hóa đơn VAT cho đơn hàng này.</small>
                  </label>
                </div>
              </div>

              <!-- VAT Form (collapsible) -->
              <div class="collapse" id="vatForm">
                <div class="gh-vat-form mt-3">
                  <h4 class="gh-vat-title"><i class="fa-solid fa-file-invoice"></i> THÔNG TIN XUẤT HÓA ĐƠN <i class="fa-solid fa-chevron-down float-end"></i></h4>
                  <div class="row g-3 mt-1">
                    <div class="col-md-6"><label class="lh-label">Tên công ty <span class="text-danger">*</span></label><input type="text" asp-for="VATCompanyName" class="form-control lh-input" placeholder="Nhập tên công ty"></div>
                    <div class="col-md-6"><label class="lh-label">Mã số thuế <span class="text-danger">*</span></label><input type="text" asp-for="VATTaxCode" class="form-control lh-input" placeholder="Nhập mã số thuế"></div>
                    <div class="col-12"><label class="lh-label">Địa chỉ công ty <span class="text-danger">*</span></label><input type="text" asp-for="VATCompanyAddress" class="form-control lh-input" placeholder="Nhập địa chỉ công ty"></div>
                    <div class="col-12"><label class="lh-label">Email nhận hóa đơn</label><input type="email" asp-for="VATInvoiceEmail" class="form-control lh-input" placeholder="Nhập email nhận hóa đơn"></div>
                  </div>
                </div>
              </div>

              <!-- Submit Button -->
              <button type="submit" class="gh-btn-submit mt-4"><i class="fa-solid fa-cart-shopping"></i> XÁC NHẬN ĐẶT HÀNG</button>
          </div>
        </div>

        <!-- CỘT PHẢI: Đơn hàng -->
        <div class="col-lg-5">
          <div class="gh-order-box border rounded-3 p-4 bg-white shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
              <h4 class="gh-order-title mb-0 fw-bold" style="color: #1a2b4c;"><i class="fa-solid fa-cart-shopping me-2"></i> ĐƠN HÀNG CỦA BẠN</h4>
              <a href="/gio-hang.html" class="text-decoration-underline text-primary small">Chỉnh sửa giỏ hàng</a>
            </div>

            <!-- Product item -->
            <div class="gh-order-items mb-4">
                @foreach(var item in Model.Items) {
                    <div class="gh-order-item border rounded-3 p-3 mb-3 bg-white d-flex align-items-center">
                        <div class="me-3" style="width: 70px; flex-shrink: 0;">
                            <img src="@item.ProductImage" alt="@item.ProductName" class="img-fluid rounded border">
                        </div>
                        <div class="flex-grow-1">
                            <h6 class="fw-bold mb-1" style="color: #1a2b4c;">@item.ProductName</h6>
                            @if(!string.IsNullOrEmpty(item.ProductCode)) {
                                <div class="text-muted small mb-1">Mã sản phẩm: @item.ProductCode</div>
                            }
                            @if(!string.IsNullOrEmpty(item.Warranty)) {
                                <div class="text-muted small">Bảo hành: @item.Warranty</div>
                            }
                        </div>
                        <div class="text-end ms-3" style="min-width: 100px;">
                            <div class="text-danger fw-bold fs-6 mb-1">@item.Price.ToString("N0")đ</div>
                            <div class="text-muted small text-end">x @item.Quantity</div>
                        </div>
                    </div>
                }
            </div>

            <div class="bg-light rounded-3 p-3 mb-3">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Tạm tính</span>
                    <span class="fw-medium">@Model.SubTotal.ToString("N0")đ</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Phí vận chuyển</span>
                    <span class="fw-medium">@((Model.ShippingFee > 0) ? Model.ShippingFee.ToString("N0") + "đ" : "Miễn phí")</span>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center p-3 bg-soft-primary rounded-3 border" style="background-color: #f8fbff; border-color: #e5f0fa !important;">
              <strong style="font-size:16px; color: #1a2b4c;">Tổng thanh toán</strong>
              <div class="text-end">
                <span class="gh-total-price text-danger fw-bold fs-4 d-block">@Model.TotalAmount.ToString("N0")đ</span>
                <small class="d-block text-muted">(Đã bao gồm VAT)</small>
              </div>
            </div>
          </div>

          <!-- Hỗ trợ -->
          <div class="gh-support-box mt-3">
            <h4><i class="fa-solid fa-headset" style="color:#1a3c8a"></i> CẦN HỖ TRỢ?</h4>
            <p class="text-muted" style="font-size:13px">Đội ngũ kỹ thuật của chúng tôi luôn sẵn sàng hỗ trợ bạn!</p>
            <div class="d-flex flex-wrap gap-3 mt-2">
              <div class="d-flex align-items-center gap-2"><i class="fa-solid fa-phone" style="color:#1a3c8a"></i><div><small class="text-muted">Hotline</small><br><strong>0963 344 888</strong></div></div>
              <div class="d-flex align-items-center gap-2"><div class="zalo-circle" style="width:28px;height:28px;font-size:9px">Zalo</div><div><small class="text-muted">Chat Zalo</small><br><strong>Tư vấn 24/7</strong></div></div>
              <div class="d-flex align-items-center gap-2"><i class="fa-solid fa-envelope" style="color:#1a3c8a"></i><div><small class="text-muted">Email</small><br><strong>info@nhatminhesc.com</strong></div></div>
            </div>
          </div>
        </div>
      </div>
  </form>
</main>

@section Scripts {
    <script>
        $(document).ready(function() {
            var savedProvince = '@(Model.ProvinceId ?? 0)';
            var savedWard = '@(Model.WardId ?? 0)';
            
            // Load provinces
            $.get('/Location/GetTinhThanh', function(res) {
                var html = '<option value="">- Chọn Tỉnh/Thành -</option>';
                res.forEach(function(item) {
                    var sel = (savedProvince && savedProvince == item.ma_Tinh) ? ' selected' : '';
                    html += '<option value="' + item.ma_Tinh + '"' + sel + '>' + item.ten_Tinh + '</option>';
                });
                $('#ProvinceId').html(html);
                
                // If province was pre-selected, load wards
                if (savedProvince && savedProvince != '0' && savedProvince != '') {
                    loadWards(savedProvince, savedWard);
                }
            });

            $('#ProvinceId').on('change', function() {
                var id = $(this).val();
                if (id) {
                    loadWards(id, null);
                } else {
                    $('#WardId').html('<option value="">- Chọn Phường/Xã -</option>');
                }
                updateFullAddress();
            });

            $('#WardId').on('change', updateFullAddress);
            $('#DetailAddress').on('input', updateFullAddress);
        });

        function loadWards(provinceId, selectedWard) {
            $.get('/Location/GetPhuongXa', { maTinh: provinceId }, function(res) {
                var html = '<option value="">- Chọn Phường/Xã -</option>';
                res.forEach(function(item) {
                    var sel = (selectedWard && selectedWard == item.ma_Xa) ? ' selected' : '';
                    html += '<option value="' + item.ma_Xa + '"' + sel + '>' + item.ten_Xa + '</option>';
                });
                $('#WardId').html(html);
                updateFullAddress();
            });
        }

        function updateFullAddress() {
            var detail = $('#DetailAddress').val() || '';
            var xa = $('#WardId option:selected').text();
            var tinh = $('#ProvinceId option:selected').text();
            
            var full = detail;
            if ($('#WardId').val() && $('#WardId').val() != '') full += ', ' + xa;
            if ($('#ProvinceId').val() && $('#ProvinceId').val() != '') full += ', ' + tinh;
            
            $('#FullAddress').val(full);
        }

        $('#checkoutForm').on('submit', function(e) {
            if (!$('#ProvinceId').val() || !$('#WardId').val()) {
                e.preventDefault();
                Swal.fire('Chú ý', 'Vui lòng chọn đầy đủ Tỉnh/Thành và Phường/Xã', 'warning');
                return false;
            }
            
            var reqVat = $('#vatCheck').is(':checked');
            if (reqVat) {
                if (!$('input[name="VATCompanyName"]').val() || !$('input[name="VATTaxCode"]').val() || !$('input[name="VATCompanyAddress"]').val()) {
                    e.preventDefault();
                    Swal.fire('Chú ý', 'Vui lòng nhập đầy đủ Tên công ty, Mã số thuế và Địa chỉ công ty để xuất hóa đơn VAT', 'warning');
                    return false;
                }
            }
        });
    </script>
}
