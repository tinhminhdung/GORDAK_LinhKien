@{
    Layout = "_MainLayout";
    ViewData["Title"] = "Đặt hàng thành công";
}

<section class="py-5">
    <div class="container py-5 text-center">
        <div class="mx-auto bg-soft-success rounded-circle d-flex align-items-center justify-content-center mb-4" style="width: 100px; height: 100px; background: #e6f7f0;">
            <i class="mdi mdi-check-circle mdi-48px text-success"></i>
        </div>
        
        <h1 class="fw-bold mb-3">Đặt hàng thành công!</h1>
        <p class="fs-5 text-muted mb-4">Cảm ơn bạn đã mua sắm tại Antigravity. Mã đơn hàng của bạn là:</p>
        
        <div class="bg-light p-3 rounded-4 border mb-5 d-inline-block px-5">
            <h3 class="fw-bold text-primary mb-0">@ViewBag.OrderCode</h3>
        </div>
        
        <div class="alert alert-info border-0 rounded-4 shadow-sm mb-5 d-inline-block text-start" style="max-width: 500px;">
            <h6 class="fw-bold"><i class="mdi mdi-information-outline me-2"></i> Thông tin tiếp theo:</h6>
            <ul class="mb-0 small ps-3">
                <li>Nhân viên sẽ gọi điện xác nhận đơn hàng trong vòng 15-30 phút.</li>
                <li>Bạn có thể kiểm tra email để xem chi tiết hóa đơn.</li>
                <li>Sản phẩm sẽ được giao đến bạn trong vòng 2-3 ngày làm việc.</li>
            </ul>
        </div>
        
        <div>
            <a href="/" class="btn btn-primary px-5 py-2 fw-bold me-2">VỀ TRANG CHỦ</a>
            <a href="/san-pham.html" class="btn btn-outline-primary px-5 py-2 fw-bold">TIẾP TỤC MUA SẮM</a>
        </div>
    </div>
</section>
