@using Antigravity.ECommerce.Services
@{
    Layout = "_MainLayout";
    ViewData["Title"] = "Đặt hàng thành công";
    var settings = SSetting.GetViewModel();
}

<div class="sp-breadcrumb py-3 bg-light">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-dark">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Đặt hàng thành công</li>
            </ol>
        </nav>
    </div>
</div>

<section class="py-5 bg-white">
    <div class="container py-4 text-center">
        <!-- Checkout Steps Indicator -->
        <style>
            .checkout-steps {
                display: flex;
                justify-content: space-between;
                max-width: 400px;
                margin: 0 auto 30px auto;
                position: relative;
                padding: 0 15px;
            }
            .checkout-steps::before {
                content: '';
                position: absolute;
                top: 15px;
                left: 50px;
                right: 50px;
                height: 1px;
                background: #e5e5e5;
                z-index: 1;
            }
            .checkout-steps::after {
                content: '';
                position: absolute;
                top: 15px;
                left: 50px;
                width: calc(100% - 100px);
                height: 1px;
                background: #1a3c8a;
                z-index: 1;
            }
            .checkout-step {
                display: flex;
                flex-direction: column;
                align-items: center;
                position: relative;
                z-index: 2;
                background: transparent;
            }
            .checkout-step-icon {
                width: 32px;
                height: 32px;
                border-radius: 50%;
                border: 1px solid #ccc;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 13px;
                color: #777;
                margin-bottom: 8px;
                background: #fff;
                text-decoration: none;
            }
            .checkout-step-text {
                font-size: 13px;
                color: #777;
                font-weight: 500;
            }
            .checkout-step.completed .checkout-step-icon {
                border-color: #1a3c8a;
                color: #1a3c8a;
            }
            .checkout-step.active .checkout-step-icon {
                background: #1a3c8a;
                border-color: #1a3c8a;
                color: #fff;
            }
            .checkout-step.active .checkout-step-text {
                color: #1a3c8a;
                font-weight: 600;
            }

            .custom-group .btn-brand-solid {
                background-color: #1a3c8a !important;
                border-color: #1a3c8a !important;
                color: #fff !important;
            }

            .custom-group .btn-brand-outline {
                color: #1a3c8a !important;
                border-color: #1a3c8a !important;
            }

                .custom-group .btn-brand-outline:hover {
                    background-color: #1a3c8a !important;
                    color: #fff !important;
                }
        </style>
        
        <div class="checkout-steps d-flex d-md-none">
            <div class="checkout-step completed">
                <a href="/gio-hang.html" class="checkout-step-icon"><i class="fa-solid fa-cart-shopping"></i></a>
                <span class="checkout-step-text">Giỏ hàng</span>
            </div>
            <div class="checkout-step completed">
                <div class="checkout-step-icon">2</div>
                <span class="checkout-step-text">Đặt hàng</span>
            </div>
            <div class="checkout-step active">
                <div class="checkout-step-icon"><i class="fa-solid fa-check"></i></div>
                <span class="checkout-step-text">Hoàn tất</span>
            </div>
        </div>

        <div class="mx-auto rounded-circle d-flex align-items-center justify-content-center mb-4 shadow-sm" style="width: 80px; height: 80px; background: #e6f7f0;">
            <i class="fas fa-check text-success" style="font-size: 36px;"></i>
        </div>
        
        <h2 class="fw-bold mb-3" style="color: #1a2b4c;">Đặt hàng thành công!</h2>
        <p class="fs-6 text-muted mb-4">Cảm ơn bạn đã mua sắm tại <strong>@settings.SiteTitle</strong>. Mã đơn hàng của bạn là:</p>
        
        <div class="d-flex flex-column flex-md-row justify-content-center align-items-stretch gap-3 mb-5 mx-auto" style="max-width: 800px;">
            <div class="bg-light p-4 rounded-3 border d-flex align-items-center justify-content-center flex-grow-1 w-100" style="min-height: 120px;">
                <h3 class="fw-bold text-primary mb-0" style="letter-spacing: 0.5px;">@ViewBag.OrderCode</h3>
            </div>
            
            <div class="alert alert-info border-0 rounded-3 mb-0 text-start flex-grow-1 w-100 d-flex flex-column justify-content-center" style="background-color: #e8f4fd; min-height: 120px;">
                @if (!string.IsNullOrEmpty(settings.OrderSuccessMessage)) {
                    <div class="success-msg-content text-dark fs-14">
                        @Html.Raw(settings.OrderSuccessMessage)
                    </div>
                } else {
                    <h6 class="fw-bold text-dark mb-2"><i class="fas fa-info-circle me-1 text-info"></i> Thông tin tiếp theo:</h6>
                    <ul class="mb-0 small ps-3 text-dark fs-14">
                        <li>Nhân viên sẽ gọi điện xác nhận đơn hàng trong vòng 15-30 phút.</li>
                        <li>Bạn có thể kiểm tra email để xem chi tiết hóa đơn.</li>
                        <li>Sản phẩm sẽ được giao đến bạn trong vòng 2-3 ngày làm việc.</li>
                    </ul>
                }
            </div>
        </div>
        
        <div class="mt-2">
            <div class="custom-group">
                <a href="/" class="btn btn-primary px-4 py-2 fw-bold me-2 rounded-2 btn-brand-solid">VỀ TRANG CHỦ</a>
                <a href="/san-pham.html" class="btn btn-outline-primary px-4 py-2 fw-bold rounded-2 btn-brand-outline">TIẾP TỤC MUA SẮM</a>
            </div>
        </div>
    </div>
</section>

<style>
    .success-msg-content ul {
        margin-bottom: 0;
        padding-left: 1.25rem;
    }
    .success-msg-content li {
        margin-bottom: 4px;
    }
    .success-msg-content li:last-child {
        margin-bottom: 0;
    }
</style>
