@using Antigravity.ECommerce.Models

@{
    Layout = "_MainLayout";
    ViewData["Title"] = "Trang chủ";
    var hotProducts = ViewBag.HotProducts as List<Product>;
    var categories = ViewBag.Categories as List<Category>;
    var banners = ViewBag.Banners as List<Advertising> ?? new List<Advertising>();
    var topBanners = ViewBag.TopBanners as List<Advertising> ?? new List<Advertising>();
    var middleBanners = ViewBag.MiddleBanners as List<Advertising> ?? new List<Advertising>();
    var popupBanners = ViewBag.PopupBanners as List<Advertising> ?? new List<Advertising>();
    var videos = ViewBag.Videos as List<Video> ?? new List<Video>();
    var news = ViewBag.News as List<News> ?? new List<News>();
    var faqs = ViewBag.FAQs as List<FAQ> ?? new List<FAQ>();
    var galleries = ViewBag.Galleries as List<Gallery> ?? new List<Gallery>();
    ViewData["SchemaFAQs"] = faqs;
}

<script type="application/ld+json">
{ "@@context":"https://schema.org","@@type":"WebSite","name":"Gordak Việt Nam","url":"@(Context.Request.Scheme+"://"+Context.Request.Host)","potentialAction":{"@@type":"SearchAction","target":"@(Context.Request.Scheme+"://"+Context.Request.Host)/Product/Search?q={search_term_string}","query-input":"required name=search_term_string"}}
</script>

<!-- ======== HERO SLIDER ======== -->
<section class="hero-section position-relative overflow-hidden">
  <div class="hero-slider-wrap position-relative">
    <div class="hero-slider d-flex" id="hero-slider">
      @if(banners.Count > 0)
      {
          foreach(var b in banners)
          {
              <div class="hero-slide">
                  <a href="@b.Link"><img src="@b.Image" class="banner-img" alt="@b.Title"></a>
              </div>
          }
      }
      else
      {
          <div class="hero-slide">
            <img src="/assets/images/banner1.jpg" class="banner-img" alt="Banner 1">
            <div class="hero-overlay container">
              <div class="row align-items-center h-100">
                <div class="col-lg-6 col-12">
                  <h1 class="hero-title">NHÀ PHÂN PHỐI<br><span class="hero-gold">CHÍNH HÃNG</span>CÁC SẢN PHẨM GORDAK<br>TẠI VIỆT NAM</h1>
                  <ul class="hero-list list-unstyled">
                    <li><i class="fa-solid fa-check hero-check"></i> 100% sản phẩm chính hãng</li>
                    <li><i class="fa-solid fa-check hero-check"></i> Bảo hành chính hãng 12 - 24 tháng</li>
                    <li><i class="fa-solid fa-check hero-check"></i> Đầy đủ giấy tờ CO, CQ</li>
                    <li><i class="fa-solid fa-check hero-check"></i> Hỗ trợ kỹ thuật chuyên sâu</li>
                  </ul>
                </div>
                <div class="col-lg-6 d-none d-lg-flex justify-content-center">
                  <img src="/assets/images/z7775799550819_90d29c67ea55bc2ff67f102c9764392b.jpg" class="hero-product-img" alt="Hero Product" />
                </div>
              </div>
            </div>
          </div>
          <div class="hero-slide"><img src="/assets/images/banner2.png" class="banner-img" alt="Banner 2"></div>
          <div class="hero-slide"><img src="/assets/images/banner3.png" class="banner-img" alt="Banner 3"></div>
          <div class="hero-slide"><img src="/assets/images/banner4.png" class="banner-img" alt="Banner 4"></div>
      }
    </div>
    <!-- Cert box (desktop only) -->
    <div class="cert-box d-none d-lg-block">
      <div class="cert-gold-wrap text-center">
        <div class="cert-label">GORDAK</div>
        <div class="cert-sub">AUTHORIZED DISTRIBUTOR</div>
        <div class="cert-loc">VIETNAM</div>
        <div class="cert-stars">★★★</div>
      </div>
      <h3 class="cert-title">CHỨNG NHẬN ĐẠI LÝ CHÍNH THỨC TẠI VIỆT NAM</h3>
      <p class="cert-desc">GORDAK ủy quyền NHẬT MINH ESC phân phối chính hãng các sản phẩm GORDAK tại thị trường Việt Nam.</p>
      <a href="/gioi-thieu.html" class="btn-cert d-block text-center">Xem chứng nhận</a>
    </div>
    <!-- Cert box mobile (inside slider) -->
    <div class="cert-badge-mobile d-lg-none">
      <div class="cert-label-sm">GORDAK</div>
      <small>AUTHORIZED DISTRIBUTOR</small>
      <div class="cert-loc-sm">VIETNAM</div>
      <div class="cert-stars-sm">★★★</div>
    </div>
    <!-- Dots -->
    <div class="slider-dots" id="slider-dots">
      @{
          int dotCount = banners.Count > 0 ? banners.Count : 4;
          for(int i = 0; i < dotCount; i++) {
              <span class="@(i==0?"active":"")" onclick="goToSlide(@i)"></span>
          }
      }
    </div>
  </div>
</section>

<!-- ======== CATEGORIES ======== -->
@{
    var homeCategoriesList = ViewBag.HomeCategories as List<HomeCategorySetting> ?? new List<HomeCategorySetting>();
    var homeCategoryProductsDict = ViewBag.HomeCategoryProducts as Dictionary<int, List<Product>> ?? new Dictionary<int, List<Product>>();
}
@if (homeCategoriesList.Any(x => x.IsActive))
{
<div class="container cat-wrap">
  <div class="row g-0 cats-row">
    @foreach(var hc in homeCategoriesList.Where(x => x.IsActive).OrderBy(x => x.SortOrder))
    {
        int totalCount = 0;
        if (homeCategoryProductsDict.ContainsKey(hc.CategoryId) && homeCategoryProductsDict[hc.CategoryId].Count > 0)
        {
            totalCount = homeCategoryProductsDict[hc.CategoryId][0].TotalCount;
        }

        <div class="col cat-col">
          <div class="cat-item text-center">
            <a href="/san-pham/danh-muc/@(hc.Slug).html" class="text-decoration-none text-dark d-block">
                <img src="@(string.IsNullOrEmpty(hc.Image) ? "/assets/images/placeholder.png" : hc.Image)" class="cat-img" alt="@hc.Name">
                <b>@hc.Name</b><small class="d-none d-lg-block">@totalCount sản phẩm</small>
            </a>
          </div>
        </div>
    }
  </div>
</div>
}

<!-- ======== FEATURED PRODUCTS ======== -->
@if (hotProducts != null && hotProducts.Any())
{
<section class="container section-products">
  <div class="d-flex justify-content-between align-items-center section-head">
    <h2 class="section-title">SẢN PHẨM NỔI BẬT</h2>
    <a href="/san-pham.html" class="view-all">Xem tất cả <i class="fa-solid fa-chevron-right"></i></a>
  </div>
  <div class="row g-3">
    @{ int pCount = 0; }
    @foreach(var p in hotProducts.Take(5))
    {
        pCount++;
        <div class="col-6 col-lg @(pCount==5?"d-none d-lg-block":"")">
          <div class="product-card position-relative">
            @if(p.IsHot){<span class="badge-hot">HOT</span>}
            <span class="badge-heart" onclick="toggleWishlist(@p.ProductId)" style="cursor:pointer"><i class="fa-regular fa-heart"></i></span>
            <a href="/san-pham/detail/@(p.Slug).html" class="d-block text-center mb-2">
                <img src="@(string.IsNullOrEmpty(p.MainImage) ? "/assets/images/placeholder.png" : p.MainImage)" class="product-img" alt="@p.Name">
            </a>
            <h3 class="product-name"><a href="/san-pham/detail/@(p.Slug).html" class="text-decoration-none text-dark">@p.Name</a></h3>
            <p class="product-desc line-clamp-2" style="font-size:12px; color:#666;">@(string.IsNullOrEmpty(p.ShortDescription) ? p.Name : p.ShortDescription)</p>
            <div class="product-price">@p.Price.ToString("N0")đ</div>
            <div class="product-actions d-flex gap-2">
              <a href="/san-pham/detail/@(p.Slug).html" class="btn-outline-gd flex-fill text-center">Chi tiết</a>
              <a href="javascript:void(0)" onclick="addToCart(@p.ProductId,1)" class="btn-gd flex-fill d-flex align-items-center justify-content-center gap-1">
                <i class="fa-solid fa-cart-shopping"></i> Mua ngay
              </a>
            </div>
          </div>
        </div>
    }
  </div>
</section>
}

