@using Antigravity.ECommerce.Models

@{
    Layout = "_MainLayout";
    ViewData["Title"] = "Trang chủ";
    var hotProducts = ViewBag.HotProducts as List<Product>;
    var categories = ViewBag.Categories as List<Category>;
    var banners = ViewBag.Banners as List<Advertising> ?? new List<Advertising>();
    var videos = ViewBag.Videos as List<Video> ?? new List<Video>();
    var news = ViewBag.News as List<News> ?? new List<News>();
}

<script type="application/ld+json">
{ "@@context":"https://schema.org","@@type":"WebSite","name":"@(Antigravity.ECommerce.Services.SSetting.GetValue("SiteTitle"))","url":"@(Context.Request.Scheme+"://"+Context.Request.Host)","potentialAction":{"@@type":"SearchAction","target":"@(Context.Request.Scheme+"://"+Context.Request.Host)/Product/Search?q={search_term_string}","query-input":"required name=search_term_string"}}
</script>

<h1 class="visually-hidden">@(Antigravity.ECommerce.Services.SSetting.GetValue("SiteTitle"))</h1>

<!-- ======== HERO SLIDER ======== -->
<section class="hero-section position-relative overflow-hidden">
  <div class="hero-slider-wrap position-relative">
    <div class="hero-slider d-flex" id="hero-slider">
      @if(banners.Count > 0)
      {
          foreach(var b in banners)
          {
              <div class="hero-slide">
                  <a href="@b.Link"><img src="@b.Image" class="banner-img" alt="@b.Title"></a>
              </div>
          }
      }
      else
      {
          <div class="hero-slide">
              <img src="/assets/images/placeholder.png" class="banner-img" alt="Gordak Banner">
          </div>
      }
  
    </div>

    <!-- Dots -->
    <div class="slider-dots" id="slider-dots">
      @{
          int dotCount = banners.Count > 0 ? banners.Count : 4;
          for(int i = 0; i < dotCount; i++) {
              <span class="@(i==0?"active":"")" onclick="goToSlide(@i)"></span>
          }
      }
    </div>
    
    <!-- Controls -->
    <button class="hero-slider-btn prev-btn" onclick="prevSlide()"><i class="fa-solid fa-chevron-left"></i></button>
    <button class="hero-slider-btn next-btn" onclick="nextSlide()"><i class="fa-solid fa-chevron-right"></i></button>
  </div>
</section>

<!-- ======== CATEGORIES ======== -->
@{
    var homeCategoriesList = ViewBag.HomeCategories as List<HomeCategorySetting> ?? new List<HomeCategorySetting>();
    var homeCategoryProductsDict = ViewBag.HomeCategoryProducts as Dictionary<int, List<Product>> ?? new Dictionary<int, List<Product>>();
}
@if (homeCategoriesList.Any(x => x.IsActive))
{
<div class="container cat-wrap">
  <div class="row g-0 cats-row">
    @foreach(var hc in homeCategoriesList.Where(x => x.IsActive).OrderBy(x => x.SortOrder))
    {
        int totalCount = 0;
        if (homeCategoryProductsDict.ContainsKey(hc.CategoryId) && homeCategoryProductsDict[hc.CategoryId].Count > 0)
        {
            totalCount = homeCategoryProductsDict[hc.CategoryId][0].TotalCount;
        }

        <div class="col cat-col">
          <div class="cat-item text-center">
            <a href="/san-pham/@(hc.Slug).html" class="text-decoration-none text-dark d-block">
                <img src="@(string.IsNullOrEmpty(hc.Image) ? "/assets/images/placeholder.png" : hc.Image)" class="cat-img" alt="@hc.Name" loading="lazy">
                <b>@hc.Name</b><small class="d-none d-lg-block">@totalCount sản phẩm</small>
            </a>
          </div>
        </div>
    }
  </div>
</div>
}

<!-- ======== FEATURED PRODUCTS ======== -->
<section class="container section-products">
  <div class="d-flex justify-content-between align-items-center section-head">
    <h2 class="section-title">SẢN PHẨM NỔI BẬT</h2>
    <a href="/san-pham.html" class="view-all">Xem tất cả <i class="fa-solid fa-chevron-right"></i></a>
  </div>
  @if (hotProducts != null && hotProducts.Any())
  {
  <div class="row g-3">
    @foreach(var p in hotProducts)
    {
        <div class="col-6 col-md-4 col-lg-3 col-xl-2-4">
          <div class="product-card position-relative h-100 d-flex flex-column">
            @if(p.IsHot){<span class="badge-hot">HOT</span>}
            <span class="badge-heart" onclick="toggleWishlist(@p.ProductId)" style="cursor:pointer"><i class="fa-regular fa-heart"></i></span>
            <a href="/san-pham/detail/@(p.Slug)-@(p.ProductId).html" class="d-block text-center mb-2" style="height: 180px;">
                <img src="@(string.IsNullOrEmpty(p.MainImage) ? "/assets/images/placeholder.png" : p.MainImage)" class="product-img h-100 w-100 object-fit-contain" alt="@p.Name" loading="lazy">
            </a>
            <h3 class="product-name"><a href="/san-pham/detail/@(p.Slug)-@(p.ProductId).html" class="text-decoration-none text-dark">@p.Name</a></h3>
            <p class="product-desc line-clamp-2" style="font-size:12px; color:#666;">@(string.IsNullOrEmpty(p.ShortDescription) ? p.Name : p.ShortDescription)</p>
            <div class="mt-auto">
                <div class="product-price">@p.Price.ToString("N0")đ</div>
                <div class="product-actions d-flex gap-2 mt-2">
                  <a href="/san-pham/detail/@(p.Slug)-@(p.ProductId).html" class="btn-outline-gd flex-fill text-center px-0 py-1" style="font-size:13px;">Xem chi tiết</a>
                  <a href="javascript:void(0)" onclick="addToCart(@p.ProductId,1)" class="btn-gd flex-fill d-flex align-items-center justify-content-center gap-1 py-1" style="font-size:13px;">
                    <i class="fa-solid fa-cart-shopping"></i> Mua
                  </a>
                </div>
            </div>
          </div>
        </div>
    }
  </div>
  }
  else
  {
      <partial name="_EmptyState" model="@("Đang cập nhật sản phẩm nổi bật.")" />
  }
</section>

<!-- ======== WHY CHOOSE ======== -->
@{
    var whyChooseList = ViewBag.WhyChoose as List<Antigravity.ECommerce.Models.Advertising> ?? new List<Antigravity.ECommerce.Models.Advertising>();
}
@if(whyChooseList.Count > 0)
{
<section class="container section-why mt-5">
  <h2 class="section-title text-center mb-4">VÌ SAO CHỌN GORDAK TẠI NHẬT MINH ESC?</h2>
  <div class="row g-4 why-desktop d-none d-lg-flex justify-content-center">
    @foreach(var item in whyChooseList)
    {
        <div class="col text-center">
            <div class="why-ico">
                @if (!string.IsNullOrEmpty(item.Image))
                {
                  <img src="@item.Image" alt="@item.Title" style="max-height: 100px; margin-bottom: 15px;">
                }
                else
                {
                    <i class="@item.VideoUrl"></i>
                }
            </div>
            <b>@item.Title</b><p>@(item.Description ?? item.Link)</p>
        </div>
    }
  </div>
  <!-- Mobile: list with icon + text -->
  <div class="why-mobile d-lg-none">
    @foreach(var item in whyChooseList)
    {
        <div class="why-m-item d-flex align-items-start gap-3">
            <div class="why-m-ico">
                @if (!string.IsNullOrEmpty(item.Image))
                {
                    <img src="@item.Image" alt="@item.Title" style="max-height: 30px;">
                }
                else
                {
                    <i class="@item.VideoUrl"></i>
                }
            </div>
            <div><b>@item.Title</b><p class="mb-0 small text-muted">@(item.Description ?? item.Link)</p></div>
        </div>
    }
  </div>
</section>
}

<!-- ======== BRAND ABOUT ======== -->
@{
    var brandIntro = ViewBag.BrandIntro as Antigravity.ECommerce.Models.Advertising;
    var brandStats = ViewBag.BrandStats as List<Antigravity.ECommerce.Models.Advertising> ?? new List<Antigravity.ECommerce.Models.Advertising>();
}
  <section class="container section-brand mt-5">
    <div class="brand-card">
      <div class="row g-0 align-items-center">
        <div class="col-lg-5">
          <div class="brand-img-wrap">
            <img src="@brandIntro?.Image" alt="@brandIntro?.Title" class="factory-img w-100" loading="lazy">
          </div>
        </div>
        <div class="col-lg-7 px-3 px-lg-4 py-3">
      <h2 class="brand-title">@brandIntro?.Title</h2>
      <p class="brand-desc">@brandIntro?.Description</p>
      <p class="brand-desc">@brandIntro?.VideoUrl</p>
      
      @if(brandStats.Count > 0)
      {
      <div class="row g-3 my-3 stats-row">
        @foreach(var stat in brandStats)
        {
        <div class="col-6 col-md-3">
          <div class="d-flex align-items-center justify-content-center justify-content-lg-start gap-2">
            @if (!string.IsNullOrEmpty(stat.Image))
            {
              <img src="@stat.Image" alt="@stat.Title" class="stat-ico mb-0" style="max-height:32px; display:inline-block;">
            }
            else
            {
              <i class="@stat.VideoUrl stat-ico mb-0" style="display:inline-block;"></i>
            }
            <div class="d-flex flex-column text-start">
              <b class="stat-num" style="display:block;">@stat.Title</b>
              <small class="stat-label" style="display:block;">
                @{
                    var labelText = stat.Description ?? stat.Link ?? "";
                    labelText = System.Text.RegularExpressions.Regex.Replace(labelText, "<.*?>", String.Empty);
                }
                @labelText
              </small>
            </div>
          </div>
        </div>
        }
      </div>
      }
      <a href="@brandIntro?.Link" class="btn-gd d-inline-flex align-items-center gap-2 px-4 py-2">Tìm hiểu thêm về Gordak <i class="fa-solid fa-arrow-right"></i></a>
    </div>
  </div>
</section>

<!-- ======== VIDEO + NEWS ======== -->
<section class="container section-media mt-5">
  <div class="row g-4">
    <!-- Videos -->
    <div class="col-lg-7">
      <div class="d-flex justify-content-between align-items-center section-head">
        <h2 class="section-title">VIDEO SẢN PHẨM</h2>
        <a href="/video.html" class="view-all">Xem tất cả <i class="fa-solid fa-arrow-right"></i></a>
      </div>
      <div class="row g-3">
          @if(videos.Count > 0)
          {
              int vCount = 0;
              foreach(var v in videos.Take(4))
              {
                  vCount++;
                  <div class="col-6 col-lg-3 @(vCount>2?"d-none d-lg-block":"")">
                    <div class="video-card" data-bs-toggle="modal" data-bs-target="#videoModal" data-src="https://www.youtube.com/embed/@v.YoutubeId?autoplay=1" onclick="document.getElementById('videoIframe').src=this.getAttribute('data-src');" style="cursor:pointer">
                      <div class="video-thumb position-relative">
                        <img src="@v.ThumbnailUrl" alt="@v.Title">
                        <i class="fa-regular fa-circle-play play-icon"></i>
                      </div>
                      <b class="d-block mt-2 line-clamp-2" style="font-size:13px; font-weight:600;">@v.Title</b>
                    </div>
                  </div>
              }
          }
      </div>
    </div>
    <!-- News -->
    <div class="col-lg-5 mt-4 mt-lg-0">
      <div class="d-flex justify-content-between align-items-center section-head">
        <h2 class="section-title">TIN TỨC - HƯỚNG DẪN</h2>
        <a href="/tin-tuc.html" class="view-all">Xem tất cả <i class="fa-solid fa-arrow-right"></i></a>
      </div>
      <div class="d-flex flex-column gap-3">
          @if(news.Count > 0)
          {
              foreach(var n in news.Take(3))
              {
                  <a href="/tin-tuc/detail/@(n.Slug).html" class="news-item d-flex gap-3 align-items-start text-decoration-none text-dark">
                    <img src="@n.Image" class="news-thumb" style="width:80px;height:60px;object-fit:cover;border-radius:4px;" alt="@n.Title" loading="lazy">
                    <div>
                        <small class="text-muted">@n.CreatedAt.ToString("dd/MM/yyyy")</small><br>
                        <b class="line-clamp-2" style="font-size:14px;">@n.Title</b>
                    </div>
                  </a>
              }
          }
          else
          {
              <p class="text-muted">Đang cập nhật tin tức.</p>
          }
      </div>
    </div>
  </div>
</section>

<!-- ======== VIDEO MODAL ======== -->
<div class="modal fade" id="videoModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content bg-dark border-0">
      <div class="modal-header border-0 pb-0">
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" onclick="document.getElementById('videoIframe').src='';"></button>
      </div>
      <div class="modal-body">
        <div class="ratio ratio-16x9">
          <iframe id="videoIframe" src="" title="Video" allowfullscreen allow="autoplay"></iframe>
        </div>
      </div>
    </div>
  </div>
</div>

@section Scripts {
<script>
  let currentSlide = 0;
  const slides = document.querySelectorAll('.hero-slide');
  const dots = document.querySelectorAll('.slider-dots span');
  const slider = document.getElementById('hero-slider');
  let sliderInterval;

  function goToSlide(index) {
    if (!slides.length) return;
    currentSlide = index;
    slider.style.transform = `translateX(-${currentSlide * 100}%)`;
    dots.forEach((dot, i) => dot.classList.toggle('active', i === currentSlide));
    resetInterval();
  }
  function nextSlide() { goToSlide((currentSlide + 1) % slides.length); }
  function prevSlide() { goToSlide((currentSlide - 1 + slides.length) % slides.length); }
  function resetInterval() { clearInterval(sliderInterval); sliderInterval = setInterval(nextSlide, 5000); }
  if (slides.length > 0) resetInterval();

  // Clear iframe src when modal is closed by clicking outside
  document.getElementById('videoModal').addEventListener('hidden.bs.modal', function () {
      document.getElementById('videoIframe').src = '';
  });
</script>

}
