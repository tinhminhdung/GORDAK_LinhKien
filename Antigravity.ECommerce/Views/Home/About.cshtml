@using Antigravity.ECommerce.Models
@{
    Layout = "_MainLayout";
    ViewBag.Title = "Về thương hiệu Gordak";
    var aboutHero = ViewBag.AboutHero as Advertising;
    var aboutIntro = ViewBag.AboutIntro as List<Advertising> ?? new List<Advertising>();
    var aboutCoreValues = ViewBag.AboutCoreValues as List<Advertising> ?? new List<Advertising>();
    var introMain = aboutIntro.FirstOrDefault();
    var heroStats = ViewBag.HeroStats as List<Advertising> ?? new List<Advertising>();
    var featuredProducts = ViewBag.FeaturedProducts as List<Product> ?? new List<Product>();
    var aboutTimeline = ViewBag.AboutTimeline as List<Advertising> ?? new List<Advertising>();
    var aboutJourneyImages = ViewBag.AboutJourneyImages as List<Advertising> ?? new List<Advertising>();
    var aboutCert = ViewBag.AboutCert as List<Advertising> ?? new List<Advertising>();
    var aboutCertDesc = ViewBag.AboutCertDesc as Advertising;
}


<!-- ======== BREADCRUMB ======== -->
<div class="container mt-3 mb-2">
    <nav class="sp-breadcrumb"><a href="/">Trang chủ</a> <i class="fa-solid fa-chevron-right"></i> <span>Về thương hiệu Gordak</span></nav>
</div>

<!-- ======== HERO BANNER - Ảnh to, mờ dần trái→phải ======== -->
<section class="gt-hero" style="--gt-hero-bg: url('@aboutHero?.Image');">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-6">
        <p class="gt-hero-label">@aboutHero?.Link</p>
        <h1 class="gt-hero-title">@aboutHero?.Title</h1>
        <p class="gt-hero-subtitle">@aboutHero?.VideoUrl</p>
        <p class="gt-hero-desc">@aboutHero?.Description</p>
        @if(heroStats.Count > 0)
        {
        <div class="row g-3 mt-3">
            @foreach(var stat in heroStats)
            {
            <div class="col-6 col-md-3 position-relative gt-stat-col">
                <div class="gt-stat">
                    @if (!string.IsNullOrEmpty(stat.Image))
                    { <img src="@stat.Image" alt="@stat.Title" style="max-height:24px;"> }
                    else
                    { <i class="@stat.VideoUrl"></i> }
                    <strong>@stat.Title</strong>
                    <small>
                        @{
                            var labelText = stat.Description ?? stat.Link ?? "";
                            labelText = System.Text.RegularExpressions.Regex.Replace(labelText, "<.*?>", String.Empty);
                        }
                        @labelText
                    </small>
                </div>
            </div>
            }
        </div>
        }
      </div>
      <div class="col-lg-6 text-center d-none d-lg-block">
        
      </div>
    </div>
  </div>
</section>

<!-- ======== GIỚI THIỆU (1 bài duy nhất, Description chứa HTML checklist) ======== -->
<section class="container gt-about-sec">
  <div class="row align-items-center g-4">
    <div class="col-lg-5">
      <img src="@introMain?.Image" alt="Gordak Products" class="gt-about-img">
    </div>
    <div class="col-lg-7">
      <h2 class="gt-section-title">@introMain?.Title</h2>
      @if(!string.IsNullOrEmpty(introMain?.Description))
      {
        @Html.Raw(introMain.Description)
      }
      <a href="@introMain?.Link" class="gt-about-btn mt-3">Xem các sản phẩm Gordak <i class="fa-solid fa-chevron-right"></i></a>
    </div>
  </div>
</section>

<!-- ======== GIÁ TRỊ CỐT LÕI ======== -->
<section class="gt-core-sec">
  <div class="container text-center">
    <h2 class="gt-section-title mb-4">GIÁ TRỊ CỐT LÕI</h2>
    @if(aboutCoreValues.Count > 0)
    {
    <div class="row g-4">
      @foreach(var item in aboutCoreValues.Take(4))
      {
      <div class="col-6 col-md-3">
        <div class="gt-core-card">
          @if (!string.IsNullOrEmpty(item.Image))
          { <img src="@item.Image" alt="@item.Title" style="max-height:40px; margin-bottom:12px;"> }
          else if (!string.IsNullOrEmpty(item.VideoUrl))
          { <i class="@item.VideoUrl"></i> }
          <strong>@item.Title</strong>
          <small>@(item.Description ?? item.Link)</small>
        </div>
      </div>
      }
    </div>
    }
  </div>
</section>

<!-- ======== HÀNH TRÌNH ======== -->
<section class="container gt-journey-sec">
  <h2 class="gt-section-title mb-4">HÀNH TRÌNH PHÁT TRIỂN</h2>
  <div class="row g-4">
    <div class="col-lg-5">
      <div class="gt-timeline">
        @if(aboutTimeline.Count > 0)
        {
          @foreach(var tl in aboutTimeline)
          {
          <div class="gt-tl-item">
            <div class="gt-tl-dot">
              @if (!string.IsNullOrEmpty(tl.Image))
              { <img src="@tl.Image" alt="" style="width:14px; height:14px; object-fit:contain;"> }
              else
              { <i class="@tl.VideoUrl"></i> }
            </div>
            <div><strong>@tl.Title</strong><p>@(tl.Description ?? tl.Link)</p></div>
          </div>
          }
        }
      </div>
    </div>
    <div class="col-lg-7 d-none d-lg-block">
      <div class="gt-journey-grid">
        @if(aboutJourneyImages.Count > 0)
        {
          @for(int i = 0; i < aboutJourneyImages.Count; i++)
          {
            var ji = aboutJourneyImages[i];
            if(i == 0)
            {
            <div class="gt-jimg gt-jimg-large"><img src="@ji.Image" alt="@ji.Title"></div>
            }
            else
            {
            <div class="gt-jimg gt-jimg-small"><img src="@ji.Image" alt="@ji.Title"></div>
            }
          }
        }
      </div>
    </div>
  </div>
  <div class="gt-quote-bar">
    <p class="mb-0">Trên hành trình phát triển, Gordak luôn giữ vững cam kết mang đến sản phẩm chất lượng<br>và dịch vụ đáng tin cậy cho khách hàng toàn cầu.</p>
  </div>
</section>

<!-- ======== SẢN PHẨM TIÊU BIỂU ======== -->
@if(featuredProducts.Count > 0)
{
<section class="gt-featured-sec">
  <div class="container text-center">
    <h2 class="gt-section-title mb-4">SẢN PHẨM TIÊU BIỂU</h2>
    <div class="row g-3 justify-content-center">
      @{ int pCount = 0; }
      @foreach(var p in featuredProducts.Take(5))
      {
        pCount++;
        <div class="col-6 col-lg @(pCount==5?"d-none d-lg-block":"")">
          <div class="product-card position-relative">
            @if(p.IsHot){<span class="badge-hot">HOT</span>}
            <span class="badge-heart" onclick="toggleWishlist(@p.ProductId)" style="cursor:pointer"><i class="fa-regular fa-heart"></i></span>
            <a href="/san-pham/detail/@(p.Slug).html" class="d-block text-center mb-2">
                <img src="@(string.IsNullOrEmpty(p.MainImage) ? "/assets/images/placeholder.png" : p.MainImage)" class="product-img" alt="@p.Name">
            </a>
            <h3 class="product-name"><a href="/san-pham/detail/@(p.Slug).html" class="text-decoration-none text-dark">@p.Name</a></h3>
            <p class="product-desc line-clamp-2" style="font-size:12px; color:#666;">@(string.IsNullOrEmpty(p.ShortDescription) ? p.Name : p.ShortDescription)</p>
            <div class="product-price">@p.Price.ToString("N0")đ</div>
            <div class="product-actions d-flex gap-2">
              <a href="/san-pham/detail/@(p.Slug).html" class="btn-outline-gd flex-fill text-center">Chi tiết</a>
              <a href="javascript:void(0)" onclick="addToCart(@p.ProductId,1)" class="btn-gd flex-fill d-flex align-items-center justify-content-center gap-1">
                <i class="fa-solid fa-cart-shopping"></i> Mua ngay
              </a>
            </div>
          </div>
        </div>
      }
    </div>
    <a href="/san-pham.html" class="view-all-btn">Xem tất cả sản phẩm <i class="fa-solid fa-chevron-right"></i></a>
  </div>
</section>
}

<!-- ======== CHỨNG NHẬN ======== -->
<section class="gt-cert-sec">
  <div class="container">
    <h2 class="gt-section-title mb-4">CHỨNG NHẬN &amp; UY TÍN</h2>
    <div class="row g-3 align-items-stretch">
      @if(aboutCert != null && aboutCert.Count > 0)
      {
        @foreach(var cert in aboutCert)
        {
          if (cert == null) continue;
        <div class="col-6 col-md-2 text-center">
          <div class="gt-cert-card">
            <img src="@cert.Image" alt="@cert.Title">
            <small>@cert.Title</small>
          </div>
        </div>
        }
      }
      <div class="col-12 col-md-4">
        <div class="gt-cert-text-box">
          @if(aboutCertDesc != null)
          {
              @Html.Raw(aboutCertDesc.Description)
              @if(!string.IsNullOrEmpty(aboutCertDesc.Link) && !string.IsNullOrEmpty(aboutCertDesc.VideoUrl))
              {
                  <a href="@aboutCertDesc.Link" class="gt-cert-btn" target="@(aboutCertDesc.Target ?? "_self")">
                      @aboutCertDesc.VideoUrl
                  </a>
              }
          }
          else
          {
              <p>Tất cả sản phẩm Gordak đều được kiểm định nghiêm ngặt trước khi đến tay khách hàng. Chúng tôi cam kết mang đến sản phẩm chính hãng, chất lượng cao và dịch vụ hỗ trợ tốt nhất.</p>
              <a href="/chuyen-muc/chung-nhan.html" class="gt-cert-btn">
                  Xem toàn bộ chứng nhận <i class="fa-solid fa-chevron-right ms-1"></i>
              </a>
          }
        </div>
      </div>
    </div>
  </div>
</section>


