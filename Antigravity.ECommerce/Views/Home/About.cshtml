@using Antigravity.ECommerce.Models
@{
    Layout = "_MainLayout";
    ViewBag.Title = "Về thương hiệu Gordak";
    var aboutHero = ViewBag.AboutHero as Advertising;
    var aboutIntro = ViewBag.AboutIntro as List<Advertising> ?? new List<Advertising>();
    var aboutCoreValues = ViewBag.AboutCoreValues as List<Advertising> ?? new List<Advertising>();
    var introMain = aboutIntro.FirstOrDefault();
    var introList = aboutIntro.Skip(1).ToList();
    var brandStats = ViewBag.BrandStats as List<Advertising> ?? new List<Advertising>();
    var featuredProducts = ViewBag.FeaturedProducts as List<Product> ?? new List<Product>();
    var aboutTimeline = ViewBag.AboutTimeline as List<Advertising> ?? new List<Advertising>();
    var aboutCert = ViewBag.AboutCert as List<Advertising> ?? new List<Advertising>();
}


<!-- ======== BREADCRUMB ======== -->
<div class="container mt-3 mb-2">
    <nav class="sp-breadcrumb"><a href="/">Trang chủ</a> <i class="fa-solid fa-chevron-right"></i> <span>Về thương hiệu Gordak</span></nav>
</div>

<!-- ======== HERO BANNER ======== -->
<section class="gt-hero">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-7">
        <p class="gt-hero-label">@(aboutHero?.Link ?? "VỀ THƯƠNG HIỆU")</p>
        <h1 class="gt-hero-title">@(aboutHero?.Title ?? "GORDAK")</h1>
        <p class="gt-hero-subtitle">@(aboutHero?.VideoUrl ?? "Nhà sản xuất thiết bị hàn & rework hàng đầu thế giới")</p>
        <p class="gt-hero-desc">@(aboutHero?.Description ?? "Gordak là thương hiệu nổi tiếng trong lĩnh vực thiết bị hàn và sửa chữa điện tử. Với công nghệ hiện đại, độ bền vượt trội và hiệu suất ổn định, sản phẩm của Gordak được tin dùng bởi kỹ thuật viên và doanh nghiệp tại nhiều quốc gia trên thế giới.")</p>
        @if(brandStats.Count > 0)
        {
        <div class="row g-3 mt-3">
            @foreach(var stat in brandStats)
            {
            <div class="col-6 col-md-3 position-relative gt-stat-col">
                <div class="gt-stat">
                    @if (!string.IsNullOrEmpty(stat.Image))
                    { <img src="@stat.Image" alt="@stat.Title" style="max-height:24px;"> }
                    else
                    { <i class="@stat.VideoUrl"></i> }
                    <strong>@stat.Title</strong>
                    <small>@(stat.Description ?? stat.Link)</small>
                </div>
            </div>
            }
        </div>
        }
      </div>
      <div class="col-lg-5 text-center d-none d-lg-block">
        <img src="@(aboutHero?.Image ?? "/assets/images/z7775799762257_f058bd78c3b1f94e77da2c4eda69efb3.jpg")" alt="Gordak Factory" class="gt-hero-img">
      </div>
    </div>
  </div>
</section>

<!-- ======== GIỚI THIỆU ======== -->
<section class="container gt-about-sec">
  <div class="row align-items-center g-4">
    <div class="col-lg-5">
      <img src="@(introMain?.Image ?? "/assets/images/z7775799762257_f058bd78c3b1f94e77da2c4eda69efb3.jpg")" alt="Gordak Products" class="gt-about-img">
    </div>
    <div class="col-lg-7">
      <h2 class="gt-section-title">@(introMain?.Title ?? "GIỚI THIỆU VỀ GORDAK")</h2>
      <p class="gt-about-desc">@(introMain?.Description ?? "Với định hướng tập trung vào chất lượng và sự đổi mới, Gordak không ngừng nghiên cứu và cải tiến công nghệ để mang đến những giải pháp hàn và sửa chữa hiệu quả, an toàn và thân thiện với người dùng.")</p>
      <ul class="gt-check-list">
        @if(introList.Count > 0)
        {
          foreach(var item in introList)
          {
            <li><i class="@(item.VideoUrl ?? "fa-solid fa-check")"></i> @item.Title</li>
          }
        }
        else
        {
        <li><i class="fa-solid fa-check"></i> Công nghệ kiểm soát nhiệt thông minh</li>
        <li><i class="fa-solid fa-check"></i> Độ bền cao, hoạt động ổn định</li>
        <li><i class="fa-solid fa-check"></i> Thiết kế tối ưu, dễ sử dụng</li>
        <li><i class="fa-solid fa-check"></i> Đáp ứng tiêu chuẩn kỹ thuật quốc tế</li>
        }
      </ul>
      <a href="/san-pham.html" class="gt-about-btn mt-3">Xem các sản phẩm Gordak <i class="fa-solid fa-chevron-right"></i></a>
    </div>
  </div>
</section>

<!-- ======== GIÁ TRỊ CỐT LÕI ======== -->
<section class="gt-core-sec">
  <div class="container text-center">
    <h2 class="gt-section-title mb-4">GIÁ TRỊ CỐT LÕI</h2>
    @if(aboutCoreValues.Count > 0)
    {
    <div class="row g-4">
      @foreach(var item in aboutCoreValues.Take(4))
      {
      <div class="col-6 col-md-3">
        <div class="gt-core-card">
          @if (!string.IsNullOrEmpty(item.Image))
          { <img src="@item.Image" alt="@item.Title" style="max-height:40px; margin-bottom:12px;"> }
          else
          { <i class="@item.VideoUrl"></i> }
          <strong>@item.Title</strong>
          <small>@(item.Description ?? item.Link)</small>
        </div>
      </div>
      }
    </div>
    }
    else
    {
    <div class="row g-4">
      <div class="col-6 col-md-3"><div class="gt-core-card"><i class="fa-solid fa-gem"></i><strong>CHẤT LƯỢNG HÀNG ĐẦU</strong><small>Kiểm soát chặt chẽ từng công đoạn để đảm bảo chất lượng sản phẩm.</small></div></div>
      <div class="col-6 col-md-3"><div class="gt-core-card"><i class="fa-solid fa-lightbulb"></i><strong>ĐỔI MỚI CÔNG NGHỆ</strong><small>Không ngừng nghiên cứu và cải tiến để mang lại giải pháp tiên tiến.</small></div></div>
      <div class="col-6 col-md-3"><div class="gt-core-card"><i class="fa-solid fa-users"></i><strong>KHÁCH HÀNG LÀ TRUNG TÂM</strong><small>Luôn lắng nghe và đáp ứng mọi nhu cầu của khách hàng.</small></div></div>
      <div class="col-6 col-md-3"><div class="gt-core-card"><i class="fa-solid fa-handshake"></i><strong>HỢP TÁC BỀN VỮNG</strong><small>Xây dựng mối quan hệ lâu dài, cùng phát triển và thành công.</small></div></div>
    </div>
    }
  </div>
</section>

<!-- ======== HÀNH TRÌNH ======== -->
<section class="container gt-journey-sec">
  <h2 class="gt-section-title mb-4">HÀNH TRÌNH PHÁT TRIỂN</h2>
  <div class="row g-4">
    <div class="col-lg-6">
      <div class="gt-timeline">
        @if(aboutTimeline.Count > 0)
        {
          @foreach(var tl in aboutTimeline)
          {
          <div class="gt-tl-item"><div class="gt-tl-dot"><i class="@(tl.VideoUrl ?? "fa-solid fa-rocket")"></i></div><div><strong>@tl.Title</strong><p>@(tl.Description ?? tl.Link)</p></div></div>
          }
        }
        else
        {
        <div class="gt-tl-item"><div class="gt-tl-dot"><i class="fa-solid fa-rocket"></i></div><div><strong>Khởi đầu & phát triển</strong><p>Tập trung nghiên cứu và phát triển thiết bị hàn chất lượng cao.</p></div></div>
        <div class="gt-tl-item"><div class="gt-tl-dot"><i class="fa-solid fa-globe"></i></div><div><strong>Mở rộng thị trường</strong><p>Sản phẩm Gordak có mặt tại nhiều quốc gia và khu vực.</p></div></div>
        <div class="gt-tl-item"><div class="gt-tl-dot"><i class="fa-solid fa-chart-line"></i></div><div><strong>Nâng cao chất lượng</strong><p>Liên tục cải tiến công nghệ, tối ưu hiệu suất và độ bền sản phẩm.</p></div></div>
        <div class="gt-tl-item"><div class="gt-tl-dot"><i class="fa-solid fa-microchip"></i></div><div><strong>Đổi mới không ngừng</strong><p>Phát triển các giải pháp hàn hiện đại, phù hợp với xu hướng mới.</p></div></div>
        <div class="gt-tl-item"><div class="gt-tl-dot"><i class="fa-solid fa-heart"></i></div><div><strong>Đồng hành cùng khách hàng</strong><p>Luôn lắng nghe và hỗ trợ để mang lại giá trị tốt nhất cho khách hàng.</p></div></div>
        }
      </div>
      <div class="gt-quote-bar">
        <p class="mb-0">Trên hành trình phát triển, Gordak luôn giữ vững cam kết mang đến sản phẩm chất lượng<br>và dịch vụ đáng tin cậy cho khách hàng toàn cầu.</p>
      </div>
    </div>
    <div class="col-lg-6 d-none d-lg-block">
      <div class="row g-3">
        <div class="col-6"><img src="@(introMain?.Image ?? "/assets/images/z7775799762257_f058bd78c3b1f94e77da2c4eda69efb3.jpg")" alt="" class="gt-journey-img"></div>
        <div class="col-6"><img src="/assets/images/z7775799762257_f058bd78c3b1f94e77da2c4eda69efb3.jpg" alt="" class="gt-journey-img"></div>
        <div class="col-12"><img src="@(aboutHero?.Image ?? "/assets/images/z7775799762257_f058bd78c3b1f94e77da2c4eda69efb3.jpg")" alt="" class="gt-journey-img" style="height:200px"></div>
      </div>
    </div>
  </div>
</section>

<!-- ======== SẢN PHẨM TIÊU BIỂU (cùng kiểu trang chủ) ======== -->
@if(featuredProducts.Count > 0)
{
<section class="gt-featured-sec">
  <div class="container text-center">
    <h2 class="gt-section-title mb-4">SẢN PHẨM TIÊU BIỂU</h2>
    <div class="row g-3 justify-content-center">
      @{ int pCount = 0; }
      @foreach(var p in featuredProducts.Take(5))
      {
        pCount++;
        <div class="col-6 col-lg @(pCount==5?"d-none d-lg-block":"")">
          <div class="product-card position-relative">
            @if(p.IsHot){<span class="badge-hot">HOT</span>}
            <span class="badge-heart" onclick="toggleWishlist(@p.ProductId)" style="cursor:pointer"><i class="fa-regular fa-heart"></i></span>
            <a href="/san-pham/detail/@(p.Slug).html" class="d-block text-center mb-2">
                <img src="@(string.IsNullOrEmpty(p.MainImage) ? "/assets/images/placeholder.png" : p.MainImage)" class="product-img" alt="@p.Name">
            </a>
            <h3 class="product-name"><a href="/san-pham/detail/@(p.Slug).html" class="text-decoration-none text-dark">@p.Name</a></h3>
            <p class="product-desc line-clamp-2" style="font-size:12px; color:#666;">@(string.IsNullOrEmpty(p.ShortDescription) ? p.Name : p.ShortDescription)</p>
            <div class="product-price">@p.Price.ToString("N0")đ</div>
            <div class="product-actions d-flex gap-2">
              <a href="/san-pham/detail/@(p.Slug).html" class="btn-outline-gd flex-fill text-center">Chi tiết</a>
              <a href="javascript:void(0)" onclick="addToCart(@p.ProductId,1)" class="btn-gd flex-fill d-flex align-items-center justify-content-center gap-1">
                <i class="fa-solid fa-cart-shopping"></i> Mua ngay
              </a>
            </div>
          </div>
        </div>
      }
    </div>
    <a href="/san-pham.html" class="view-all-btn">Xem tất cả sản phẩm <i class="fa-solid fa-chevron-right"></i></a>
  </div>
</section>
}

<!-- ======== CHỨNG NHẬN ======== -->
<section class="gt-cert-sec">
  <div class="container">
    <h2 class="gt-section-title mb-4">CHỨNG NHẬN & UY TÍN</h2>
    <div class="row g-3 align-items-stretch">
      @if(aboutCert != null && aboutCert.Count > 0)
      {
        @foreach(var cert in aboutCert)
        {
          if (cert == null) continue;
        <div class="col-6 col-md-2 text-center">
          <div class="gt-cert-card">
            <img src="@(cert.Image ?? "/assets/images/placeholder.png")" alt="@(cert.Title ?? "")">
            <small>@(cert.Title ?? "")</small>
          </div>
        </div>
        }
      }
      else
      {
      <div class="col-6 col-md-2 text-center"><div class="gt-cert-card"><img src="@(aboutHero?.Image ?? "/assets/images/z7775799762257_f058bd78c3b1f94e77da2c4eda69efb3.jpg")" alt=""><small>Chứng nhận<br>đại lý chính thức</small></div></div>
      <div class="col-6 col-md-2 text-center"><div class="gt-cert-card"><img src="@(aboutHero?.Image ?? "/assets/images/z7775799762257_f058bd78c3b1f94e77da2c4eda69efb3.jpg")" alt=""><small>Chứng nhận<br>ISO 9001:2015</small></div></div>
      <div class="col-6 col-md-2 text-center"><div class="gt-cert-card"><img src="@(aboutHero?.Image ?? "/assets/images/z7775799762257_f058bd78c3b1f94e77da2c4eda69efb3.jpg")" alt=""><small>Chứng nhận<br>CO, CQ đầy đủ</small></div></div>
      <div class="col-6 col-md-2 text-center"><div class="gt-cert-card"><img src="@(aboutHero?.Image ?? "/assets/images/z7775799762257_f058bd78c3b1f94e77da2c4eda69efb3.jpg")" alt=""><small>Nhà phân phối chính hãng<br>tại Việt Nam</small></div></div>
      }
      <div class="col-12 col-md-4">
        <div class="gt-cert-text-box">
          <p>Tất cả sản phẩm Gordak đều được kiểm định nghiêm ngặt trước khi đến tay khách hàng. Chúng tôi cam kết mang đến sản phẩm chính hãng, chất lượng cao và dịch vụ hỗ trợ tốt nhất.</p>
          <div>
            <a href="#" class="gt-cert-btn">Xem toàn bộ chứng nhận <i class="fa-solid fa-chevron-right"></i></a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ======== CTA BAR ======== -->
<section class="sp-cta-bar">
  <div class="container d-flex flex-wrap align-items-center justify-content-between gap-3">
    <div class="d-flex align-items-center gap-3"><i class="fa-solid fa-shield-halved" style="font-size:32px;color:#fff"></i><div><strong style="font-size:16px">Nhà phân phối chính thức GORDAK tại Việt Nam</strong><br><small>Cam kết mang đến sản phẩm chính hãng, chất lượng và dịch vụ tốt nhất cho khách hàng.</small></div></div>
    <div class="d-flex gap-2"><a href="/lien-he.html" class="sp-cta-btn sp-cta-red">NHẬN BÁO GIÁ NGAY</a><a href="tel:0963344888" class="sp-cta-btn sp-cta-outline"><i class="fa-solid fa-phone"></i> GỌI TƯ VẤN: 0963 344 888</a></div>
  </div>
</section>
