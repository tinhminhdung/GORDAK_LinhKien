        function removeDiacritics(str) {
            return str.normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/đ/g, 'd').replace(/Đ/g, 'D');
        }

        let ALL_ICONS = [];
        let modalInstance = null;

        async function loadAllIcons() {
            try {
                document.getElementById('loadStatus').textContent = 'Đang tải từ FontAwesome...';
                const resp = await fetch('https://raw.githubusercontent.com/FortAwesome/Font-Awesome/6.x/metadata/icons.json');
                const json = await resp.json();
                const icons = [];
                for (const [name, meta] of Object.entries(json)) {
                    if (meta.styles && meta.styles.includes('solid')) icons.push('fas fa-' + name);
                }
                ALL_ICONS = icons.sort();
                document.getElementById('loadStatus').textContent = `✅ Đã tải ${ALL_ICONS.length} icon`;
            } catch (e) {
                console.warn('Fetch metadata failed, parsing CSS...', e);
                loadFromCSS();
            }
        }

        function loadFromCSS() {
            const icons = new Set();
            for (const sheet of document.styleSheets) {
                try {
                    for (const rule of sheet.cssRules) {
                        if (rule.selectorText && rule.style && rule.style.content) {
                            const m = rule.selectorText.match(/\.fa-([a-z0-9-]+)::before/);
                            if (m && m[1].length > 1) icons.add(m[1]);
                        }
                    }
                } catch (e) {}
            }
            ALL_ICONS = Array.from(icons).sort().map(n => 'fas fa-' + n);
            document.getElementById('loadStatus').textContent = `✅ Đã tải ${ALL_ICONS.length} icon (CSS)`;
        }

        function openIconPicker() {
            if (!modalInstance) modalInstance = new bootstrap.Modal(document.getElementById('modalIconPicker'));
            document.getElementById('searchIconInput').value = '';
            renderIconGrid(ALL_ICONS);
            modalInstance.show();
            setTimeout(() => document.getElementById('searchIconInput').focus(), 300);
        }

        function renderIconGrid(icons) {
            const cur = document.getElementById('MenuIcon').value;
            const display = icons.slice(0, 500);
            const extra = icons.length > 500 ? `<p class="text-muted text-center py-2" style="grid-column:1/-1;font-size:12px;">Hiển thị 500/${icons.length} — hãy gõ để lọc thêm</p>` : '';
            const html = display.map(icon => {
                const name = icon.replace(/^fas fa-/, '');
                const sel = icon === cur ? 'selected' : '';
                return `<div class="icon-cell ${sel}" onclick="selectIcon('${icon}')" title="${icon}"><i class="${icon}"></i><small>${name}</small></div>`;
            }).join('') + extra;
            document.getElementById('iconGrid').innerHTML = html || '<p class="text-muted text-center py-4">Không tìm thấy icon nào</p>';
            document.getElementById('iconCount').textContent = icons.length;
        }

        function filterIcons(keyword) {
            const raw = keyword.toLowerCase().trim();
            if (!raw) { renderIconGrid(ALL_ICONS); return; }
            const kwNoDiac = removeDiacritics(raw);
            let extraEN = '';
            for (const [viKey, enVal] of Object.entries(VI_MAP)) {
                if (viKey.includes(kwNoDiac) || kwNoDiac.includes(viKey)) extraEN += ' ' + enVal;
            }
            const allTerms = (kwNoDiac + ' ' + extraEN).trim().split(/\s+/);
            const filtered = ALL_ICONS.filter(icon => allTerms.some(t => icon.includes(t)));
            renderIconGrid(filtered);
        }

        function selectIcon(iconClass) {
            $('#MenuIcon').val(iconClass);
            $('#iconPreviewBox').html('<i class="' + iconClass + '" style="font-size: 20px;"></i>');
