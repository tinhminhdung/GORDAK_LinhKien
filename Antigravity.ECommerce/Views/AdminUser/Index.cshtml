@model List<Antigravity.ECommerce.Models.AdminUser>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Tài khoản Quản trị";
}

<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0">Tài khoản Quản trị</h4>
            <div class="page-title-right">
                <a href="/AdminUser/Create" class="btn btn-primary"><i class="ri-add-line align-bottom me-1"></i> Thêm tài khoản</a>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle table-nowrap mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" style="width: 50px;">ID</th>
                                <th scope="col">Người dùng</th>
                                <th scope="col">Vai trò</th>
                                <th scope="col">Liên hệ</th>
                                <th scope="col">Trạng thái</th>
                                <th scope="col">Đăng nhập cuối</th>
                                <th scope="col" class="text-center" style="width: 140px;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.UserId</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="flex-shrink-0 me-3">
                                                <img src="@(string.IsNullOrEmpty(item.Avatar) ? "/assets/images/users/multi-user.jpg" : item.Avatar)" alt="" class="avatar-sm rounded-circle shadow">
                                            </div>
                                            <div class="flex-grow-1">
                                                <h6 class="fs-14 mb-1 text-dark">@item.FullName</h6>
                                                <p class="text-muted mb-0 fs-12">@@@item.Username</p>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge badge-soft-info fs-12 p-2">
                                            <i class="ri-shield-user-line me-1"></i> @(item.RoleName ?? "Chưa gán")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="text-muted fs-13">
                                            <i class="ri-mail-line align-bottom me-1"></i> @item.Email<br />
                                            <i class="ri-phone-line align-bottom me-1"></i> @item.Phone
                                        </div>
                                    </td>
                                    <td>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" role="switch" @(item.Status == 1 ? "checked" : "") 
                                                   onchange="changeStatus(@item.UserId, this.checked)" @(item.RoleId == 1 ? "disabled" : "")>
                                            <label class="form-check-label @(item.Status == 1 ? "text-success" : "text-muted") fs-12">
                                                @(item.Status == 1 ? "Hoạt động" : "Tạm khóa")
                                            </label>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="text-muted fs-12">
                                            @(item.LastLogin?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa từng")
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-1">
                                            <a href="/AdminUser/Edit/@item.UserId" class="btn btn-sm btn-soft-info" title="Chỉnh sửa">
                                                <i class="ri-pencil-line"></i>
                                            </a>
                                            @if (item.RoleId != 1)
                                            {
                                                <button class="btn btn-sm btn-soft-danger" onclick="deleteUser(@item.UserId)" title="Xóa">
                                                    <i class="ri-delete-bin-line"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function changeStatus(id, isChecked) {
            const status = isChecked ? 1 : 0;
            $.post('/AdminUser/UpdateStatus', { id: id, status: status }, function (res) {
                if (res.success) {
                    // Update label text
                    const label = $(`input[onchange*="${id}"]`).next('label');
                    if (isChecked) {
                        label.text('Hoạt động').removeClass('text-muted').addClass('text-success');
                    } else {
                        label.text('Tạm khóa').removeClass('text-success').addClass('text-muted');
                    }
                } else {
                    alert('Không thể thay đổi trạng thái tài khoản này (có thể là mã đăng nhập admin gốc).');
                    location.reload();
                }
            });
        }

        function deleteUser(id) {
            if (confirm('Bạn có chắc chắn muốn xóa tài khoản này? Thao tác này không thể hoàn tác.')) {
                $.post('/AdminUser/Delete', { id: id }, function (res) {
                    if (res.success) {
                        location.reload();
                    } else {
                        alert('Xóa thất bại! Có thể do ràng buộc dữ liệu hoặc tài khoản hệ thống.');
                    }
                });
            }
        }
    </script>
}
