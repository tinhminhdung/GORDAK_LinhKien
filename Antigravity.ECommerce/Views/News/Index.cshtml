@model List<Antigravity.ECommerce.Models.News>
@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    var categories = ViewBag.Categories as List<Antigravity.ECommerce.Models.Category> ?? new List<Antigravity.ECommerce.Models.Category>();
    var hotNews = ViewBag.HotNews as List<Antigravity.ECommerce.Models.News> ?? new List<Antigravity.ECommerce.Models.News>();
    var currentCat = ViewBag.Category as Antigravity.ECommerce.Models.Category;
    
    // Breadcrumb
    ViewData["SchemaBreadcrumbs"] = new List<Antigravity.ECommerce.Models.BreadcrumbItem> {
        new Antigravity.ECommerce.Models.BreadcrumbItem { Name = "Trang chủ", Url = "/" },
        new Antigravity.ECommerce.Models.BreadcrumbItem { Name = "Tin tức", Url = "/tin-tuc.html" }
    };
    if(currentCat != null) {
        ((List<Antigravity.ECommerce.Models.BreadcrumbItem>)ViewData["SchemaBreadcrumbs"]).Add(new Antigravity.ECommerce.Models.BreadcrumbItem { Name = currentCat.Name, Url = "/tin-tuc/" + currentCat.Slug + ".html" });
    }
}

<div class="container mt-3 mb-4">
    <nav class="sp-breadcrumb">
        <a href="/">Trang chủ</a> 
        <i class="fa-solid fa-chevron-right"></i> 
        @if(currentCat == null) {
            <span>Tin tức</span>
        } else {
            <a href="/tin-tuc.html">Tin tức</a> <i class="fa-solid fa-chevron-right"></i> <span>@currentCat.Name</span>
        }
    </nav>
</div>

<main class="container mb-5">
    <h1 class="lh-page-title mb-3 text-uppercase">@(currentCat?.Name ?? "TIN TỨC")</h1>

    <!-- Filter tabs -->
    @if(categories.Any()) {
    <div class="tt-filter-tabs mb-4">
        <a href="/tin-tuc.html" class="tt-filter-btn @(currentCat == null ? "active" : "")">Tất cả</a>
        @foreach(var cat in categories) {
            <a href="/tin-tuc/@(cat.Slug).html" class="tt-filter-btn @(currentCat?.CategoryId == cat.CategoryId ? "active" : "")">@cat.Name</a>
        }
    </div>
    }

    <div class="row g-4">
        <!-- NỘI DUNG CHÍNH -->
        <div class="col-lg-9">
            @if((ViewBag.BigNews != null && ((List<Antigravity.ECommerce.Models.News>)ViewBag.BigNews).Any()) || (Model != null && Model.Any())) {
                <div class="row g-4 mb-4">
                    @{
                        var bigNews = ViewBag.BigNews as List<Antigravity.ECommerce.Models.News> ?? new List<Antigravity.ECommerce.Models.News>();
                    }
                    
                    @foreach(var item in bigNews) {
                        var newsUrl = $"/tin-tuc/detail/{item.Slug}.html";
                        <!-- Bài viết lớn (Nổi bật) -->
                        <div class="col-md-6">
                            <div class="tt-card-big">
                                <div class="tt-card-img-wrap">
                                    <a href="@newsUrl">
                                        <img src="@(string.IsNullOrEmpty(item.Image) ? "/assets/images/placeholder.png" : item.Image)" alt="@item.Title">
                                    </a>
                                    <span class="tt-badge tt-badge-teal">@item.CategoryName</span>
                                </div>
                                <div class="tt-card-meta">
                                    <i class="fa-regular fa-calendar"></i> @item.CreatedAt.ToString("dd/MM/yyyy") &nbsp; 
                                    <i class="fa-regular fa-eye"></i> @item.Views.ToString("N0") lượt xem
                                </div>
                                <h3 class="tt-card-title">
                                    <a href="@newsUrl" class="text-decoration-none text-dark">@item.Title</a>
                                </h3>
                                <p class="tt-card-desc line-clamp-2">@item.ShortDescription</p>
                                <a href="@newsUrl" class="tt-readmore">Xem chi tiết <i class="fa-solid fa-arrow-right"></i></a>
                            </div>
                        </div>
                    }

                    @if (bigNews.Any() && Model != null && Model.Any()) {
                        @Html.Raw("</div><div class='row g-4 mb-4'>")
                    }

                    @if(Model != null) {
                        @foreach(var item in Model) {
                            var newsUrl = $"/tin-tuc/detail/{item.Slug}.html";
                            <!-- bài viết nhỏ -->
                            <div class="col-md-4">
                                <div class="tt-card-small">
                                    <div class="tt-card-img-wrap">
                                        <a href="@newsUrl">
                                            <img src="@(string.IsNullOrEmpty(item.Image) ? "/assets/images/placeholder.png" : item.Image)" alt="@item.Title">
                                        </a>
                                        <span class="tt-badge tt-badge-orange">@item.CategoryName</span>
                                    </div>
                                    <div class="tt-card-meta">
                                        <i class="fa-regular fa-calendar"></i> @item.CreatedAt.ToString("dd/MM/yyyy") &nbsp; 
                                        <i class="fa-regular fa-eye"></i> @item.Views.ToString("N0")
                                    </div>
                                    <h3 class="tt-card-title-sm line-clamp-2">
                                        <a href="@newsUrl" class="text-decoration-none text-dark">@item.Title</a>
                                    </h3>
                                    <a href="@newsUrl" class="tt-readmore">Xem chi tiết <i class="fa-solid fa-arrow-right"></i></a>
                                </div>
                            </div>
                        }
                    }
                </div>
                
                <!-- Phân trang / Nút Xem tất cả -->

                
                <div class="vd-pagination mt-4 mb-5">
                    @if (ViewBag.CurrentPage > 1)
                    {
                        <a class="vd-page-btn" href="?page=@(ViewBag.CurrentPage - 1)&kw=@ViewBag.Keyword"><i class="fa-solid fa-chevron-left" style="font-size:11px;"></i></a>
                    }
                    else
                    {
                        <a class="vd-page-btn disabled" href="javascript:void(0);"><i class="fa-solid fa-chevron-left" style="font-size:11px;"></i></a>
                    }
                    
                    @for (int i = 1; i <= Math.Max(1, (int)ViewBag.TotalPages); i++)
                    {
                        <a class="vd-page-btn @(i == ViewBag.CurrentPage ? "active" : "")" href="?page=@i&kw=@ViewBag.Keyword">@i</a>
                    }
                    
                    @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                    {
                        <a class="vd-page-btn" href="?page=@(ViewBag.CurrentPage + 1)&kw=@ViewBag.Keyword"><i class="fa-solid fa-chevron-right" style="font-size:11px;"></i></a>
                    }
                    else
                    {
                        <a class="vd-page-btn disabled" href="javascript:void(0);"><i class="fa-solid fa-chevron-right" style="font-size:11px;"></i></a>
                    }
                </div>
            } else {
                <div class="text-center py-5">
                    <i class="fa-regular fa-newspaper fa-3x text-muted mb-3"></i>
                    <p class="text-muted">Không có bài viết nào trong mục này.</p>
                </div>
            }
        </div>

        <!-- SIDEBAR -->
        <div class="col-lg-3">
            <!-- Danh mục tin tức -->
            <div class="tt-sidebar-box mb-3">
                <h4 class="tt-sidebar-title">DANH MỤC TIN TỨC</h4>
                <ul class="tt-sidebar-list">
                    <li><a href="/tin-tuc.html">Tất cả <span>@ViewBag.TotalNewsCount</span></a></li>
                    @foreach(var cat in categories.Take(10)) {
                        <li><a href="/tin-tuc/@(cat.Slug).html">@cat.Name <span>@cat.ItemCount</span></a></li>
                    }
                </ul>
                @if(categories.Count > 10) {
                    <a href="javascript:void(0)" onclick="$('.tt-sidebar-list li.d-none').removeClass('d-none'); $(this).hide();" class="tt-sidebar-link">Xem tất cả danh mục <i class="fa-solid fa-arrow-right"></i></a>
                    <ul class="tt-sidebar-list">
                         @foreach(var cat in categories.Skip(10)) {
                            <li class="d-none"><a href="/tin-tuc/@(cat.Slug).html">@cat.Name <span>@cat.ItemCount</span></a></li>
                        }
                    </ul>
                }
            </div>

            <!-- Tin nổi bật -->
            @if(hotNews.Any()) {
            <div class="tt-sidebar-box mb-3">
                <h4 class="tt-sidebar-title">TIN NỔI BẬT</h4>
                @foreach(var hn in hotNews) {
                    <div class="tt-hot-item">
                        <a href="/tin-tuc/detail/@(hn.Slug).html">
                            <img src="@(string.IsNullOrEmpty(hn.Image) ? "/assets/images/placeholder.png" : hn.Image)" alt="@hn.Title">
                        </a>
                        <div>
                            <a href="/tin-tuc/detail/@(hn.Slug).html" class="tt-hot-title line-clamp-2">@hn.Title</a>
                            <div class="tt-hot-meta">
                                <i class="fa-regular fa-calendar"></i> @hn.CreatedAt.ToString("dd/MM/yyyy") &nbsp; 
                                <i class="fa-regular fa-eye"></i> @hn.Views.ToString("N0")
                            </div>
                        </div>
                    </div>
                }
            </div>
            }

            <!-- CTA Box -->
            <partial name="_SidebarCTA" />
        </div>
    </div>
</main>
