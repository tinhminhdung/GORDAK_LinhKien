@model List<Antigravity.ECommerce.Models.News>
@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    ViewBag.Title = "Tin Tức Sự Kiện";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold" style="color:var(--primary-color);">TIN TỨC CÔNG NGHỆ</h1>
        @if (!string.IsNullOrEmpty(ViewBag.Keyword))
        {
            <p class="text-muted">Kết quả tìm kiếm cho: <strong>"@ViewBag.Keyword"</strong> (@Model.Count bài viết)</p>
        }
        else
        {
            <p class="text-muted">Cập nhật những xu hướng và bài viết hấp dẫn</p>
        }
    </div>

    @if (Model.Count == 0)
    {
        <div class="text-center py-5">
            <i class="ri-search-line fs-1 text-muted"></i>
            <p class="mt-3 text-muted">Không tìm thấy bài viết nào phù hợp.</p>
            <a href="/tin-tuc.html" class="btn btn-primary mt-2">Xem tất cả tin tức</a>
        </div>
    }
    else
    {
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm" style="border-radius:12px; overflow:hidden;">
                    <a href="/tin-tuc/detail/@(item.Slug).html">
                        <img data-src="@item.Image" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E" class="card-img-top lazy" alt="@item.Title" style="height:220px; object-fit:cover;" />
                    </a>
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <small class="text-muted"><i class="ri-calendar-2-line me-1"></i>@item.CreatedAt.ToString("dd/MM/yyyy")</small>
                            <small class="text-muted"><i class="ri-eye-line me-1"></i>@item.Views</small>
                        </div>
                        <h5 class="card-title fw-bold" style="font-size:18px; line-height:1.4;">
                            <a href="/tin-tuc/detail/@(item.Slug).html" class="text-dark text-decoration-none">@item.Title</a>
                        </h5>
                        
                        @if (!string.IsNullOrEmpty(item.Tags))
                        {
                            <div class="mb-2 d-flex flex-wrap gap-1">
                                @foreach (var tag in item.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-normal" style="font-size:11px; padding: 3px 8px;">#@tag.Trim()</span>
                                }
                            </div>
                        }

                        <p class="card-text text-muted" style="font-size:14px; display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; margin-bottom: 0;">
                            @item.ShortDescription
                        </p>
                    </div>
                </div>
            </div>
        }
    </div>
    }

    <!-- Pagination -->
    @if(ViewBag.TotalPages > 1) {
    <div class="d-flex justify-content-center mt-5">
        <nav>
          <ul class="pagination">
            @for(int i=1; i<=ViewBag.TotalPages; i++) {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")"><a class="page-link" href="?page=@i">@i</a></li>
            }
          </ul>
        </nav>
    </div>
    }
</div>
