@model Antigravity.ECommerce.Models.News
@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    ViewBag.Title = Model.Title;
    var related = ViewBag.RelatedNews as List<Antigravity.ECommerce.Models.News> ?? new List<Antigravity.ECommerce.Models.News>();
    var categories = ViewBag.Categories as List<Antigravity.ECommerce.Models.Category> ?? new List<Antigravity.ECommerce.Models.Category>();
    var hotNews = ViewBag.HotNews as List<Antigravity.ECommerce.Models.News> ?? new List<Antigravity.ECommerce.Models.News>();

    // SEO Schema Setup
    ViewData["SchemaNews"] = Model;
    ViewData["SchemaBreadcrumbs"] = new List<Antigravity.ECommerce.Models.BreadcrumbItem> {
        new Antigravity.ECommerce.Models.BreadcrumbItem { Name = "Trang chủ", Url = "/" },
        new Antigravity.ECommerce.Models.BreadcrumbItem { Name = "Tin tức", Url = "/tin-tuc.html" },
        new Antigravity.ECommerce.Models.BreadcrumbItem { Name = Model.Title, Url = Context.Request.Path }
    };
}

<div class="container mt-3 mb-2">
    <nav class="sp-breadcrumb">
        <a href="/">Trang chủ</a> 
        <i class="fa-solid fa-chevron-right"></i> 
        <a href="/tin-tuc.html">Tin tức</a>
        <i class="fa-solid fa-chevron-right"></i> 
        <span>@Model.Title</span>
    </nav>
</div>

<main class="container mb-5">
    <div class="row g-4">
        <!-- NỘI DUNG CHÍNH -->
        <div class="col-lg-9">
            <h1 class="fw-bold fs-2 mb-3" style="color: #212d45; line-height: 1.3;">@Model.Title</h1>
            
            <div class="d-flex align-items-center mb-4 text-muted border-bottom pb-3" style="font-size: 14px;">
                <span class="me-3"><i class="fa-regular fa-calendar me-1"></i> @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                <span class="me-3"><i class="fa-solid fa-folder-open me-1"></i> @Model.CategoryName</span>
                <span><i class="fa-regular fa-eye me-1"></i> @Model.Views.ToString("N0") lượt xem</span>
            </div>
            
            <div class="content-body mb-5" style="font-size:16px; line-height:1.8; color: #333;">
                <p class="fw-bold mb-4" style="font-size: 18px; color: #555; font-style: italic;">@Model.ShortDescription</p>
                
                @if (!string.IsNullOrEmpty(Model.Image))
                {
                    <div class="mb-4 text-center">
                        <img src="@Model.Image" class="img-fluid rounded shadow-sm w-100" style="max-height:500px; object-fit:cover;" alt="@Model.Title" />
                    </div>
                }

                <div class="main-detail-content">@Html.Raw(Model.DetailDescription)</div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Tags))
            {
                <div class="mt-4 pt-4 border-top">
                    <div class="d-flex align-items-center flex-wrap gap-2">
                        <span class="fw-bold me-2"><i class="fa-solid fa-tags me-1"></i>Từ khóa:</span>
                        @foreach (var tag in Model.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries))
                        {
                            <a href="/tin-tuc.html?kw=@tag.Trim()" class="badge bg-light text-primary border border-primary-subtle fw-normal text-decoration-none" style="font-size:13px; padding: 6px 12px;">#@tag.Trim()</a>
                        }
                    </div>
                </div>
            }
            
            <!-- Social Share -->
            <partial name="_SocialShare" model='"Chia sẻ bài viết:"' />

            <!-- Tin liên quan -->
            @if(related.Any()) {
                <div class="mt-5">
                    <h4 class="tt-sidebar-title border-bottom pb-2 mb-4">BÀI VIẾT LIÊN QUAN</h4>
                    <div class="row g-4">
                        @foreach(var r in related) {
                            <div class="col-md-4">
                                <div class="tt-card-small">
                                    <div class="tt-card-img-wrap">
                                        <a href="/tin-tuc/detail/@(r.Slug).html">
                                            <img src="@(string.IsNullOrEmpty(r.Image) ? "/assets/images/no-image.png" : r.Image)" alt="@r.Title" style="height: 140px; width: 100%; object-fit: cover;">
                                        </a>
                                    </div>
                                    <h3 class="tt-card-title-sm line-clamp-2" style="font-size: 13px;">
                                        <a href="/tin-tuc/detail/@(r.Slug).html" class="text-decoration-none text-dark">@r.Title</a>
                                    </h3>
                                    <div class="tt-card-meta" style="font-size: 11px;">
                                        <i class="fa-regular fa-calendar"></i> @r.CreatedAt.ToString("dd/MM/yyyy")
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- SIDEBAR -->
        <div class="col-lg-3">
             <!-- Danh mục tin tức -->
            <div class="tt-sidebar-box mb-3">
                <h4 class="tt-sidebar-title">DANH MỤC TIN TỨC</h4>
                <ul class="tt-sidebar-list">
                    <li><a href="/tin-tuc.html">Tất cả <span>@ViewBag.TotalNewsCount</span></a></li>
                    @foreach(var cat in categories.Take(10)) {
                        <li><a href="/tin-tuc/@(cat.Slug).html">@cat.Name <span>@cat.ItemCount</span></a></li>
                    }
                </ul>
                @if(categories.Count > 10) {
                    <a href="javascript:void(0)" onclick="$('.tt-sidebar-list li.d-none').removeClass('d-none'); $(this).hide();" class="tt-sidebar-link">Xem tất cả danh mục <i class="fa-solid fa-arrow-right"></i></a>
                    <ul class="tt-sidebar-list">
                         @foreach(var cat in categories.Skip(10)) {
                            <li class="d-none"><a href="/tin-tuc/@(cat.Slug).html">@cat.Name <span>@cat.ItemCount</span></a></li>
                        }
                    </ul>
                }
            </div>

            <!-- Tin nổi bật -->
            @if(hotNews.Any()) {
            <div class="tt-sidebar-box mb-3">
                <h4 class="tt-sidebar-title">TIN NỔI BẬT</h4>
                @foreach(var hn in hotNews) {
                    <div class="tt-hot-item">
                        <img src="@(string.IsNullOrEmpty(hn.Image) ? "/assets/images/no-image.png" : hn.Image)" alt="@hn.Title">
                        <div>
                            <a href="/tin-tuc/detail/@(hn.Slug).html" class="tt-hot-title line-clamp-2">@hn.Title</a>
                            <div class="tt-hot-meta">
                                <i class="fa-regular fa-calendar"></i> @hn.CreatedAt.ToString("dd/MM/yyyy") &nbsp; 
                                <i class="fa-regular fa-eye"></i> @hn.Views.ToString("N0")
                            </div>
                        </div>
                    </div>
                }
            </div>
            }

            <!-- CTA Box -->
            <partial name="_SidebarCTA" />
        </div>
    </div>
</main>
