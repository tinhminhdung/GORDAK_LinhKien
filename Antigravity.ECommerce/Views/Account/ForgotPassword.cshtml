@{
    Layout = "_MainLayout";
    ViewData["Title"] = "Quên mật khẩu";
}
@section Styles {
    <style>
        .auth-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #f3f4f6 0%, #e5e7eb 100%);
            padding: 2rem 0;
        }
        .auth-card {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.05);
            border-radius: 20px;
            padding: 2.5rem;
            width: 100%;
            max-width: 550px;
        }
        .auth-title {
            font-size: 1.75rem;
            font-weight: 700;
            color: #1f2937;
            margin-bottom: 0.5rem;
            text-align: center;
        }
        .auth-subtitle {
            text-align: center;
            color: #6b7280;
            margin-bottom: 2rem;
        }
        .form-control-custom {
            border-radius: 12px;
            padding: 0.75rem 1rem;
            border: 1px solid #d1d5db;
            background: rgba(255, 255, 255, 0.9);
            transition: all 0.3s;
        }
        .form-control-custom:focus {
            border-color: #4f46e5;
            box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
        }
        .btn-auth {
            background: linear-gradient(to right, #4f46e5, #4338ca);
            color: white;
            border-radius: 12px;
            padding: 0.75rem;
            font-weight: 600;
            border: none;
            width: 100%;
            transition: all 0.3s;
        }
        .btn-auth:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(79, 70, 229, 0.3);
            color: white;
        }
        .auth-links {
            text-align: center;
            margin-top: 1.5rem;
        }
        .auth-links a {
            color: #4f46e5;
            text-decoration: none;
            font-weight: 500;
            transition: color 0.2s;
        }
        .auth-links a:hover {
            color: #3730a3;
        }
    </style>
}

<div class="auth-page">
    <div class="auth-card">
        <h1 class="auth-title">Khôi phục mật khẩu</h1>
        <p class="auth-subtitle">Nhập email của bạn để nhận mật khẩu mới</p>
        
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @ViewBag.Error
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form asp-controller="Account" asp-action="ForgotPassword" method="post">
            <div class="mb-4">
                <label class="form-label text-muted fw-semibold">Email đã đăng ký</label>
                <input type="email" name="email" class="form-control form-control-custom" placeholder="Nhập địa chỉ email" required>
            </div>
            <button type="submit" class="btn btn-auth mb-3">Nhận mật khẩu mới</button>
        </form>

        <div class="auth-links">
            <a asp-controller="Account" asp-action="Login"><i class="mdi mdi-arrow-left"></i> Quay lại đăng nhập</a>
        </div>
    </div>
</div>
